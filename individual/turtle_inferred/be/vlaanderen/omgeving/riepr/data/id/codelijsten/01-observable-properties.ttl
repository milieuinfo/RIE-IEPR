@prefix :               <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix quantalitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt:           <http://qudt.org/schema/qudt/> .
@prefix rdfs:           <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa:           <http://www.w3.org/ns/sosa/> .
@prefix unit:           <http://qudt.org/vocab/unit/> .

:ZinkConcentratie  a       sosa:ObservableProperty;
        rdfs:label         "Zink concentratie"@nl;
        qudt:quantityKind  quantalitykind:MassConcentration;
        qudt:unit          unit:MicrogramPerCubicMeter .

:Zuurtegraad  a            sosa:ObservableProperty;
        rdfs:label         "Zuurtegraad"@nl;
        qudt:quantityKind  quantalitykind:Acidity;
        qudt:unit          unit:PH .
