        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: TTTFFTFFT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: TTTFFTFFT\n    "@en;
        skos:prefLabel    "non-tangential proper part inverse"@en .

prov:Accept  rdf:type    owl:Class;
        rdfs:label       "Accept"@en;
        rdfs:subClassOf  prov:Activity;
        prov:definition  "Activity that identifies the acceptance of a resource (e.g., an article in a conference)"@en .

prov:Role  rdf:type       owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "Role";
        rdfs:seeAlso      prov:hadRole;
        prov:category     "qualified";
        prov:component    "agents-responsibility";
        prov:definition   "A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end."@en;
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-role"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI .

geo:sfDisjoint  rdf:type  owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject is spatially disjoint \n      from the object SpatialObject. DE-9IM: FF*FF****\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "disjoint"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject is spatially disjoint \n      from the object SpatialObject. DE-9IM: FF*FF****\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject is spatially disjoint \n      from the object SpatialObject. DE-9IM: FF*FF****\n    "@en;
        skos:prefLabel    "disjoint"@en .

sosa:madeActuation  rdf:type   owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-act:;
        rdfs:label             "made actuation"@en;
        rdfs:subPropertyOf     sosa:madeExecution;
        schema:domainIncludes  sosa:Actuator;
        schema:rangeIncludes   sosa:Actuation , sosa:ActuationCollection;
        owl:inverseOf          sosa:madeByActuator;
        skos:definition        "\n  relation from an Actuator to an Actuation or ActuationCollection it has made\n  "@en .

prov:PrimarySourceShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:PrimarySource .

prov:AgentInfluenceShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:AgentInfluence .

prov:qualifiedPrimarySource
        rdf:type                   owl:ObjectProperty;
        rdfs:comment               "If this Entity prov:hadPrimarySource Entity :e, then it can qualify how using prov:qualifiedPrimarySource [ a prov:PrimarySource; prov:entity :e; :foo :bar ]."@en;
        rdfs:domain                prov:Entity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedPrimarySource";
        rdfs:range                 prov:PrimarySource;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "derivations";
        prov:inverse               "qualifiedSourceOf";
        prov:sharesDefinitionWith  prov:PrimarySource;
        prov:unqualifiedForm       prov:hadPrimarySource .

geo:sfCrosses  rdf:type   owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially crosses the \n      object SpatialObject. DE-9IM: T*T******\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "crosses"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially crosses the \n      object SpatialObject. DE-9IM: T*T******\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially crosses the \n      object SpatialObject. DE-9IM: T*T******\n    "@en;
        skos:prefLabel    "crosses"@en .

prov:Plan  rdf:type       owl:Class;
        rdfs:comment      "There exist no prescriptive requirement on the nature of plans, their representation, the actions or steps they consist of, or their intended goals. Since plans may evolve over time, it may become necessary to track their provenance, so plans themselves are entities. Representing the plan explicitly in the provenance can be useful for various tasks: for example, to validate the execution as represented in the provenance record, to manage expectation failures, or to provide explanations."@en;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#> , prov:;
        rdfs:label        "Plan";
        rdfs:subClassOf   prov:Entity;
        prov:category     "qualified" , "expanded";
        prov:component    "agents-responsibility";
        prov:definition   "A plan is an entity that represents a set of actions or steps intended by one or more agents to achieve some goals.";
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Association"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Association"^^xsd:anyURI .

riepr:Stof  rdf:type     owl:Class;
        rdfs:comment     "Een stof is een chemische substantie die wordt gebruikt, verwerkt, getransporteerd of uitgestoten binnen een activiteit."@nl;
        rdfs:label       "Stof"@nl;
        rdfs:subClassOf  dbo:ChemicalSubstance;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ] .

prov:contributed  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "contributed";
        owl:inverseOf     prov:wasAttributedTo .

prov:EmptyDictionary  rdf:type  owl:Class;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "Empty Dictionary";
        rdfs:subClassOf   prov:EmptyCollection , prov:Dictionary;
        prov:category     "collections";
        prov:component    "collections";
        prov:constraints  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition   "An empty dictionary (i.e. has no members).";
        prov:dm           "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI .

prov:ServiceDescriptionShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:ServiceDescription .

sosa:hasInputValue  rdf:type   owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has input value"@en;
        schema:domainIncludes  sosa:Actuation , sosa:ActuationCollection , sosa:Observation , sosa:Execution , sosa:ExecutionCollection , sosa:Sampling;
        skos:definition        "\n  assigns a value to an input defined by the Procedure that is used in an Execution\n  "@en;
        skos:note              "The input value MUST be consistent with a hasInput definition from the corresponding Procedure"@en;
        skos:scopeNote         "The input might be a calibration or conditioning parameter, or the output of a previous procedure within an extended processing chain."@en .

<file:///home/gehau/git/RIE-IEPR/#>
        rdf:type               owl:Ontology;
        rdfs:seeAlso           <http://www.w3.org/TR/prov-o/#names-of-inverse-properties>;
        owl:imports            <http://www.w3.org/ns/prov-o#>;
        owl:versionIRI         <http://www.w3.org/ns/prov-o-inverses-20130430>;
        prov:specializationOf  <http://www.w3.org/ns/prov-o-inverses>;
        prov:wasDerivedFrom    <http://www.w3.org/ns/prov-o-20130430>;
        prov:wasRevisionOf     <http://www.w3.org/ns/prov-o-inverses-20120312> .

prov:Agent  rdf:type      owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "Agent";
        owl:disjointWith  prov:InstantaneousEvent;
        prov:category     "starting-point";
        prov:component    "agents-responsibility";
        prov:definition   "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity. "@en;
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent"^^xsd:anyURI .

prov:EmptyCollectionShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:EmptyCollection .

[ rdf:type               owl:Axiom;
  owl:annotatedProperty  rdfs:range;
  owl:annotatedSource    prov:wasInfluencedBy;
  owl:annotatedTarget    [ rdf:type     owl:Class;
                           owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                         ];
  prov:definition        "influencer: an identifier (o1) for an ancestor entity, activity, or agent that the former depends on;";
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"
] .

sosa:System  rdf:type     owl:Class;
        rdfs:isDefinedBy  sosa-common:;
        rdfs:label        "System"@en;
        rdfs:subClassOf   prov:Entity , prov:Agent;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:implements
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:isHostedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Execution sosa:ExecutionCollection )
                                               ];
                            owl:onProperty     sosa:madeExecution
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:hasSubSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:hasDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:isSubSystemOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:hasDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Execution sosa:ExecutionCollection )
                                               ];
                            owl:onProperty     sosa:madeExecution
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:isHostedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Execution sosa:ExecutionCollection )
                                               ];
                            owl:onProperty     sosa:madeExecution
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:hasSubSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:hasDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:isSubSystemOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:isSubSystemOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:isSubSystemOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Execution sosa:ExecutionCollection )
                                               ];
                            owl:onProperty     sosa:madeExecution
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:isHostedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:isHostedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:hasDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:hasSubSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:hasSubSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:implements
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:implements
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:implements
                          ];
        skos:definition   "\n  entity that implements a Procedure in the context of an Execution\n  "@en;
        skos:note         "\n  This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation).\n\n  Different Systems can implement the same (reusable) Procedure for different Executions.\n\n  A System may have components, its sub-systems, which are other systems.\n  "@en;
        skos:scopeNote    "\n  The association of a System (Actuator, Sensor, and Sampler) with a FeatureOfInterest is usually in the context of an Execution or a Deployment. \n\n  A System can be hosted by a Platform. \n\n  A System can be deployed for a specified time interval as part of a Deployment.\n  "@en , "\n  Specific system types may be implemented as sub-classes of this class or its sub-classes.\n  Their descriptions may capture the properties and characteristics of a whole class of systems, corresponding with the information typically found in a data-sheet.\n\n  Individual system instances are members of this class or its sub-classes. \n  "@en , "\n  System generalizes the Actuator, Sensor, and Sampler classes. \n  It is included in the ontology to support the definition of a common pattern for executions and their properties. \n\n  System MUST be considered to be abstract, so any individual System SHOULD be declared to be an instance of a concrete sub-class, and not of the System class.\n  "@en .

prov:started  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "started";
        owl:inverseOf     prov:wasStartedBy .

prov:qualifiedStart  rdf:type      owl:ObjectProperty;
        rdfs:comment               "If this Activity prov:wasStartedBy Entity :e1, then it can qualify how it was started using prov:qualifiedStart [ a prov:Start;  prov:entity :e1; :foo :bar ]."@en;
        rdfs:domain                prov:Activity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedStart";
        rdfs:range                 prov:Start;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "entities-activities";
        prov:inverse               "qualifiedStartOf";
        prov:sharesDefinitionWith  prov:Start;
        prov:unqualifiedForm       prov:wasStartedBy .

prov:wasPlanOf  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "wasPlanOf";
        owl:inverseOf     prov:hadPlan .

riepr:Grondwaterput  rdf:type  owl:Class;
        rdfs:comment     "Een grondwaterput is een specifiek type emissiepunt dat wordt gebruikt voor de uitstoot van stoffen in het grondwater."@nl;
        rdfs:label       "Grondwaterput"@nl;
        rdfs:subClassOf  riepr:Emissiepunt;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dbo:depth
                         ];
        skos:example     [ rdf:type         riepr:Grondwaterput;
                           rdfs:label       "Grondwaterput 1 Cementfabriek Antwerpen"@nl;
                           dbo:depth        "15.0"^^xsd:float;
                           geo:hasGeometry  [ rdf:type   geo:Geometry;
                                              geo:asWKT  "POINT(4.4020 51.2190)"^^geo:wktLiteral
                                            ];
                           prov:atLocation  [ rdf:type    riepr:Installatie;
                                              rdfs:label  "Cementfabriek Antwerpen Installatie 1"@nl
                                            ]
                         ] .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Derivation is a particular case of trace (see http://www.w3.org/TR/prov-dm/#term-trace), since it links an entity to another entity that contributed to its existence.";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasDerivedFrom;
  owl:annotatedTarget    prov:wasInfluencedBy
] .

ssn:    rdf:type             owl:Ontology;
        rdfs:comment         "Please report any errors to the W3C Spatial Data on the Web Working Group via the SDW WG Public List public-sdw-wg@w3.org"@en;
        rdfs:seeAlso         <https://www.w3.org/2015/spatial/wiki/Semantic_Sensor_Network_Ontology>;
        dcterms:created      "2017-04-17"^^xsd:date;
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:description  "This ontology describes sensors, actuators and observations, and related concepts. It does not describe domain concepts, time, locations, etc. these are intended to be included from other ontologies via OWL imports."@en , "\n  This module imports all the axiomatizations of the SOSA terms, and adds cross-module axioms. \n  "@en;
        dcterms:license      <http://www.opengeospatial.org/ogc/Software> , <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document>;
        dcterms:modified     "2024-02-03"^^xsd:date;
        dcterms:rights       "Copyright 2025 W3C/OGC.";
        dcterms:title        "Semantic Sensor Network Ontology"@en;
        owl:imports          ssn-dep: , sosa: , ssn-obs: , ssn-act: , ssn-sam:;
        owl:priorVersion     <http://www.w3.org/ns/ssn/2017/>;
        owl:versionIRI       <http://www.w3.org/ns/ssn/2023/>;
        owl:versionInfo      "New modular version of the SSN ontology. \n\nThis ontology was originally developed in 2009-2011 by the W3C Semantic Sensor Networks Incubator Group (SSN-XG). For more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/. The ontology was revised and modularized in 2015-2017 by the W3C/OGC Spatial Data on the Web Working Group, see: https://www.w3.org/2015/spatial/wiki/Semantic_Sensor_Network_Ontology. \n\nIn particular, (a) the scope is extended to include actuation and sampling; (b) the core concepts and properties are factored out into the SOSA ontology. The SSN ontology imports SOSA and adds formal axiomatization consistent with the text definitions in SOSA, and adds classes and properties to accommodate the scope of the original SSN ontology. "@en;
        skos:historyNote     "\n  Terms in the ssn: namespace have equivalence axioms to terms declared in the sosa: namespace, and are marked 'deprecated'. \n  The axiomatization from the 2017 version of the standard is preserved. \n\n  Terms in the sosa: namespace do not carry symmetric equivalent axioms. \n  Axiomatization only uses sosa: terms. \n  ";
        skos:scopeNote       "The SSN module contains an axiomatization of the core terms from the SOSA module (serialized in the sosa:ttl file) plus some deprecated terms in the ssn: namespace. " .

dbo:ProjectShape  rdf:type  sh:NodeShape;
        sh:targetClass  dbo:Project .

riepr:LozingspuntShape
        rdf:type        sh:NodeShape;
        sh:targetClass  riepr:Lozingspunt .

riepr:Bron  rdf:type     owl:Class;
        rdfs:comment     "Een bron is de oorsprong of herkomst van water of andere stoffen die als input worden gebruikt in een activiteit of procedure."@nl;
        rdfs:label       "Bron"@nl;
        rdfs:subClassOf  ssn:Input;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:comment
                         ];
        skos:example     [ rdf:type      riepr:Bron;
                           rdfs:comment  "Grondwater als waterbron voor industriele processen"@nl;
                           rdfs:label    "Grondwater"@nl
                         ];
        skos:example     [ rdf:type      riepr:Bron;
                           rdfs:comment  "Water uit oppervlaktewaterlopen als bron"@nl;
                           rdfs:label    "Oppervlaktewater (waterlopen/kanalen)"@nl
                         ] .

riepr:ProcesShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      p-plan:isStepOfPlan
                        ];
        sh:property     [ sh:class     xsd:date;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      dcterms:issued
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      dcterms:valid
                        ];
        sh:property     [ sh:class     sosa:Procedure;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      ssn:implements
                        ];
        sh:property     [ sh:minCount  "0"^^xsd:long;
                          sh:or        ( [ sh:class  riepr:Emissiepunt ]
                                         [ sh:class  riepr:Apparaat ]
                                         [ sh:class  riepr:Bron ]
                                         [ sh:class  riepr:Stof ]
                                       );
                          sh:path      prov:used
                        ];
        sh:targetClass  riepr:Proces .

prov:CommunicationShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:Communication .

prov:QuotationShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Quotation .

prov:Revision  rdf:type       owl:Class;
        rdfs:comment          "An instance of prov:Revision provides additional descriptions about the binary prov:wasRevisionOf relation from some newer prov:Entity to an earlier prov:Entity. For example, :draft_2 prov:wasRevisionOf :draft_1; prov:qualifiedRevision [ a prov:Revision; prov:entity :draft_1; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Revision";
        rdfs:subClassOf       prov:Derivation;
        prov:category         "qualified";
        prov:component        "derivations";
        prov:definition       "A revision is a derivation for which the resulting entity is a revised version of some original. The implication here is that the resulting entity contains substantial content from the original. Revision is a particular case of derivation."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-revision"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Revision"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasRevisionOf .

prov:RightsHolder  rdf:type  owl:Class;
        rdfs:label       "RightsHolder"@en;
        rdfs:subClassOf  prov:Role;
        prov:definition  "Role with the function of owning or managing rights over a resource. The Agent assigned to this role is associated with a RightsAssignment Activity"@en .

prov:SoftwareAgent  rdf:type  owl:Class;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "SoftwareAgent";
        rdfs:subClassOf   prov:Agent , owl:Thing;
        prov:category     "expanded";
        prov:component    "agents-responsibility";
        prov:definition   "A software agent is running software."@en;
        prov:dm           "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-dm.html#term-agent"^^xsd:anyURI , "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-n.html#expression-types"^^xsd:anyURI , "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

ssn-sam:  rdf:type           owl:Ontology;
        dcterms:created      "2024-02-02"^^xsd:date;
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:description  "Sampling classes and properties for the SSN Ontology."@en;
        dcterms:license      <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document> , <http://www.opengeospatial.org/ogc/Software>;
        dcterms:rights       "Copyright 2025 W3C/OGC.";
        dcterms:title        "Sensor, Observation, Sample, and Actuator (SOSA) Ontology - actuation module"@en;
        owl:imports          sosa-sam: , ssn-common: .

sosa:madeExecution  rdf:type   owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "made execution"@en;
        schema:domainIncludes  sosa:Sampler , sosa:System , sosa:Sensor , sosa:Actuator;
        schema:rangeIncludes   sosa:Observation , sosa:Execution , sosa:ObservationCollection , sosa:Sampling , sosa:ExecutionCollection , sosa:ActuationCollection , sosa:SamplingCollection , sosa:Actuation;
        owl:inverseOf          sosa:madeBySystem;
        skos:definition        "\n  relation from a System to an Execution or ExecutionCollection that it has made\n  "@en;
        skos:scopeNote         "\n  madeExecution generalizes the madeActuation, madeObservation, and madeSampling properties. \n  It is included in the ontology to support the definition of a common pattern for executions and their properties. \n\n  madeExecution MUST be considered to be abstract, so SHOULD NOT appear in data instances. \n  Applications can use concrete sub-properties of madeExecution.\n  "@en .

sosa:SamplerShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:class  sosa:SamplingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:class  sosa:SamplingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySampler ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySampler ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySampler ]
                        ];
        sh:property     [ sh:class  sosa:SamplingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:class  sosa:SamplingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySampler ]
                        ];
        sh:targetClass  sosa:Sampler .

riepr:Gesloten  rdf:type      skos:Concept;
        rdfs:comment          "De gesloten status geeft aan dat een entiteit permanent buiten gebruik is gesteld."@nl;
        rdfs:equivalentClass  <http://purl.org/adms/status/Withdrawn>;
        rdfs:label            "Gesloten"@nl;
        skos:prefLabel        "Gesloten"@nl .

sosa:FeatureOfInterest
        rdf:type          owl:Class;
        rdfs:isDefinedBy  sosa-common:;
        rdfs:label        "Feature Of Interest"@en;
        rdfs:subClassOf   prov:Entity;
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:isFeatureOfInterestOf;
                            owl:someValuesFrom  [ rdf:type     owl:Class;
                                                  owl:unionOf  ( sosa:Deployment sosa:Execution sosa:ExecutionCollection )
                                                ]
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasSample
                          ];
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:isFeatureOfInterestOf;
                            owl:someValuesFrom  [ rdf:type     owl:Class;
                                                  owl:unionOf  ( sosa:Deployment sosa:Execution sosa:ExecutionCollection )
                                                ]
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasSample
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:hasProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:hasProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:hasProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:hasProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasSample
                          ];
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:isFeatureOfInterestOf;
                            owl:someValuesFrom  [ rdf:type     owl:Class;
                                                  owl:unionOf  ( sosa:Deployment sosa:Execution sosa:ExecutionCollection )
                                                ]
                          ];
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:isFeatureOfInterestOf;
                            owl:someValuesFrom  [ rdf:type     owl:Class;
                                                  owl:unionOf  ( sosa:Deployment sosa:Execution sosa:ExecutionCollection )
                                                ]
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasSample
                          ];
        skos:definition   "\n  entity that is the target of an Execution or Deployment\n\n  i.e., whose property is being estimated by an Observation, \n  or whose property is being manipulated by an Actuator, \n  or which is being sampled or transformed in an act of Sampling, \n  or which is the target of Executions planned as part of a Deployment.\n  "@en;
        skos:example      "When measuring the height of a tree, the height is the observed Property, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuation."@en .

prov:InsertionShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:dictionary
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      prov:insertedKeyEntityPair
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      prov:insertedKeyEntityPair
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:dictionary
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      prov:insertedKeyEntityPair
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:dictionary
                        ];
        sh:targetClass  prov:Insertion .

dbo:ResearchProjectShape
        rdf:type        sh:NodeShape;
        sh:targetClass  dbo:ResearchProject .

dbo:projectBudgetFunding
        rdfs:domain  dbo:ResearchProject .

<http://www.w3.org/ns/prov-links#>
        rdf:type               owl:Ontology;
        rdfs:comment           "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/\n). All feedback is welcome."@en;
        rdfs:label             "W3C PROV Linking Across Provenance Bundles Ontology (PROV-LINKS)"@en;
        rdfs:seeAlso           <http://www.w3.org/ns/prov> , <http://www.w3.org/TR/prov-links/>;
        owl:imports            <http://www.w3.org/ns/prov-o#>;
        owl:versionIRI         <http://www.w3.org/ns/prov-links-20130430>;
        owl:versionInfo        "Working Group Note version 2013-04-30"@en;
        prov:specializationOf  <http://www.w3.org/ns/prov-links> .

prov:DerivationShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Derivation .

p-plan:isVariableOfPlan
        rdf:type          owl:ObjectProperty;
        rdfs:domain       p-plan:Variable;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "isVariableofPlan"@en;
        rdfs:range        p-plan:Plan;
        prov:definition   "p-plan:IsVariableOfPlan binds a p-plan:Variable to the p-plan:Plan it corresponds to."@en .

prov:hadRole  rdf:type             owl:ObjectProperty;
        rdfs:comment               "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>." , "The _optional_ Role that an Entity assumed in the context of an Activity. For example, :baking prov:used :spoon; prov:qualified [ a prov:Usage; prov:entity :spoon; prov:hadRole roles:mixing_implement ]."@en;
        rdfs:domain                prov:Influence;
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Association prov:InstantaneousEvent )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Association prov:InstantaneousEvent )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Association prov:InstantaneousEvent )
                                   ];
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "hadRole";
        rdfs:range                 prov:Role;
        prov:category              "qualified";
        prov:component             "agents-responsibility";
        prov:editorsDefinition     "prov:hadRole references the Role (i.e. the function of an entity with respect to an activity), in the context of an instantaneous usage, generation, association, start, and end."@en;
        prov:inverse               "wasRoleIn";
        prov:sharesDefinitionWith  prov:Role .

prov:Creator  rdf:type   owl:Class;
        rdfs:label       "Creator"@en;
        rdfs:subClassOf  prov:Contributor;
        prov:definition  "Role with the function of creating a resource. The Agent assigned to this role is associated with a Create Activity"@en .

[ rdf:type            owl:Class;
  rdfs:subClassOf     [ rdf:type            owl:Restriction;
                        owl:onProperty      prov:used;
                        owl:someValuesFrom  riepr:Apparaat
                      ];
  owl:intersectionOf  ( riepr:Proces
                        [ rdf:type            owl:Restriction;
                          owl:onProperty      ssn:implements;
                          owl:someValuesFrom  riepr:apparaatVerwerkingsProces
                        ]
                      )
] .

prov:locationOf  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "locationOf";
        owl:inverseOf     prov:atLocation .

geo:ehOverlap  rdf:type   owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: T*T***T**\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "overlap"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: T*T***T**\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: T*T***T**\n    "@en;
        skos:prefLabel    "overlap"@en .

geo:isSimple  rdf:type    owl:DatatypeProperty;
        rdfs:comment      "\n      (true) if this geometric object has no anomalous geometric \n      points, such as self intersection or self tangency.\n    "@en;
        rdfs:domain       geo:Geometry;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "isSimple"@en;
        rdfs:range        xsd:boolean;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      (true) if this geometric object has no anomalous geometric \n      points, such as self intersection or self tangency.\n    "@en;
        skos:definition   "\n      (true) if this geometric object has no anomalous geometric \n      points, such as self intersection or self tangency.\n    "@en;
        skos:prefLabel    "isSimple"@en .

prov:ModifyShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Modify .

sosa:madeSamplingHasResult
        rdf:type                owl:ObjectProperty;
        rdfs:isDefinedBy        sosa-sam:;
        rdfs:label              "made sampling has result"@en;
        schema:domainIncludes   sosa:Sampler;
        schema:rangeIncludes    sosa:Sample , sosa:SampleCollection;
        owl:inverseOf           sosa:isResultOfMadeBySampler;
        owl:propertyChainAxiom  ( sosa:madeSampling sosa:hasResult );
        owl:propertyChainAxiom  ( sosa:madeSampling sosa:hasResult );
        owl:propertyChainAxiom  ( sosa:madeSampling sosa:hasResult );
        owl:propertyChainAxiom  ( sosa:madeSampling sosa:hasResult );
        skos:definition         "\n  relation from a Sampler to a Sample or SampleCollection made by it\n  "@en .

sosa:ActuatingProcedure
        rdf:type          owl:Class;
        rdfs:isDefinedBy  sosa-act:;
        rdfs:label        "Actuating Procedure"@en;
        rdfs:subClassOf   sosa:Procedure;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:implementedBy
                          ];
        skos:definition   "\n  workflow, protocol, plan, algorithm, or computational method specifying how to make an Actuation\n  \n  An Actuating Procedure is re-usable, and might be applied in many Actuations.\n  It explains the steps to be carried out to arrive at reproducible results.\n  "@en .

prov:qualifiedDelegationOf
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "qualifiedDelegationOf";
        owl:inverseOf     prov:qualifiedDelegation .

prov:pairKey  rdf:type    owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:domain       prov:KeyEntityPair;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "pairKey";
        rdfs:range        rdfs:Literal;
        prov:category     "collections";
        prov:component    "collections";
        prov:constraints  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition   "The key of a KeyEntityPair, which is an element of a prov:Dictionary.";
        prov:dm           "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

<file:///home/gehau/git/RIE-IEPR/>
        rdf:type                       owl:Ontology;
        rdfs:seeAlso                   <https://omgeving.vlaanderen.be>;
        dcterms:creator                "Flemish Government - Department of Environment"@en , "Vlaamse overheid - Departement Omgeving"@nl;
        dcterms:description            "De RIE-IEPR ontologie definieert een datamodel voor het beschrijven van industriele activiteiten, installaties, emissiepunten, meetpunten, apparaten, observaties, exploitanten en exploitatie locaties binnen het kader van het RIE-IEPR systeem."@nl , "The RIE-IEPR ontology defines a data model for describing industrial activities, installations, emission points, measurement points, devices, observations, operators and operation locations within the context of the RIE-IEPR system."@en;
        dcterms:issued                 "2026-01-27"^^xsd:date;
        dcterms:license                <https://data.vlaanderen.be/id/licentie/modellicentie-gratis-hergebruik/v1.0>;
        dcterms:modified               "2026-01-27"^^xsd:date;
        dcterms:publisher              "Vlaamse overheid - Departement Omgeving"@nl , "Flemish Government - Department of Environment and Spatial Development"@en;
        dcterms:title                  "RIE-IEPR Ontology"@en , "RIE-IEPR Ontologie"@nl;
        vann:preferredNamespacePrefix  "riepr";
        vann:preferredNamespaceUri     "https://data.riepr.omgeving.vlaanderen.be/ns/riepr#";
        owl:imports                    org: , foaf: , skos: , ssn: , sosa: , prov: , geo: , p-plan: , dbo:;
        owl:versionInfo                "1.0.0";
        foaf:homepage                  <https://github.com/milieuinfo/RIE-IEPR> .

prov:wasAssociateFor  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "wasAssociateFor";
        owl:inverseOf     prov:wasAssociatedWith .

prov:atLocation  rdf:type          owl:ObjectProperty;
        rdfs:comment               "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>." , "The Location of any resource."@en;
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity prov:InstantaneousEvent )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity prov:InstantaneousEvent )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity prov:InstantaneousEvent )
                                   ];
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "atLocation";
        rdfs:range                 prov:Location;
        prov:category              "expanded";
        prov:editorialNote         "The naming of prov:atLocation parallels prov:atTime, and is not named prov:hadLocation to avoid conflicting with the convention that prov:had* properties are used on prov:Influence classes."@en , "This property is not functional because the many values could be at a variety of granularies (In this building, in this room, in that chair)."@en;
        prov:inverse               "locationOf";
        prov:sharesDefinitionWith  prov:Location .

rdfs:comment  rdf:type    owl:AnnotationProperty;
        rdfs:comment      ""@en;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#> .

prov:editorialNote  rdf:type  owl:AnnotationProperty;
        rdfs:comment      "A note by the OWL development team about how this term expresses the PROV-DM concept, or how it should be used in context of semantic web or linked data."@en;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#> .

geo:sfWithin  rdf:type    owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject is spatially within the \n      object SpatialObject. DE-9IM: T*F**F***\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "within"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject is spatially within the \n      object SpatialObject. DE-9IM: T*F**F***\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject is spatially within the \n      object SpatialObject. DE-9IM: T*F**F***\n    "@en;
        skos:prefLabel    "within"@en .

