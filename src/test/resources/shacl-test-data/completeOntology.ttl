riepr:MeetProcedureShape
        rdf:type        sh:NodeShape;
        sh:targetClass  riepr:MeetProcedure .

riepr:Meetpunt  rdf:type  owl:Class;
        rdfs:comment     "Een meetpunt is een specifiek punt waar metingen worden uitgevoerd om de kwaliteit van de uitstoot of de omgeving te controleren."@nl;
        rdfs:label       "Meetpunt"@nl;
        rdfs:subClassOf  geo:SpatialObject;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:valid
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      adms:status
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      sosa:isProxyFor;
                           owl:someValuesFrom  ( riepr:Emissiepunt riepr:Proces )
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:created;
                           owl:someValuesFrom  xsd:dateTime
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:issued;
                           owl:someValuesFrom  xsd:date
                         ];
        skos:example     [ rdf:type         riepr:Meetpunt;
                           rdfs:label       "Meetpunt Luchtkwaliteit Schouw 1"@nl;
                           dcterms:created  "2020-01-01T00:00:00"^^xsd:dateTime;
                           dcterms:issued   "2020-01-01"^^xsd:date;
                           dcterms:valid    "2030-12-31"^^xsd:date;
                           geo:hasGeometry  [ rdf:type   geo:Geometry;
                                              geo:asWKT  "POINT(4.4026 51.2195)"^^geo:wktLiteral
                                            ];
                           sosa:isProxyFor  [ rdf:type    riepr:Emissiepunt;
                                              rdfs:label  "Schouw 1 Cementfabriek Antwerpen"@nl
                                            ]
                         ] .

prov:wasGeneratedBy  rdf:type   owl:ObjectProperty;
        rdfs:domain             prov:Entity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#> , <http://www.w3.org/ns/prov-o-inverses#> , prov:;
        rdfs:label              "wasGeneratedBy";
        rdfs:range              prov:Activity;
        rdfs:subPropertyOf      prov:wasInfluencedBy;
        owl:inverseOf           prov:generated;
        owl:propertyChainAxiom  ( prov:qualifiedGeneration prov:activity );
        owl:propertyChainAxiom  ( prov:qualifiedGeneration prov:activity );
        owl:propertyChainAxiom  ( prov:qualifiedGeneration prov:activity );
        prov:category           "starting-point";
        prov:component          "entities-activities";
        prov:inverse            "generated";
        prov:qualifiedForm      prov:qualifiedGeneration , prov:Generation .

prov:entityOfInfluence
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "entityOfInfluence";
        owl:inverseOf     prov:entity .

riepr:SchouwShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      dbo:height
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      dbo:diameter
                        ];
        sh:targetClass  riepr:Schouw .

prov:wasUsedInDerivation
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "wasUsedInDerivation";
        owl:inverseOf     prov:hadUsage .

prov:hadMember  rdf:type           owl:ObjectProperty;
        rdfs:domain                prov:Collection;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "hadMember";
        rdfs:range                 prov:Entity;
        rdfs:subPropertyOf         prov:wasInfluencedBy;
        prov:category              "expanded";
        prov:component             "expanded";
        prov:inverse               "wasMemberOf";
        prov:sharesDefinitionWith  prov:Collection .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Derivation is a particular case of trace (see http://www.w3.org/TR/prov-dm/#term-trace), since it links an entity to another entity that contributed to its existence.";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasDerivedFrom;
  owl:annotatedTarget    prov:wasInfluencedBy
] .

prov:agentOfInfluence
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "agentOfInfluence";
        owl:inverseOf     prov:agent .

<http://www.w3.org/ns/prov-dc#>
        rdf:type      owl:Ontology;
        rdfs:comment  "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).\n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en , "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en;
        rdfs:label    "Dublin Core extensions of the W3C PROVenance Interchange Ontology (PROV-O) "@en;
        owl:imports   <http://www.w3.org/ns/prov-o#> .

prov:Location  rdf:type   owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "Location";
        rdfs:seeAlso      prov:atLocation;
        prov:category     "expanded";
        prov:definition   "A location can be an identifiable geographic place (ISO 19112), but it can also be a non-geographic place such as a directory, row, or column. As such, there are numerous ways in which location can be expressed, such as by a coordinate, address, landmark, and so forth."@en;
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-location"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI .

geo:FeatureShape  rdf:type  sh:NodeShape;
        sh:targetClass  geo:Feature .

sosa:hasProxy  rdf:type        owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "has proxy"@en;
        schema:domainIncludes  sosa:Property;
        schema:rangeIncludes   sosa:Stimulus;
        owl:inverseOf          sosa:isProxyFor;
        skos:definition        "\n  relation from an Property to a Stimulus that serves as its proxy\n  "@en;
        skos:example           "\nFor example, the expansion of mercury is a Stimulus that serves as a proxy for some temperature Property.\nAn increase or decrease in the velocity of spinning cups on a wind Sensor is serving as a proxy for the wind speed.\n  "@en .

riepr:Installatie  rdf:type  owl:Class;
        rdfs:comment     "Een installatie is een verzameling van apparatuur en infrastructuur op een bepaalde locatie die een specifieke functie vervult."@nl;
        rdfs:label       "Installatie"@nl;
        rdfs:subClassOf  ssn:System , geo:SpatialObjectCollection;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:issued;
                           owl:someValuesFrom  xsd:date
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:atLocation;
                           owl:someValuesFrom  riepr:ExploitatieLocatie
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:valid
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:wasDerivedFrom;
                           owl:someValuesFrom  riepr:ExploitatieLocatie
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:created;
                           owl:someValuesFrom  xsd:dateTime
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      adms:identifier
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      adms:status
                         ];
        skos:example     [ rdf:type         riepr:Installatie;
                           rdfs:label       "Cementfabriek Antwerpen Installatie 1"@nl;
                           dcterms:created  "2020-01-01T00:00:00"^^xsd:dateTime;
                           dcterms:issued   "2020-01-01"^^xsd:date;
                           dcterms:valid    "2030-12-31"^^xsd:date;
                           adms:status      riepr:Actief;
                           prov:atLocation  [ rdf:type    riepr:ExploitatieLocatie;
                                              rdfs:label  "Cementfabriek Antwerpen"@nl
                                            ]
                         ] .

prov:agent  rdf:type            owl:ObjectProperty;
        rdfs:domain             prov:AgentInfluence;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "agent";
        rdfs:range              prov:Agent;
        rdfs:subPropertyOf      prov:influencer;
        prov:category           "qualified";
        prov:editorialNote      "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en;
        prov:editorsDefinition  "The prov:agent property references an prov:Agent which influenced a resource. This property applies to an prov:AgentInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent."@en;
        prov:inverse            "agentOfInfluence" .

prov:specializationOf
        rdf:type            owl:AnnotationProperty , owl:ObjectProperty;
        rdfs:domain         prov:Entity;
        rdfs:isDefinedBy    <http://www.w3.org/ns/prov-o#> , prov:;
        rdfs:label          "specializationOf";
        rdfs:range          prov:Entity;
        rdfs:seeAlso        prov:alternateOf;
        rdfs:subPropertyOf  prov:alternateOf , owl:topObjectProperty;
        prov:category       "expanded";
        prov:component      "alternate";
        prov:constraints    "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI , "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-constraints.html#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition     "An entity that is a specialization of another shares all aspects of the latter, and additionally presents more specific aspects of the same thing as the latter. In particular, the lifetime of the entity being specialized contains that of any specialization. Examples of aspects include a time period, an abstraction, and a context associated with the entity."@en;
        prov:dm             "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-dm.html#term-specialization"^^xsd:anyURI , "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-specialization"^^xsd:anyURI;
        prov:inverse        "generalizationOf";
        prov:n              "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-n.html#expression-specialization"^^xsd:anyURI , "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-specialization"^^xsd:anyURI .

geo:dimension  rdf:type   owl:DatatypeProperty;
        rdfs:comment      "\n      The topological dimension of this geometric object, which \n      must be less than or equal to the coordinate dimension. \n      In non-homogeneous collections, this will return the largest \n      topological dimension of the contained objects.\n    "@en;
        rdfs:domain       geo:Geometry;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "dimension"@en;
        rdfs:range        xsd:integer;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      The topological dimension of this geometric object, which \n      must be less than or equal to the coordinate dimension. \n      In non-homogeneous collections, this will return the largest \n      topological dimension of the contained objects.\n    "@en;
        skos:definition   "\n      The topological dimension of this geometric object, which \n      must be less than or equal to the coordinate dimension. \n      In non-homogeneous collections, this will return the largest \n      topological dimension of the contained objects.\n    "@en;
        skos:prefLabel    "dimension"@en .

sosa:isSampleOf  rdf:type      owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-sam:;
        rdfs:label             "is sample of"@en;
        rdfs:subPropertyOf     prov:wasDerivedFrom;
        schema:domainIncludes  sosa:Sample , sosa:SampleCollection;
        schema:rangeIncludes   sosa:FeatureOfInterest;
        owl:inverseOf          sosa:hasSample;
        skos:definition        "\n  relation from a Sample or SampleCollection to the FeatureOfInterest that it is intended to represent\n  "@en .

prov:wasRoleIn  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "wasRoleIn";
        owl:inverseOf     prov:hadRole .

sosa:outputFor  rdf:type      owl:ObjectProperty;
        rdfs:isDefinedBy      sosa-common:;
        rdfs:label            "output for"@en;
        schema:rangeIncludes  sosa:Procedure;
        owl:inverseOf         sosa:hasOutput;
        skos:definition       "\n  relation from an output to a Procedure that generates it in an Execution\n  "@en .

ssn-common:  rdf:type        owl:Ontology;
        dcterms:created      "2024-02-03"^^xsd:date;
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:description  "Core classes and properties for the SSN Ontology.\n  This module adds RDFS and OWL axioms to the terms defined in SOSA Core\n  "@en;
        dcterms:license      <http://www.opengeospatial.org/ogc/Software> , <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document>;
        dcterms:rights       "Copyright 2025 W3C/OGC.";
        dcterms:title        "SSN Ontology - core module"@en;
        owl:imports          sosa-common: .

sosa:ObservationCollectionShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:madeObservation ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:wasObservedBy ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:wasObservedBy ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:madeObservation ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:madeObservation ]
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:wasObservedBy ]
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:madeObservation ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:wasObservedBy ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:targetClass  sosa:ObservationCollection .

prov:qualifiedStartOf
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "qualifiedStartOf";
        owl:inverseOf     prov:qualifiedStart .

riepr:EmissiepuntShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      adms:status
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      rdfs:label
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:or        ( [ sh:class  riepr:Installatie ]
                                         [ sh:class  riepr:ExploitatieLocatie ]
                                       );
                          sh:path      prov:atLocation
                        ];
        sh:targetClass  riepr:Emissiepunt .

prov:hadActivity  rdf:type         owl:ObjectProperty;
        rdfs:comment               "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>." , "The _optional_ Activity of an Influence, which used, generated, invalidated, or was the responsibility of some Entity. This property is _not_ used by ActivityInfluence (use prov:activity instead)."@en;
        rdfs:domain                prov:Influence;
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Delegation prov:Derivation prov:End prov:Start )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Delegation prov:Derivation prov:End prov:Start )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Delegation prov:Derivation prov:End prov:Start )
                                   ];
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "hadActivity";
        rdfs:range                 prov:Activity;
        prov:category              "qualified";
        prov:component             "derivations";
        prov:editorialNote         "The multiple rdfs:domain assertions are intended. One is simpler and works for OWL-RL, the union is more specific but is not recognized by OWL-RL."@en;
        prov:inverse               "wasActivityOfInfluence";
        prov:sharesDefinitionWith  prov:Activity .

[ rdf:type            owl:Class;
  rdfs:subClassOf     [ rdf:type            owl:Restriction;
                        owl:onProperty      prov:used;
                        owl:someValuesFrom  riepr:Emissiepunt
                      ];
  owl:intersectionOf  ( riepr:Proces
                        [ rdf:type            owl:Restriction;
                          owl:onProperty      ssn:implements;
                          owl:someValuesFrom  riepr:EmissieProcedure
                        ]
                      )
] .

prov:qualifiedInfluence
        rdf:type                   owl:ObjectProperty;
        rdfs:comment               "Because prov:qualifiedInfluence is a broad relation, the more specific relations (qualifiedCommunication, qualifiedDelegation, qualifiedEnd, etc.) should be used when applicable."@en;
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedInfluence";
        rdfs:range                 prov:Influence;
        prov:category              "qualified";
        prov:component             "derivations";
        prov:inverse               "qualifiedInfluenceOf";
        prov:sharesDefinitionWith  prov:Influence;
        prov:unqualifiedForm       prov:wasInfluencedBy .

prov:generatedAsDerivation
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "generatedAsDerivation";
        owl:inverseOf     prov:hadGeneration .

sosa:detects  rdf:type         owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "detects"@en;
        schema:domainIncludes  sosa:Sensor;
        schema:rangeIncludes   sosa:Stimulus;
        owl:inverseOf          sosa:isDetectedBy;
        skos:definition        "\n  relation from a Sensor to the Stimulus that it detects\n\n  The Stimulus itself will be serving as a proxy for some Property.\n  "@en .

riepr:EmissieProcedureShape
        rdf:type        sh:NodeShape;
        sh:targetClass  riepr:EmissieProcedure .

geo:wktLiteral  rdf:type  rdfs:Datatype;
        rdfs:comment      "\n      A Well-known Text serialization of a geometry object.\n    "@en;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "Well-known Text Literal"@en;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      A Well-known Text serialization of a geometry object.\n    "@en;
        skos:definition   "\n      A Well-known Text serialization of a geometry object.\n    "@en;
        skos:prefLabel    "Well-known Text Literal"@en .

prov:Collection  rdf:type  owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "Collection";
        rdfs:subClassOf   prov:Entity;
        prov:category     "expanded";
        prov:component    "collections";
        prov:definition   "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en;
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection"^^xsd:anyURI .

sosa:hasFeatureOfInterest
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has feature of interest"@en;
        rdfs:subPropertyOf     prov:used;
        schema:domainIncludes  sosa:Actuation , sosa:ObservationCollection , sosa:ActuationCollection , sosa:SamplingCollection , sosa:Deployment , sosa:Sampling , sosa:ExecutionCollection , sosa:Observation , sosa:Execution;
        schema:rangeIncludes   sosa:FeatureOfInterest;
        owl:inverseOf          sosa:isFeatureOfInterestOf;
        skos:definition        "\n  relation from an Execution or Deployment to its subject entity\n\n  i.e., from an Actuation to the entity whose property was modified;\n  from an Observation to the entity whose quality was observed;\n  from an act of Sampling to the entity that was sampled;\n  or from a Deployment to its target\n  "@en;
        skos:example           "For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight."@en;
        skos:scopeNote         "This is the _proximate_ feature of interest, which may be a proxy entity such as a sample of the _ultimate_ feature of interest. Use `hasUltimateFeatureOfInterest` if the intention is to link to the _ultimate_ feature of interest. " .

sosa:usedForExecution
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "used for execution"@en;
        schema:domainIncludes  sosa:Procedure;
        schema:rangeIncludes   sosa:Observation , sosa:Sampling , sosa:Actuation , sosa:Execution;
        owl:inverseOf          sosa:usedProcedure;
        skos:definition        "\n  relation from a Procedure to an Execution or ExecutionCollection made using it\n  "@en .

prov:quotedAs  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "quotedAs";
        owl:inverseOf     prov:wasQuotedFrom .

[ rdf:type               owl:Axiom;
  owl:annotatedProperty  rdfs:domain;
  owl:annotatedSource    prov:wasInfluencedBy;
  owl:annotatedTarget    [ rdf:type     owl:Class;
                           owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                         ];
  prov:definition        "influencee: an identifier (o2) for an entity, activity, or agent; ";
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"
] .

prov:activity  rdf:type         owl:ObjectProperty;
        rdfs:domain             prov:ActivityInfluence;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "activity";
        rdfs:range              prov:Activity;
        rdfs:subPropertyOf      prov:influencer;
        prov:category           "qualified";
        prov:editorialNote      "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en;
        prov:editorsDefinition  "The prov:activity property references an prov:Activity which influenced a resource. This property applies to an prov:ActivityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent.";
        prov:inverse            "activityOfInfluence" .

prov:qualifiedForm  rdf:type  owl:AnnotationProperty;
        rdfs:comment        "This annotation property links a subproperty of prov:wasInfluencedBy with the subclass of prov:Influence and the qualifying property that are used to qualify it.\n\nExample annotation:\n\n    prov:wasGeneratedBy prov:qualifiedForm prov:qualifiedGeneration, prov:Generation .\n\nThen this unqualified assertion:\n\n    :entity1 prov:wasGeneratedBy :activity1 .\n\ncan be qualified by adding:\n\n   :entity1 prov:qualifiedGeneration :entity1Gen .\n   :entity1Gen\n       a prov:Generation, prov:Influence;\n       prov:activity :activity1;\n       :customValue 1337 .\n\nNote how the value of the unqualified influence (prov:wasGeneratedBy :activity1) is mirrored as the value of the prov:activity (or prov:entity, or prov:agent) property on the influence class."@en , "This annotation property links a subproperty of prov:wasInfluencedBy with the subclass of prov:Influence and the qualifying property that are used to qualify it. \n\nExample annotation:\n\n    prov:wasGeneratedBy prov:qualifiedForm prov:qualifiedGeneration, prov:Generation .\n\nThen this unqualified assertion:\n\n    :entity1 prov:wasGeneratedBy :activity1 .\n\ncan be qualified by adding:\n\n   :entity1 prov:qualifiedGeneration :entity1Gen .\n   :entity1Gen \n       a prov:Generation, prov:Influence;\n       prov:activity :activity1;\n       :customValue 1337 .\n\nNote how the value of the unqualified influence (prov:wasGeneratedBy :activity1) is mirrored as the value of the prov:activity (or prov:entity, or prov:agent) property on the influence class."@en;
        rdfs:isDefinedBy    prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:subPropertyOf  rdfs:seeAlso .

prov:qualifiedSourceOf
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "qualifiedSourceOf";
        owl:inverseOf     prov:qualifiedPrimarySource .

sosa:deployedOnPlatform
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "deployed on platform"@en;
        rdfs:subPropertyOf     sosa:deployedAsset;
        schema:domainIncludes  sosa:Deployment;
        schema:rangeIncludes   sosa:Platform;
        owl:inverseOf          sosa:inDeployment;
        skos:definition        "\n  relation from a Deployment to a Platform on which Systems are hosted\n  "@en .

prov:qualifiedEnd  rdf:type        owl:ObjectProperty;
        rdfs:comment               "If this Activity prov:wasEndedBy Entity :e1, then it can qualify how it was ended using prov:qualifiedEnd [ a prov:End;  prov:entity :e1; :foo :bar ]."@en;
        rdfs:domain                prov:Activity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedEnd";
        rdfs:range                 prov:End;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "entities-activities";
        prov:inverse               "qualifiedEndOf";
        prov:sharesDefinitionWith  prov:End;
        prov:unqualifiedForm       prov:wasEndedBy .

prov:Usage  rdf:type          owl:Class;
        rdfs:comment          "An instance of prov:Usage provides additional descriptions about the binary prov:used relation from some prov:Activity to an prov:Entity that it used. For example, :keynote prov:used :podium; prov:qualifiedUsage [ a prov:Usage; prov:entity :podium; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Usage";
        rdfs:subClassOf       prov:EntityInfluence , prov:InstantaneousEvent;
        prov:category         "qualified";
        prov:component        "entities-activities";
        prov:constraints      "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition       "Usage is the beginning of utilizing an entity by an activity. Before usage, the activity had not begun to utilize this entity and could not have been affected by the entity."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Usage"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Usage"^^xsd:anyURI;
        prov:unqualifiedForm  prov:used .

prov:dm  rdf:type           owl:AnnotationProperty;
        rdfs:comment        "A reference to the principal section of the PROV-DM document that describes this concept."@en;
        rdfs:isDefinedBy    prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:subPropertyOf  rdfs:seeAlso .

p-plan:isSubPlanOfPlan
        rdf:type            owl:ObjectProperty;
        rdfs:domain         p-plan:Plan;
        rdfs:isDefinedBy    p-plan:;
        rdfs:label          "isSubPlanOfPlan"@en;
        rdfs:range          p-plan:Plan;
        rdfs:subPropertyOf  owl:topObjectProperty;
        prov:definition     "A p-plan:Plan may be a subplan of another bigger p-plan:Plan. p-plan:isSubPlanOfPlan is used to state the link among the two different plans. Note that if p1 is a p-plan:subPlan of p2, p1will not necessarily be a step of p2. A multistep will represent p1 in p2, and link to p1 with the p-plan.hasStepDecomposition relationship."@en .

sp:executionAssociation
        rdf:type            owl:ObjectProperty;
        rdfs:domain         sosa:Execution;
        rdfs:subPropertyOf  prov:qualifiedAssociation .

prov:revisedEntity  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "revisedEntity";
        owl:inverseOf     prov:qualifiedRevision .

prov:qualifiedRemoval
        rdf:type            owl:ObjectProperty;
        rdfs:domain         prov:Dictionary;
        rdfs:isDefinedBy    prov:;
        rdfs:label          "qualifiedRemoval";
        rdfs:range          prov:Removal;
        rdfs:subPropertyOf  prov:qualifiedDerivation;
        prov:category       "collections";
        prov:component      "collections";
        prov:constraints    "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition     "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed keys.";
        prov:dm             "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        prov:n              "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

prov:wasEndedBy  rdf:type       owl:ObjectProperty;
        rdfs:comment            "End is when an activity is deemed to have ended. An end may refer to an entity, known as trigger, that terminated the activity."@en;
        rdfs:domain             prov:Activity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "wasEndedBy";
        rdfs:range              prov:Entity;
        rdfs:subPropertyOf      prov:wasInfluencedBy;
        owl:propertyChainAxiom  ( prov:qualifiedEnd prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedEnd prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedEnd prov:entity );
        prov:category           "expanded";
        prov:component          "entities-activities";
        prov:inverse            "ended";
        prov:qualifiedForm      prov:End , prov:qualifiedEnd .

vann:preferredNamespacePrefix
        rdf:type  owl:AnnotationProperty .

prov:PersonShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Person .

prov:Publish  rdf:type   owl:Class;
        rdfs:label       "Publish"@en;
        rdfs:subClassOf  prov:Activity;
        prov:definition  "Activity that identifies the publication of a resource"@en .

prov:qualifiedRevision
        rdf:type                   owl:ObjectProperty;
        rdfs:comment               "If this Entity prov:wasRevisionOf Entity :e, then it can qualify how it was revised using prov:qualifiedRevision [ a prov:Revision;  prov:entity :e; :foo :bar ]."@en;
        rdfs:domain                prov:Entity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedRevision";
        rdfs:range                 prov:Revision;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "derivations";
        prov:inverse               "revisedEntity";
        prov:sharesDefinitionWith  prov:Revision;
        prov:unqualifiedForm       prov:wasRevisionOf .

geo:isEmpty  rdf:type     owl:DatatypeProperty;
        rdfs:comment      "\n      (true) if this geometric object is the empty Geometry. If \n      true, then this geometric object represents the empty point \n      set for the coordinate space.\n    "@en;
        rdfs:domain       geo:Geometry;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "isEmpty"@en;
        rdfs:range        xsd:boolean;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      (true) if this geometric object is the empty Geometry. If \n      true, then this geometric object represents the empty point \n      set for the coordinate space.\n    "@en;
        skos:definition   "\n      (true) if this geometric object is the empty Geometry. If \n      true, then this geometric object represents the empty point \n      set for the coordinate space.\n    "@en;
        skos:prefLabel    "isEmpty"@en .

prov:EmptyCollection  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "EmptyCollection"@en;
        rdfs:subClassOf   prov:Collection;
        prov:category     "expanded";
        prov:component    "collections";
        prov:definition   "An empty collection is a collection without members."@en .

p-plan:Bundle  rdf:type   owl:Class;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "Bundle"@en;
        rdfs:subClassOf   p-plan:Entity , prov:Bundle;
        prov:definition   "A p-plan:Bundle is a specific type of prov:Bundle that contains the provenance assertions of the execution of a p-plan:Plan"@en .

sosa:ExecutionShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class     sosa:FeatureOfInterest;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:property     [ sh:class     sosa:FeatureOfInterest;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class     sosa:FeatureOfInterest;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class     sosa:FeatureOfInterest;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:madeExecution ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   sosa:hasUltimateFeatureOfInterest
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:madeExecution ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:madeExecution ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:madeExecution ]
                        ];
        sh:targetClass  sosa:Execution .

sosa:SystemShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:or    ( [ sh:class  sosa:Execution ]
                                     [ sh:class  sosa:ExecutionCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySystem ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:hasSubSystem ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:hasSubSystem ]
                        ];
        sh:property     [ sh:class  sosa:Deployment;
                          sh:path   [ sh:inversePath  sosa:deployedAsset ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:Deployment;
                          sh:path   [ sh:inversePath  sosa:deployedAsset ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:hosts ]
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:isSubSystemOf ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Execution ]
                                     [ sh:class  sosa:ExecutionCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySystem ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:isSubSystemOf ]
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Execution ]
                                     [ sh:class  sosa:ExecutionCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySystem ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:hosts ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:hosts ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:hosts ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:hasSubSystem ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:Deployment;
                          sh:path   [ sh:inversePath  sosa:deployedAsset ]
                        ];
        sh:property     [ sh:class  sosa:Deployment;
                          sh:path   [ sh:inversePath  sosa:deployedAsset ]
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:isSubSystemOf ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:hasSubSystem ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Execution ]
                                     [ sh:class  sosa:ExecutionCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySystem ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:isSubSystemOf ]
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:targetClass  sosa:System .

prov:DirectQueryServiceShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:DirectQueryService .

prov:CreateShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Create .

dbo:UnitOfWork  rdf:type  owl:Class;
        rdfs:comment      "This class is meant to convey the notion of an amount work to be done. It is different from Activity in that it has a definite end and is being measured."@en , "Deze klasse is bedoeld om het concept van een hoeveelheid uit te voeren werk weer te geven. Ze verschilt van Activity doordat ze een duidelijk eindpunt heeft en meetbaar is."@nl;
        rdfs:label        "werkeenheid"@nl , "unit of work"@en;
        rdfs:subClassOf   owl:Thing;
        owl:disjointWith  dbo:Person .

prov:category  rdf:type   owl:AnnotationProperty;
        rdfs:comment      "Classify prov-o terms into three categories, including 'starting-point', 'qualifed', and 'extended'. This classification is used by the prov-o html document to gently introduce prov-o terms to its users. "@en;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#> .

sosa:isSampleOfUltimateFOI
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-sam:;
        rdfs:label             "has sampled feature"@en;
        schema:domainIncludes  sosa:Sample , sosa:SampleCollection;
        schema:rangeIncludes   sosa:FeatureOfInterest;
        owl:inverseOf          sosa:featureHasUltimateSample;
        skos:definition        "\n  relation from a Sample or SampleCollection to the ultimate FeatureOfInterest that it is intended to be representative of; i.e., the end of a chain of isSampleOf relations\n  "@en .

geo:rcc8eq  rdf:type      owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "equals"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        skos:prefLabel    "equals"@en .

sosa:isResultOfMadeBySampler
        rdf:type                owl:ObjectProperty;
        rdfs:isDefinedBy        sosa-sam:;
        rdfs:label              "is a result of made by sampler"@en;
        schema:domainIncludes   sosa:Sample , sosa:SampleCollection;
        schema:rangeIncludes    sosa:Sampler;
        owl:inverseOf           sosa:madeSamplingHasResult;
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:madeBySampler );
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:madeBySampler );
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:madeBySampler );
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:madeBySampler );
        skos:definition         "\n  relation from a Sample or SampleCollection to the Sampler that made it\n  "@en .

sosa:usedProcedure  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy        sosa-common:;
        rdfs:label              "used procedure"@en;
        schema:domainIncludes   sosa:SamplingCollection , sosa:Observation , sosa:ExecutionCollection , sosa:ObservationCollection , sosa:ActuationCollection , sosa:Sampling , sosa:Actuation , sosa:Execution;
        schema:rangeIncludes    sosa:ActuatingProcedure , sosa:ObservingProcedure , sosa:Procedure , sosa:SamplingProcedure;
        owl:inverseOf           sosa:usedForExecution;
        owl:propertyChainAxiom  ( sp:executionAssociation sp:hadProcedure );
        owl:propertyChainAxiom  ( sp:executionAssociation sp:hadProcedure );
        owl:propertyChainAxiom  ( sp:executionAssociation sp:hadProcedure );
        owl:propertyChainAxiom  ( sp:executionAssociation sp:hadProcedure );
        skos:definition         "\n  relation from an Execution or ExecutionCollection to a Procedure used to make it\n  "@en .

sosa:madeObservation  rdf:type  owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "made observation"@en;
        rdfs:subPropertyOf     sosa:madeExecution;
        schema:domainIncludes  sosa:Sensor;
        schema:rangeIncludes   sosa:Observation , sosa:ObservationCollection;
        owl:inverseOf          sosa:madeBySensor;
        skos:definition        "\n  relation from a Sensor to an Observation or ObservationCollection it has made\n  "@en .

dcterms:title  rdf:type  owl:AnnotationProperty .

riepr:Activiteit  rdf:type  owl:Class;
        rdfs:comment     "Een (milieu)activiteit is een door de gebruiker in te vullen industriele activiteit op een bepaalde locatie bestaande uit meerdere procedurestappen die de industriele activiteit beschrijven."@nl;
        rdfs:label       "Activiteit"@nl;
        rdfs:subClassOf  dbo:Project , p-plan:Plan;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:valid
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:issued;
                           owl:someValuesFrom  xsd:date
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:atLocation;
                           owl:someValuesFrom  riepr:ExploitatieLocatie
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:created;
                           owl:someValuesFrom  xsd:dateTime
                         ];
        skos:example     [ rdf:type         riepr:Activiteit;
                           rdfs:label       "Productie van cement in een fabriek te Antwerpen"@nl;
                           dcterms:created  "2024-01-15T10:00:00"^^xsd:dateTime;
                           dcterms:issued   "2020-01-01"^^xsd:date;
                           dcterms:valid    "2030-12-31"^^xsd:date;
                           prov:atLocation  [ rdf:type    riepr:ExploitatieLocatie;
                                              rdfs:label  "Cementfabriek Antwerpen"@nl
                                            ]
                         ] .

riepr:brandstofVerbruikProces
        rdf:type        skos:Concept , sosa:Procedure;
        rdfs:comment    "Een brandstofverbruikproces is een specifieke procedure die betrekking heeft op het verbruik van brandstof binnen een activiteit."@nl;
        rdfs:label      "Brandstofverbruikproces"@nl;
        skos:broader    riepr:VerbruiksProcedure;
        skos:prefLabel  "Brandstofverbruikproces"@nl .

owl:ThingShape  rdf:type  sh:NodeShape;
        sh:targetClass  owl:Thing .

sosa:isUltimateFeatureOfInterestOf
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "is ultimate feature of interest of"@en;
        schema:domainIncludes  sosa:FeatureOfInterest;
        schema:rangeIncludes   sosa:SamplingCollection , sosa:Observation , sosa:Sampling , sosa:Actuation , sosa:ActuationCollection , sosa:Execution , sosa:ExecutionCollection , sosa:ObservationCollection , sosa:Deployment;
        owl:inverseOf          sosa:hasUltimateFeatureOfInterest;
        skos:definition        "\n  relation from an ultimate FeatureOfInterest to an Execution, Execution Collection, or Deployment, for which it is the ultimate subject\n  "@en .

prov:provenanceUriTemplate
        rdf:type          owl:DatatypeProperty;
        rdfs:comment      "Relates a provenance service to a URI template string for constructing provenance-URIs."@en;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "provenanceUriTemplate";
        prov:aq           "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI;
        prov:category     "access-and-query" .

sosa:hasResult  rdf:type       owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has result"@en;
        rdfs:subPropertyOf     prov:generated;
        schema:domainIncludes  sosa:SamplingCollection , sosa:ObservationCollection , sosa:ExecutionCollection , sosa:Execution , sosa:Observation , sosa:ActuationCollection , sosa:Actuation , sosa:Sampling;
        schema:rangeIncludes   sosa:Sample;
        owl:inverseOf          sosa:isResultOf;
        skos:definition        "\n  relation from an Execution to its result\n\n  In the case of an Actuation, the result may be the value of the Property following the execution of the Procedure by the Actuator. \n\n  In the case of an Observation, the result is the value of the Property produced by the execution of the Procedure by the Sensor. \n  \n  In the case of a Sampling, the result is the Sample produced by the execution of the Procedure by the Sampler. \n\n  An Execution has a single result, therefore sosa:hasResult is Functional.\n  "@en;
        skos:note              "The result value MUST be consistent with the hasOutput definition from the corresponding Procedure"@en .

prov:RightsAssignment
        rdf:type         owl:Class;
        rdfs:label       "RightsAssignment"@en;
        rdfs:subClassOf  prov:Activity;
        prov:definition  "Activity that identifies the rights assignment of a resource."@en .

prov:endedAtTime  rdf:type  owl:DatatypeProperty;
        rdfs:comment        "The time at which an activity ended. See also prov:startedAtTime."@en;
        rdfs:domain         prov:Activity;
        rdfs:isDefinedBy    <http://www.w3.org/ns/prov-o#>;
        rdfs:label          "endedAtTime";
        rdfs:range          xsd:dateTime;
        prov:category       "starting-point";
        prov:component      "entities-activities";
        prov:editorialNote  "It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime."@en;
        prov:qualifiedForm  prov:atTime , prov:End .

sosa:featureHasUltimateSample
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-sam:;
        rdfs:label             "feature has ultimate sample"@en;
        schema:domainIncludes  sosa:FeatureOfInterest;
        schema:rangeIncludes   sosa:Sample , sosa:SampleCollection;
        owl:inverseOf          sosa:isSampleOfUltimateFOI;
        skos:definition        "\n  relation from an ultimate FeatureOfInterest to a Sample or SampleCollection that is intended to be representative of it; i.e., the end of a chain of hasSample relations\n  "@en .

prov:PrimarySource  rdf:type  owl:Class;
        rdfs:comment          "An instance of prov:PrimarySource provides additional descriptions about the binary prov:hadPrimarySource relation from some secondary prov:Entity to an earlier, primary prov:Entity. For example, :blog prov:hadPrimarySource :newsArticle; prov:qualifiedPrimarySource [ a prov:PrimarySource; prov:entity :newsArticle; :foo :bar ] ."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "PrimarySource";
        rdfs:subClassOf       prov:Derivation;
        prov:category         "qualified";
        prov:component        "derivations";
        prov:definition       "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight.\n\nBecause of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated.\n\nA primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-primary-source"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-original-source"^^xsd:anyURI;
        prov:unqualifiedForm  prov:hadPrimarySource .

sosa:hasSample  rdf:type       owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-sam:;
        rdfs:label             "has sample"@en;
        schema:domainIncludes  sosa:FeatureOfInterest;
        schema:rangeIncludes   sosa:Sample;
        owl:inverseOf          sosa:isSampleOf;
        skos:definition        "\n  relation from a FeatureOfInterest to the Sample or SampleCollection used to represent it\n  "@en .

prov:DictionaryShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Dictionary .

[ rdf:type               owl:Axiom;
  owl:annotatedProperty  rdfs:range;
  owl:annotatedSource    prov:wasInfluencedBy;
  owl:annotatedTarget    [ rdf:type     owl:Class;
                           owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                         ];
  prov:definition        "influencer: an identifier (o1) for an ancestor entity, activity, or agent that the former depends on;";
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"
] .

prov:InstantaneousEvent
        rdf:type          owl:Class;
        rdfs:comment      "An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous."@en;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "InstantaneousEvent";
        prov:category     "qualified";
        prov:component    "entities-activities";
        prov:constraints  "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#dfn-event"^^xsd:anyURI;
        prov:definition   "The PROV data model is implicitly based on a notion of instantaneous events (or just events), that mark transitions in the world. Events include generation, usage, or invalidation of entities, as well as starting or ending of activities. This notion of event is not first-class in the data model, but it is useful for explaining its other concepts and its semantics."@en .

riepr:Schouw  rdf:type   owl:Class;
        rdfs:comment     "Een schouw is een specifiek type emissiepunt dat wordt gebruikt voor de uitstoot van gassen en dampen."@nl;
        rdfs:label       "Schouw"@nl;
        rdfs:subClassOf  riepr:Emissiepunt;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dbo:diameter
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dbo:height
                         ];
        skos:example     [ rdf:type         riepr:Schouw;
                           rdfs:label       "Schouw 1 Cementfabriek Antwerpen"@nl;
                           dbo:diameter     "2.5"^^xsd:float;
                           dbo:height       "30.0"^^xsd:float;
                           geo:hasGeometry  [ rdf:type   geo:Geometry;
                                              geo:asWKT  "POINT(4.4025 51.2194)"^^geo:wktLiteral
                                            ];
                           prov:atLocation  [ rdf:type    riepr:Installatie;
                                              rdfs:label  "Cementfabriek Antwerpen Installatie 1"@nl
                                            ]
                         ] .

sosa:StimulusShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:wasOriginatedBy ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:wasOriginatedBy ]
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:detects ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:wasOriginatedBy ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:hasProxy ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:wasOriginatedBy ]
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:detects ]
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:detects ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:hasProxy ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:hasProxy ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:hasProxy ]
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:detects ]
                        ];
        sh:targetClass  sosa:Stimulus .

prov:CopyrightShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Copyright .

sosa:actsOn  rdf:type          owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-act:;
        rdfs:label             "acts on"@en;
        rdfs:subPropertyOf     sosa:forProperty;
        schema:domainIncludes  sosa:Actuator;
        schema:rangeIncludes   sosa:Property;
        owl:inverseOf          sosa:isActedOnBy;
        skos:definition        "\n  relation from an Actuator to a Property whose state may be changed by using it\n  "@en;
        skos:example           "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property upon which the Actuator acts is the state of the window as it changes from being open to being closed. "@en .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Revision is a derivation (see http://www.w3.org/TR/prov-dm/#term-Revision). Moreover, according to\nhttp://www.w3.org/TR/2013/REC-prov-constraints-20130430/#term-Revision 23 April 2012 'wasRevisionOf is a strict sub-relation of wasDerivedFrom since two entities e2 and e1 may satisfy wasDerivedFrom(e2,e1) without being a variant of each other.'";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasRevisionOf;
  owl:annotatedTarget    prov:wasDerivedFrom
] .

sosa:Platform  rdf:type   owl:Class;
        rdfs:isDefinedBy  sosa-common:;
        rdfs:label        "Platform or Host"@en;
        rdfs:subClassOf   prov:Entity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:inDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:inDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:System sosa:Platform )
                                               ];
                            owl:onProperty     sosa:hosts
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:System sosa:Platform )
                                               ];
                            owl:onProperty     sosa:hosts
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:inDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:System sosa:Platform )
                                               ];
                            owl:onProperty     sosa:hosts
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Deployment;
                            owl:onProperty     sosa:inDeployment
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:System sosa:Platform )
                                               ];
                            owl:onProperty     sosa:hosts
                          ];
        dcterms:source    <https://inspire.ec.europa.eu/id/document/tg/ef>;
        skos:altLabel     "Host";
        skos:definition   "\n  entity that hosts other entities, particularly Systems and other Platforms\n  "@en;
        skos:example      "A post, buoy, vehicle, ship, aircraft, satellite, cell-phone, human or animal may act as platforms for (technical or biological) sensors or actuators.\n  An environmental monitoring facility. \n  A platform that hosts a set of sensors. \n  A team performing a survey, where each team member would be modeled as an Observer."@en;
        skos:prefLabel    "Platform";
        skos:scopeNote    "The INSPIRE 'Environmental Monitoring Facility' may be implemented using SOSA by the OWL/RDFS class 'Platform'" .

riepr:InstallatieShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:class     riepr:ExploitatieLocatie;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      prov:wasDerivedFrom
                        ];
        sh:property     [ sh:class     riepr:ExploitatieLocatie;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:atLocation
                        ];
        sh:property     [ sh:class     xsd:date;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:issued
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      dcterms:valid
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      adms:status
                        ];
        sh:property     [ sh:minCount  "0"^^xsd:long;
                          sh:path      adms:identifier
                        ];
        sh:property     [ sh:class     xsd:dateTime;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:created
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      rdfs:label
                        ];
        sh:targetClass  riepr:Installatie .

prov:wasActivityOfInfluence
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "wasActivityOfInfluence";
        owl:inverseOf     prov:hadActivity .

prov:Bundle  rdf:type     owl:Class;
        rdfs:comment      "Note that there are kinds of bundles (e.g. handwritten letters, audio recordings, etc.) that are not expressed in PROV-O, but can be still be described by PROV-O."@en;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#> , prov:;
        rdfs:label        "Bundle";
        rdfs:subClassOf   prov:Entity;
        prov:category     "expanded";
        prov:definition   "A bundle is a named set of provenance descriptions, and is itself an Entity, so allowing provenance of provenance to be expressed."@en;
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-bundle-entity"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-bundle-declaration"^^xsd:anyURI .

[ rdf:type               owl:Axiom;
  owl:annotatedProperty  rdfs:range;
  owl:annotatedSource    prov:wasInfluencedBy;
  owl:annotatedTarget    [ rdf:type     owl:Class;
                           owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                         ];
  prov:definition        "influencer: an identifier (o1) for an ancestor entity, activity, or agent that the former depends on;";
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"
] .

geo:hasSerialization  rdf:type  owl:DatatypeProperty;
        rdfs:comment      "\n      Connects a geometry object with its text-based serialization.\n    "@en;
        rdfs:domain       geo:Geometry;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "has serialization"@en;
        rdfs:range        rdfs:Literal;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Connects a geometry object with its text-based serialization.\n    "@en;
        skos:definition   "\n      Connects a geometry object with its text-based serialization.\n    "@en;
        skos:prefLabel    "has serialization"@en .

prov:Delegation  rdf:type     owl:Class;
        rdfs:comment          "An instance of prov:Delegation provides additional descriptions about the binary prov:actedOnBehalfOf relation from a performing prov:Agent to some prov:Agent for whom it was performed. For example, :mixing prov:wasAssociatedWith :toddler . :toddler prov:actedOnBehalfOf :mother; prov:qualifiedDelegation [ a prov:Delegation; prov:entity :mother; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Delegation";
        rdfs:subClassOf       prov:AgentInfluence;
        prov:category         "qualified";
        prov:component        "agents-responsibility";
        prov:definition       "Delegation is the assignment of authority and responsibility to an agent (by itself or by another agent) to carry out a specific activity as a delegate or representative, while the agent it acts on behalf of retains some responsibility for the outcome of the delegated work.\n\nFor example, a student acted on behalf of his supervisor, who acted on behalf of the department chair, who acted on behalf of the university; all those agents are responsible in some way for the activity that took place but we do not say explicitly who bears responsibility and to what degree."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-delegation"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-delegation"^^xsd:anyURI;
        prov:unqualifiedForm  prov:actedOnBehalfOf .

sosa:Property  rdf:type   owl:Class;
        rdfs:isDefinedBy  sosa-common:;
        rdfs:label        "Property"@en;
        rdfs:subClassOf   prov:Entity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isPropertyOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:wasActedOnBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:wasActedOnBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Stimulus;
                            owl:onProperty     [ owl:inverseOf  sosa:isProxyFor ]
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:wasObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:hasProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isPropertyOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Stimulus;
                            owl:onProperty     [ owl:inverseOf  sosa:isProxyFor ]
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:hasProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Stimulus;
                            owl:onProperty     [ owl:inverseOf  sosa:isProxyFor ]
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:isActedOnBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:wasActedOnBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isPropertyOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:isActedOnBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:wasObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:wasActedOnBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:wasObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:hasProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Stimulus;
                            owl:onProperty     [ owl:inverseOf  sosa:isProxyFor ]
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isPropertyOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:hasProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:wasObservedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:isActedOnBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:isActedOnBy
                          ];
        skos:definition   "\n  identifiable quality of features of interest that can be observed or acted upon\n\n  A property can apply to different features of interest.\n\n  "@en;
        skos:example      "Cars (a feature type) all have a characteristic colour, where 'colour' is a property."@en;
        skos:note         "Concepts from existing code lists, vocabularies, and taxonomies, may be used as instances of Property"@en .

sosa:Procedure  rdf:type  owl:Class;
        rdfs:isDefinedBy  sosa-common:;
        rdfs:label        "Procedure"@en;
        rdfs:subClassOf   prov:Plan;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:forProperty
                          ];
        skos:definition   "\n  workflow, protocol, plan, algorithm, or computational method specifying how to make an Execution\n\n  A Procedure is re-usable, and might be applied in many Actuations, Observations, or Samplings.\n  It explains the steps to be carried out to arrive at reproducible results.\n  "@en;
        skos:example      "The measured wind speed differs depending on the height of the sensor above the surface, e.g., due to friction. Consequently, procedures for measuring wind speed define a standard height for anemometers above ground, typically 10m for meteorological measures and 2m in Agrometeorology. This definition of height, sensor placement, and so forth are defined by the Procedure."@en;
        skos:scopeNote    "\n  Procedure generalizes the ActuationProcedure, ObservationProcedure, and SamplingProcedure classes. \n  It is included in the ontology to support the definition of a common pattern for executions and their properties. \n  "@en .

prov:End  rdf:type            owl:Class;
        rdfs:comment          "An instance of prov:End provides additional descriptions about the binary prov:wasEndedBy relation from some ended prov:Activity to an prov:Entity that ended it. For example, :ball_game prov:wasEndedBy :buzzer; prov:qualifiedEnd [ a prov:End; prov:entity :buzzer; :foo :bar; prov:atTime '2012-03-09T08:05:08-05:00'^^xsd:dateTime ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "End";
        rdfs:subClassOf       prov:InstantaneousEvent , prov:EntityInfluence;
        prov:category         "qualified";
        prov:component        "entities-activities";
        prov:constraints      "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition       "End is when an activity is deemed to have been ended by an entity, known as trigger. The activity no longer exists after its end. Any usage, generation, or invalidation involving an activity precedes the activity's end. An end may refer to a trigger entity that terminated the activity, or to an activity, known as ender that generated the trigger."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-End"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-End"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasEndedBy .

sosa:SpatialSampleShape
        rdf:type        sh:NodeShape;
        sh:targetClass  sosa:SpatialSample .

<http://www.w3.org/ns/prov-dictionary#>
        rdf:type      owl:Ontology;
        rdfs:comment  "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).\n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en , "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \r\n\r\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en;
        rdfs:label    "W3C PROVenance Interchange Ontology (PROV-O) Dictionary Extension"@en;
        rdfs:seeAlso  <http://www.w3.org/ns/prov> , <http://www.w3.org/TR/prov-dictionary/> .

prov:qualifiedAttribution
        rdf:type                   owl:ObjectProperty;
        rdfs:comment               "If this Entity prov:wasAttributedTo Agent :ag, then it can qualify how it was influenced using prov:qualifiedAttribution [ a prov:Attribution;  prov:agent :ag; :foo :bar ]."@en;
        rdfs:domain                prov:Entity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedAttribution";
        rdfs:range                 prov:Attribution;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "agents-responsibility";
        prov:inverse               "qualifiedAttributionOf";
        prov:sharesDefinitionWith  prov:Attribution;
        prov:unqualifiedForm       prov:wasAttributedTo .

prov:used  rdf:type             owl:ObjectProperty;
        rdfs:comment            "A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven ."@en;
        rdfs:domain             prov:Activity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#> , prov:;
        rdfs:label              "used";
        rdfs:range              prov:Entity;
        rdfs:subPropertyOf      prov:wasInfluencedBy;
        owl:propertyChainAxiom  ( prov:qualifiedUsage prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedUsage prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedUsage prov:entity );
        prov:category           "starting-point";
        prov:component          "entities-activities";
        prov:inverse            "wasUsedBy";
        prov:qualifiedForm      prov:qualifiedUsage , prov:Usage .

dbo:fundedBy  rdfs:domain  dbo:ResearchProject .

prov:Attribution  rdf:type    owl:Class;
        rdfs:comment          "An instance of prov:Attribution provides additional descriptions about the binary prov:wasAttributedTo relation from an prov:Entity to some prov:Agent that had some responsible for it. For example, :cake prov:wasAttributedTo :baker; prov:qualifiedAttribution [ a prov:Attribution; prov:entity :baker; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Attribution";
        rdfs:subClassOf       prov:AgentInfluence;
        prov:category         "qualified";
        prov:component        "agents-responsibility";
        prov:constraints      "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition       "Attribution is the ascribing of an entity to an agent.\n\nWhen an entity e is attributed to agent ag, entity e was generated by some unspecified activity that in turn was associated to agent ag. Thus, this relation is useful when the activity is not known, or irrelevant."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribution"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribution"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasAttributedTo .

prov:ended  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "ended";
        owl:inverseOf     prov:wasEndedBy .

sosa:madeBySensor  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "made by sensor or observer"@en;
        rdfs:subPropertyOf     sosa:madeBySystem;
        schema:domainIncludes  sosa:Observation , sosa:ObservationCollection;
        schema:rangeIncludes   sosa:Sensor;
        owl:inverseOf          sosa:madeObservation;
        skos:definition        "\n  relation from an Observation or ObservationCollection to the Sensor that made it\n  "@en .

sosa:isResultOfUsedProcedure
        rdf:type                owl:ObjectProperty;
        rdfs:isDefinedBy        sosa-sam:;
        rdfs:label              "is a result of used procedure"@en;
        schema:domainIncludes   sosa:Sample , sosa:SampleCollection;
        schema:rangeIncludes    sosa:SamplingProcedure;
        owl:inverseOf           sosa:usedForExecutionHasResult;
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:usedProcedure );
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:usedProcedure );
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:usedProcedure );
        owl:propertyChainAxiom  ( sosa:isResultOf sosa:usedProcedure );
        skos:definition         "\n  relation from a Sample or SampleCollection to the Procedure (plan) used to make it\n  "@en .

riepr:VerbruiksProcedureShape
        rdf:type        sh:NodeShape;
        sh:targetClass  riepr:VerbruiksProcedure .

prov:Person  rdf:type     owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "Person";
        rdfs:subClassOf   prov:Agent;
        prov:category     "expanded";
        prov:component    "agents-responsibility";
        prov:definition   "Person agents are people."@en;
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI .

sosa:   rdf:type             owl:Ontology;
        dcterms:created      "2017-04-17"^^xsd:date;
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:description  "\n  This module imports all the terms in the SOSA module, and adds cross-module annotations (domain/rangeIncludes). \n  "@en;
        dcterms:license      <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document> , <http://www.opengeospatial.org/ogc/Software>;
        dcterms:modified     "2024-02-03"^^xsd:date;
        dcterms:rights       "Copyright 2025 W3C/OGC.";
        dcterms:title        "Sensor, Observation, Sample, and Actuator (SOSA) Ontology"@en;
        owl:imports          sosa-dep: , sosa-act: , sosa-sam: , sosa-obs:;
        owl:priorVersion     <http://www.w3.org/ns/sosa/2017/>;
        owl:versionIRI       <http://www.w3.org/ns/sosa/2023/> .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Quotation is a particular case of derivation (see http://www.w3.org/TR/prov-dm/#term-quotation) in which an entity is derived from an original entity by copying, or \"quoting\", some or all of it. ";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasQuotedFrom;
  owl:annotatedTarget    prov:wasDerivedFrom
] .

p-plan:Plan  rdf:type     owl:Class;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "Plan"@en;
        rdfs:subClassOf   riepr:IIOA , p-plan:Entity , prov:Plan;
        prov:definition   "A p-plan:Plan is a specific type of prov:Plan. It is composed of smaller steps that use and produce Variables."@en .

prov:AgentShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Agent .

geo:ehContains  rdf:type  owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: T*TFF*FF*\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "contains"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: T*TFF*FF*\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: T*TFF*FF*\n    "@en;
        skos:prefLabel    "contains"@en .

prov:RightsAssignmentShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:RightsAssignment .

prov:DirectQueryService
        rdf:type          owl:Class;
        rdfs:comment      "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments.";
        rdfs:isDefinedBy  prov:;
        rdfs:label        "ProvenanceService";
        rdfs:subClassOf   prov:SoftwareAgent;
        prov:aq           "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI;
        prov:category     "access-and-query" .

riepr:MeetProcedure  rdf:type  owl:Class;
        rdfs:comment     "Een meetprocedure is een specifieke procedure die wordt gebruikt om metingen uit te voeren op meetpunten."@nl;
        rdfs:label       "Meetprocedure"@nl;
        rdfs:subClassOf  sosa:Procedure .

sosa:MaterialSampleShape
        rdf:type        sh:NodeShape;
        sh:targetClass  sosa:MaterialSample .

prov:InfluenceShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Influence .

sosa:Actuator  rdf:type   owl:Class;
        rdfs:isDefinedBy  sosa-act:;
        rdfs:label        "Actuator"@en;
        rdfs:subClassOf   sosa:System;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOn
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:implements
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:madeActuation
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOn
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:madeActuation
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:implements
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOn
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:madeActuation
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:implements
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:implements
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOn
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:madeActuation
                          ];
        skos:definition   "\n  System that implements an ActuatingProcedure to change the value of an actuatable Property\n\n  This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation)."@en;
        skos:example      "A window actuator for automatic window control, i.e., opening or closing the window."@en .

prov:hadDelegate  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "hadDelegate";
        owl:inverseOf     prov:actedOnBehalfOf .

sosa:Sampling  rdf:type   owl:Class;
        rdfs:isDefinedBy  sosa-sam:;
        rdfs:label        "Sampling"@en;
        rdfs:subClassOf   sosa:Execution;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasResult
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasResult
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:madeBySampler
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasResult
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasResult
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:madeBySampler
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:madeBySampler
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:madeBySampler
                          ];
        skos:definition   "\n  act of carrying out a SamplingProcedure using a Sampler to create one or more Samples of a FeatureOfInterest\n  "@en;
        skos:example      "Crushing a rock sample in a ball mill."@en , "Registering an image of the landscape."@en , "Splitting a piece of drill-core to create two new samples."@en , "Digging a pit through a soil sequence."@en , "Drawing blood from a patient."@en , "Dividing a field site into quadrants."@en , "Establishing a station for environmental monitoring."@en , "Selecting a subset of a population."@en , "Sieving a powder to separate the subset finer than 100-mesh."@en , "Drilling an observation well."@en , "Taking a diamond-drill core from a rock outcrop."@en .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Quotation is a particular case of derivation (see http://www.w3.org/TR/prov-dm/#term-quotation) in which an entity is derived from an original entity by copying, or \"quoting\", some or all of it. ";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasQuotedFrom;
  owl:annotatedTarget    prov:wasDerivedFrom
] .

prov:Replace  rdf:type   owl:Class;
        rdfs:label       "Replace"@en;
        rdfs:subClassOf  prov:Activity;
        prov:definition  "Activity that identifies the replacement of a resource."@en .

sosa:hasMember  rdf:type       owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has member of collection";
        schema:domainIncludes  sosa:ObservationCollection , sosa:SamplingCollection , sosa:ExecutionCollection , sosa:ActuationCollection , sosa:SampleCollection;
        schema:rangeIncludes   sosa:SampleCollection , sosa:Sampling , sosa:Sample , sosa:ExecutionCollection , sosa:Observation , sosa:SamplingCollection , sosa:ActuationCollection , sosa:Actuation , sosa:Execution , sosa:ObservationCollection;
        owl:inverseOf          sosa:isMemberOf;
        skos:definition        "\n  link from a Collection to an Execution or Sample or Collection of these that is part of it\n  ";
        skos:editorialNote     "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types";
        skos:scopeNote         "rules for the consistency of values of properties of collections and properties of their members are given for each collection type" .

[ rdf:type               owl:Axiom;
  rdfs:comment           "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en;
  owl:annotatedProperty  rdfs:range;
  owl:annotatedSource    prov:hadMember;
  owl:annotatedTarget    prov:Entity;
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection"
] .

prov:Start  rdf:type          owl:Class;
        rdfs:comment          "An instance of prov:Start provides additional descriptions about the binary prov:wasStartedBy relation from some started prov:Activity to an prov:Entity that started it. For example, :foot_race prov:wasStartedBy :bang; prov:qualifiedStart [ a prov:Start; prov:entity :bang; :foo :bar; prov:atTime '2012-03-09T08:05:08-05:00'^^xsd:dateTime ] ."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Start";
        rdfs:subClassOf       prov:InstantaneousEvent , prov:EntityInfluence;
        prov:category         "qualified";
        prov:component        "entities-activities";
        prov:constraints      "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition       "Start is when an activity is deemed to have been started by an entity, known as trigger. The activity did not exist before its start. Any usage, generation, or invalidation involving an activity follows the activity's start. A start may refer to a trigger entity that set off the activity, or to an activity, known as starter, that generated the trigger."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Start"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Start"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasStartedBy .

prov:ActivityInfluence
        rdf:type                owl:Class;
        rdfs:comment            "ActivityInfluence provides additional descriptions of an Activity's binary influence upon any other kind of resource. Instances of ActivityInfluence use the prov:activity property to cite the influencing Activity."@en , "It is not recommended that the type ActivityInfluence be asserted without also asserting one of its more specific subclasses."@en;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "ActivityInfluence";
        rdfs:seeAlso            prov:activity;
        rdfs:subClassOf         prov:Influence;
        rdfs:subClassOf         [ rdf:type            owl:Restriction;
                                  owl:maxCardinality  "0"^^xsd:nonNegativeInteger;
                                  owl:onProperty      prov:hadActivity
                                ];
        rdfs:subClassOf         [ rdf:type            owl:Restriction;
                                  owl:maxCardinality  "0"^^xsd:nonNegativeInteger;
                                  owl:onProperty      prov:hadActivity
                                ];
        rdfs:subClassOf         [ rdf:type            owl:Restriction;
                                  owl:maxCardinality  "0"^^xsd:nonNegativeInteger;
                                  owl:onProperty      prov:hadActivity
                                ];
        owl:disjointWith        prov:EntityInfluence;
        prov:category           "qualified";
        prov:editorsDefinition  "ActivitiyInfluence is the capacity of an activity to have an effect on the character, development, or behavior of another by means of generation, invalidation, communication, or other."@en .

prov:influencer  rdf:type       owl:ObjectProperty;
        rdfs:comment            "Subproperties of prov:influencer are used to cite the object of an unqualified PROV-O triple whose predicate is a subproperty of prov:wasInfluencedBy (e.g. prov:used, prov:wasGeneratedBy). prov:influencer is used much like rdf:object is used."@en;
        rdfs:domain             prov:Influence;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "influencer";
        rdfs:range              owl:Thing;
        prov:category           "qualified";
        prov:dm                 "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"^^xsd:anyURI;
        prov:editorialNote      "This property and its subproperties are used in the same way as the rdf:object property, i.e. to reference the object of an unqualified prov:wasInfluencedBy or prov:influenced triple."@en;
        prov:editorsDefinition  "This property is used as part of the qualified influence pattern. Subclasses of prov:Influence use these subproperties to reference the resource (Entity, Agent, or Activity) whose influence is being qualified."@en;
        prov:inverse            "hadInfluence" .

dbo:projectCoordinator
        rdfs:domain  dbo:ResearchProject .

sosa:SamplingProcedure
        rdf:type          owl:Class;
        rdfs:isDefinedBy  sosa-sam:;
        rdfs:label        "Sampling Procedure"@en;
        rdfs:subClassOf   sosa:Procedure;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:implementedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:implementedBy
                          ];
        skos:definition   "\n  workflow, protocol, plan, algorithm, or computational method specifying how to make a Sampling\n\n  A Sampling Procedure is re-usable, and might be involved in many Samplings. \n  It explains the steps to be carried out to arrive at reproducible results.\n  "@en;
        skos:example      "\nspatial distribution of locations where to collect a sample (e.g., river segment)\ninstrument (or mode of use thereof) required to collect a sample (e.g., fish net, electric stunner)\nfield work instructions (e.g., dig four boreholes in each cardinal direction 2 metre way from the centre of the site; collect soil material from the 15-30 cm depth and mix it in a single bag)\n  "@en;
        skos:note         "\n[ISO 19156:2023] A SamplingProcedure shall be defined as the description of steps performed by a Sampler in order to extract a Sample from its sampledFeature in the frame of a Sampling.\n  "@en .

dbo:Case  rdf:type       owl:Class;
        rdfs:comment     "Een zaak is het geheel aan werk gedaan om tot een bestuurlijke of zakelijke beslissing te komen. Een zaak slaat doorgaans neer in een verzameling documenten."@nl , "A case is the total of work done to prepare for an administrative or business decision. As a rule, a case is reflected in a set of documents."@en;
        rdfs:label       "case"@en , "zaak"@nl;
        rdfs:subClassOf  dbo:UnitOfWork .

p-plan:Entity  rdf:type   owl:Class;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "Entity"@en;
        rdfs:subClassOf   prov:Entity;
        prov:definition   "A p-plan:Entity represents the input of the execution of a p-plan:Activity. It corresponds to a p-plan:Variable."@en .

sosa:wasObservedBy  rdf:type   owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "was observed by"@en;
        schema:domainIncludes  sosa:Property;
        schema:rangeIncludes   sosa:Observation , sosa:ObservationCollection;
        owl:inverseOf          sosa:observedProperty;
        skos:definition        "\n  relation from a Property to an Observation that observed it\n  "@en .

prov:qualifiedInvalidationOf
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "qualifiedInvalidationOf";
        owl:inverseOf     prov:qualifiedInvalidation .

sosa:Actuation  rdf:type  owl:Class;
        rdfs:isDefinedBy  sosa-act:;
        rdfs:label        "Actuation"@en;
        rdfs:subClassOf   sosa:Execution;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        skos:definition   "\n  act of carrying out an ActuatingProcedure using an Actuator to change the value of an actuatable Property of a FeatureOfInterest\n  \n  In this context hasResult may indicate the value of the Property at the completion of the Actuation\n  "@en;
        skos:example      "The activity of automatically closing a window if the temperature in a room drops below 20 degree Celsius. The activity is the Actuation and the device that closes the window is the Actuator. The Procedure is the rule, plan, or specification that defines the conditions that triggers the Actuation, here a drop in temperature. "@en;
        skos:note         "relatedObservation SHOULD be used to link to an associated Observation or ObservationCollection that monitors the actuated property to verify that the result value has been obtained. "@en;
        skos:scopeNote    "\n  An Actuation primarily concerns a single Property of a single FeatureOfInterest. \n  Changes to multiple properties, or other combinations of Actuations, may be described in an ActuationCollection.\n    \n  Alternatively, applications may choose to encapsulate complexity by defining a complex property with multiple individual components, and a corresponding complex result (e.g., a vector). \n  This approach is not prohibited by the SSN Ontology, but the details are beyond the scope of SSN.\n  "@en .

sosa:startTime  rdf:type       owl:DatatypeProperty;
        rdfs:comment           "The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear"@en;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "start time"@en;
        rdfs:subPropertyOf     prov:startedAtTime;
        schema:domainIncludes  sosa:Observation , sosa:Sampling , sosa:ExecutionCollection , sosa:ObservationCollection , sosa:ActuationCollection , sosa:Actuation , sosa:SamplingCollection , sosa:Deployment , sosa:Execution;
        skos:definition        "\n  instant of time when the Execution or Deployment was initiated or tasked\n  "@en .

p-plan:correspondsToStep
        rdf:type          owl:ObjectProperty , owl:FunctionalProperty;
        rdfs:domain       p-plan:Activity;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "correspondsToStep"@en;
        rdfs:range        p-plan:Step;
        prov:definition   "p-plan:correspondsToStep links a p-plan:Activity to its planned p-plan:Step"@en .

prov:qualifiedDerivationOf
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "qualifiedDerivationOf";
        owl:inverseOf     prov:qualifiedDerivation .

sosa:isActedOnBy  rdf:type     owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-act:;
        rdfs:label             "is acted on by"@en;
        schema:domainIncludes  sosa:Property;
        schema:rangeIncludes   sosa:Actuator;
        owl:inverseOf          sosa:actsOn;
        skos:definition        "\n  relation from a Property to an Actuator that may change its state\n  "@en;
        skos:example           "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property upon which the Actuator acts is the state of the window as it changes from being open to being closed. "@en .

prov:qualifiedCommunication
        rdf:type                   owl:ObjectProperty;
        rdfs:comment               "If this Activity prov:wasInformedBy Activity :a, then it can qualify how it was influenced using prov:qualifiedCommunication [ a prov:Communication;  prov:activity :a; :foo :bar ]."@en;
        rdfs:domain                prov:Activity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedCommunication";
        rdfs:range                 prov:Communication;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "entities-activities";
        prov:inverse               "qualifiedCommunicationOf";
        prov:qualifiedForm         prov:Communication;
        prov:sharesDefinitionWith  prov:Communication .

sosa:isSubSystemOf  rdf:type   owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "is subsystem of"@en;
        schema:domainIncludes  sosa:System , sosa:Sampler , sosa:Actuator , sosa:Sensor;
        schema:rangeIncludes   sosa:System , sosa:Sampler , sosa:Sensor , sosa:Actuator;
        owl:inverseOf          sosa:hasSubSystem;
        skos:definition        "\n  relation from a component System to a System that it belongs to\n  "@en .

rdfs:label  rdf:type      owl:AnnotationProperty;
        rdfs:comment      ""@en;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#> .

<file:///tmp/prov.ttl#>
        rdf:type               owl:Ontology;
        rdfs:seeAlso           <http://www.w3.org/TR/prov-o/#names-of-inverse-properties>;
        owl:imports            <http://www.w3.org/ns/prov-o#>;
        owl:versionIRI         <http://www.w3.org/ns/prov-o-inverses-20130430>;
        prov:specializationOf  <http://www.w3.org/ns/prov-o-inverses>;
        prov:wasDerivedFrom    <http://www.w3.org/ns/prov-o-20130430>;
        prov:wasRevisionOf     <http://www.w3.org/ns/prov-o-inverses-20120312> .

sosa:implements  rdf:type      owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "implements"@en;
        schema:domainIncludes  sosa:System , sosa:Sensor , sosa:Sampler , sosa:Actuator;
        schema:rangeIncludes   sosa:ObservingProcedure , sosa:ActuatingProcedure , sosa:Procedure , sosa:SamplingProcedure;
        owl:inverseOf          sosa:implementedBy;
        skos:definition        "\n  relation from a System to the Procedure that it is capable of executing\n  "@en;
        skos:example           "For example, the relationship between a sensor and the scientific measuring Procedure via which it senses."@en .

riepr:VerwerkingsProcedureShape
        rdf:type        sh:NodeShape;
        sh:targetClass  riepr:VerwerkingsProcedure .

prov:hadInfluence  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "hadInfluence";
        owl:inverseOf     prov:influencer .

sosa:isMemberOf  rdf:type      owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "is member of collection";
        schema:domainIncludes  sosa:Actuation , sosa:Sample , sosa:Execution , sosa:Observation , sosa:ActuationCollection , sosa:ExecutionCollection , sosa:ObservationCollection , sosa:Sampling , sosa:SamplingCollection , sosa:SampleCollection;
        schema:rangeIncludes   sosa:ExecutionCollection , sosa:ObservationCollection , sosa:ActuationCollection , sosa:SampleCollection , sosa:SamplingCollection;
        owl:inverseOf          sosa:hasMember;
        skos:definition        "\n  link from an Execution or Sample or Collection of these, to a collection that it is part of\n  ";
        skos:editorialNote     "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types";
        skos:scopeNote         "rules for the consistency of values of properties of collections and properties of their members are given for each collection type" .

geo:SpatialObjectShape
        rdf:type        sh:NodeShape;
        sh:targetClass  geo:SpatialObject .

geo:SpatialObject  rdf:type  owl:Class;
        rdfs:comment      "\n      The class spatial-object represents everything that can have \n      a spatial representation. It is superclass of feature and geometry.\n    "@en;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "SpatialObject"@en;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      The class spatial-object represents everything that can have \n      a spatial representation. It is superclass of feature and geometry.\n    "@en;
        skos:definition   "\n      The class spatial-object represents everything that can have \n      a spatial representation. It is superclass of feature and geometry.\n    "@en;
        skos:prefLabel    "SpatialObject"@en .

sosa:isOriginalSampleOf
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-sam:;
        rdfs:label             "is original sample  of"@en;
        schema:domainIncludes  sosa:Sample;
        schema:rangeIncludes   sosa:Sample , sosa:SampleCollection;
        owl:inverseOf          sosa:hasOriginalSample;
        skos:definition        "\n  relation from the initial Sample collected from the ultimate FeatureOfInterest to a downstream Sample or SampleCollection\n  "@en .

prov:wasInformedBy  rdf:type    owl:ObjectProperty;
        rdfs:comment            "An activity a2 is dependent on or informed by another activity a1, by way of some unspecified entity that is generated by a1 and used by a2."@en;
        rdfs:domain             prov:Activity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "wasInformedBy";
        rdfs:range              prov:Activity;
        rdfs:subPropertyOf      prov:wasInfluencedBy;
        owl:propertyChainAxiom  ( prov:qualifiedCommunication prov:activity );
        owl:propertyChainAxiom  ( prov:qualifiedCommunication prov:activity );
        owl:propertyChainAxiom  ( prov:qualifiedCommunication prov:activity );
        prov:category           "starting-point";
        prov:component          "entities-activities";
        prov:inverse            "informed";
        prov:qualifiedForm      prov:Communication , prov:qualifiedCommunication .

sosa:FeatureOfInterestShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:class  sosa:Sample;
                          sh:path   [ sh:inversePath  sosa:isSampleOf ]
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasFeatureOfInterest ]
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasFeatureOfInterest ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isPropertyOf ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isPropertyOf ]
                        ];
        sh:property     [ sh:class  sosa:Sample;
                          sh:path   [ sh:inversePath  sosa:isSampleOf ]
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasFeatureOfInterest ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isPropertyOf ]
                        ];
        sh:property     [ sh:class  sosa:Sample;
                          sh:path   [ sh:inversePath  sosa:isSampleOf ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isPropertyOf ]
                        ];
        sh:property     [ sh:class  sosa:Sample;
                          sh:path   [ sh:inversePath  sosa:isSampleOf ]
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasFeatureOfInterest ]
                        ];
        sh:targetClass  sosa:FeatureOfInterest .

p-plan:BundleShape  rdf:type  sh:NodeShape;
        sh:targetClass  p-plan:Bundle .

sosa:StatisticalSampleShape
        rdf:type        sh:NodeShape;
        sh:targetClass  sosa:StatisticalSample .

sp:hadProcedure  rdf:type   owl:ObjectProperty;
        rdfs:range          sosa:Procedure;
        rdfs:subPropertyOf  prov:hadPlan .

prov:wasMemberOf  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "wasMemberOf";
        owl:inverseOf     prov:hadMember .

sosa:ResultShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:class     sosa:Execution;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasResult ]
                        ];
        sh:property     [ sh:class     sosa:Execution;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasResult ]
                        ];
        sh:property     [ sh:class     sosa:Execution;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasResult ]
                        ];
        sh:property     [ sh:class     sosa:Execution;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      [ sh:inversePath  sosa:hasResult ]
                        ];
        sh:targetClass  sosa:Result .

prov:ServiceDescription
        rdf:type          owl:Class;
        rdfs:comment      "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments.";
        rdfs:isDefinedBy  prov:;
        rdfs:label        "ServiceDescription";
        rdfs:subClassOf   prov:SoftwareAgent;
        prov:aq           "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI;
        prov:category     "access-and-query" .

prov:RemovalShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      prov:removedKey
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      prov:removedKey
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:dictionary
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:dictionary
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      prov:removedKey
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:dictionary
                        ];
        sh:targetClass  prov:Removal .

sosa:madeBySystem  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "made by system"@en;
        rdfs:subPropertyOf     prov:wasAssociatedWith;
        schema:domainIncludes  sosa:ExecutionCollection , sosa:Observation , sosa:ObservationCollection , sosa:ActuationCollection , sosa:Sampling , sosa:Execution , sosa:SamplingCollection , sosa:Actuation;
        schema:rangeIncludes   sosa:System , sosa:Sensor , sosa:Sampler , sosa:Actuator;
        owl:inverseOf          sosa:madeExecution;
        skos:definition        "\n  relation from an Execution to the System that made it\n  "@en;
        skos:scopeNote         "\n  madeBySystem generalizes the madeByActuator, madeBySensor, and madeBySampler properties. \n  It is included in the ontology to support the definition of a common pattern for executions and their properties. \n\n  madeBySystem MUST be considered to be abstract, so SHOULD NOT appear in data instances. \n  Applications can use concrete sub-properties of madeBySystem.\n  "@en .

sosa:Stimulus  rdf:type   owl:Class;
        rdfs:isDefinedBy  sosa-obs:;
        rdfs:label        "Stimulus"@en;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isDetectedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:originated
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:isProxyFor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:isProxyFor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:isProxyFor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:originated
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:isProxyFor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isDetectedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isDetectedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:isDetectedBy
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:originated
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:originated
                          ];
        skos:definition   "\n  event in the real world that triggers a Sensor\n  "@en;
        skos:note         "The properties associated to the Stimulus may be different to the eventual observed Property. It is the event, not the object, that triggers the Sensor."@en .

prov:activityOfInfluence
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "activityOfInfluence";
        owl:inverseOf     prov:activity .

sosa:hasUltimateFeatureOfInterest
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has ultimate feature of interest"@en;
        schema:domainIncludes  sosa:SamplingCollection , sosa:Actuation , sosa:Deployment , sosa:ExecutionCollection , sosa:Sampling , sosa:Execution , sosa:ObservationCollection , sosa:ActuationCollection , sosa:Observation;
        schema:rangeIncludes   sosa:FeatureOfInterest;
        skos:definition        "\n  relation from a Deployment or Execution to its ultimate subject entity\n\n  i.e., from an Actuation to the ultimate entity whose property was modified;\n  from an Observation to the ultimate entity whose property was observed;\n  from an act of Sampling to the ultimate entity that was sampled;\n  or from a Deployment to its ultimate target\n  "@en;
        skos:note              "should match a property chain something like this but with sosa:isSampleOf*\n      owl:propertyChainAxiom ( sosa:hasFeatureOfInterest sosa:isSampleOf )";
        skos:scopeNote         "This is useful when the proximate feature of interest is a sample of the ultimate feature of interest, directly or transitively." .

sosa:Execution  rdf:type  owl:Class;
        rdfs:isDefinedBy  sosa-common:;
        rdfs:label        "Execution of a Procedure"@en;
        rdfs:subClassOf   prov:Activity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:hasFeatureOfInterest;
                            owl:someValuesFrom  sosa:FeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:hasFeatureOfInterest;
                            owl:someValuesFrom  sosa:FeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:madeBySystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:madeBySystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:madeBySystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:hasFeatureOfInterest;
                            owl:someValuesFrom  sosa:FeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Procedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:madeBySystem
                          ];
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:onProperty      sosa:hasFeatureOfInterest;
                            owl:someValuesFrom  sosa:FeatureOfInterest
                          ];
        skos:definition   "\n  act of carrying out a Procedure using a System\n  "@en;
        skos:scopeNote    "\n  Execution generalizes the Actuation, Observation, and Sampling classes. \n  It is included in the ontology to support the definition of a common pattern for executions and their properties. \n\n  Execution MUST be considered to be abstract, so any individual Execution SHOULD be declared to be an instance of one of the concrete sub-classes, and not of the Execution class.\n  "@en .

prov:KeyEntityPair  rdf:type  owl:Class;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "Key-Entity Pair";
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:int;
                            owl:onProperty   prov:pairEntity
                          ];
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:int;
                            owl:onProperty   prov:pairKey
                          ];
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:int;
                            owl:onProperty   prov:pairKey
                          ];
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:int;
                            owl:onProperty   prov:pairEntity
                          ];
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:int;
                            owl:onProperty   prov:pairKey
                          ];
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:int;
                            owl:onProperty   prov:pairEntity
                          ];
        prov:category     "collections";
        prov:component    "collections";
        prov:constraints  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition   "A key-entity pair. Part of a prov:Dictionary through prov:hadDictionaryMember. The key is any RDF Literal, the value is a prov:Entity.";
        prov:dm           "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

prov:has_provenance  rdf:type  owl:ObjectProperty;
        rdfs:comment      "Indicates a provenance-URI for a resource; the resource identified by this property presents a provenance record about its subject or anchor resource."@en;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "has_provenance";
        prov:aq           "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#resource-represented-as-html"^^xsd:anyURI;
        prov:category     "access-and-query";
        prov:inverse      "provenanceOf" .

<http://www.opengis.net/ont/geosparql>
        rdf:type         owl:Ontology;
        rdfs:seeAlso     <http://www.opengis.net/def/function/ogc-geosparql/1.0> , <http://www.opengis.net/def/rule/ogc-geosparql/1.0> , <http://www.opengis.net/doc/IS/geosparql/1.0>;
        dc:creator       "Open Geospatial Consortium";
        dc:date          "2012-04-30"^^xsd:date;
        dc:description   "An RDF/OWL vocabulary for representing spatial information";
        dc:source        "OGC GeoSPARQL – A Geographic Query Language for RDF Data OGC 11-052r5";
        dc:source        <http://www.opengis.net/doc/IS/geosparql/1.0>;
        owl:imports      <http://www.w3.org/2004/02/skos/core> , dc: , <http://www.opengis.net/ont/sf> , <http://www.opengis.net/ont/gml>;
        owl:versionInfo  "OGC GeoSPARQL 1.0" .

prov:wasRevisionOf  rdf:type    owl:AnnotationProperty , owl:ObjectProperty;
        rdfs:comment            "A revision is a derivation that revises an entity into a revised version."@en;
        rdfs:domain             prov:Entity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "wasRevisionOf";
        rdfs:range              prov:Entity;
        rdfs:subPropertyOf      prov:wasDerivedFrom;
        owl:propertyChainAxiom  ( prov:qualifiedRevision prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedRevision prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedRevision prov:entity );
        prov:category           "expanded";
        prov:component          "derivations";
        prov:inverse            "hadRevision";
        prov:qualifiedForm      prov:qualifiedRevision , prov:Revision .

prov:qualifiedAssociationOf
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "qualifiedAssociationOf";
        owl:inverseOf     prov:qualifiedAssociation .

sosa:isProcedureFor  rdf:type  owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "is procedure for"@en;
        rdfs:subPropertyOf     sosa:forProperty;
        schema:domainIncludes  sosa:Procedure;
        schema:rangeIncludes   sosa:Property;
        owl:inverseOf          sosa:hasProcedure;
        skos:definition        "\n  relation from a Procedure to a Property that it can observe or act on\n  "@en .

prov:Entity  rdf:type     owl:Class;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:label        "Entity";
        owl:disjointWith  prov:InstantaneousEvent;
        prov:category     "starting-point";
        prov:component    "entities-activities";
        prov:constraints  "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition   "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en;
        prov:dm           "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI .

dbo:procedure  rdf:type      owl:DatatypeProperty , rdf:Property;
        rdfs:comment         "The name designating a formal collection of steps to be taken to complete the case"@en , "De naam die verwijst naar de formele definitie van een verzameling stappen die in de juiste volgorde leiden tot de afronding van de zaak"@nl;
        rdfs:domain          dbo:Case;
        rdfs:label           "procedure"@nl , "procedure"@en , "Verfahren"@de;
        rdfs:range           xsd:string;
        owl:sameAs           dbo:procedure;
        prov:wasDerivedFrom  ns5:procedure .

prov:mentionOf  rdf:type    owl:ObjectProperty;
        rdfs:comment        "prov:mentionOf is used to specialize an entity as described in another bundle. It is to be used in conjuction with prov:asInBundle.\n\n          prov:asInBundle is used to cite the Bundle in which the generalization was mentioned."@en , "prov:mentionOf is used to specialize an entity as described in another bundle. It is to be used in conjuction with prov:asInBundle.\n\nprov:asInBundle is used to cite the Bundle in which the generalization was mentioned."@en;
        rdfs:domain         prov:Entity;
        rdfs:isDefinedBy    <http://www.w3.org/ns/prov-links#>;
        rdfs:label          "mentionOf";
        rdfs:range          prov:Entity;
        rdfs:subPropertyOf  prov:specializationOf;
        prov:inverse        "hadMention" .

riepr:GrondwaterputShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      dbo:depth
                        ];
        sh:targetClass  riepr:Grondwaterput .

prov:generatedAtTime  rdf:type  owl:DatatypeProperty;
        rdfs:comment        "The time at which an entity was completely created and is available for use."@en;
        rdfs:domain         prov:Entity;
        rdfs:isDefinedBy    <http://www.w3.org/ns/prov-o#>;
        rdfs:label          "generatedAtTime";
        rdfs:range          xsd:dateTime;
        prov:category       "expanded";
        prov:component      "entities-activities";
        prov:editorialNote  "It is the intent that the property chain holds: (prov:qualifiedGeneration o prov:atTime) rdfs:subPropertyOf prov:generatedAtTime."@en;
        prov:qualifiedForm  prov:Generation , prov:atTime .

[ rdf:type               owl:Axiom;
  owl:annotatedProperty  rdfs:domain;
  owl:annotatedSource    prov:wasInfluencedBy;
  owl:annotatedTarget    [ rdf:type     owl:Class;
                           owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                         ];
  prov:definition        "influencee: an identifier (o2) for an entity, activity, or agent; ";
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"
] .

prov:sharesDefinitionWith
        rdf:type            owl:AnnotationProperty;
        rdfs:isDefinedBy    prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:subPropertyOf  rdfs:seeAlso .

prov:informed  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "informed";
        owl:inverseOf     prov:wasInformedBy .

<http://www.w3.org/ns/prov-o#>
        rdf:type               owl:Ontology;
        rdfs:comment           "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en , "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).\n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en;
        rdfs:label             "W3C PROVenance Interchange Ontology (PROV-O)"@en;
        rdfs:seeAlso           <http://www.w3.org/ns/prov> , <http://www.w3.org/TR/prov-o/>;
        owl:versionIRI         <http://www.w3.org/ns/prov-o-20130430>;
        owl:versionInfo        "Recommendation version 2013-04-30"@en;
        prov:specializationOf  <http://www.w3.org/ns/prov-o>;
        prov:wasRevisionOf     <http://www.w3.org/ns/prov-o-20120312> .

p-plan:Activity  rdf:type  owl:Class;
        rdfs:comment      "A p-plan:Activity represents the execution process planned in a p-plan:Step"@en;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "Activity"@en;
        rdfs:subClassOf   prov:Activity .

prov:InstantaneousEventShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:InstantaneousEvent .

