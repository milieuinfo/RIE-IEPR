        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:description  "Actuation classes and properties for the SSN Ontology."@en , "Actuation classes and properties for the SSN Ontology.\n  This module adds RDFS and OWL axioms to the terms defined in SOSA Actuation\n  "@en;
        dcterms:license      <http://www.opengeospatial.org/ogc/Software> , <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document>;
        dcterms:rights       "Copyright 2025 W3C/OGC.";
        dcterms:title        "Sensor, Observation, Sample, and Actuator (SOSA) Ontology - actuation module"@en , "SSN Ontology - actuation module"@en;
        owl:imports          ssn-common: , sosa-act: .

riepr:lozingsProces  rdf:type  skos:Concept , sosa:Procedure;
        rdfs:comment    "Een lozingsproces is een specifieke procedure die betrekking heeft op het lozen van stoffen aan een emissiepunt in grondwater."@nl;
        rdfs:label      "Lozingsproces"@nl;
        skos:broader    riepr:EmissieProcedure;
        skos:prefLabel  "Lozingsproces"@nl .

sosa:inputFor  rdf:type       owl:ObjectProperty;
        rdfs:isDefinedBy      sosa-common:;
        rdfs:label            "input for"@en;
        schema:rangeIncludes  sosa:Procedure;
        owl:inverseOf         sosa:hasInput;
        skos:definition       "\n  relation from an input to a Procedure that uses it in an Execution\n  "@en .

prov:GenerationShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Generation .

prov:asInBundle  rdf:type          owl:ObjectProperty;
        rdfs:comment               "prov:asInBundle is used to specify which bundle the general entity of a prov:mentionOf property is described.\n\n          When :x prov:mentionOf :y and :y is described in Bundle :b, the triple :x prov:asInBundle :b is also asserted to cite the Bundle in which :y was described."@en , "prov:asInBundle is used to specify which bundle the general entity of a prov:mentionOf property is described.\n\nWhen :x prov:mentionOf :y and :y is described in Bundle :b, the triple :x prov:asInBundle :b is also asserted to cite the Bundle in which :y was described."@en;
        rdfs:domain                prov:Entity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-links#>;
        rdfs:label                 "asInBundle";
        rdfs:range                 prov:Bundle;
        prov:inverse               "contextOf";
        prov:sharesDefinitionWith  prov:mentionOf .

prov:Modify  rdf:type    owl:Class;
        rdfs:label       "Modify"@en;
        rdfs:subClassOf  prov:Activity;
        prov:definition  "Activity that identifies the modification of a resource. "@en .

geo:spatialDimension  rdf:type  owl:DatatypeProperty;
        rdfs:comment      "\n      The number of measurements or axes needed to describe the spatial position of \n      this geometry in a coordinate system.\n    "@en;
        rdfs:domain       geo:Geometry;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "spatialDimension"@en;
        rdfs:range        xsd:integer;
        dc:contributor    "Matthew Perry";
