@prefix :            <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix adms:        <http://www.w3.org/ns/adms#> .
@prefix concept:     <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix dbo:         <http://dbpedia.org/ontology/> .
@prefix dc:          <http://purl.org/dc/elements/1.1/> .
@prefix dct:         <http://purl.org/dc/terms/> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix dqv:         <http://www.w3.org/ns/dqv#> .
@prefix foaf:        <http://xmlns.com/foaf/0.1/> .
@prefix geo:         <http://www.opengis.net/ont/geosparql#> .
@prefix ns5:         <http://mappings.dbpedia.org/index.php/OntologyProperty:> .
@prefix ns6:         <http://mappings.dbpedia.org/index.php/OntologyClass:> .
@prefix ogc:         <http://www.opengis.net/ont/geosparql#> .
@prefix org:         <http://www.w3.org/ns/org#> .
@prefix owl:         <http://www.w3.org/2002/07/owl#> .
@prefix p-plan:      <http://purl.org/net/p-plan#> .
@prefix pplan:       <http://purl.org/net/p-plan#> .
@prefix prov:        <http://www.w3.org/ns/prov#> .
@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix riepr:       <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix schema:      <http://schema.org/> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix skos:        <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:        <http://www.w3.org/ns/sosa/> .
@prefix sosa-act:    <http://www.w3.org/ns/sosa/act/> .
@prefix sosa-common: <http://www.w3.org/ns/sosa/common/> .
@prefix sosa-dep:    <http://www.w3.org/ns/sosa/dep/> .
@prefix sosa-obs:    <http://www.w3.org/ns/sosa/obs/> .
@prefix sosa-sam:    <http://www.w3.org/ns/sosa/sam/> .
@prefix sp:          <http://www.w3.org/ns/sosa/prov/> .
@prefix ssn:         <http://www.w3.org/ns/ssn/> .
@prefix ssn-act:     <http://www.w3.org/ns/ssn/act/> .
@prefix ssn-common:  <http://www.w3.org/ns/ssn/common/> .
@prefix ssn-dep:     <http://www.w3.org/ns/ssn/dep/> .
@prefix ssn-obs:     <http://www.w3.org/ns/ssn/obs/> .
@prefix ssn-sam:     <http://www.w3.org/ns/ssn/sam/> .
@prefix terms:       <http://purl.org/dc/terms/> .
@prefix time:        <http://www.w3.org/2006/time#> .
@prefix vann:        <http://purl.org/vocab/vann/> .
@prefix wikidata:    <http://www.wikidata.org/entity/> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .

prov:ContributorShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:Contributor .

prov:dictionary  rdf:type   owl:ObjectProperty;
        rdfs:domain         prov:Removal , prov:Insertion;
        rdfs:isDefinedBy    prov:;
        rdfs:label          "dictionary";
        rdfs:range          prov:Dictionary;
        rdfs:subPropertyOf  prov:entity;
        prov:category       "collections";
        prov:component      "collections";
        prov:constraints    "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition     "The property used by a prov:Insertion and prov:Removal to cite the prov:Dictionary that was prov:derivedByInsertionFrom or prov:derivedByRemovalFrom another dictionary.";
        prov:dm             "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI , "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        prov:n              "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI , "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

prov:qualifiedUsage  rdf:type      owl:ObjectProperty;
        rdfs:comment               "If this Activity prov:used Entity :e, then it can qualify how it used it using prov:qualifiedUsage [ a prov:Usage; prov:entity :e; :foo :bar ]."@en;
        rdfs:domain                prov:Activity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedUsage";
        rdfs:range                 prov:Usage;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "entities-activities";
        prov:inverse               "qualifiedUsingActivity";
        prov:sharesDefinitionWith  prov:Usage;
        prov:unqualifiedForm       prov:used .

sosa:isObservedBy  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "is observed by"@en;
        schema:domainIncludes  sosa:Property;
        schema:rangeIncludes   sosa:Sensor;
        owl:inverseOf          sosa:observes;
        skos:definition        "\n  relation from a Property to a Sensor that is able to observe it\n  "@en .

riepr:TransportProcedure
        rdf:type         owl:Class , skos:ConceptScheme;
        rdfs:comment     "Een transport procedure is een specifieke procedure die betrekking heeft op het transport van stoffen binnen of buiten een activiteit."@nl;
        rdfs:label       "Transport Procedure"@nl;
        rdfs:subClassOf  riepr:ActiviteitProcedure .

prov:InvalidationShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:Invalidation .

dbo:projectParticipant
        rdfs:domain  dbo:ResearchProject .

dbo:projectEndDate  rdf:type  owl:DatatypeProperty , rdf:Property;
        rdfs:comment         "The end date of the project."@en;
        rdfs:domain          dbo:Project;
        rdfs:label           "project end date"@en , "Projektende"@de;
        rdfs:range           xsd:date;
        owl:sameAs           dbo:projectEndDate;
        prov:wasDerivedFrom  ns5:projectEndDate .

geo:ehMeet  rdf:type      owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially meets the \n      object SpatialObject. \n      DE-9IM: FT******* ^ F**T***** ^ F***T****\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "meet"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially meets the \n      object SpatialObject. \n      DE-9IM: FT******* ^ F**T***** ^ F***T****\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially meets the \n      object SpatialObject. \n      DE-9IM: FT******* ^ F**T***** ^ F***T****\n    "@en;
        skos:prefLabel    "meet"@en .

riepr:StofShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      rdfs:label
                        ];
        sh:targetClass  riepr:Stof .

geo:rcc8tppi  rdf:type    owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially covers the \n      object SpatialObject. DE-9IM: TTTFTTFFT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "tangential proper part inverse"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially covers the \n      object SpatialObject. DE-9IM: TTTFTTFFT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially covers the \n      object SpatialObject. DE-9IM: TTTFTTFFT\n    "@en;
        skos:prefLabel    "tangential proper part inverse"@en .

sosa:isProxyFor  rdf:type      owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "is proxy for"@en;
        schema:domainIncludes  sosa:Stimulus;
        schema:rangeIncludes   sosa:Property;
        owl:inverseOf          sosa:hasProxy;
        skos:definition        "\n  relation from a Stimulus to the Property for which it is serving as a proxy\n  "@en;
        skos:example           "For example, the expansion of quicksilver is a stimulus that serves as a proxy for some temperature property. An increase or decrease in the velocity of spinning cups on a wind sensor is serving as a proxy for the wind speed."@en .

prov:Removal  rdf:type        owl:Class;
        rdfs:isDefinedBy      prov:;
        rdfs:label            "Removal";
        rdfs:subClassOf       prov:Derivation;
        rdfs:subClassOf       [ rdf:type         owl:Restriction;
                                owl:cardinality  "1"^^xsd:int;
                                owl:onProperty   prov:dictionary
                              ];
        rdfs:subClassOf       [ rdf:type            owl:Restriction;
                                owl:minCardinality  "1"^^xsd:int;
                                owl:onProperty      prov:removedKey
                              ];
        rdfs:subClassOf       [ rdf:type         owl:Restriction;
                                owl:cardinality  "1"^^xsd:int;
                                owl:onProperty   prov:dictionary
                              ];
        rdfs:subClassOf       [ rdf:type            owl:Restriction;
                                owl:minCardinality  "1"^^xsd:int;
                                owl:onProperty      prov:removedKey
                              ];
        rdfs:subClassOf       [ rdf:type         owl:Restriction;
                                owl:cardinality  "1"^^xsd:int;
                                owl:onProperty   prov:dictionary
                              ];
        rdfs:subClassOf       [ rdf:type            owl:Restriction;
                                owl:minCardinality  "1"^^xsd:int;
                                owl:onProperty      prov:removedKey
                              ];
        prov:category         "collections";
        prov:component        "collections";
        prov:constraints      "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition       "Removal is a derivation that transforms a dictionary into another, by removing one or more key-entity pairs.";
        prov:dm               "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI;
        prov:unqualifiedForm  prov:derivedByRemovalFrom .

geo:gmlLiteral  rdf:type  rdfs:Datatype;
        rdfs:comment      "\n      A GML serialization of a geometry object.\n    "@en;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "GML Literal"@en;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      A GML serialization of a geometry object.\n    "@en;
        skos:definition   "\n      A GML serialization of a geometry object.\n    "@en;
        skos:prefLabel    "GML Literal"@en .

dbo:CaseShape  rdf:type  sh:NodeShape;
        sh:targetClass  dbo:Case .

owl:versionInfo  rdf:type  owl:AnnotationProperty .

prov:RevisionShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Revision .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Revision is a derivation (see http://www.w3.org/TR/prov-dm/#term-Revision). Moreover, according to \nhttp://www.w3.org/TR/2013/REC-prov-constraints-20130430/#term-Revision 23 April 2012 'wasRevisionOf is a strict sub-relation of wasDerivedFrom since two entities e2 and e1 may satisfy wasDerivedFrom(e2,e1) without being a variant of each other.'";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasRevisionOf;
  owl:annotatedTarget    prov:wasDerivedFrom
] .

sosa:SensorShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySensor ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySensor ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isObservedBy ]
                        ];
        sh:property     [ sh:class  sosa:Stimulus;
                          sh:path   [ sh:inversePath  sosa:isDetectedBy ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isObservedBy ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySensor ]
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:madeBySensor ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isObservedBy ]
                        ];
        sh:property     [ sh:class  sosa:Stimulus;
                          sh:path   [ sh:inversePath  sosa:isDetectedBy ]
                        ];
        sh:property     [ sh:class  sosa:Stimulus;
                          sh:path   [ sh:inversePath  sosa:isDetectedBy ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:isObservedBy ]
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:class  sosa:ObservingProcedure;
                          sh:path   [ sh:inversePath  sosa:implementedBy ]
                        ];
        sh:property     [ sh:class  sosa:Stimulus;
                          sh:path   [ sh:inversePath  sosa:isDetectedBy ]
                        ];
        sh:targetClass  sosa:Sensor .

geo:Geometry  rdf:type    owl:Class;
        rdfs:comment      "\n      The class represents the top-level geometry type. This class is \n      equivalent to the UML class GM_Object defined in ISO 19107, and \n      it is superclass of all geometry types.\n    "@en;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "Geometry"@en;
        rdfs:subClassOf   geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      The class represents the top-level geometry type. This class is \n      equivalent to the UML class GM_Object defined in ISO 19107, and \n      it is superclass of all geometry types.\n    "@en;
        owl:disjointWith  geo:Feature;
        skos:definition   "\n      The class represents the top-level geometry type. This class is \n      equivalent to the UML class GM_Object defined in ISO 19107, and \n      it is superclass of all geometry types.\n    "@en;
        skos:prefLabel    "Geometry"@en .

sosa:inputValueForExecution
        rdf:type              owl:ObjectProperty;
        rdfs:isDefinedBy      sosa-common:;
        rdfs:label            "input value for execution"@en;
        schema:rangeIncludes  sosa:Actuation , sosa:ActuationCollection , sosa:ExecutionCollection , sosa:Observation , sosa:Sampling , sosa:Execution;
        owl:inverseOf         sosa:hasInputValue;
        skos:definition       "\n  relation from an input value to an Execution that used it\n  "@en .

sosa-sam:  rdf:type          owl:Ontology;
        dcterms:created      "2024-02-02"^^xsd:date;
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:description  "Sampling classes and properties for the SSN Ontology."@en;
        dcterms:license      <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document> , <http://www.opengeospatial.org/ogc/Software>;
        dcterms:rights       "Copyright 2025 W3C/OGC.";
        dcterms:title        "Sensor, Observation, Sample, and Actuator (SOSA) Ontology - actuation module"@en;
        owl:imports          sosa-common: .

geo:sfEquals  rdf:type    owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "equals"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        skos:prefLabel    "equals"@en .

prov:has_query_service
        rdf:type          owl:ObjectProperty;
        rdfs:comment      "Indicates a provenance query service that can access provenance related to its subject or anchor resource."@en;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "hasProvenanceService";
        prov:aq           "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI;
        prov:category     "access-and-query";
        prov:inverse      "provenanceQueryServiceOf" .

prov:EntityShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Entity .

geo:rcc8dc  rdf:type      owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject is spatially disjoint\n      from the object SpatialObject. DE-9IM: FFTFFTTTT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "disconnected"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject is spatially disjoint\n      from the object SpatialObject. DE-9IM: FFTFFTTTT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject is spatially disjoint\n      from the object SpatialObject. DE-9IM: FFTFFTTTT\n    "@en;
        skos:prefLabel    "disconnected"@en .

sosa:ObservationCollection
        rdf:type          owl:Class;
        rdfs:isDefinedBy  sosa-obs:;
        rdfs:label        "Observation Collection"@en;
        rdfs:subClassOf   sosa:ExecutionCollection;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:observedProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:madeBySensor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ObservingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ObservingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:madeBySensor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:observedProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:observedProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ObservingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:madeBySensor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:observedProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ObservingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Observation sosa:ObservationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sensor;
                            owl:onProperty     sosa:madeBySensor
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasUltimateFeatureOfInterest
                          ];
        owl:disjointWith  sosa:SamplingCollection , sosa:SampleCollection , sosa:ActuationCollection;
        skos:definition   "\n  set of one or more Observations or ObservationCollections; collections may be nested\n\n  All Observation properties may appear in an Observation Collection, including: \n  hasFeatureOfInterest , hasUltimateFeatureOfInterest , usedProcedure , madeBySensor , observedProperty , phenomenonTime , startTime, resultTime , hasResult , hasSimpleResult : \n  If they are present, the value of these properties summarize the values of the matching properties of the member observations, where membership is either direct or transitive through one or more member observation collections. \n  The following consistency rules apply with respect to the Observation properties listed above: \n  \n  1. Where an individual Observation Collection omits a property, a member Observation (direct or transitive) MAY have any value for that property.\n\n  2. Where an individual Observation Collection has a single value for a property, each member Observation(direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property.  That property MAY then be omitted in any member Observation or Observation Collection.\n\n  3. Where an individual Observation Collection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. \n  \n  4. Where an individual Observation Collection has a value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval.\n\n  5. Where an individual Observation Collection has more than one value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals.\n  "@en;
        skos:note         "The members of a collection do not necessarily share a common value for any property. "@en , "An instance of ObservationCollection represents a container for a set of data derived from observations.\n  This broadly corresponds with the class Dataset from DCAT."@en , "The results of collections of observations are often packaged in a 'data cube' whose axes define the\n      range of properties of the set of observations." .

prov:Derivation  rdf:type     owl:Class;
        rdfs:comment          "The more specific forms of prov:Derivation (i.e., prov:Revision, prov:Quotation, prov:PrimarySource) should be asserted if they apply."@en , "An instance of prov:Derivation provides additional descriptions about the binary prov:wasDerivedFrom relation from some derived prov:Entity to another prov:Entity from which it was derived. For example, :chewed_bubble_gum prov:wasDerivedFrom :unwrapped_bubble_gum; prov:qualifiedDerivation [ a prov:Derivation; prov:entity :unwrapped_bubble_gum; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Derivation";
        rdfs:subClassOf       prov:EntityInfluence;
        prov:category         "qualified";
        prov:component        "derivations";
        prov:constraints      "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition       "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Derivation"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#Derivation-Relation"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasDerivedFrom .

sosa:deployedAsset  rdf:type   owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "deployed asset"@en;
        schema:domainIncludes  sosa:Deployment;
        schema:rangeIncludes   sosa:System , sosa:Sampler , sosa:Sensor , sosa:Actuator , sosa:Platform;
        owl:inverseOf          sosa:hasDeployment;
        skos:definition        "\n  relation from a Deployment to an asset (System or Platform)\n  "@en .

[ rdf:type               owl:Axiom;
  rdfs:comment           "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en;
  owl:annotatedProperty  rdfs:range;
  owl:annotatedSource    prov:hadMember;
  owl:annotatedTarget    prov:Entity;
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection"
] .

prov:todo  rdf:type  owl:AnnotationProperty .

riepr:apparaatVerwerkingsProces
        rdf:type        skos:Concept , sosa:Procedure;
        rdfs:comment    "Een apparaatverwerkingsproces is een specifieke procedure die betrekking heeft op de verwerking van stoffen binnen een apparaat."@nl;
        rdfs:label      "Apparaatverwerkingsproces"@nl;
        skos:broader    riepr:VerwerkingsProcedure;
        skos:prefLabel  "Apparaatverwerkingsproces"@nl .

sosa:ObservationShape
