prov:unqualifiedForm  rdf:type  owl:AnnotationProperty;
        rdfs:comment        "Classes and properties used to qualify relationships are annotated with prov:unqualifiedForm to indicate the property used to assert an unqualified provenance relation."@en;
        rdfs:isDefinedBy    prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:subPropertyOf  rdfs:seeAlso .

sosa:inDeployment  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "in deployment"@en;
        rdfs:subPropertyOf     sosa:hasDeployment;
        schema:domainIncludes  sosa:Platform;
        schema:rangeIncludes   sosa:Deployment;
        owl:inverseOf          sosa:deployedOnPlatform;
        skos:definition        "\n  relation from a Platform to a Deployment\n  "@en;
        skos:example           "For example, a relation between a buoy and a deployment of several Sensors."@en .

riepr:Proces  rdf:type  owl:Class;
  rdfs:comment         "Het proces is een individuele of meervoudige stap binnen een proces."@nl;
  rdfs:label           "Proces"@nl;
        rdfs:subClassOf      p-plan:Step;
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      ssn:implements;
                               owl:someValuesFrom  sosa:Procedure
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      dcterms:issued;
                               owl:someValuesFrom  xsd:date
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      prov:used;
                               owl:someValuesFrom  ( riepr:Emissiepunt riepr:Apparaat riepr:Bron riepr:Stof )
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                               owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                               owl:onProperty      dcterms:valid
                             ];
        rdfs:subClassOf      [ rdf:type            owl:Restriction;
                               owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                               owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                               owl:onProperty      p-plan:isStepOfPlan
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( p-plan:Step p-plan:MultiStep )
                             ];
        skos:example         [ rdf:type        riepr:Proces;
                               rdfs:label      "Verwerking van grondstoffen"@nl;
                               ssn:implements  [ rdf:type  riepr:VerwerkingsProcedure ]
                             ] .

<http://www.w3.org/ns/prov-aq#>
        rdf:type        owl:Ontology;
        rdfs:comment    "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).\n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en , "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). \n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en , "0.2";
        rdfs:label      "PROV Access and Query Ontology"@en;
        rdfs:seeAlso    <http://www.w3.org/TR/prov-aq/> , prov:;
        owl:versionIRI  <http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/> .

