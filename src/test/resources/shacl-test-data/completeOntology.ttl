        sh:property     [ sh:or    ( [ sh:class  sosa:Observation ]
                                     [ sh:class  sosa:ObservationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:observedProperty ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Actuation ]
                                     [ sh:class  sosa:ActuationCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:actsOnProperty ]
                        ];
        sh:property     [ sh:class  sosa:Stimulus;
                          sh:path   [ sh:inversePath  sosa:isProxyFor ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Actuation ]
