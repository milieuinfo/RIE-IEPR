                        ];
        sh:property     [ sh:class  sosa:ActuatingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:wasActedOnBy ]
                        ];
        sh:property     [ sh:class  sosa:ActuatingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:wasActedOnBy ]
                        ];
        sh:property     [ sh:class  sosa:ActuatingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
