                        ];
        sh:property     [ sh:class  sosa:Actuator;
                          sh:path   [ sh:inversePath  sosa:actsOn ]
                        ];
        sh:property     [ sh:class  sosa:Sensor;
                          sh:path   [ sh:inversePath  sosa:observes ]
                        ];
        sh:property     [ sh:class  sosa:Stimulus;
                          sh:path   [ sh:inversePath  sosa:isProxyFor ]
                        ];
        sh:property     [ sh:class  sosa:Procedure;
                          sh:path   sosa:hasProcedure
                        ];
        sh:property     [ sh:class  sosa:Actuator;
                          sh:path   [ sh:inversePath  sosa:actsOn ]
                        ];
        sh:property     [ sh:class  sosa:Actuator;
