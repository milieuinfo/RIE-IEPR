        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:Sample;
                          sh:path   [ sh:inversePath  sosa:isResultOf ]
                        ];
        sh:property     [ sh:class  sosa:Sampler;
                          sh:path   [ sh:inversePath  sosa:madeSampling ]
                        ];
        sh:property     [ sh:class  sosa:SamplingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Sampling ]
                                     [ sh:class  sosa:SamplingCollection ]
                                   );
                          sh:path  [ sh:inversePath  sosa:isMemberOf ]
                        ];
        sh:property     [ sh:class  sosa:Sample;
                          sh:path   [ sh:inversePath  sosa:isResultOf ]
                        ];
        sh:property     [ sh:class  sosa:Sampler;
                          sh:path   [ sh:inversePath  sosa:madeSampling ]
                        ];
        sh:property     [ sh:class  sosa:SamplingProcedure;
                          sh:path   [ sh:inversePath  sosa:usedForExecution ]
                        ];
        sh:property     [ sh:class  sosa:Sample;
                          sh:path   [ sh:inversePath  sosa:isResultOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:targetClass  sosa:SamplingCollection .

prov:PlanShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Plan .

prov:inverse  rdf:type    owl:AnnotationProperty;
        rdfs:comment      "PROV-O does not define all property inverses. The directionalities defined in PROV-O should be given preference over those not defined. However, if users wish to name the inverse of a PROV-O property, the local name given by prov:inverse should be used."@en;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:seeAlso      <http://www.w3.org/TR/prov-o/#names-of-inverse-properties> .

riepr:ActiviteitProcedure
        rdf:type         owl:Class;
        rdfs:comment     "Een activiteit procedure is een specifieke procedure die betrekking heeft op de algemene uitvoering van een activiteit."@nl;
        rdfs:label       "Activiteit Procedure"@nl;
        rdfs:subClassOf  sosa:Procedure .

prov:value  rdf:type        owl:DatatypeProperty;
        rdfs:domain         prov:Entity;
        rdfs:isDefinedBy    <http://www.w3.org/ns/prov-o#>;
        rdfs:label          "value";
        prov:category       "expanded";
        prov:component      "entities-activities";
        prov:definition     "Provides a value that is a direct representation of an entity."@en;
        prov:dm             "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-value"^^xsd:anyURI;
        prov:editorialNote  "The editor's definition comes from http://www.w3.org/TR/rdf-primer/#rdfvalue" , "This property serves the same purpose as rdf:value, but has been reintroduced to avoid some of the definitional ambiguity in the RDF specification (specifically, 'may be used in describing structured values')."@en .

prov:Copyright  rdf:type  owl:Class;
        rdfs:label       "Copyright"@en;
        rdfs:subClassOf  prov:Activity;
        prov:definition  "Activity that identifies the Copyrighting activity associated to a resource."@en .

[ rdf:type               owl:Axiom;
  rdfs:comment           "hadPrimarySource property is a particular case of wasDerivedFrom (see http://www.w3.org/TR/prov-dm/#term-original-source) that aims to give credit to the source that originated some information.";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:hadPrimarySource;
  owl:annotatedTarget    prov:wasDerivedFrom
] .

sosa:isDetectedBy  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-obs:;
        rdfs:label             "is detected by"@en;
        schema:domainIncludes  sosa:Stimulus;
        schema:rangeIncludes   sosa:Sensor;
        owl:inverseOf          sosa:detects;
        skos:definition        "\n  relation from a Stimulus to a Sensor that may detect it\n\n  The Stimulus itself will be serving as a proxy for some Property.\n  "@en .

prov:EntityInfluence  rdf:type  owl:Class;
        rdfs:comment            "It is not recommended that the type EntityInfluence be asserted without also asserting one of its more specific subclasses."@en , "EntityInfluence provides additional descriptions of an Entity's binary influence upon any other kind of resource. Instances of EntityInfluence use the prov:entity property to cite the influencing Entity."@en;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "EntityInfluence";
        rdfs:seeAlso            prov:entity;
        rdfs:subClassOf         prov:Influence;
        prov:category           "qualified";
        prov:editorsDefinition  "EntityInfluence is the capacity of an entity to have an effect on the character, development, or behavior of another by means of usage, start, end, derivation, or other. "@en .

dbo:projectBudgetTotal
        rdfs:domain  dbo:ResearchProject .

prov:ContributeShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Contribute .

sosa:hasSimpleResult  rdf:type  owl:DatatypeProperty , owl:FunctionalProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has simple result"@en;
        schema:domainIncludes  sosa:ExecutionCollection , sosa:ObservationCollection , sosa:Execution , sosa:Actuation , sosa:Observation , sosa:ActuationCollection;
        skos:definition        "\n  relation from an Execution to its value expressed as a literal\n\n  In the case of an Actuation, the result may be the value of the Property following the execution of the Procedure by the Actuator. \n\n  In the case of an Observation, the result is the value of the Property produced by the execution of the Procedure by the Sensor. \n  "@en;
        skos:example           "For instance, the values 23 or true."@en;
        skos:note              "This DatatypeProperty provides an alternative to hasResult, to be used only if the execution result can be expressed as a Literal"@en .

geo:rcc8tpp  rdf:type     owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject is spatially covered \n      by the object SpatialObject. DE-9IM: TFFTTFTTT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "tangential proper part"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject is spatially covered \n      by the object SpatialObject. DE-9IM: TFFTTFTTT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject is spatially covered \n      by the object SpatialObject. DE-9IM: TFFTTFTTT\n    "@en;
        skos:prefLabel    "tangential proper part"@en .

prov:order  rdf:type      owl:AnnotationProperty;
        rdfs:comment      "The position that this OWL term should be listed within documentation. The scope of the documentation (e.g., among all terms, among terms within a prov:category, among properties applying to a particular class, etc.) is unspecified."@en;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o#> .

geo:ehEquals  rdf:type    owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "equals"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially equals the \n      object SpatialObject. DE-9IM: TFFFTFFFT\n    "@en;
        skos:prefLabel    "equals"@en .

prov:derivedByRemovalFrom
        rdf:type            owl:ObjectProperty;
        rdfs:domain         prov:Dictionary;
        rdfs:isDefinedBy    prov:;
        rdfs:label          "derivedByRemovalFrom";
        rdfs:range          prov:Dictionary;
        rdfs:subPropertyOf  prov:wasDerivedFrom;
        prov:category       "collections";
        prov:component      "collections";
        prov:constraints    "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition     "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed key-entity pairs.";
        prov:dm             "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        prov:n              "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

prov:entity  rdf:type           owl:ObjectProperty;
        rdfs:domain             prov:EntityInfluence;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "entity";
        rdfs:range              prov:Entity;
        rdfs:subPropertyOf      prov:influencer;
        prov:category           "qualified";
        prov:editorialNote      "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en;
        prov:editorsDefinition  "The prov:entity property references an prov:Entity which influenced a resource. This property applies to an prov:EntityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent.";
        prov:inverse            "entityOfInfluence" .

geo:Feature  rdf:type     owl:Class;
        rdfs:comment      "\n      This class represents the top-level feature type. This class is \n      equivalent to GFI_Feature defined in ISO 19156:2011, and it is \n      superclass of all feature types.\n    "@en;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "Feature"@en;
        rdfs:subClassOf   geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      This class represents the top-level feature type. This class is \n      equivalent to GFI_Feature defined in ISO 19156:2011, and it is \n      superclass of all feature types.\n    "@en;
        owl:disjointWith  geo:Geometry;
        skos:definition   "\n      This class represents the top-level feature type. This class is \n      equivalent to GFI_Feature defined in ISO 19156:2011, and it is \n      superclass of all feature types.\n    "@en;
        skos:prefLabel    "Feature"@en .

sosa:ProcedureShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:implements ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:implements ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:implements ]
                        ];
        sh:property     [ sh:class  sosa:Property;
                          sh:path   [ sh:inversePath  sosa:propertyFor ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   [ sh:inversePath  sosa:implements ]
                        ];
        sh:targetClass  sosa:Procedure .

prov:ActivityInfluenceShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:maxCount  "0"^^xsd:long;
                          sh:path      prov:hadActivity
                        ];
        sh:property     [ sh:maxCount  "0"^^xsd:long;
                          sh:path      prov:hadActivity
                        ];
        sh:property     [ sh:maxCount  "0"^^xsd:long;
                          sh:path      prov:hadActivity
                        ];
        sh:targetClass  prov:ActivityInfluence .

prov:Quotation  rdf:type      owl:Class;
        rdfs:comment          "An instance of prov:Quotation provides additional descriptions about the binary prov:wasQuotedFrom relation from some taken prov:Entity from an earlier, larger prov:Entity. For example, :here_is_looking_at_you_kid prov:wasQuotedFrom :casablanca_script; prov:qualifiedQuotation [ a prov:Quotation; prov:entity :casablanca_script; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Quotation";
        rdfs:subClassOf       prov:Derivation;
        prov:category         "qualified";
        prov:component        "derivations";
        prov:definition       "A quotation is the repeat of (some or all of) an entity, such as text or image, by someone who may or may not be its original author. Quotation is a particular case of derivation."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-quotation"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-quotation"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasQuotedFrom .

prov:hadPrimarySource
        rdf:type                owl:ObjectProperty;
        rdfs:domain             prov:Entity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "hadPrimarySource";
        rdfs:range              prov:Entity;
        rdfs:subPropertyOf      prov:wasDerivedFrom;
        owl:propertyChainAxiom  ( prov:qualifiedPrimarySource prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedPrimarySource prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedPrimarySource prov:entity );
        prov:category           "expanded";
        prov:component          "derivations";
        prov:inverse            "wasPrimarySourceOf";
        prov:qualifiedForm      prov:qualifiedPrimarySource , prov:PrimarySource .

prov:BundleShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Bundle .

prov:EndShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:End .

sosa:SampleCollection
        rdf:type          owl:Class;
        rdfs:isDefinedBy  sosa-sam:;
        rdfs:label        "Sample Collection"@en;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Sampling sosa:SamplingCollection )
                                               ];
                            owl:onProperty     sosa:isResultOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:isResultOfMadeBySampler
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:isResultOfUsedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:isResultOfMadeBySampler
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:isResultOfUsedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasOriginalSample
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Sampling sosa:SamplingCollection )
                                               ];
                            owl:onProperty     sosa:isResultOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOfUltimateFOI
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:isResultOfMadeBySampler
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasOriginalSample
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:isResultOfUsedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasOriginalSample
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOfUltimateFOI
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Sampling sosa:SamplingCollection )
                                               ];
                            owl:onProperty     sosa:isResultOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOfUltimateFOI
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOfUltimateFOI
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sampler;
                            owl:onProperty     sosa:isResultOfMadeBySampler
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Sample;
                            owl:onProperty     sosa:hasOriginalSample
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Sample sosa:SampleCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:SamplingProcedure;
                            owl:onProperty     sosa:isResultOfUsedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Sampling sosa:SamplingCollection )
                                               ];
                            owl:onProperty     sosa:isResultOf
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:isSampleOf
                          ];
        owl:disjointWith  sosa:ActuationCollection , sosa:SamplingCollection , sosa:ObservationCollection;
        skos:definition   "\n  set of one or more Samples or SampleCollections; collections may be nested.\n\n  All Sample properties may appear in a Sample Collection, including: \n  hasOriginalSample , isSampleOfUltimateFOI , isSampleOf , isResultOfUsedProcedure , isResultOfMadeBySampler . \n  If they are present, the value of these properties summarize the values of the matching properties of the member samples, where membership is either direct or transitive through one or more member sample collections. \n\n  The following consistency rules apply with respect to the Sample properties listed above: \n  \n  1. Where an individual Sample Collection omits a property, a member Sample (direct or transitive) MAY have any value for that property.\n\n  2. Where an individual Sample Collection has a single value for a property, each member Sample (direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property.  That property MAY be omitted in any member Sample or Sample Collection.\n\n  3. Where an individual Sample Collection has more than one value for a property, each member Sample (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. \n  \n  4. Where an individual Sample Collection has a value for a property that is a range or interval, each member Sample (direct or transitive) MUST have a value for that property that either matches or falls within that range or interval.\n\n  5. Where an individual Sample Collection has more than one value for a property that is a range or interval, each member Sample (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals.\n  "@en;
        skos:note         "\n  The members of a collection do not necessarily share a common value for any property. \n  " .

sosa:hasInput  rdf:type        owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has input"@en;
        schema:domainIncludes  sosa:Procedure;
        owl:inverseOf          sosa:inputFor;
        skos:definition        "\n  relation from a Procedure to an input required for its execution\n  "@en;
        skos:note              "This property will typically describe the type of the inputs required to execute the Procedure."@en;
        skos:scopeNote         "An input might be a calibration or conditioning parameter, or the output of a previous procedure within an extended processing chain."@en .

sosa:isFeatureOfInterestOf
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "is feature of interest of"@en;
        schema:domainIncludes  sosa:FeatureOfInterest;
        schema:rangeIncludes   sosa:SamplingCollection , sosa:Deployment , sosa:ExecutionCollection , sosa:Observation , sosa:Sampling , sosa:ActuationCollection , sosa:Actuation , sosa:Execution , sosa:ObservationCollection;
        owl:inverseOf          sosa:hasFeatureOfInterest;
        skos:definition        "\n  relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it\n\n  i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it,\n  or to a Deployment for which it is the subject.\n"@en .

riepr:BronShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      rdfs:comment
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      rdfs:label
                        ];
        sh:targetClass  riepr:Bron .

owl:Thing  rdf:type  owl:Class .

prov:qualifiedUsingActivity
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "qualifiedUsingActivity";
        owl:inverseOf     prov:qualifiedUsage .

riepr:waterVerbruikProces
        rdf:type        skos:Concept , sosa:Procedure;
        rdfs:comment    "Een waterverbruikproces is een specifieke procedure die betrekking heeft op het verbruik van water binnen een activiteit."@nl;
        rdfs:label      "Waterverbruikproces"@nl;
        skos:broader    riepr:VerbruiksProcedure;
        skos:prefLabel  "Waterverbruikproces"@nl .

p-plan:MultiStepShape
        rdf:type        sh:NodeShape;
        sh:targetClass  p-plan:MultiStep .

prov:RoleShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Role .

sosa:actsOnProperty  rdf:type  owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-act:;
        rdfs:label             "acts on property"@en;
        schema:domainIncludes  sosa:Actuation , sosa:ActuationCollection;
        schema:rangeIncludes   sosa:Property;
        owl:inverseOf          sosa:wasActedOnBy;
        skos:definition        "\n  relation from an Actuation to the Property it acted upon\n  "@en;
        skos:example           "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property upon which the Actuator acts is the state of the window as it changes from being open to being closed. "@en .

sosa:phenomenonOccurred
        rdf:type               owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "phenomenon occurred"@en;
        schema:domainIncludes  time:TemporalEntity;
        schema:rangeIncludes   sosa:ActuationCollection , sosa:Sampling , sosa:ExecutionCollection , sosa:Observation , sosa:Actuation , sosa:Execution;
        owl:inverseOf          sosa:phenomenonTime;
        skos:definition        "\n  result of an Execution that this time applies to\n  "@en .

riepr:Voorgesteld  rdf:type   skos:Concept;
        rdfs:comment          "De voorgestelde status geeft aan dat een entiteit is voorgesteld door de overheid maar nog niet bevestigd is."@nl;
        rdfs:equivalentClass  <http://purl.org/adms/status/UnderDevelopment>;
        rdfs:label            "Voorgesteld"@nl;
        skos:prefLabel        "Voorgesteld"@nl .

rdfs:seeAlso  rdf:type  owl:AnnotationProperty;
        rdfs:comment  ""@en .

geo:hasGeometry  rdf:type  owl:ObjectProperty;
        rdfs:comment      "\n      A spatial representation for a given feature.\n    "@en;
        rdfs:domain       geo:Feature;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "hasGeometry"@en;
        rdfs:range        geo:Geometry;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      A spatial representation for a given feature.\n    "@en;
        skos:definition   "\n      A spatial representation for a given feature.\n    "@en;
        skos:prefLabel    "hasGeometry"@en .

dcterms:description  rdf:type  owl:AnnotationProperty .

prov:wasInvalidatedBy
        rdf:type                owl:ObjectProperty;
        rdfs:domain             prov:Entity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#> , <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label              "wasInvalidatedBy";
        rdfs:range              prov:Activity;
        rdfs:subPropertyOf      prov:wasInfluencedBy;
        owl:inverseOf           prov:invalidated;
        owl:propertyChainAxiom  ( prov:qualifiedInvalidation prov:activity );
        owl:propertyChainAxiom  ( prov:qualifiedInvalidation prov:activity );
        owl:propertyChainAxiom  ( prov:qualifiedInvalidation prov:activity );
        prov:category           "expanded";
        prov:component          "entities-activities";
        prov:inverse            "invalidated";
        prov:qualifiedForm      prov:Invalidation , prov:qualifiedInvalidation .

ssn-act:  rdf:type           owl:Ontology;
        dcterms:created      "2024-02-02"^^xsd:date;
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                             ];
        dcterms:creator      [ rdf:type   foaf:Agent;
                               foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
