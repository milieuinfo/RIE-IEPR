sosa:isHostedBy  rdf:type      owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "is hosted by"@en;
        schema:domainIncludes  sosa:Actuator , sosa:Sensor , sosa:Sampler , sosa:Platform , sosa:System;
        schema:rangeIncludes   sosa:Platform;
        owl:inverseOf          sosa:hosts;
        skos:definition        "\n  relation from an asset (System or Platform), to a Platform that it is mounted on or hosted by\n  "@en .

prov:n  rdf:type            owl:AnnotationProperty;
        rdfs:comment        "A reference to the principal section of the PROV-M document that describes this concept."@en , "A reference to the principal section of the PROV-DM document that describes this concept."@en;
        rdfs:isDefinedBy    prov: , <http://www.w3.org/ns/prov-o#>;
        rdfs:subPropertyOf  rdfs:seeAlso .

rdfs:isDefinedBy  rdf:type  owl:AnnotationProperty .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it.";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasAttributedTo;
  owl:annotatedTarget    prov:wasInfluencedBy;
  prov:definition        "IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. "
] .

p-plan:  rdf:type                      owl:Thing , owl:Ontology , owl:NamedIndividual;
        rdfs:comment                   "PROV extension for linking Plans and parts of plans to their respective executions. Created by Daniel Garijo and Yolanda Gil";
        dcterms:created                "2012-11-10"^^xsd:date;
        dcterms:creator                "http://www.isi.edu/~gil/"^^xsd:anyURI , "http://delicias.dia.fi.upm.es/members/DGarijo#me"^^xsd:anyURI;
        dcterms:description            "PROV extension for linking Plans and parts of plans to their respective executions."@en;
        dcterms:license                "https://creativecommons.org/licenses/by/4.0/";
        dcterms:modified               "2014-03-12"^^xsd:date;
        dcterms:title                  "The P-Plan ontology"@en;
        vann:preferredNamespacePrefix  "p-plan";
        vann:preferredNamespaceUri     "http://purl.org/net/p-plan#";
        owl:versionInfo                "1.3" .

riepr:VerbruiksProcedure
        rdf:type         owl:Class , skos:ConceptScheme;
        rdfs:comment     "Een verbruiks procedure is een specifieke procedure die betrekking heeft op het transport van grondstoffen binnen een activiteit."@nl;
        rdfs:label       "Verbruiks Procedure"@nl;
        rdfs:subClassOf  riepr:TransportProcedure .

dbo:projectObjective  rdf:type  rdf:Property , owl:DatatypeProperty;
        rdfs:comment         "A defined objective of the project."@en;
        rdfs:domain          dbo:Project;
        rdfs:label           "Projektziel"@de , "project objective"@en;
        rdfs:range           xsd:string;
        owl:sameAs           dbo:projectObjective;
        prov:wasDerivedFrom  ns5:projectObjective .

geo:ehCoveredBy  rdf:type  owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject is spatially covered \n      by the object SpatialObject. DE-9IM: TFF*TFT**\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "coveredBy"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject is spatially covered \n      by the object SpatialObject. DE-9IM: TFF*TFT**\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject is spatially covered \n      by the object SpatialObject. DE-9IM: TFF*TFT**\n    "@en;
        skos:prefLabel    "coveredBy"@en .

prov:startedAtTime  rdf:type  owl:DatatypeProperty;
        rdfs:comment        "The time at which an activity started. See also prov:endedAtTime."@en;
        rdfs:domain         prov:Activity;
        rdfs:isDefinedBy    <http://www.w3.org/ns/prov-o#>;
        rdfs:label          "startedAtTime";
        rdfs:range          xsd:dateTime;
        prov:category       "starting-point";
        prov:component      "entities-activities";
        prov:editorialNote  "It is the intent that the property chain holds: (prov:qualifiedStart o prov:atTime) rdfs:subPropertyOf prov:startedAtTime."@en;
        prov:qualifiedForm  prov:atTime , prov:Start .

dbo:projectType  rdfs:domain  dbo:ResearchProject .

[ rdf:type               owl:Axiom;
  owl:annotatedProperty  rdfs:domain;
  owl:annotatedSource    prov:wasInfluencedBy;
  owl:annotatedTarget    [ rdf:type     owl:Class;
                           owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                         ];
  prov:definition        "influencee: an identifier (o2) for an entity, activity, or agent; ";
  prov:dm                "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"
] .

riepr:Exploitant  rdf:type  owl:Class;
        rdfs:comment     "Een exploitant is een entiteit die een milieuimpact heeft."@nl;
        rdfs:label       "Exploitant"@nl;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:created;
                           owl:someValuesFrom  xsd:dateTime
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:issued;
                           owl:someValuesFrom  xsd:date
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:valid
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdf:type;
                           owl:someValuesFrom  ( org:Organization foaf:Person )
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ] .

sosa:Deployment  rdf:type  owl:Class;
        rdfs:isDefinedBy  sosa-common:;
        rdfs:label        "Deployment"@en;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Platform sosa:System )
                                               ];
                            owl:onProperty     sosa:deployedAsset
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:deployedSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:deployedOnPlatform
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:deployedSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:deployedOnPlatform
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Platform sosa:System )
                                               ];
                            owl:onProperty     sosa:deployedAsset
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:deployedSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:deployedOnPlatform
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Platform;
                            owl:onProperty     sosa:deployedOnPlatform
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:System;
                            owl:onProperty     sosa:deployedSystem
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Platform sosa:System )
                                               ];
                            owl:onProperty     sosa:deployedAsset
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sosa:Platform sosa:System )
                                               ];
                            owl:onProperty     sosa:deployedAsset
                          ];
        skos:definition   "\n  arrangement of one or more assets (Systems or Platforms) to execute Procedures with respect to designated features of interest.\n  "@en;
        skos:example      "A temperature Sensor deployed on a wall, a network of Sensors deployed for an Observation campaign."@en;
        skos:note         "\n  A Deployment will usually be for a specified time interval. \n  It MAY involve Platforms, or Systems, or both. \n  A Deployment can be used quite flexibly to describe the use of systems, and platforms that host systems, with respect to a feature of interest. \n  "@en .

prov:Communication  rdf:type  owl:Class;
        rdfs:comment          "An instance of prov:Communication provides additional descriptions about the binary prov:wasInformedBy relation from an informed prov:Activity to the prov:Activity that informed it. For example, :you_jumping_off_bridge prov:wasInformedBy :everyone_else_jumping_off_bridge; prov:qualifiedCommunication [ a prov:Communication; prov:activity :everyone_else_jumping_off_bridge; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Communication";
        rdfs:subClassOf       prov:ActivityInfluence;
        prov:category         "qualified";
        prov:component        "entities-activities";
        prov:constraints      "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
        prov:definition       "Communication is the exchange of an entity by two activities, one activity using the entity generated by the other.";
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Communication"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-wasInformedBy"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasInformedBy .

sosa:prov  rdf:type       owl:Ontology;
        rdfs:comment      "Alignment of the the W3C/OGC SOSA Ontology with the W3C PROV-O Ontology"@en;
        rdfs:label        "Alignment of SOSA with PROV-O"@en;
        dcterms:created   "2016-12-14"^^xsd:date;
        dcterms:creator   "Simon J D Cox";
        dcterms:creator   [ rdf:type   foaf:Agent;
                            foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                          ];
        dcterms:creator   [ rdf:type   foaf:Agent;
                            foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                          ];
        dcterms:creator   [ rdf:type   foaf:Agent;
                            foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                          ];
        dcterms:creator   [ rdf:type   foaf:Agent;
                            foaf:name  "W3C/OGC Spatial Data on the Web Working Group"@en
                          ];
        dcterms:license   <http://www.opengeospatial.org/ogc/Software> , <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document>;
        dcterms:modified  "2025-10-23"^^xsd:date;
        dcterms:rights    "Copyright 2017, 2025 W3C/OGC.";
        owl:imports       <http://www.w3.org/ns/prov-o#> , sosa: .

prov:wasUsedBy  rdfs:isDefinedBy  <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label        "wasUsedBy";
        owl:inverseOf     prov:used .

prov:   rdf:type             owl:Thing , owl:NamedIndividual , owl:Ontology;
        rdfs:comment         "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).\n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/\nArchives/Public/public-prov-comments/). All feedback is welcome."@en;
        rdfs:isDefinedBy     <http://www.w3.org/ns/prov>;
        rdfs:label           "W3C PROVenance Interchange"@en;
        rdfs:seeAlso         <http://www.w3.org/TR/prov-overview/>;
        owl:imports          <http://www.w3.org/ns/prov-aq#> , <http://www.w3.org/ns/prov-o-inverses#> , <http://www.w3.org/ns/prov-links#> , <http://www.w3.org/ns/prov-dc#> , <http://www.w3.org/ns/prov-o#> , <http://www.w3.org/ns/prov-dictionary#>;
        owl:versionIRI       <http://www.w3.org/ns/prov-20130430>;
        prov:wasDerivedFrom  <http://www.w3.org/ns/prov-o#> , <http://www.w3.org/ns/prov-o-inverses#> , <http://www.w3.org/ns/prov-dc#> , <http://www.w3.org/ns/prov-aq#> , <http://www.w3.org/ns/prov-dictionary#> , <http://www.w3.org/ns/prov-links#>;
        prov:wasRevisionOf   <http://www.w3.org/ns/prov-20130312> .

riepr:ActiviteitShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      dcterms:valid
                        ];
        sh:property     [ sh:class     riepr:ExploitatieLocatie;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:atLocation
                        ];
        sh:property     [ sh:class     xsd:date;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:issued
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      rdfs:label
                        ];
        sh:property     [ sh:class     xsd:dateTime;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:created
                        ];
        sh:targetClass  riepr:Activiteit .

riepr:Inactief  rdf:type      skos:Concept;
        rdfs:comment          "De inactieve status geeft aan dat een entiteit momenteel niet in gebruik is."@nl;
        rdfs:equivalentClass  <http://purl.org/adms/status/Deprecated>;
        rdfs:label            "Inactief"@nl;
        skos:prefLabel        "Inactief"@nl .

riepr:ExploitatieLocatie
        rdf:type         owl:Class;
        rdfs:comment     "Een exploitatie locatie is een specifieke geografische locatie waar een exploitant zijn activiteiten uitvoert."@nl;
        rdfs:label       "Exploitatie Locatie"@nl;
        rdfs:subClassOf  geo:SpatialObjectCollection , prov:Entity;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:wasDerivedFrom;
                           owl:someValuesFrom  riepr:ExploitatieLocatie
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:atLocation;
                           owl:someValuesFrom  riepr:Exploitant
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:created;
                           owl:someValuesFrom  xsd:dateTime
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:valid
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:wasInfluencedBy
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      adms:identifier
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:issued;
                           owl:someValuesFrom  xsd:date
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:hadPrimarySource;
                           owl:someValuesFrom  org:Site
                         ];
        skos:example     [ rdf:type               riepr:ExploitatieLocatie;
                           rdfs:label             "Cementfabriek Antwerpen"@nl;
                           prov:hadPrimarySource  [ rdf:type    org:Site;
                                                    rdfs:label  "VKBO Vestiging Cementfabriek"@nl
                                                  ]
                         ] .

p-plan:isInputVarOf  rdf:type  owl:ObjectProperty;
        rdfs:domain       p-plan:Variable;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "isInputVarOf"@en;
        rdfs:range        p-plan:Step;
        owl:inverseOf     p-plan:hasInputVar;
        prov:definition   "p-plan:isInputVarOf links an input variable of a step to the step."@en .

prov:EntityInfluenceShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:EntityInfluence .

prov:describesService
        rdf:type          owl:ObjectProperty;
        rdfs:comment      "relates a generic provenance query service resource (type prov:ServiceDescription) to a specific query service description (e.g. a prov:DirectQueryService or a sd:Service)."@en;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "describesService";
        prov:aq           "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/rovenance-query-service-description"^^xsd:anyURI;
        prov:category     "access-and-query";
        prov:inverse      "serviceDescribedBy" .

p-plan:MultiStep  rdf:type  owl:Class;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "MultiStep"@en;
        rdfs:subClassOf   p-plan:Plan , p-plan:Step;
        prov:definition   "A multi step is the representation of a plan that appears as a step of another plan."@en .

sosa:isPropertyOf  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "is property of"@en;
        schema:domainIncludes  sosa:Property;
        schema:rangeIncludes   sosa:FeatureOfInterest;
        owl:inverseOf          sosa:hasProperty;
        skos:definition        "\n  relation from a Property to a FeatureOfInterest that it is a quality of\n  "@en .

geo:sfOverlaps  rdf:type  owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: T*T***T** \n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "overlaps"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: T*T***T** \n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: T*T***T** \n    "@en;
        skos:prefLabel    "overlaps"@en .

sosa:hasProcedure  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-common:;
        rdfs:label             "has procedure"@en;
        rdfs:subPropertyOf     sosa:propertyFor;
        schema:domainIncludes  sosa:Property;
        schema:rangeIncludes   sosa:Procedure;
        owl:inverseOf          sosa:isProcedureFor;
        owl:inverseOf          [ rdfs:subPropertyOf
                          sosa:forProperty ];
        owl:inverseOf          [ rdfs:subPropertyOf
                          sosa:forProperty ];
        owl:inverseOf          [ rdfs:subPropertyOf
                          sosa:forProperty ];
        owl:inverseOf          [ rdfs:subPropertyOf
                          sosa:forProperty ];
        skos:definition        "\n  relation from a Property to a Procedure that can observe or act on it\n  "@en .

geo:sfContains  rdf:type  owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: T*****FF*\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "contains"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: T*****FF*\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially contains the \n      object SpatialObject. DE-9IM: T*****FF*\n    "@en;
        skos:prefLabel    "contains"@en .

p-plan:correspondsToVariable
        rdf:type          owl:ObjectProperty , owl:FunctionalProperty;
        rdfs:domain       p-plan:Entity;
        rdfs:isDefinedBy  p-plan:;
        rdfs:label        "correspondsToVariable"@en;
        rdfs:range        p-plan:Variable;
        prov:definition   "p-plan:correspondsToVariable binds a p-plan:Entity (used by a p-plan:Activity in the execution of a plan) to the p-plan:Variable it represented it in the p-plan:Plan."@en .

riepr:EmissieProcedure
        rdf:type         owl:Class , skos:ConceptScheme;
        rdfs:comment     "Een emissie procedure is een specifieke procedure die betrekking heeft op het uitstoten of lozen van stoffen aan emissiepunten."@nl;
        rdfs:label       "Emissie Procedure"@nl;
        rdfs:subClassOf  riepr:TransportProcedure .

geo:rcc8po  rdf:type      owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: TTTTTTTTT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "partially overlapping"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: TTTTTTTTT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially overlaps the \n      object SpatialObject. DE-9IM: TTTTTTTTT\n    "@en;
        skos:prefLabel    "partially overlapping"@en .

prov:OrganizationShape
        rdf:type        sh:NodeShape;
        sh:targetClass  prov:Organization .

riepr:Observatie  rdf:type  owl:Class;
        rdfs:comment     "Een observatie is een waarneming of meting die is uitgevoerd op een meetpunt."@nl;
        rdfs:label       "Observatie"@nl;
        rdfs:subClassOf  sosa:Observation;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      sosa:hasFeatureOfInterest;
                           owl:someValuesFrom  ( riepr:Meetpunt riepr:Installatie )
                         ] .

geo:sfIntersects  rdf:type  owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject is not spatially disjoint \n      from the object SpatialObject.\n      DE-9IM: T******** ^ *T******* ^ ***T***** ^ ****T**** \n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/spec/geosparql/1.0> , <http://www.opengis.net/ont/geosparql>;
        rdfs:label        "intersects"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject is not spatially disjoint \n      from the object SpatialObject.\n      DE-9IM: T******** ^ *T******* ^ ***T***** ^ ****T**** \n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject is not spatially disjoint \n      from the object SpatialObject.\n      DE-9IM: T******** ^ *T******* ^ ***T***** ^ ****T**** \n    "@en;
        skos:prefLabel    "intersects"@en .

riepr:Apparaat  rdf:type  owl:Class;
        rdfs:comment     "Een apparaat is een specifiek onderdeel van een installatie dat een bepaalde functie vervult binnen de installatie."@nl;
        rdfs:label       "Apparaat"@nl;
        rdfs:subClassOf  geo:SpatialObject , ssn:System;
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      rdfs:label
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      prov:atLocation;
                           owl:someValuesFrom  ( riepr:Installatie riepr:ExploitatieLocatie )
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:created;
                           owl:someValuesFrom  xsd:dateTime
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:issued;
                           owl:someValuesFrom  xsd:date
                         ];
        rdfs:subClassOf  [ rdf:type            owl:Restriction;
                           owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                           owl:minCardinality  "0"^^xsd:nonNegativeInteger;
                           owl:onProperty      dcterms:valid
                         ];
        skos:example     [ rdf:type         riepr:Apparaat;
                           rdfs:label       "Filterinstallatie Schouw 1"@nl;
                           dcterms:created  "2020-01-01T00:00:00"^^xsd:dateTime;
                           dcterms:issued   "2020-01-01"^^xsd:date;
                           dcterms:valid    "2030-12-31"^^xsd:date;
                           prov:atLocation  [ rdf:type    riepr:Installatie;
                                              rdfs:label  "Cementfabriek Antwerpen Installatie 1"@nl
                                            ]
                         ] .

sosa:SpatialSample  rdf:type  owl:Class;
        rdfs:isDefinedBy  sosa-sam:;
        rdfs:label        "Spatial Sample"@en;
        rdfs:subClassOf   sosa:Sample;
        skos:definition   "\n  subset of a FeatureOfInterest defined by its location and shape in space\n  \n  When observations are made to estimate properties of a geospatial feature, particularly where the value of a property varies within the scope of the feature, a SpatialSample is used.\n  "@en;
        skos:example      "Some common names for spatial samples include: borehole, flightline, interval, lidar cloud, map horizon, microscope slide, mine level, mine, observation well, profile,  quadrat, scene, section, ship track, spot, station, swath, trajectory, traverse, etc..."@en;
        skos:note         "Depending on accessibility and on the nature of the expected property variation, a SpatialSample may extend in one, two or three spatial dimensions."@en .

prov:KeyEntityPairShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:pairKey
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:pairEntity
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:pairKey
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:pairKey
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:pairEntity
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      prov:pairEntity
                        ];
        sh:targetClass  prov:KeyEntityPair .

riepr:VerwerkingsProcedure
        rdf:type         owl:Class , skos:ConceptScheme;
        rdfs:comment     "Een verwerkings procedure is een specifieke procedure die betrekking heeft op de verwerking van stoffen binnen een activiteit."@nl;
        rdfs:label       "Verwerkings Procedure"@nl;
        rdfs:subClassOf  riepr:ActiviteitProcedure .

[ rdf:type               owl:Axiom;
  rdfs:comment           "Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it.";
  owl:annotatedProperty  rdfs:subPropertyOf;
  owl:annotatedSource    prov:wasAttributedTo;
  owl:annotatedTarget    prov:wasInfluencedBy;
  prov:definition        "IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. "
] .

dcterms:created  rdf:type  owl:AnnotationProperty .

prov:removedKey  rdf:type  owl:DatatypeProperty;
        rdfs:domain       prov:Removal;
        rdfs:isDefinedBy  prov:;
        rdfs:label        "removedKey";
        rdfs:range        rdfs:Literal;
        prov:category     "collections";
        prov:component    "collections";
        prov:constraints  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        prov:definition   "The key removed in a Removal.";
        prov:dm           "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        prov:n            "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

dbo:ResearchProject  rdf:type  owl:Class;
        rdfs:comment         "A research project is a scientific investigation, usually using scientific methods, to achieve defined objectives."@en;
        rdfs:label           "onderzoeksproject"@nl , "Forschungsprojekt"@de , "research project"@en;
        rdfs:subClassOf      dbo:Project;
        owl:equivalentClass  wikidata:Q1298668;
        owl:sameAs           dbo:ResearchProject;
        prov:wasDerivedFrom  ns6:ResearchProject .

sosa:DeploymentShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:class  sosa:System;
                          sh:path   sosa:deployedSystem
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Platform ]
                                     [ sh:class  sosa:System ]
                                   );
                          sh:path  [ sh:inversePath  sosa:hasDeployment ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:inDeployment ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:inDeployment ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:inDeployment ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Platform ]
                                     [ sh:class  sosa:System ]
                                   );
                          sh:path  [ sh:inversePath  sosa:hasDeployment ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   sosa:deployedSystem
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Platform ]
                                     [ sh:class  sosa:System ]
                                   );
                          sh:path  [ sh:inversePath  sosa:hasDeployment ]
                        ];
        sh:property     [ sh:class  sosa:FeatureOfInterest;
                          sh:path   [ sh:inversePath  sosa:isFeatureOfInterestOf ]
                        ];
        sh:property     [ sh:class  sosa:Platform;
                          sh:path   [ sh:inversePath  sosa:inDeployment ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   sosa:deployedSystem
                        ];
        sh:property     [ sh:or    ( [ sh:class  sosa:Platform ]
                                     [ sh:class  sosa:System ]
                                   );
                          sh:path  [ sh:inversePath  sosa:hasDeployment ]
                        ];
        sh:property     [ sh:class  sosa:System;
                          sh:path   sosa:deployedSystem
                        ];
        sh:targetClass  sosa:Deployment .

prov:Association  rdf:type    owl:Class;
        rdfs:comment          "An instance of prov:Association provides additional descriptions about the binary prov:wasAssociatedWith relation from an prov:Activity to some prov:Agent that had some responsiblity for it. For example, :baking prov:wasAssociatedWith :baker; prov:qualifiedAssociation [ a prov:Association; prov:agent :baker; :foo :bar ]."@en;
        rdfs:isDefinedBy      <http://www.w3.org/ns/prov-o#>;
        rdfs:label            "Association";
        rdfs:subClassOf       prov:AgentInfluence;
        prov:category         "qualified";
        prov:component        "agents-responsibility";
        prov:definition       "An activity association is an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity. It further allows for a plan to be specified, which is the plan intended by the agent to achieve some goals in the context of this activity."@en;
        prov:dm               "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Association"^^xsd:anyURI;
        prov:n                "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Association"^^xsd:anyURI;
        prov:unqualifiedForm  prov:wasAssociatedWith .

prov:component  rdf:type  owl:AnnotationProperty;
        rdfs:comment      "Classify prov-o terms into six components according to prov-dm, including 'agents-responsibility', 'alternate', 'annotations', 'collections', 'derivations', and 'entities-activities'. This classification is used so that readers of prov-o specification can find its correspondence with the prov-dm specification."@en;
        rdfs:isDefinedBy  prov: , <http://www.w3.org/ns/prov-o#> .

p-plan:isPrecededBy  rdf:type  owl:ObjectProperty , owl:TransitiveProperty;
        rdfs:comment      p-plan:;
        rdfs:domain       p-plan:Step;
        rdfs:isDefinedBy  "Property that asserts which Step preceeds the current one. "@en;
        rdfs:label        "isPrecededBy"@en;
        rdfs:range        p-plan:Step .

prov:wasInfluencedBy  rdf:type     owl:ObjectProperty;
        rdfs:comment               "Because prov:wasInfluencedBy is a broad relation, its more specific subproperties (e.g. prov:wasInformedBy, prov:actedOnBehalfOf, prov:wasEndedBy, etc.) should be used when applicable."@en , "This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.";
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:domain                [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#> , <http://www.w3.org/ns/prov-o-inverses#>;
        rdfs:label                 "wasInfluencedBy";
        rdfs:range                 [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:range                 [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        rdfs:range                 [ rdf:type     owl:Class;
                                     owl:unionOf  ( prov:Activity prov:Agent prov:Entity )
                                   ];
        owl:inverseOf              prov:influenced;
        prov:category              "qualified";
        prov:component             "agents-responsibility";
        prov:editorialNote         "The sub-properties of prov:wasInfluencedBy can be elaborated in more detail using the Qualification Pattern. For example, the binary relation :baking prov:used :spoon can be qualified by asserting :baking prov:qualifiedUsage [ a prov:Usage; prov:entity :spoon; prov:atLocation :kitchen ] .\n\nSubproperties of prov:wasInfluencedBy may also be asserted directly without being qualified.\n\nprov:wasInfluencedBy should not be used without also using one of its subproperties. \n"@en , "The sub-properties of prov:wasInfluencedBy can be elaborated in more detail using the Qualification Pattern. For example, the binary relation :baking prov:used :spoon can be qualified by asserting :baking prov:qualifiedUsage [ a prov:Usage; prov:entity :spoon; prov:atLocation :kitchen ] .\n\nSubproperties of prov:wasInfluencedBy may also be asserted directly without being qualified.\n\nprov:wasInfluencedBy should not be used without also using one of its subproperties.\n"@en;
        prov:inverse               "influenced";
        prov:qualifiedForm         prov:qualifiedInfluence , prov:Influence;
        prov:sharesDefinitionWith  prov:Influence .

geo:rcc8ntpp  rdf:type    owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject is spatially inside \n      the object SpatialObject. DE-9IM: TFFTFFTTT\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "non-tangential proper part"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject is spatially inside \n      the object SpatialObject. DE-9IM: TFFTFFTTT\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject is spatially inside \n      the object SpatialObject. DE-9IM: TFFTFFTTT\n    "@en;
        skos:prefLabel    "non-tangential proper part"@en .

prov:Contributor  rdf:type  owl:Class;
        rdfs:label       "Contributor"@en;
        rdfs:subClassOf  prov:Role;
        prov:definition  "Role with the function of having responsibility for making contributions to a resource. The Agent assigned to this role is associated with a Modify or Create Activities"@en .

prov:qualifiedInvalidation
        rdf:type                   owl:ObjectProperty;
        rdfs:comment               "If this Entity prov:wasInvalidatedBy Activity :a, then it can qualify how it was invalidated using prov:qualifiedInvalidation [ a prov:Invalidation;  prov:activity :a; :foo :bar ]."@en;
        rdfs:domain                prov:Entity;
        rdfs:isDefinedBy           <http://www.w3.org/ns/prov-o#>;
        rdfs:label                 "qualifiedInvalidation";
        rdfs:range                 prov:Invalidation;
        rdfs:subPropertyOf         prov:qualifiedInfluence;
        prov:category              "qualified";
        prov:component             "entities-activities";
        prov:inverse               "qualifiedInvalidationOf";
        prov:sharesDefinitionWith  prov:Invalidation;
        prov:unqualifiedForm       prov:wasInvalidatedBy .

riepr:ApparaatShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      dcterms:valid
                        ];
        sh:property     [ sh:class     xsd:date;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:issued
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      rdfs:label
                        ];
        sh:property     [ sh:class     xsd:dateTime;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:created
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:or        ( [ sh:class  riepr:Installatie ]
                                         [ sh:class  riepr:ExploitatieLocatie ]
                                       );
                          sh:path      prov:atLocation
                        ];
        sh:targetClass  riepr:Apparaat .

sosa:ActuationCollection
        rdf:type          owl:Class;
        rdfs:isDefinedBy  sosa-act:;
        rdfs:label        "Actuation Collection"@en;
        rdfs:subClassOf   sosa:ExecutionCollection;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:ActuatingProcedure;
                            owl:onProperty     sosa:usedProcedure
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Property;
                            owl:onProperty     sosa:actsOnProperty
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:Actuator;
                            owl:onProperty     sosa:madeByActuator
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ owl:unionOf  ( sosa:Actuation sosa:ActuationCollection )
                                               ];
                            owl:onProperty     sosa:hasMember
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sosa:FeatureOfInterest;
                            owl:onProperty     sosa:hasFeatureOfInterest
                          ];
        owl:disjointWith  sosa:SamplingCollection , sosa:SampleCollection , sosa:ObservationCollection;
        skos:definition   "\n  set of one or more Actuations or ActuationCollections; collections may be nested\n\n  All Actuation properties may appear in an Actuation Collection, including:\n  hasFeatureOfInterest , usedProcedure , madeByActuator , actsOnProperty , endTime ,  hasResult , hasSimpleResult . \n  If they are present, the value of these properties summarize the values of the matching properties of the member actuations, where membership is either direct or transitive through one or more member actuation collections. \n  The following consistency rules apply with respect to the Actuation properties: \n  \n  1. Where an individual Actuation Collection omits a property, a member Actuation (direct or transitive) MAY have any value for that property.\n\n  2. Where an individual Actuation Collection has a single value for a property, each member Actuation (direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property.  That property MAY then be omitted in any member Actuation or Actuation Collection.\n\n  3. Where an individual Actuation Collection has more than one value for a property, each member Actuation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. \n  \n  4. Where an individual Actuation Collection has a value for a property that is a range or interval, each member Actuation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval.\n\n  5. Where an individual Actuation Collection has more than one value for a property that is a range or interval, each member Actuation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals.\n  "@en;
        skos:note         "The members of a collection do not necessarily share a common value for any property. "@en .

riepr:MeetpuntShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:class     xsd:dateTime;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:created
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:path      rdfs:label
                        ];
        sh:property     [ sh:minCount  "1"^^xsd:long;
                          sh:or        ( [ sh:class  riepr:Emissiepunt ]
                                         [ sh:class  riepr:Proces ]
                                       );
                          sh:path      [ sh:inversePath  sosa:hasProxy ]
                        ];
        sh:property     [ sh:class     xsd:date;
                          sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      dcterms:issued
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "1"^^xsd:long;
                          sh:path      adms:status
                        ];
        sh:property     [ sh:maxCount  "1"^^xsd:long;
                          sh:minCount  "0"^^xsd:long;
                          sh:path      dcterms:valid
                        ];
        sh:targetClass  riepr:Meetpunt .

vann:preferredNamespaceUri
        rdf:type  owl:AnnotationProperty .

riepr:TransportProcedureShape
        rdf:type        sh:NodeShape;
