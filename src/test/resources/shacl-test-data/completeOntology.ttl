geo:sfTouches  rdf:type   owl:ObjectProperty;
        rdfs:comment      "\n      Exists if the subject SpatialObject spatially touches the \n      object SpatialObject.\n      DE-9IM: FT******* ^ F**T***** ^ F***T****\n    "@en;
        rdfs:domain       geo:SpatialObject;
        rdfs:isDefinedBy  <http://www.opengis.net/ont/geosparql> , <http://www.opengis.net/spec/geosparql/1.0>;
        rdfs:label        "touches"@en;
        rdfs:range        geo:SpatialObject;
        dc:contributor    "Matthew Perry";
        dc:creator        "OGC GeoSPARQL 1.0 Standard Working Group";
        dc:date           "2011-06-16"^^xsd:date;
        dc:description    "\n      Exists if the subject SpatialObject spatially touches the \n      object SpatialObject.\n      DE-9IM: FT******* ^ F**T***** ^ F***T****\n    "@en;
        skos:definition   "\n      Exists if the subject SpatialObject spatially touches the \n      object SpatialObject.\n      DE-9IM: FT******* ^ F**T***** ^ F***T****\n    "@en;
        skos:prefLabel    "touches"@en .

sosa:wasActedOnBy  rdf:type    owl:ObjectProperty;
        rdfs:isDefinedBy       sosa-act:;
        rdfs:label             "was acted on by"@en;
        schema:domainIncludes  sosa:Property;
        schema:rangeIncludes   sosa:Actuation , sosa:ActuationCollection;
        owl:inverseOf          sosa:actsOnProperty;
        skos:definition        "\n  relation from a Property to an Actuation that changed its state\n  "@en;
        skos:example           "In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property upon which the Actuator acts is the state of the window as it changes from being open to being closed. "@en .

prov:SubmitShape  rdf:type  sh:NodeShape;
        sh:targetClass  prov:Submit .

prov:wasStartedBy  rdf:type     owl:ObjectProperty;
        rdfs:comment            "Start is when an activity is deemed to have started. A start may refer to an entity, known as trigger, that initiated the activity."@en;
        rdfs:domain             prov:Activity;
        rdfs:isDefinedBy        <http://www.w3.org/ns/prov-o#>;
        rdfs:label              "wasStartedBy";
        rdfs:range              prov:Entity;
        rdfs:subPropertyOf      prov:wasInfluencedBy;
        owl:propertyChainAxiom  ( prov:qualifiedStart prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedStart prov:entity );
        owl:propertyChainAxiom  ( prov:qualifiedStart prov:entity );
        prov:category           "expanded";
        prov:component          "entities-activities";
        prov:inverse            "started";
        prov:qualifiedForm      prov:Start , prov:qualifiedStart .

sosa:originated  rdf:type      owl:ObjectProperty;
