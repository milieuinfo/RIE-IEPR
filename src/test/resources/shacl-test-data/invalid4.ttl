@prefix ex:   <http://example.org/invalid4/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:i
    rdf:type prov:Insertion ;
    prov:dictionary ex:d1, ex:d2 ;
    prov:insertedKeyEntityPair ex:kep .

ex:d1 rdf:type prov:Entity .
ex:d2 rdf:type prov:Entity .
ex:kep rdf:type prov:Entity .