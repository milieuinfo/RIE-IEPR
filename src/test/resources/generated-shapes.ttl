@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

<http://www.w3.org/ns/sosa/PropertyShape>
        a               sh:NodeShape;
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/FeatureOfInterest>;
                          sh:path   <http://www.w3.org/ns/sosa/isPropertyOf>
                        ];
        sh:property     [ sh:or    ( [ sh:class  <http://www.w3.org/ns/sosa/Observation> ]
                                     [ sh:class  <http://www.w3.org/ns/sosa/ObservationCollection> ]
                                   );
                          sh:path  <http://www.w3.org/ns/sosa/wasObservedBy>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Sensor>;
                          sh:path   <http://www.w3.org/ns/sosa/isObservedBy>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Procedure>;
                          sh:path   <http://www.w3.org/ns/sosa/hasProcedure>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Actuator>;
                          sh:path   <http://www.w3.org/ns/sosa/isActedOnBy>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Stimulus>;
                          sh:path   [ sh:inversePath  <http://www.w3.org/ns/sosa/isProxyFor> ]
                        ];
        sh:property     [ sh:or    ( [ sh:class  <http://www.w3.org/ns/sosa/Actuation> ]
                                     [ sh:class  <http://www.w3.org/ns/sosa/ActuationCollection> ]
                                   );
                          sh:path  <http://www.w3.org/ns/sosa/wasActedOnBy>
                        ];
        sh:targetClass  <http://www.w3.org/ns/sosa/Property> .

<http://www.w3.org/ns/sosa/ResultShape>
        a               sh:NodeShape;
        sh:targetClass  <http://www.w3.org/ns/sosa/Result> .

<http://www.w3.org/ns/prov#InsertionShape>
        a               sh:NodeShape;
        sh:targetClass  <http://www.w3.org/ns/prov#Insertion> .

<http://www.w3.org/ns/sosa/ExecutionCollectionShape>
        a               sh:NodeShape;
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Procedure>;
                          sh:path   <http://www.w3.org/ns/sosa/usedProcedure>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/FeatureOfInterest>;
                          sh:path   <http://www.w3.org/ns/sosa/hasFeatureOfInterest>
                        ];
        sh:property     [ sh:or    ( [ sh:class  <http://www.w3.org/ns/sosa/Execution> ]
                                     [ sh:class  <http://www.w3.org/ns/sosa/ExecutionCollection> ]
                                   );
                          sh:path  <http://www.w3.org/ns/sosa/hasMember>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/FeatureOfInterest>;
                          sh:path   <http://www.w3.org/ns/sosa/hasUltimateFeatureOfInterest>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/System>;
                          sh:path   <http://www.w3.org/ns/sosa/madeBySystem>
                        ];
        sh:targetClass  <http://www.w3.org/ns/sosa/ExecutionCollection> .
