@prefix ex:   <http://example.org/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

###########
# Property
###########

ex:property1
    rdf:type sosa:Property ;
    sosa:isPropertyOf ex:feature1 ;
    sosa:isObservedBy ex:sensor1 ;
    sosa:wasObservedBy ex:observation1 ;
    sosa:hasProcedure ex:procedure1 ;
    sosa:isActedOnBy ex:actuator1 ;
    sosa:wasActedOnBy ex:actuation1 .

###########
# Klassen die Property vereist
###########

ex:feature1
    rdf:type sosa:FeatureOfInterest .

ex:sensor1
    rdf:type sosa:Sensor .

ex:observation1
    rdf:type sosa:Observation .

ex:procedure1
    rdf:type sosa:Procedure .

ex:actuator1
    rdf:type sosa:Actuator .

ex:actuation1
    rdf:type sosa:Actuation .

###########
# Result
###########

ex:result1
    rdf:type sosa:Result ;
    sosa:isResultOf ex:execution1 .

###########
# Execution + ExecutionCollection
###########

ex:executionCollection1
    rdf:type sosa:ExecutionCollection ;
    sosa:usedProcedure ex:procedure1 ;
    sosa:hasFeatureOfInterest ex:feature1 ;
    sosa:hasUltimateFeatureOfInterest ex:feature1 ;
    sosa:madeBySystem ex:system1 ;
    sosa:hasMember ex:execution1 .

ex:execution1
    rdf:type sosa:Execution .

ex:system1
    rdf:type sosa:System .

###########
# PROV Insertion
###########

ex:insertion1
    rdf:type prov:Insertion ;
    prov:dictionary ex:dictionary1 ;
    prov:insertedKeyEntityPair ex:keyEntityPair1 .

ex:dictionary1
    rdf:type prov:Entity .

ex:keyEntityPair1
    rdf:type prov:Entity .
