proces:STAP_001_2  rdf:type  prov:Entity , pplan:Step , pplan:Plan , pplan:Entity , sosa:Procedure , prov:Plan , riepr:Proces;
        rdfs:label          "Overbrenging"@nl;
        dc:type             riepr:overbrengingsProces;
        pplan:hasInputVar   stof:mengsel;
        pplan:hasOutputVar  stof:mengsel;
        pplan:isPrecededBy  proces:STAP_001_1;
        pplan:isStepOfPlan  proces:STAP_001 .

stof:deeg  rdf:type          pplan:Variable , riepr:ProcesVariabele;
        rdfs:label           "Deeg"@nl;
        pplan:isInputVarOf   proces:STAP_002;
        pplan:isOutputVarOf  proces:STAP_001 , proces:STAP_001_3 .

exploitatie:ACTIVITEIT_001_VERSIE2020
        rdf:type         ssn:Deployment , riepr:Exploitatie;
        rdfs:label       "Koekjes maken - Versie 2020"@nl;
        dc:created       "2020-07-30T10:00:00Z"^^xsd:dateTime;
        dc:issued        "2020-07-30"^^xsd:date;
        dc:valid         "2030-12-31"^^xsd:date;
        adms:status      riepr:Actief;
        sosa:isHostedBy  exploitatielocatie:ACTIVITEIT_001_LOC;
        ssn:implements   proces:ACTIVITEIT_001 .

stof:koekjes  rdf:type       pplan:Variable , riepr:ProcesVariabele;
        rdfs:label           "Koekjes"@nl;
        pplan:isOutputVarOf  proces:ACTIVITEIT_001 , proces:STAP_002 .

riepr:Actief  rdf:type  skos:Concept .

exploitatielocatie:ACTIVITEIT_001_LOC
        rdf:type    geo:Feature , prov:Entity , sosa:Platform , geo:SpatialObject , riepr:ExploitatieLocatie;
        rdfs:label  "Locatie ACTIVITEIT_001"@nl;
        sosa:hosts  proces:ACTIVITEIT_001 , exploitatie:ACTIVITEIT_001_VERSIE2020 .

proces:STAP_002  rdf:type   pplan:Plan , prov:Entity , riepr:Proces , prov:Plan , pplan:Step , pplan:Entity , sosa:Procedure;
        rdfs:label          "Koekjes bakken"@nl;
        pplan:hasInputVar   stof:deeg;
        pplan:hasOutputVar  stof:koekjes;
        pplan:isPrecededBy  proces:STAP_001;
        pplan:isStepOfPlan  proces:ACTIVITEIT_001 .

proces:ACTIVITEIT_001
        rdf:type            prov:Plan , pplan:Plan , riepr:Proces , prov:Entity , pplan:Entity , pplan:Step , sosa:Procedure;
        rdfs:label          "Koekjes maken"@nl;
        dc:created          "2020-07-30T10:00:00Z"^^xsd:dateTime;
        dc:issued           "2020-07-30"^^xsd:date;
        dc:valid            "2030-12-31"^^xsd:date;
        pplan:hasInputVar   stof:meel;
        pplan:hasOutputVar  stof:koekjes;
        adms:status         riepr:Actief;
        sosa:isHostedBy     exploitatielocatie:ACTIVITEIT_001_LOC;
        ssn:implementedBy   exploitatie:ACTIVITEIT_001_VERSIE2020 .

emissiepunt:TBD  rdf:type  geo:SpatialObject , ssn:System , riepr:Emissiepunt;
        rdfs:label  "Emissiepunt koekjesoven"@nl .

proces:STAP_001_1  rdf:type  pplan:Entity , sosa:Procedure , pplan:Step , pplan:Plan , prov:Entity , prov:Plan , riepr:Proces;
        rdfs:label          "Ingrediënten mengen"@nl;
        pplan:hasInputVar   stof:meel;
        pplan:hasOutputVar  stof:mengsel;
        pplan:isStepOfPlan  proces:STAP_001 .

proces:STAP_001_3  rdf:type  prov:Plan , riepr:Proces , pplan:Entity , sosa:Procedure , pplan:Step , pplan:Plan , prov:Entity;
        rdfs:label          "Deeg laten rusten"@nl;
        pplan:hasInputVar   stof:mengsel;
        pplan:hasOutputVar  stof:deeg;
        pplan:isPrecededBy  proces:STAP_001_2;
        pplan:isStepOfPlan  proces:STAP_001 .

proces:STAP_001  rdf:type   prov:Plan , pplan:Plan , riepr:Proces , prov:Entity , pplan:Step , pplan:Entity , sosa:Procedure;
        rdfs:label          "Koekjesdeeg maken"@nl;
        pplan:hasInputVar   stof:meel;
        pplan:hasOutputVar  stof:deeg;
        pplan:isStepOfPlan  proces:ACTIVITEIT_001 .

stof:mengsel  rdf:type       pplan:Variable , riepr:ProcesVariabele;
        rdfs:label           "Deegmengsel"@nl;
        pplan:isInputVarOf   proces:STAP_001_3 , proces:STAP_001_2;
        pplan:isOutputVarOf  proces:STAP_001_1 , proces:STAP_001_2 .

stof:meel  rdf:type         pplan:Variable , riepr:ProcesVariabele;
        rdfs:label          "Meel"@nl;
        pplan:isInputVarOf  proces:STAP_001 , proces:STAP_001_1 , proces:ACTIVITEIT_001 .

var:emissie_TBD  rdf:type   pplan:Variable , riepr:ProcesVariabele;
        rdfs:label          "Emissie via emissiepunt TBD"@nl;
        pplan:isInputVarOf  proces:STAP_003 .

proces:STAP_003  rdf:type   pplan:Step , pplan:Plan , riepr:Proces , pplan:Entity , sosa:Procedure , prov:Plan , prov:Entity;
        rdfs:label          "Rookgas afvoeren"@nl;
        dc:type             riepr:uitstootProces;
        pplan:hasInputVar   stof:rookgas , var:emissie_TBD;
        pplan:hasOutputVar  stof:rookgas;
        pplan:isPrecededBy  proces:STAP_002;
        pplan:isStepOfPlan  proces:ACTIVITEIT_001 .

stof:rookgas  rdf:type       pplan:Variable;
        pplan:isInputVarOf   proces:STAP_003;
        pplan:isOutputVarOf  proces:STAP_003 .
