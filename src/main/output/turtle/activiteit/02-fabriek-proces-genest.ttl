activiteit:ACTIVITEIT_001
        rdf:type     p-plan:Entity , prov:Entity , dbo:Project , dbo:UnitOfWork , p-plan:Plan , riepr:Activiteit , prov:Plan , riepr:IIOA;
        rdfs:label   "Koekjes maken"@nl;
        dct:created  "2020-07-30T10:00:00Z"^^xsd:dateTime;
        dct:issued   "2020-07-30"^^xsd:date;
        dct:valid    "2030-12-31"^^xsd:date;
        adms:status  riepr:Actief .

activiteitstap:STAP_001_2
        rdf:type             p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Overbrenging"@nl;
        p-plan:isPrecededBy  activiteitstap:STAP_001_1;
        p-plan:isStepOfPlan  activiteitstap:STAP_001;
        ssn:implements       riepr:overbrengingsProces .

activiteitstap:STAP_002
        rdf:type             p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Koekjes bakken"@nl;
        p-plan:isPrecededBy  activiteitstap:STAP_001;
        p-plan:isStepOfPlan  activiteit:ACTIVITEIT_001 .

activiteitstap:STAP_001_1
        rdf:type             p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Ingrediënten mengen"@nl;
        p-plan:isStepOfPlan  activiteitstap:STAP_001 .

activiteitstap:STAP_001_3
        rdf:type             p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Deeg laten rusten"@nl;
        p-plan:isPrecededBy  activiteitstap:STAP_001_2;
        p-plan:isStepOfPlan  activiteitstap:STAP_001 .

activiteitstap:STAP_001
        rdf:type             p-plan:Step , p-plan:Plan , prov:Plan , p-plan:Entity , riepr:IIOA , prov:Entity , riepr:ActiviteitStap;
        rdfs:label           "Koekjesdeeg maken"@nl;
        p-plan:isStepOfPlan  activiteit:ACTIVITEIT_001 .
