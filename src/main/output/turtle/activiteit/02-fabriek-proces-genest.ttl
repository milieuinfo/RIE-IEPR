activiteit:ACTIVITEIT_001
        rdf:type         pplan:Entity , prov:Entity , <http://www.w3.org/2002/07/owl#Thing> , <http://dbpedia.org/ontology/Project> , <http://dbpedia.org/ontology/UnitOfWork> , pplan:Plan , riepr:Activiteit , prov:Plan , riepr:IIOA;
        rdfs:label       "Koekjes maken"@nl;
        dct:created      "2020-07-30T10:00:00Z"^^xsd:dateTime;
        dct:issued       "2020-07-30"^^xsd:date;
        dct:valid        "2030-12-31"^^xsd:date;
        adms:status      riepr:Actief;
        prov:atLocation  exploitatielocatie:ACTIVITEIT_001_LOC .

exploitatielocatie:ACTIVITEIT_001_LOC
        rdf:type    prov:Entity , <http://www.opengis.net/ont/geosparql#SpatialObjectCollection> , prov:Location , riepr:ExploitatieLocatie;
        rdfs:label  "Locatie ACTIVITEIT_001"@nl .

riepr:overbrengingsProces
        rdf:type         prov:Entity;
        prov:influenced  activiteitstap:STAP_001_2 .

activiteitstap:STAP_001_2
        rdf:type              pplan:Step , prov:Entity , riepr:ActiviteitStap;
        rdfs:label            "Overbrenging"@nl;
        pplan:isPrecededBy    activiteitstap:STAP_001_1;
        pplan:isStepOfPlan    activiteitstap:STAP_001;
        prov:wasDerivedFrom   riepr:overbrengingsProces;
        prov:wasInfluencedBy  riepr:overbrengingsProces .

activiteitstap:STAP_002
        rdf:type            pplan:Step , riepr:ActiviteitStap;
        rdfs:label          "Koekjes bakken"@nl;
        pplan:isPrecededBy  activiteitstap:STAP_001;
        pplan:isStepOfPlan  activiteit:ACTIVITEIT_001 .

activiteitstap:STAP_001_1
        rdf:type            pplan:Step , riepr:ActiviteitStap;
        rdfs:label          "Ingrediënten mengen"@nl;
        pplan:isStepOfPlan  activiteitstap:STAP_001 .

activiteitstap:STAP_001_3
        rdf:type            pplan:Step , riepr:ActiviteitStap;
        rdfs:label          "Deeg laten rusten"@nl;
        pplan:isPrecededBy  activiteitstap:STAP_001_2;
        pplan:isStepOfPlan  activiteitstap:STAP_001 .

activiteitstap:STAP_001
        rdf:type            pplan:Step , pplan:Plan , prov:Plan , pplan:Entity , riepr:IIOA , prov:Entity , riepr:ActiviteitStap;
        rdfs:label          "Koekjesdeeg maken"@nl;
        pplan:isStepOfPlan  activiteit:ACTIVITEIT_001 .
