proces:STAP_001_2  rdf:type   dbo:Project , prov:Entity , pplan:Step , dbo:UnitOfWork , riepr:IIOA , pplan:Plan , owl:Thing , pplan:Entity , prov:Plan , riepr:Proces;
        rdfs:label            "Overbrenging"@nl;
        pplan:hasInputVar     stof:mengsel;
        pplan:hasOutputVar    stof:mengsel;
        pplan:isPrecededBy    proces:STAP_001_1;
        pplan:isStepOfPlan    proces:STAP_001;
        prov:wasDerivedFrom   riepr:overbrengingsProces;
        prov:wasInfluencedBy  riepr:overbrengingsProces .

stof:deeg  rdf:type          pplan:Variable , dbo:ChemicalSubstance , riepr:Stof;
        rdfs:label           "Deeg"@nl;
        pplan:isInputVarOf   proces:STAP_002;
        pplan:isOutputVarOf  proces:STAP_001 , proces:STAP_001_3 .

stof:koekjes  rdf:type       pplan:Variable , dbo:ChemicalSubstance , riepr:Stof;
        rdfs:label           "Koekjes"@nl;
        pplan:isOutputVarOf  proces:ACTIVITEIT_001 , proces:STAP_002 .

riepr:Actief  rdf:type  skos:Concept .

exploitatielocatie:ACTIVITEIT_001_LOC
        rdf:type         prov:Location , prov:Entity , geo:SpatialObjectCollection , riepr:ExploitatieLocatie;
        rdfs:label       "Locatie ACTIVITEIT_001"@nl;
        prov:locationOf  proces:ACTIVITEIT_001 .

riepr:overbrengingsProces
        rdf:type            prov:Entity;
        prov:hadDerivation  proces:STAP_001_2;
        prov:influenced     proces:STAP_001_2 .

proces:STAP_002  rdf:type   prov:Entity , pplan:Plan , riepr:Proces , dbo:UnitOfWork , prov:Plan , riepr:IIOA , pplan:Step , pplan:Entity , owl:Thing , dbo:Project;
        rdfs:label          "Koekjes bakken"@nl;
        pplan:hasInputVar   stof:deeg;
        pplan:hasOutputVar  stof:koekjes;
        pplan:isPrecededBy  proces:STAP_001;
        pplan:isStepOfPlan  proces:ACTIVITEIT_001 .

proces:ACTIVITEIT_001
        rdf:type            riepr:IIOA , dbo:UnitOfWork , prov:Plan , owl:Thing , dbo:Project , pplan:Plan , riepr:Proces , prov:Entity , pplan:Entity , pplan:Step;
        rdfs:label          "Koekjes maken"@nl;
        dct:created         "2020-07-30T10:00:00Z"^^xsd:dateTime;
        dct:issued          "2020-07-30"^^xsd:date;
        dct:valid           "2030-12-31"^^xsd:date;
        pplan:hasInputVar   stof:meel;
        pplan:hasOutputVar  stof:koekjes;
        adms:status         riepr:Actief;
        prov:atLocation     exploitatielocatie:ACTIVITEIT_001_LOC .

proces:STAP_001_1  rdf:type  pplan:Entity , pplan:Step , dbo:Project , dbo:UnitOfWork , pplan:Plan , riepr:IIOA , prov:Entity , prov:Plan , owl:Thing , riepr:Proces;
        rdfs:label          "Ingrediënten mengen"@nl;
        pplan:hasInputVar   stof:meel;
        pplan:hasOutputVar  stof:mengsel;
        pplan:isStepOfPlan  proces:STAP_001 .

proces:STAP_001_3  rdf:type  prov:Plan , owl:Thing , riepr:Proces , pplan:Entity , dbo:Project , pplan:Step , dbo:UnitOfWork , riepr:IIOA , pplan:Plan , prov:Entity;
        rdfs:label          "Deeg laten rusten"@nl;
        pplan:hasInputVar   stof:mengsel;
        pplan:hasOutputVar  stof:deeg;
        pplan:isPrecededBy  proces:STAP_001_2;
        pplan:isStepOfPlan  proces:STAP_001 .

proces:STAP_001  rdf:type   riepr:IIOA , prov:Plan , pplan:Plan , riepr:Proces , prov:Entity , dbo:UnitOfWork , owl:Thing , pplan:Entity , pplan:Step , dbo:Project;
        rdfs:label          "Koekjesdeeg maken"@nl;
        pplan:hasInputVar   stof:meel;
        pplan:hasOutputVar  stof:deeg;
        pplan:isStepOfPlan  proces:ACTIVITEIT_001 .

stof:mengsel  rdf:type       dbo:ChemicalSubstance , pplan:Variable , riepr:Stof;
        rdfs:label           "Deegmengsel"@nl;
        pplan:isInputVarOf   proces:STAP_001_3 , proces:STAP_001_2;
        pplan:isOutputVarOf  proces:STAP_001_1 , proces:STAP_001_2 .

stof:meel  rdf:type         dbo:ChemicalSubstance , pplan:Variable , riepr:Stof;
        rdfs:label          "Meel"@nl;
        pplan:isInputVarOf  proces:STAP_001 , proces:STAP_001_1 , proces:ACTIVITEIT_001 .
