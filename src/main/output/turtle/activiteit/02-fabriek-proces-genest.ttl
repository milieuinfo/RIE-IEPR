@prefix :               <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix activiteit:     <https://data.riepr.omgeving.vlaanderen.be/id/activiteit/> .
@prefix activiteitstap: <https://data.riepr.omgeving.vlaanderen.be/id/activiteit/stap/> .
@prefix concept:        <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix dbo:            <http://dbpedia.org/ontology/> .
@prefix foaf:           <http://xmlns.com/foaf/0.1/> .
@prefix geosparql:      <http://www.opengis.net/ont/geosparql#> .
@prefix ogc:            <http://www.opengis.net/ont/geosparql#> .
@prefix org:            <http://www.w3.org/ns/org#> .
@prefix owl:            <http://www.w3.org/2002/07/owl#> .
@prefix p-plan:         <http://purl.org/net/p-plan#> .
@prefix pplan:          <http://purl.org/net/p-plan#> .
@prefix prov:           <http://www.w3.org/ns/prov#> .
@prefix rdf:            <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:           <http://www.w3.org/2000/01/rdf-schema#> .
@prefix riepr:          <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix schema:         <http://schema.org/> .
@prefix skos:           <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:           <http://www.w3.org/ns/sosa/> .
@prefix sp:             <http://www.w3.org/ns/sosa/prov/> .
@prefix ssn:            <http://www.w3.org/ns/ssn/> .
@prefix xsd:            <http://www.w3.org/2001/XMLSchema#> .

activiteit:ACTIVITEIT_001
        rdf:type    p-plan:Entity , prov:Entity , dbo:Project , p-plan:Plan , riepr:Activiteit , prov:Plan;
        rdf:type    [] ;
        rdf:type    [] ;
        rdf:type    [] ;
        rdf:type    [] ;
        rdfs:label  "Koekjes maken"@nl .

riepr:uitstootProces  rdf:type  prov:Entity , prov:Plan .

riepr:apparaatVerwerkingsProces
        rdf:type  prov:Entity , prov:Plan .

riepr:stoomProces  rdf:type  prov:Entity , prov:Plan .

activiteitstap:STAP_001_2
        rdf:type             _:b0 , _:b1 , p-plan:Step , _:b2 , riepr:ActiviteitStap , _:b3 , _:b4;
        rdfs:label           "Overbrenging"@nl;
        p-plan:isPrecededBy  activiteitstap:STAP_001_1;
        p-plan:isStepOfPlan  activiteitstap:STAP_001;
        ssn:implements       riepr:overbrengingsProces .

riepr:electriciteitsVerbruikProces
        rdf:type  prov:Entity , prov:Plan .

activiteitstap:STAP_002
        rdf:type             _:b2 , p-plan:Step , _:b0 , _:b4 , _:b1 , riepr:ActiviteitStap , _:b3;
        rdfs:label           "Koekjes bakken"@nl;
        p-plan:isPrecededBy  activiteitstap:STAP_001;
        p-plan:isStepOfPlan  activiteit:ACTIVITEIT_001 .

activiteitstap:STAP_001_1
        rdf:type             _:b4 , p-plan:Step , _:b3 , _:b1 , _:b2 , _:b0 , riepr:ActiviteitStap;
        rdfs:label           "Ingrediënten mengen"@nl;
        p-plan:isStepOfPlan  activiteitstap:STAP_001 .

activiteitstap:STAP_001_3
        rdf:type             _:b0 , _:b4 , _:b2 , p-plan:Step , riepr:ActiviteitStap , _:b1 , _:b3;
        rdfs:label           "Deeg laten rusten"@nl;
        p-plan:isPrecededBy  activiteitstap:STAP_001_2;
        p-plan:isStepOfPlan  activiteitstap:STAP_001 .

activiteitstap:STAP_001
        rdf:type             riepr:ActiviteitStap , _:b0 , p-plan:Entity , p-plan:Plan , _:b2 , prov:Plan , prov:Entity , _:b1 , p-plan:Step , _:b4 , _:b3;
        rdfs:label           "Koekjesdeeg maken"@nl;
        p-plan:isStepOfPlan  activiteit:ACTIVITEIT_001 .
