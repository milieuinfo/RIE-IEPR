procedurestap:STAP_001
        rdf:type            pplan:Plan , pplan:Entity , prov:Plan , prov:Entity , pplan:Step , pplan:MultiStep;
        rdfs:label          "Koekjesdeeg maken"@nl;
        pplan:isStepOfPlan  activiteit:ACTIVITEIT_001 .

activiteit:ACTIVITEIT_001
        rdf:type    pplan:Plan , pplan:Entity , prov:Plan , prov:Entity , riepr:Activiteit;
        rdfs:label  "Koekjes maken"@nl .

procedurestap:STAP_001_2
        rdf:type            pplan:Step;
        rdfs:label          "Deeg laten rusten"@nl;
        pplan:isPrecededBy  procedurestap:STAP_001_1;
        pplan:isStepOfPlan  procedurestap:STAP_001 .

procedurestap:STAP_002
        rdf:type            pplan:Step;
        rdfs:label          "Koekjes bakken"@nl;
        pplan:isPrecededBy  procedurestap:STAP_001;
        pplan:isStepOfPlan  activiteit:ACTIVITEIT_001 .

procedurestap:STAP_001_1
        rdf:type            pplan:Step;
        rdfs:label          "Ingrediënten mengen"@nl;
        pplan:isStepOfPlan  procedurestap:STAP_001 .
