@prefix activiteit:    <https://data.riepr.omgeving.vlaanderen.be/id/activiteit/> .
@prefix owl:           <http://www.w3.org/2002/07/owl#> .
@prefix p-plan:        <http://purl.org/net/p-plan#> .
@prefix pplan:         <http://purl.org/net/p-plan#> .
@prefix procedurestap: <https://data.riepr.omgeving.vlaanderen.be/id/procedure/> .
@prefix prov:          <http://www.w3.org/ns/prov#> .
@prefix rdf:           <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:          <http://www.w3.org/2000/01/rdf-schema#> .
@prefix riepr:         <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix sosa:          <http://www.w3.org/ns/sosa/> .
@prefix sp:            <http://www.w3.org/ns/sosa/prov/> .
@prefix xsd:           <http://www.w3.org/2001/XMLSchema#> .

procedurestap:STAP_001
        rdf:type             p-plan:Plan , p-plan:Entity , prov:Plan , prov:Entity , p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Koekjesdeeg maken"@nl;
        p-plan:isStepOfPlan  activiteit:ACTIVITEIT_001 .

activiteit:ACTIVITEIT_001
        rdf:type    p-plan:Plan , p-plan:Entity , prov:Plan , prov:Entity , riepr:Activiteit;
        rdfs:label  "Koekjes maken"@nl .

procedurestap:STAP_001_2
        rdf:type             p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Deeg laten rusten"@nl;
        p-plan:isPrecededBy  procedurestap:STAP_001_1;
        p-plan:isStepOfPlan  procedurestap:STAP_001 .

procedurestap:STAP_002
        rdf:type             p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Koekjes bakken"@nl;
        p-plan:isPrecededBy  procedurestap:STAP_001;
        p-plan:isStepOfPlan  activiteit:ACTIVITEIT_001 .

procedurestap:STAP_001_1
        rdf:type             p-plan:Step , riepr:ActiviteitStap;
        rdfs:label           "Ingrediënten mengen"@nl;
        p-plan:isStepOfPlan  procedurestap:STAP_001 .
