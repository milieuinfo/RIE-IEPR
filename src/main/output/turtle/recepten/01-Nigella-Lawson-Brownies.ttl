        pplan:hasOutputVar     var:brownies;
        pplan:isPrecededBy     step:mengen;
        pplan:isStepOfPlan     plan:nigella-brownies;
        sosa:implementedBy     inst:oven-nigella;
        sosa:usedForExecution  exec:bakken .

