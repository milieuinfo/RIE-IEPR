        prov:qualifiedInfluenceOf    kitchen:keuken-geert .

inst:smeltsysteem-geert
        rdf:type              prov:Agent , sosa:System , prov:Entity;
        rdfs:label            "Het systeem van Geert dat mengsels homogeen vloeibaar kan maken"@nl;
        prov:actedOnBehalfOf  agent:geert;
        prov:influenced       exec:smelten;
        prov:wasAssociateFor  exec:smelten;
        prov:wasInfluencedBy  agent:geert;
