inst:pan-geert  rdf:type      prov:Agent , prov:Entity , sosa:System;
        rdfs:label            "Geerts gietijzeren pan"@nl , "Geert's cast iron pan"@en;
        prov:actedOnBehalfOf  agent:geert;
        prov:influenced       exec:acting-as-recipient-2026-02-10;
        prov:wasAssociateFor  exec:acting-as-recipient-2026-02-10;
        prov:wasInfluencedBy  agent:geert;
        sosa:hasDeployment    exec:brownies-baking-for-demo-on-wednesday;
        sosa:implements       step:butter_and_chocolate_in_pan;
        sosa:isSubSystemOf    inst:melting-system-geert .

inst:kitchen-robot-geert
        rdf:type              sosa:System , sosa:Actuator , prov:Agent , ssn:System , prov:Entity;
        rdfs:label            "Geerts keukenmachine."@nl , "Geert's kitchen robot."@en;
        prov:actedOnBehalfOf  agent:geert;
        prov:influenced       exec:mixing-2026-02-10;
        prov:wasAssociateFor  exec:mixing-2026-02-10;
        prov:wasInfluencedBy  agent:geert;
        sosa:hasDeployment    exec:brownies-baking-for-demo-on-wednesday;
        sosa:implements       plan:mixing;
        sosa:madeActuation    exec:mixing-2026-02-10;
        sosa:madeExecution    exec:mixing-2026-02-10 .

ingredient:dark_chocolate
        rdf:type    skos:Concept;
        rdfs:label  "Dark chocolate"@en , "Pure chocolade"@nl .

plan:nigella-brownies
        rdf:type               sosa:ActuatingProcedure , prov:Entity , pplan:Entity , prov:Plan , pplan:Plan , sosa:Procedure;
        rdfs:label             "Nigella Lawson Brownies"@nl , "Nigella Lawson Brownies"@en;
        dct:creator            agent:nigella-lawson;
        dct:source             <https://www.nigella.com/recipes/brownies>;
        sosa:usedForExecution  exec:brownies-baking-2026-02-10 .

step:mixing  rdf:type             pplan:Entity , pplan:Plan , pplan:Step , pplan:MultiStep , prov:Plan , prov:Entity;
        rdfs:label                "Mix all ingredients"@en , "Alle ingrediënten mengen"@nl;
        pplan:hasInputVar         var:sugar , var:eggs , var:melted-mixture , var:flour , var:chopped-walnuts;
        pplan:hasOutputVar        var:batter;
        pplan:isDecomposedAsPlan  plan:mixing;
        pplan:isPrecededBy        step:chopping;
        pplan:isStepOfPlan        plan:nigella-brownies .

exec:mixing-2026-02-10
        rdf:type                   sosa:Actuation , prov:Activity , pplan:Activity , sosa:Execution;
        rdfs:label                 "Mengen"@nl , "Mixing"@en;
        pplan:correspondsToStep    step:mixing;
        prov:generated             ent:batter_001;
        prov:influenced            ent:batter_001;
        prov:used                  ent:sugar_001 , ent:melted-mixture_001 , ent:mixture_002 , ent:chopped-walnuts_001 , ent:eggs_001 , ent:flour_001;
        prov:wasAssociatedWith     inst:kitchen-robot-geert;
        prov:wasInfluencedBy       ent:mixture_002 , ent:melted-mixture_001 , ent:chopped-walnuts_001 , ent:eggs_001 , ent:flour_001 , inst:kitchen-robot-geert , ent:sugar_001;
        sosa:actsOnProperty        prop:state-components;
        sosa:hasFeatureOfInterest  ent:mixture_002;
        sosa:hasResult             ent:batter_001;
        sosa:isMemberOf            exec:brownies-baking-2026-02-10;
        sosa:madeByActuator        inst:kitchen-robot-geert;
        sosa:madeBySystem          inst:kitchen-robot-geert;
        sosa:resultTime            "2026-02-10T20:45:00Z"^^xsd:dateTime;
        sosa:usedProcedure         plan:mixing .

step:baking_tin_in_oven
        rdf:type            pplan:Step;
        rdfs:label          "Place the baking tin in the oven"@en , "Zet de bakvorm in de oven"@nl;
        pplan:isPrecededBy  step:batter_in_baking_tin;
        pplan:isStepOfPlan  plan:baking .

step:batter_in_baking_tin
        rdf:type            prov:Plan , prov:Entity , pplan:Step , sosa:Procedure;
        rdfs:label          "Fill the baking tin with batter"@en , "Doe het beslag in de bakvorm"@nl;
        pplan:isPrecededBy  step:preheating;
        pplan:isStepOfPlan  plan:baking;
        sosa:implementedBy  inst:baking-tin-geert .

plan:chopping  rdf:type        prov:Plan , prov:Entity , sosa:ActuatingProcedure , pplan:Entity , pplan:Plan , sosa:Procedure;
        rdfs:label             "De walnoten hakken"@nl , "Chop the walnuts"@en;
        pplan:isSubPlanOfPlan  plan:nigella-brownies;
        owl:topObjectProperty  plan:nigella-brownies;
        sosa:hasInput          var:walnuts;
        sosa:hasOutput         var:chopped-walnuts;
        sosa:implementedBy     inst:chopping-system-geert;
        sosa:usedForExecution  exec:chopping-2026-02-10 .

parameter:the_colour_of_the_top_of_the_brownie
        rdf:type            ssn:Property , prov:Entity , sosa:Property , sosa:ObservableProperty;
        rdfs:label          "Colour of the top of the brownie"@en , "Kleur van de bovenkant van de brownie"@nl;
        sosa:hasProcedure   plan:bake_until_light_brown_top;
        sosa:isPropertyOf   ent:brownies_001;
        sosa:propertyFor    plan:bake_until_light_brown_top;
        sosa:wasObservedBy  exec:check_when_brownies_are_done .

exec:brownies-baking-for-demo-on-wednesday
        rdf:type                 prov:Activity , sosa:Deployment;
        rdfs:label               "Baking brownies for the demo"@en , "Brownies bakken voor de demo"@nl;
        prov:startedAtTime       "2010-01-01T00:00:00Z"^^xsd:dateTime;
        sosa:deployedAsset       inst:knife-geert , inst:cutting-board-geert , inst:baking-tin-geert , inst:pan-geert , inst:gas-stove-geert , inst:kitchen-robot-geert , inst:whisk-geert , inst:oven-geert , kitchen:kitchen-geert;
        sosa:deployedOnPlatform  kitchen:kitchen-geert;
        sosa:startTime           "2010-01-01T00:00:00Z"^^xsd:dateTime .

inst:melting-system-geert
        rdf:type              prov:Entity , prov:Agent , sosa:System , sosa:Actuator , ssn:System;
        rdfs:label            "Geerts systeem dat mengsels homogeen vloeibaar kan maken"@nl , "Geert's system that can make mixtures homogeneously liquid"@en;
        prov:actedOnBehalfOf  agent:geert;
        prov:influenced       exec:melting-2026-02-10;
        prov:wasAssociateFor  exec:melting-2026-02-10;
        prov:wasInfluencedBy  agent:geert;
        sosa:hasSubSystem     inst:gas-stove-geert , inst:whisk-geert , inst:pan-geert;
        sosa:implements       plan:melting;
        sosa:madeActuation    exec:melting-2026-02-10;
        sosa:madeExecution    exec:melting-2026-02-10 .

attr:relation-kitchen-geert
        rdf:type                     prov:Influence , prov:Attribution , prov:AgentInfluence;
        rdfs:label                   "The relation between the kitchen and Geert"@en , "De relatie tussen de keuken en Geert"@nl;
        prov:agent                   agent:geert;
        prov:hadRole                 role:user;
        prov:influencer              agent:geert;
        prov:qualifiedAttributionOf  kitchen:kitchen-geert;
        prov:qualifiedInfluenceOf    kitchen:kitchen-geert .

step:heat_pan  rdf:type     prov:Plan , prov:Entity , pplan:Step , sosa:Procedure;
        rdfs:label          "Heat the pan on the stove"@en , "Verwarm de pan op het fornuis"@nl;
        pplan:isPrecededBy  step:butter_and_chocolate_in_pan;
        pplan:isStepOfPlan  plan:melting;
        sosa:implementedBy  inst:gas-stove-geert .

exec:baking-2026-02-10
        rdf:type                   sosa:Execution , sosa:Actuation , pplan:Activity , prov:Activity;
        rdfs:label                 "Baking"@en , "Bakken"@nl;
        pplan:correspondsToStep    step:baking;
        prov:generated             ent:brownies_001;
        prov:influenced            ent:brownies_001;
        prov:used                  ent:batter_001;
        prov:wasAssociatedWith     inst:oven-geert;
        prov:wasInfluencedBy       ent:batter_001 , inst:oven-geert;
        sosa:actsOnProperty        prop:state-batter;
        sosa:hasFeatureOfInterest  ent:batter_001;
        sosa:hasResult             ent:brownies_001;
        sosa:isMemberOf            exec:brownies-baking-2026-02-10;
        sosa:madeByActuator        inst:oven-geert;
        sosa:madeBySystem          inst:oven-geert;
        sosa:resultTime            "2026-02-10T21:25:00Z"^^xsd:dateTime;
        sosa:usedProcedure         plan:baking .

ingredient:eggs  rdf:type  skos:Concept;
        rdfs:label  "Eggs"@en , "Eieren"@nl .

ent:chopped-walnuts_001
        rdf:type                     pplan:Entity , prov:Entity , sosa:Result;
        rdfs:label                   "Chopped walnuts"@en , "Gehakte walnoten"@nl;
        dct:type                     intermediateproduct:chopped-walnuts;
        pplan:correspondsToVariable  var:chopped-walnuts;
        prov:hadDerivation           ent:batter_001;
        prov:influenced              ent:mixture_002 , exec:mixing-2026-02-10 , ent:batter_001;
        prov:wasDerivedFrom          ent:walnuts_001;
        prov:wasGeneratedBy          exec:chopping-2026-02-10;
        prov:wasInfluencedBy         exec:chopping-2026-02-10 , ent:walnuts_001;
        prov:wasMemberOf             ent:mixture_002;
        prov:wasUsedBy               exec:mixing-2026-02-10;
        sosa:isResultOf              exec:chopping-2026-02-10 .

ent:mixture_001  rdf:type           sosa:FeatureOfInterest , prov:Entity , prov:Collection;
        rdfs:label                  "boter + chocolade"@nl , "butter + chocolate"@en;
        prov:hadMember              ent:butter_001 , ent:chocolate_001;
        prov:influenced             exec:melting-2026-02-10;
        prov:wasInfluencedBy        ent:chocolate_001 , ent:butter_001;
        prov:wasUsedBy              exec:melting-2026-02-10;
        sosa:hasProperty            prop:state-butter-chocolate;
        sosa:isFeatureOfInterestOf  exec:melting-2026-02-10 .

step:chopping  rdf:type           pplan:Plan , pplan:MultiStep , prov:Plan , pplan:Step , pplan:Entity , prov:Entity;
        rdfs:label                "De walnoten hakken"@nl , "Chop the walnuts"@en;
        pplan:hasInputVar         var:walnuts;
        pplan:hasOutputVar        var:chopped-walnuts;
        pplan:isDecomposedAsPlan  plan:chopping;
        pplan:isPrecededBy        step:melting;
        pplan:isStepOfPlan        plan:nigella-brownies .

prop:state-butter-chocolate
        rdf:type           ssn:Property , prov:Entity , sosa:ActuatableProperty , sosa:Property;
        rdfs:label         "State of butter and chocolate (solid → liquid)"@en , "Toestand van boter en chocolade (vast → vloeibaar)"@nl;
        sosa:isPropertyOf  ent:mixture_001;
        sosa:wasActedOnBy  exec:melting-2026-02-10 .

step:stir_until_homogeneous_liquid_mixture
        rdf:type            prov:Plan , prov:Entity , pplan:Step , sosa:Procedure;
        rdfs:label          "Stir until homogeneous mixture"@en , "Roer tot een homogeen mengsel"@nl;
        pplan:isPrecededBy  step:heat_pan;
        pplan:isStepOfPlan  plan:melting;
        sosa:implementedBy  inst:whisk-geert .

intermediateproduct:batter
        rdf:type    skos:Concept;
        rdfs:label  "Batter"@en , "Beslag"@nl .

var:chopped-walnuts  rdf:type   pplan:Variable;
        rdfs:label              "Chopped walnuts"@en , "Gehakte walnoten"@nl;
        dct:type                intermediateproduct:chopped-walnuts;
        pplan:isInputVarOf      step:mixing;
        pplan:isOutputVarOf     step:chopping;
        pplan:isVariableOfPlan  plan:nigella-brownies;
        sosa:inputFor           plan:mixing;
        sosa:outputFor          plan:chopping .

intermediateproduct:chopped-walnuts
        rdf:type    skos:Concept;
        rdfs:label  "Chopped walnuts"@en , "Gehakte walnoten"@nl .

ent:brownies_001  rdf:type           sosa:FeatureOfInterest , sosa:Result , prov:Entity , pplan:Entity;
        rdfs:label                   "Brownies"@nl , "Brownies"@en;
        dct:type                     finalproduct:brownies;
        pplan:correspondsToVariable  var:brownies;
        prov:influenced              exec:check_when_brownies_are_done;
        prov:wasDerivedFrom          ent:batter_001;
        prov:wasGeneratedBy          exec:baking-2026-02-10;
        prov:wasInfluencedBy         exec:baking-2026-02-10 , ent:batter_001;
        prov:wasUsedBy               exec:check_when_brownies_are_done;
        sosa:hasProperty             parameter:the_colour_of_the_top_of_the_brownie;
        sosa:isFeatureOfInterestOf   exec:check_when_brownies_are_done;
        sosa:isResultOf              exec:baking-2026-02-10;
        sosa:isUltimateFeatureOfInterestOf
                exec:brownies-baking-2026-02-10 .

kitchen:kitchen-geert
        rdf:type                   sosa:Platform , prov:Entity;
        rdfs:label                 "Keuken van Geert Van Haute."@nl , "Geert Van Haute's kitchen."@en;
        prov:qualifiedAttribution  attr:relation-kitchen-geert;
        prov:qualifiedInfluence    attr:relation-kitchen-geert;
        prov:wasAttributedTo       agent:geert;
        prov:wasInfluencedBy       agent:geert;
        sosa:hasDeployment         exec:brownies-baking-for-demo-on-wednesday;
        sosa:inDeployment          exec:brownies-baking-for-demo-on-wednesday .

plan:baking  rdf:type          pplan:Entity , prov:Entity , sosa:ActuatingProcedure , sosa:Procedure , prov:Plan , pplan:Plan;
        rdfs:label             "Het beslag bakken"@nl , "Bake the batter"@en;
        pplan:isSubPlanOfPlan  plan:nigella-brownies;
        owl:topObjectProperty  plan:nigella-brownies;
        sosa:hasInput          var:batter;
        sosa:hasOutput         var:brownies;
        sosa:implementedBy     inst:oven-geert;
        sosa:usedForExecution  exec:baking-2026-02-10 .

ingredient:butter  rdf:type  skos:Concept;
        rdfs:label  "Butter"@en , "Boter"@nl .

exec:chopping-2026-02-10
        rdf:type                   sosa:Actuation , prov:Activity , pplan:Activity , sosa:Execution;
        rdfs:label                 "Walnoten hakken."@nl , "Chopping walnuts."@en;
        pplan:correspondsToStep    step:chopping;
        prov:generated             ent:chopped-walnuts_001;
        prov:influenced            ent:chopped-walnuts_001;
        prov:used                  ent:walnuts_001;
        prov:wasAssociatedWith     inst:chopping-system-geert;
        prov:wasInfluencedBy       inst:chopping-system-geert , ent:walnuts_001;
        sosa:actsOnProperty        prop:state-walnuts;
        sosa:hasFeatureOfInterest  ent:walnuts_001;
        sosa:hasResult             ent:chopped-walnuts_001;
        sosa:isMemberOf            exec:brownies-baking-2026-02-10;
        sosa:madeByActuator        inst:chopping-system-geert;
        sosa:madeBySystem          inst:chopping-system-geert;
        sosa:resultTime            "2026-02-10T20:50:00Z"^^xsd:dateTime;
        sosa:usedProcedure         plan:chopping .

var:melted-mixture  rdf:type    pplan:Variable;
        rdfs:label              "Melted butter-chocolate"@en , "Gesmolten boter-chocolade"@nl;
        dct:type                intermediateproduct:melted-mixture;
        pplan:isInputVarOf      step:mixing;
        pplan:isOutputVarOf     step:melting;
        pplan:isVariableOfPlan  plan:nigella-brownies;
        sosa:inputFor           plan:mixing;
        sosa:outputFor          plan:melting .

plan:bake_until_light_brown_top
        rdf:type               pplan:Plan , prov:Entity , sosa:Procedure , prov:Plan , pplan:Entity , sosa:ObservingProcedure;
        rdfs:label             "Bake for approximately 25 minutes until the top is light brown"@en , "Bak ongeveer 25 minuten tot de bovenkant lichtbruin is"@nl;
        pplan:isSubPlanOfPlan  plan:nigella-brownies;
        owl:topObjectProperty  plan:nigella-brownies;
        sosa:forProperty       parameter:the_colour_of_the_top_of_the_brownie;
        sosa:hasOutput         var:colour;
        sosa:isProcedureFor    parameter:the_colour_of_the_top_of_the_brownie;
        sosa:usedForExecution  exec:check_when_brownies_are_done .

ent:mixture_002  rdf:type           sosa:FeatureOfInterest , prov:Collection , prov:Entity;
        rdfs:label                  "Homogenised butter and chocolate, chopped walnuts, sugar, eggs and flour"@en , "Gehomogeniseerde boter en chocolade, gehakte walnoten, suiker, eieren en bloem"@nl;
        prov:hadMember              ent:flour_001 , ent:melted-mixture_001 , ent:sugar_001 , ent:eggs_001 , ent:chopped-walnuts_001;
        prov:influenced             exec:mixing-2026-02-10;
        prov:wasInfluencedBy        ent:melted-mixture_001 , ent:chopped-walnuts_001 , ent:eggs_001 , ent:sugar_001 , ent:flour_001;
        prov:wasUsedBy              exec:mixing-2026-02-10;
        sosa:hasProperty            prop:state-components;
        sosa:isFeatureOfInterestOf  exec:mixing-2026-02-10 .

prop:state-batter  rdf:type  ssn:Property , prov:Entity , sosa:ActuatableProperty , sosa:Property;
        rdfs:label         "State of the batter (raw → baked)"@en , "Toestand van het beslag (rauw → gebakken)"@nl;
        sosa:isPropertyOf  ent:batter_001;
        sosa:wasActedOnBy  exec:baking-2026-02-10 .

ingredient:sugar  rdf:type  skos:Concept;
        rdfs:label  "Sugar"@en , "Suiker"@nl .

exec:homogenising-2026-02-10
        rdf:type                prov:Activity;
        rdfs:label              "Homogenising liquid chocolate and butter."@en , "Vloeibare chocolade en boter homogeniseren."@nl;
        prov:influenced         exec:melting-2026-02-10;
        prov:informed           exec:melting-2026-02-10;
        prov:wasAssociatedWith  inst:whisk-geert;
        prov:wasInfluencedBy    inst:whisk-geert .

var:flour  rdf:type             pplan:Variable;
        rdfs:label              "Flour"@en , "Bloem"@nl;
        dct:type                ingredient:flour;
        pplan:isInputVarOf      step:mixing;
