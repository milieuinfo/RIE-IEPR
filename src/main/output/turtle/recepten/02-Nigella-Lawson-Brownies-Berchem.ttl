        sosa:implements       step:smelten;
        sosa:madeActuation    exec:smelten;
        sosa:madeExecution    exec:smelten .

exec:bakken  rdf:type            sosa:Execution , sosa:Actuation , prov:Activity , pplan:Activity;
        rdfs:label               "Bakken"@nl;
        pplan:correspondsToStep  step:bakken;
        prov:generated           ent:brownies_001;
        prov:influenced          ent:brownies_001;
        prov:used                ent:beslag_001;
        prov:wasAssociatedWith   inst:oven-geert;
        prov:wasInfluencedBy     ent:beslag_001 , inst:oven-geert;
        sosa:hasResult           ent:brownies_001;
        sosa:isMemberOf          exec:brownies-bakken-2024;
        sosa:madeByActuator      inst:oven-geert;
        sosa:madeBySystem        inst:oven-geert;
        sosa:usedProcedure       step:bakken .

ent:brownies_001  rdf:type           prov:Entity , pplan:Entity;
        rdf:value                    150;
        dct:type                     eindproduct:brownies;
        pplan:correspondsToVariable  var:brownies;
        qudt:unit                    unit:GM;
        prov:influenced              exec:controleer_wanneer_brownies_klaar_zijn;
