        dct:type                ingredient:eieren;
        pplan:isInputVarOf      step:mengen;
        pplan:isVariableOfPlan  plan:nigella-brownies;
        qudt:unit               unit:UNITLESS .

inst:mes-geert  sosa:hasDeployment  exec:brownies-bakken-voor-demo-op-woensdag;
        sosa:isSubSystemOf  inst:haksysteem-geert .

ent:gehakte-walnoten_001
        rdf:type                     pplan:Entity , prov:Entity;
        rdfs:label                   "Gehakte walnoten"@nl;
        dct:type                     tussenproduct:gehakte-walnoten;
        pplan:correspondsToVariable  var:gehakte-walnoten;
