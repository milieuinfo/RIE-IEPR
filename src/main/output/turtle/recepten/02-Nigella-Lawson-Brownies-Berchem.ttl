        prov:hadDelegate       inst:gasvuur-geert , inst:garde-geert , inst:smeltsysteem-geert , inst:pan-geert , inst:snijplank-geert , inst:inst:mes-geert , inst:keukenrobot-geert , inst:haksysteem-geert , inst:oven-geert , inst:bakvorm-geert;
        prov:hadInfluence      attr:relatie-keuken-geert;
        prov:influenced        inst:gasvuur-geert , inst:inst:mes-geert , inst:garde-geert , inst:bakvorm-geert , inst:haksysteem-geert , inst:keukenrobot-geert , kitchen:keuken-geert , exec:controleer_wanneer_brownies_klaar_zijn , inst:oven-geert , inst:snijplank-geert , exec:brownies-bakken-2024 , inst:smeltsysteem-geert , inst:pan-geert;
