        sosa:isFeatureOfInterestOf   exec:controleer_wanneer_brownies_klaar_zijn;
        sosa:isResultOf              exec:bakken .

ent:gesmolten-mengsel_001
        rdf:type                     pplan:Entity , prov:Entity;
        rdfs:label                   "Gesmolten boter-chocolade"@nl;
        dct:type                     tussenproduct:gesmolten-mengsel;
        pplan:correspondsToVariable  var:gesmolten-mengsel;
