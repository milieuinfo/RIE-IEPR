        prov:wasAssociateFor  exec:als-recipient-functioneren-2026-02-10;
        prov:wasInfluencedBy  agent:geert;
        sosa:hasDeployment    exec:brownies-bakken-voor-demo-op-woensdag;
        sosa:implements       step:boter_en_chocolade_in_pan;
        sosa:isSubSystemOf    inst:smeltsysteem-geert .

var:suiker  rdf:type            pplan:Variable;
