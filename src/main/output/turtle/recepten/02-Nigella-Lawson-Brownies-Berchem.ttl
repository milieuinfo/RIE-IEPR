        dc:type                 ingredient:suiker;
        pplan:isInputVarOf      step:mengen;
        pplan:isVariableOfPlan  plan:nigella-brownies;
        qudt:hasUnit            unit:GM;
        sosa:inputFor           plan:mengen .

exec:brownies-bakken-voor-demo-op-woensdag
        rdf:type                 sosa:Deployment , prov:Activity;
        rdfs:label               "Brownies bakken voor de demo"@nl;
        prov:startedAtTime       "2010-01-01T00:00:00Z"^^xsd:dateTime;
        sosa:deployedAsset       kitchen:keuken-geert , inst:keukenrobot-geert , inst:gasvuur-geert , inst:garde-geert , inst:pan-geert , inst:oven-geert , inst:snijplank-geert , inst:mes-geert;
        sosa:deployedOnPlatform  kitchen:keuken-geert;
        sosa:startTime           "2010-01-01T00:00:00Z"^^xsd:dateTime .

ingredient:eieren  rdf:type  skos:Concept .

step:laat_bakken_tot_lichtbruine_bovenkant
        rdf:type                  pplan:Plan , prov:Plan , pplan:Entity , sosa:Procedure , pplan:MultiStep , pplan:Step , prov:Entity , sosa:ObservingProcedure;
