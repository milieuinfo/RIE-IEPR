kitchen:keuken-geert  rdf:type     prov:Entity , sosa:Platform;
        rdfs:label                 "Keuken van Geert Van Haute"@nl;
        prov:qualifiedAttribution  attr:relatie-keuken-geert;
        prov:qualifiedInfluence    attr:relatie-keuken-geert;
        prov:wasAttributedTo       agent:geert;
        prov:wasInfluencedBy       agent:geert;
        sosa:hasDeployment         exec:brownies-bakken-voor-demo-op-woensdag;
        sosa:inDeployment          exec:brownies-bakken-voor-demo-op-woensdag .

step:bakken  rdf:type          riepr:IIOA , pplan:Step , pplan:Entity , prov:Plan , pplan:Plan , sosa:Procedure , prov:Entity;
        rdfs:label             "Bak het beslag"@nl;
        pplan:hasInputVar      var:beslag;
        pplan:hasOutputVar     var:brownies;
        pplan:isPrecededBy     step:mengen;
        pplan:isStepOfPlan     plan:nigella-brownies;
        sosa:implementedBy     inst:oven-geert;
        sosa:usedForExecution  exec:bakken .

ent:eieren_001  rdf:type             prov:Entity , pplan:Entity;
        rdf:value                    6;
        dct:type                     ingredient:eieren;
        pplan:correspondsToVariable  var:eieren;
        qudt:unit                    unit:UNITLESS;
        prov:hadDerivation           ent:beslag_001;
        prov:influenced              ent:beslag_001 , exec:mengen;
        prov:wasUsedBy               exec:mengen .

inst:pan-geert  rdf:type      prov:Agent , prov:Entity , sosa:System;
        rdfs:label            "Gietijzeren pan van Geert"@nl;
        prov:actedOnBehalfOf  agent:geert;
        prov:influenced       exec:als-recipient-functioneren;
        prov:wasAssociateFor  exec:als-recipient-functioneren;
        prov:wasInfluencedBy  agent:geert;
        sosa:hasDeployment    exec:brownies-bakken-voor-demo-op-woensdag;
        sosa:implements       step:boter_en_chocolade_in_pan;
        sosa:isSubSystemOf    inst:smeltsysteem-geert .

var:suiker  rdf:type            pplan:Variable;
        rdf:value               500;
        dct:type                ingredient:suiker;
        pplan:isInputVarOf      step:mengen;
        pplan:isVariableOfPlan  plan:nigella-brownies;
        qudt:unit               unit:GM .

exec:brownies-bakken-voor-demo-op-woensdag
        rdf:type                 sosa:Deployment , prov:Activity;
        rdfs:label               "Brownies bakken voor de demo"@nl;
        prov:startedAtTime       "2010-01-01T00:00:00Z"^^xsd:dateTime;
        sosa:deployedAsset       kitchen:keuken-geert , inst:keukenrobot-geert , inst:gasvuur-geert , inst:garde-geert , inst:pan-geert , inst:oven-geert , inst:snijplank-geert , inst:mes-geert;
        sosa:deployedOnPlatform  kitchen:keuken-geert;
        sosa:implements          plan:nigella-brownies;
        sosa:startTime           "2010-01-01T00:00:00Z"^^xsd:dateTime .

step:laat_bakken_tot_lichtbruine_bovenkant
        rdf:type               riepr:IIOA , pplan:Plan , prov:Plan , sosa:Procedure , pplan:Entity , pplan:Step , prov:Entity;
        rdfs:label             "Laat ongeveer 35 minuten bakken tot de bovenzijde lichtbruin is"@nl;
        pplan:hasOutputVar     var:kleur;
        pplan:isPrecededBy     step:bakvorm_in_oven;
        pplan:isStepOfPlan     step:bakken;
        sosa:forProperty       parameter:de_kleur_van_de_bovenzijde_va_de_brownie;
        sosa:hasOutput         var:kleur;
        sosa:implementedBy     agent:geert;
        sosa:isProcedureFor    parameter:de_kleur_van_de_bovenzijde_va_de_brownie;
        sosa:usedForExecution  exec:controleer_wanneer_brownies_klaar_zijn .

<file:///home/gehau/git/RIE-IEPR/>
        sosa:isUltimateFeatureOfInterestOf
                exec:brownies-bakken-2024 .

plan:nigella-brownies
        rdf:type               prov:Entity , pplan:Entity , prov:Plan , riepr:IIOA , pplan:Plan , sosa:Procedure;
        rdfs:label             "Nigella Lawson Brownies"@en;
        dct:creator            agent:nigella-lawson;
        dct:source             <https://www.nigella.com/recipes/brownies>;
        sosa:implementedBy     exec:brownies-bakken-voor-demo-op-woensdag;
        sosa:usedForExecution  exec:brownies-bakken-2024 .

exec:smelten  rdf:type           sosa:Execution , prov:Activity , sosa:Actuation , pplan:Activity;
        rdfs:label               "Verhitten"@nl;
        pplan:correspondsToStep  step:smelten;
        prov:generated           ent:gesmolten-mengsel_001;
        prov:influenced          ent:gesmolten-mengsel_001;
        prov:used                ent:boter_001 , ent:chocolade_001;
        prov:wasAssociatedWith   inst:smeltsysteem-geert;
        prov:wasInfluencedBy     inst:smeltsysteem-geert , ent:chocolade_001 , exec:als-recipient-functioneren , ent:boter_001;
        prov:wasInformedBy       exec:als-recipient-functioneren;
        sosa:hasResult           ent:gesmolten-mengsel_001;
        sosa:madeByActuator      inst:smeltsysteem-geert;
        sosa:madeBySystem        inst:smeltsysteem-geert;
        sosa:usedProcedure       step:smelten .

exec:hakken  rdf:type            pplan:Activity , sosa:Execution , sosa:Actuation , prov:Activity;
        rdfs:label               "Hakken van walnoten"@nl;
        pplan:correspondsToStep  step:mengen;
        prov:generated           ent:gehakte-walnoten_001;
        prov:influenced          ent:gehakte-walnoten_001;
        prov:used                ent:walnoten_001;
        prov:wasAssociatedWith   inst:haksysteem-geert;
        prov:wasInfluencedBy     inst:haksysteem-geert , ent:walnoten_001;
        sosa:hasResult           ent:gehakte-walnoten_001;
        sosa:isMemberOf          exec:brownies-bakken-2024;
        sosa:madeByActuator      inst:haksysteem-geert;
        sosa:madeBySystem        inst:haksysteem-geert;
        sosa:usedProcedure       step:mengen .

step:mengen  rdf:type          prov:Plan , sosa:Procedure , prov:Entity , riepr:IIOA , pplan:Plan , pplan:Step , pplan:Entity;
        rdfs:label             "Meng alle ingrediënten"@nl;
        pplan:hasInputVar      var:bloem , var:gesmolten-mengsel , var:suiker , var:gehakte-walnoten , var:eieren;
        pplan:hasOutputVar     var:beslag;
        pplan:isPrecededBy     step:hakken;
        pplan:isStepOfPlan     plan:nigella-brownies;
        sosa:implementedBy     inst:keukenrobot-geert;
        sosa:usedForExecution  exec:hakken , exec:mengen .

var:bloem  rdf:type             pplan:Variable;
        rdf:value               225;
        dct:type                ingredient:bloem;
        pplan:isInputVarOf      step:mengen;
        pplan:isVariableOfPlan  plan:nigella-brownies;
        qudt:unit               unit:GM .

ent:boter_001  rdf:type              prov:Entity , pplan:Entity;
        rdf:value                    375;
        dct:type                     ingredient:boter;
        pplan:correspondsToVariable  var:boter;
        qudt:unit                    unit:GM;
        prov:hadDerivation           ent:gesmolten-mengsel_001;
