exec:fenomeen-kleur-2026-02-10
        rdf:type                 time:TemporalEntity , owl:Thing , time:Instant;
        time:inXSDDateTimeStamp  "2026-02-10T21:30:00Z"^^xsd:dateTimeStamp;
        sosa:phenomenonOccurred  exec:controleer_wanneer_brownies_klaar_zijn .

plan:nigella-brownies
