step:bakken  rdf:type             pplan:MultiStep , pplan:Step , pplan:Entity , prov:Plan , pplan:Plan , prov:Entity;
        rdfs:label                "Bak het beslag"@nl;
        pplan:hasInputVar         var:beslag;
        pplan:hasOutputVar        var:brownies;
        pplan:isDecomposedAsPlan  plan:bakken;
        pplan:isPrecededBy        step:mengen;
        pplan:isStepOfPlan        plan:nigella-brownies .

ent:eieren_001  rdf:type             prov:Entity , pplan:Entity;
        rdf:value                    6;
        dc:type                      ingredient:eieren;
        pplan:correspondsToVariable  var:eieren;
        qudt:hasUnit                 unit:UNITLESS;
        prov:hadDerivation           ent:beslag_001;
        prov:influenced              ent:beslag_001 , exec:mengen-2026-02-10;
        prov:wasUsedBy               exec:mengen-2026-02-10 .

inst:pan-geert  rdf:type      prov:Agent , prov:Entity , sosa:System;
        rdfs:label            "Gietijzeren pan van Geert"@nl;
        prov:actedOnBehalfOf  agent:geert;
