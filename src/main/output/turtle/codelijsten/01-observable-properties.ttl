@prefix :             <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix geosparql:    <http://www.opengis.net/ont/geosparql#> .
@prefix owl:          <http://www.w3.org/2002/07/owl#> .
@prefix p-plan:       <http://purl.org/net/p-plan#> .
@prefix prov:         <http://www.w3.org/ns/prov#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt:         <http://qudt.org/schema/qudt/> .
@prefix rdfs:         <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa:         <http://www.w3.org/ns/sosa/> .
@prefix sp:           <http://www.w3.org/ns/sosa/prov/> .
@prefix unit:         <http://qudt.org/vocab/unit/> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .

:ZinkConcentratie  a       sosa:ObservableProperty;
        rdfs:label         "Zink concentratie"@nl;
        qudt:quantityKind  quantitykind:MassConcentration;
        qudt:unit          unit:MicrogramPerCubicMeter .

:Zuurtegraad  a            sosa:ObservableProperty;
        rdfs:label         "Zuurtegraad"@nl;
        qudt:quantityKind  quantitykind:Acidity;
        qudt:unit          unit:PH .
