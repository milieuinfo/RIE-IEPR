# Entiteiten
# {

# } => {

# }

# Actuations
{
    ?proces a riepr:Proces ;
        ssn:implementedBy ?systeem .
} => {
    ?actuation a sosa:Actuation ;
        pplan:correspondsToStep ?proces ;
        prov:used ?usedEntity ;
        sosa:endTime ?endTime ;
        sosa:hasResult ?result ;
        sosa:madeByActuator ?systeem ;
        sosa:startTime ?startTime .
} .