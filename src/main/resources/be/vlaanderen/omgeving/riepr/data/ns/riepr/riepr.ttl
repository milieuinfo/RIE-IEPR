@prefix :       <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix pplan:  <http://purl.org/net/p-plan#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix ogc:    <http://www.opengis.net/ont/geosparql#> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix ssn:    <http://www.w3.org/ns/ssn/> .
@prefix hydra:  <http://www.w3.org/ns/hydra/core#> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix concept: <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix schema: <http://schema.org/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix locn:   <http://www.w3.org/ns/locn#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .

# --------------------------------------- #
# Ontology definition
# --------------------------------------- #

<> a owl:Ontology ;
    dct:title "RIE-IEPR Ontologie"@nl ;
    dct:title "RIE-IEPR Ontology"@en ;
    dct:creator "Vlaamse overheid - Departement Omgeving"@nl ;
    dct:creator "Flemish Government - Department of Environment"@en ;
    dct:publisher "Vlaamse overheid - Departement Omgeving"@nl ;
    dct:publisher "Flemish Government - Department of Environment and Spatial Development"@en ;
    dct:description "De RIE-IEPR ontologie definieert een datamodel voor het beschrijven van industriele processen, installaties, emissiepunten, meetpunten, apparaten, observaties, exploitanten en exploitatie locaties binnen het kader van het RIE-IEPR systeem."@nl ;
    dct:description "The RIE-IEPR ontology defines a data model for describing industrial processes, installations, emission points, measurement points, devices, observations, operators and operation locations within the context of the RIE-IEPR system."@en ;
    dct:license <https://data.vlaanderen.be/id/licentie/modellicentie-gratis-hergebruik/v1.0> ;
    dct:issued "2026-01-27"^^xsd:date ;
    dct:modified "2026-01-27"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "riepr" ;
    vann:preferredNamespaceUri "https://data.riepr.omgeving.vlaanderen.be/ns/riepr#" ;
    rdfs:seeAlso <https://omgeving.vlaanderen.be> ;
    foaf:homepage <https://github.com/milieuinfo/RIE-IEPR> ;
    owl:imports prov: , pplan: , ogc: , sosa: , ssn: , dbo: , org: , skos: , foaf: .

# --------------------------------------- #
# Classes
# --------------------------------------- #

:Proces a owl:Class ;
    rdfs:label "Proces"@nl ;
    rdfs:comment "Een (milieu)proces is een door de gebruiker in te vullen industrieel proces op een bepaalde locatie bestaande uit meerdere procedurestappen die het proces beschrijven. Een proces kan hiërarchisch opgebouwd zijn als een plan met substappen."@nl ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/proces/{exploitatielocatie}/{localId}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "exploitatielocatie" ; hydra:property adms:identifier ; hydra:required true ] ,
                      [ hydra:variable "localId" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    skos:example [ a :Proces ;
        rdfs:label "Productie van cement in een fabriek te Antwerpen"@nl ;
        dct:created "2024-01-15T10:00:00"^^xsd:dateTime ;
        dct:issued "2020-01-01"^^xsd:date ;
        dct:valid "2030-12-31"^^xsd:date ;
        sosa:isHostedBy [ a :ExploitatieLocatie ;
            rdfs:label "Cementfabriek Antwerpen"@nl
        ]
    ] ;
    skos:example [ a :Proces ;
        rdfs:label "Verwerking van grondstoffen"@nl ;
        dct:type [ a :VerwerkingsProcedure ]
    ] ;
    rdfs:subClassOf pplan:Plan, pplan:Step, dbo:Project, ssn:System, prov:Agent ;
    owl:equivalentClass [ a owl:Class ;
        rdfs:comment "Proces kan een plan op zichzelf zijn (multi step)"@nl ;
        owl:unionOf ( pplan:Step pplan:MultiStep pplan:Plan ) 
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces moet een datum hebben waarop het is ingegeven"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces moet een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces vindt plaats op een enkele exploitatie locatie"@nl ;
        owl:onProperty sosa:isHostedBy ;
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces moet een enkele status hebben"@nl ;
        owl:onProperty adms:status ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces kan externe identificaties hebben (optioneel)"@nl ;
        owl:onProperty adms:identifier ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een proces kan worden geïmplementeerd door een agent"@nl ;
        owl:onProperty ssn:implementedBy ; 
        owl:someValuesFrom ssn:System ; 
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een proces kan zijn afgeleid van een (generieke) procedure (optioneel). Max 1 omdat een proces slechts van 1 procedure afgeleid kan zijn en deze procedure een verzameling van andere procedures zou moeten zijn."@nl ;
        owl:onProperty dct:type ; 
        owl:someValuesFrom sosa:Procedure ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces mag minstens één inputvariabele hebben (stof)"@nl ;
        owl:onProperty pplan:hasInputVar ;
        owl:someValuesFrom pplan:Variable ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces mag minstens één outputvariabele hebben (stof)"@nl ;
        owl:onProperty pplan:hasOutputVar ;
        owl:someValuesFrom pplan:Variable ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een proces kan deel uitmaken van een ander proces (hiërarchie)"@nl ;
        owl:onProperty pplan:isStepOfPlan ; 
        owl:someValuesFrom :Proces ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:ProcesVariabele a owl:Class ;
    rdfs:label "Proces variabele"@nl ;
    rdfs:comment "Een proces variabele is een stof die als input of output van een proces dient."@nl ;
    skos:example [ a :ProcesVariabele ;
        rdfs:label "Meel"@nl ;
        dct:type [ a prov:Entity ;
            rdfs:label "Stof"@nl
        ] ;
    ] ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/procesvariabele/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf pplan:Variable ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces variabele moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces variabele kan een typering hebben via dct:type"@nl ;
        owl:onProperty dct:type ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces variabele kan een eenheid hebben"@nl ;
        owl:onProperty qudt:hasUnit ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een proces variabele kan een waarde hebben"@nl ;
        owl:onProperty qudt:numericValue ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] .
    
:Installatie a owl:Class ;
    rdfs:label "Installatie"@nl ;
    rdfs:comment "Een installatie is een verzameling van apparatuur en infrastructuur op een bepaalde locatie die een specifieke functie vervult."@nl ;
    skos:example [ a :Installatie ;
        rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl ;
        dct:created "2020-01-01T00:00:00"^^xsd:dateTime ;
        dct:issued "2020-01-01"^^xsd:date ;
        dct:valid "2030-12-31"^^xsd:date ;
        adms:status :Actief ;
        sosa:isHostedBy [ a :ExploitatieLocatie ;
            rdfs:label "Cementfabriek Antwerpen"@nl
        ]
    ] ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/installatie/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf ogc:SpatialObjectCollection, ssn:System, prov:Agent ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie heeft externe identificaties (optioneel)"@nl ;
        owl:onProperty adms:identifier ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een installatie kan als systeem meerdere objecten bevatten; dit is optioneel, want een installatie kan ook (nog) geen sub-systemen hebben"@nl ;
        owl:onProperty ssn:hasSubSystem ; 
        owl:someValuesFrom ssn:System ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie moet een creatie datum hebben"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie moet een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie moet onderdeel van een locatie zijn"@nl ;
        owl:onProperty sosa:isHostedBy ;
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie moet een enkele status hebben"@nl ;
        owl:onProperty adms:status ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een installatie locatie kan afgeleid zijn van een andere installatie (bijvoorbeeld wanneer een vestiging verkocht is en de locatie hergebruikt wordt)"@nl ;
        owl:onProperty prov:wasDerivedFrom ;
        owl:someValuesFrom :Installatie ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Emissiepunt a owl:Class ;
    rdfs:label "Emissiepunt"@nl ;
    rdfs:comment "Een emissiepunt is een specifiek punt waar stoffen de installatie verlaten en in de omgeving worden uitgestoten."@nl ;
    rdfs:subClassOf ogc:SpatialObject, ssn:System, prov:Agent ;
    skos:example [ a :Emissiepunt ;
        rdfs:label "Schouw 1 Cementfabriek Antwerpen"@nl ;
        dct:issued "2020-01-01"^^xsd:date ;
        dct:valid "2030-12-31"^^xsd:date ;
        sosa:isHostedBy [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ] ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4025 51.2194)"^^ogc:wktLiteral
        ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt is verschillend van een onttrekkingspunt (disjoint)"@nl ;
        owl:disjointWith :Onttrekkingspunt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt kan een typering hebben via dct:type"@nl ;
        owl:onProperty dct:type ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt moet een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt moet een creatie datum hebben"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt kan een status hebben"@nl ;
        owl:onProperty adms:status ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/emissiepunt/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een emissiepunt moet gekoppeld zijn aan een exploitatie locatie"@nl ;
        owl:onProperty sosa:isHostedBy ; 
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een emissiepunt mag max 1 geometrie hebben"@nl ;
        owl:onProperty ogc:hasGeometry ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Onttrekkingspunt a owl:Class ;
    rdfs:label "Onttrekkingspunt"@nl ;
    rdfs:comment "Een onttrekkingspunt is een punt waar grondstoffen worden gewonnen of bemonsterd (onttrekking)."@nl ;
    rdfs:subClassOf ogc:SpatialObject, ssn:System, prov:Agent ;
    skos:example [ a :Onttrekkingspunt ;
        rdfs:label "Onttrekking 1"@nl
    ] ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/onttrekkingspunt/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een Onttrekkingspunt moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een onttrekkingspunt is verschillend van een emissiepunt (disjoint)"@nl ;
        owl:disjointWith :Emissiepunt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een onttrekkingspunt kan een typering hebben via dct:type"@nl ;
        owl:onProperty dct:type ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een onttrekkingspunt moet een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een onttrekkingspunt kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een onttrekkingspunt moet een creatie datum hebben"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een onttrekkingspunt kan een status hebben"@nl ;
        owl:onProperty adms:status ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een onttrekkingspunt moet gekoppeld zijn aan een exploitatie locatie"@nl ;
        owl:onProperty sosa:isHostedBy ; 
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een onttrekkingspunt mag max 1 geometrie hebben"@nl ;
        owl:onProperty ogc:hasGeometry ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .
    
:AbstractEmissiepunt a owl:Class ;
    rdfs:label "Abstract Emissiepunt"@nl ;
    rdfs:comment "Een abstract emissiepunt is een conceptueel emissiepunt dat niet noodzakelijk een vaste locatie heeft, maar wel een functionele rol vervult in het proces."@nl ;
    skos:example [ a :AbstractEmissiepunt ;
        rdfs:label "Gebouw uitstootpunt"@nl ;
        dct:issued "2020-01-01"^^xsd:date ;
        dct:valid "2030-12-31"^^xsd:date ;
        sosa:isHostedBy [ a :ExploitatieLocatie ;
            rdfs:label "Cementfabriek Antwerpen"@nl
        ]
    ] ;
    rdfs:subClassOf :Emissiepunt .
    
:Schouw a owl:Class ;
    rdfs:label "Schouw"@nl ;
    rdfs:comment "Een schouw is een specifiek type emissiepunt dat wordt gebruikt voor de uitstoot van gassen en dampen."@nl ;
    skos:example [ a :Schouw ;
        rdfs:label "Schouw 1 Cementfabriek Antwerpen"@nl ;
        dbo:diameter "2.5"^^xsd:float ;
        dbo:height "30.0"^^xsd:float ;
        sosa:isHostedBy [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ] ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4025 51.2194)"^^ogc:wktLiteral
        ]
    ] ;
    rdfs:subClassOf :Emissiepunt ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een schouw heeft een diameter en hoogte"@nl ;
        owl:onProperty dbo:diameter ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty dbo:height ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Grondwaterput a owl:Class ;
    rdfs:label "Grondwaterput"@nl ;
    rdfs:comment "Een grondwaterput is een fysieke put (boring) die toegang geeft tot het grondwater; wordt gebruikt voor onttrekking of bemonstering."@nl ;
    rdfs:subClassOf :Onttrekkingspunt ;
    skos:example [ a :Grondwaterput ;
        rdfs:label "Grondwaterput 1 Cementfabriek Antwerpen"@nl ;
        dbo:depth "15.0"^^xsd:float ;
        sosa:isHostedBy [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ] ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4020 51.2190)"^^ogc:wktLiteral
        ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een grondwaterput heeft een diepte"@nl ;
        owl:onProperty dbo:depth ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Lozingspunt a owl:Class ;
    rdfs:label "Lozingspunt"@nl ;
    rdfs:comment "Een lozingspunt is een specifiek punt waar vloeistoffen of afvalstoffen de installatie verlaten en in de omgeving worden geloosd."@nl ;
    rdfs:subClassOf :Emissiepunt ;
    skos:example [ a :Lozingspunt ;
        rdfs:label "Lozingspunt 1 Cementfabriek Antwerpen"@nl ;
        sosa:isHostedBy [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ] ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4030 51.2200)"^^ogc:wktLiteral
        ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een lozingspunt kan een diepte hebben"@nl ;
        owl:onProperty dbo:depth ; 
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Meetpunt a owl:Class ;
    rdfs:label "Meetpunt"@nl ;
    rdfs:comment "Een meetpunt is een specifiek punt waar metingen worden uitgevoerd om de kwaliteit van de uitstoot of de omgeving te controleren."@nl ;
    rdfs:subClassOf ogc:SpatialObject, ssn:System, prov:Agent ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/meetpunt/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    skos:example [ a :Meetpunt ;
        rdfs:label "Meetpunt Luchtkwaliteit Schouw 1"@nl ;
        dct:created "2020-01-01T00:00:00"^^xsd:dateTime ;
        dct:issued "2020-01-01"^^xsd:date ;
        dct:valid "2030-12-31"^^xsd:date ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4026 51.2195)"^^ogc:wktLiteral
        ] 
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt is verschillend van een emissiepunt (disjoint)"@nl ;
        owl:disjointWith :Emissiepunt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt is verschillend van een onttrekkingspunt (disjoint)"@nl ;
        owl:disjointWith :Onttrekkingspunt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt kan een typering hebben via dct:type"@nl ;
        owl:onProperty dct:type ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt moet een creatie datum hebben"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt moet een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt moet een enkele status hebben"@nl ;
        owl:onProperty adms:status ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt heeft externe identificaties (optioneel)"@nl ;
        owl:onProperty adms:identifier ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een meetpunt mag max 1 geometrie hebben. TODO MOGELIJK VERPLICHT"@nl ;
        owl:onProperty ogc:hasGeometry ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Apparaat a owl:Class ;
    rdfs:label "Apparaat"@nl ;
    rdfs:comment "Een apparaat is een specifiek onderdeel van een installatie dat een bepaalde functie vervult binnen de installatie."@nl ;
    skos:example [ a :Apparaat ;
        rdfs:label "Filterinstallatie Schouw 1"@nl ;
        dct:created "2020-01-01T00:00:00"^^xsd:dateTime ;
        dct:issued "2020-01-01"^^xsd:date ;
        dct:valid "2030-12-31"^^xsd:date ;
        sosa:isHostedBy [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ]
    ] ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/apparaat/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf ogc:SpatialObject, ssn:System, prov:Agent ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een apparaat moet een creatie datum hebben"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een apparaat moet een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een apparaat kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een apparaat moet gekoppeld zijn aan exact één exploitatie locatie"@nl ;
        owl:onProperty sosa:isHostedBy ; 
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een apparaat moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een apparaat mag max 1 geometrie hebben"@nl ;
        owl:onProperty ogc:hasGeometry ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Observatie a owl:Class ;
    rdfs:label "Observatie"@nl ;
    rdfs:comment "Een observatie is een waarneming of meting die is uitgevoerd op een meetpunt."@nl ;
    rdfs:subClassOf sosa:Observation ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/observatie/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        rdfs:comment "Een observatie moet gekoppeld zijn aan exact één meetpunt of installatie"@nl ;
        owl:onProperty sosa:hasFeatureOfInterest ; 
        owl:someValuesFrom :Meetpunt ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Exploitant a owl:Class ;
    rdfs:label "Exploitant"@nl ;
    rdfs:comment "Een exploitant is een entiteit die een milieuimpact heeft."@nl ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/exploitant/{scheme}/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "scheme" ; hydra:property dct:type ; hydra:required true ] ,
                      [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf prov:Agent ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant kan een creatie datum hebben"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant kan een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant moet een organisatie of persoon zijn maar niet beide tegelijk"@nl ;
        owl:onProperty dct:type ;
        owl:someValuesFrom ( org:Organization foaf:Person ) ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant heeft een verzendadres dat kan afwijken van het vestigingsadres"@nl ;
        owl:onProperty locn:address ;
        owl:someValuesFrom locn:Address ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Contactpersoon a owl:Class ;
    rdfs:label "Exploitant Contactpersoon"@nl ;
    rdfs:comment "Een exploitant contactpersoon is een persoon die optreedt als contactpersoon voor een exploitant."@nl ;
    rdfs:subClassOf foaf:Person ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/contactpersoon/{id}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "id" ; hydra:property adms:identifier ; hydra:required true ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon moet gekoppeld zijn aan exact één exploitant"@nl ;
        owl:onProperty org:memberOf ;
        owl:someValuesFrom :Exploitant ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon kan een e-mailadres hebben"@nl ;
        owl:onProperty foaf:mbox ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon kan een telefoonnummer hebben"@nl ;
        owl:onProperty foaf:phone ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon moet een functie hebben binnen de organisatie"@nl ;
        owl:onProperty org:hasRole ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon kan een adres hebben"@nl ;
        owl:onProperty locn:address ;
        owl:someValuesFrom locn:Address ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon kan een creatie datum hebben"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon kan een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitant contactpersoon moet een naam hebben"@nl ;
        owl:onProperty foaf:name ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:ExploitatieLocatie a owl:Class ;
    rdfs:label "Exploitatie Locatie"@nl ;
    rdfs:comment "Een exploitatie locatie is een specifieke geografische locatie waar een exploitant zijn processen uitvoert."@nl ;
    hydra:search [ a hydra:IriTemplate ;
        hydra:template "https://data.riepr.omgeving.vlaanderen.be/id/exploitatielocatie/{source}/{geoId}"^^hydra:Rfc6570Template ;
        hydra:mapping [ hydra:variable "source" ; hydra:property dct:source ; hydra:required true ] ,
                      [ hydra:variable "geoId" ; hydra:property owl:sameAs ; hydra:required true ]
    ] ;
    rdfs:subClassOf ogc:Feature, prov:Entity, sosa:Platform ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie moet een datum hebben waarop het is ingegeven"@nl ;
        owl:onProperty dct:created ;
        owl:someValuesFrom xsd:dateTime ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie moet een benaming hebben"@nl ;
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie moet een geldigheid start hebben"@nl ;
        owl:onProperty dct:issued ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie kan een geldigheid einde hebben"@nl ;
        owl:onProperty dct:valid ;
        owl:someValuesFrom xsd:date ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie moet gekoppeld zijn aan exact één exploitant"@nl ;
        owl:onProperty prov:wasAttributedTo ;
        owl:someValuesFrom :Exploitant ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie heeft externe identificaties (optioneel)"@nl ;
        owl:onProperty adms:identifier ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie kan overeenkomen met één vestiging (VKBO)"@nl ;
        owl:onProperty prov:hadPrimarySource ;
        owl:someValuesFrom org:Site ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    skos:example [ a :ExploitatieLocatie ;
        rdfs:label "Cementfabriek Antwerpen"@nl ;
        prov:hadPrimarySource [ a org:Site ;
            rdfs:label "VKBO Vestiging Cementfabriek"@nl
        ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie kan optioneel beïnvloed zijn door aan een org:Site of ander type"@nl ;
        owl:onProperty prov:wasInfluencedBy ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie kan afgeleid zijn van een andere exploitatie locatie; bijvoorbeeld wanneer een vestiging verkocht is en de locatie hergebruikt wordt"@nl ;
        owl:onProperty prov:wasDerivedFrom ;
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie moet exact 1 geometrie hebben"@nl ;
        owl:onProperty ogc:hasGeometry ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        rdfs:comment "Een exploitatie locatie kan een adres hebben"@nl ;
        owl:onProperty locn:address ;
        owl:someValuesFrom locn:Address ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

# Proces Procedures
:TransportProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Transport Procedure"@nl ;
    rdfs:comment "Een transport procedure is een specifieke procedure die betrekking heeft op het transport van stoffen binnen of buiten een proces."@nl ;
    rdfs:subClassOf sosa:Procedure .
:VerwerkingsProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Verwerkings Procedure"@nl ;
    rdfs:comment "Een verwerkings procedure is een specifieke procedure die betrekking heeft op de verwerking van stoffen binnen een proces."@nl ;
    rdfs:subClassOf sosa:Procedure .

:VerbruiksProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Verbruiks Procedure"@nl ;
    rdfs:comment "Een verbruiks procedure is een specifieke procedure die betrekking heeft op het transport van grondstoffen binnen een proces."@nl ;
    # Verbruiks procedures zijn het transport van stoffen van buiten naar binnen
    rdfs:subClassOf :TransportProcedure .
:EmissieProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Emissie Procedure"@nl ;
    rdfs:comment "Een emissie procedure is een specifieke procedure die betrekking heeft op het uitstoten of lozen van stoffen aan emissiepunten."@nl ;
    # Emissie procedures zijn het intern transport van stoffen naar emissiepunten
    rdfs:subClassOf :TransportProcedure .

# Meet Procedures
:MeetProcedure a owl:Class ;
    rdfs:label "Meetprocedure"@nl ;
    rdfs:comment "Een meetprocedure is een specifieke procedure die wordt gebruikt om metingen uit te voeren op meetpunten."@nl ;
    rdfs:subClassOf sosa:Procedure .

# --------------------------------------- #
# Object Properties
# --------------------------------------- #
# Object properties worden vermeden waar mogelijk
# Business benamingen worden in concepten vastgelegd

# --------------------------------------- #
# Data Properties
# --------------------------------------- #
# Data properties worden vermeden waar mogelijk
# Business benamingen worden in concepten vastgelegd

# --------------------------------------- #
# Individuals
# --------------------------------------- #
# Procedure concepten voor ssn:implements
:apparaatVerwerkingsProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Apparaatverwerkingsproces"@nl ;
    rdfs:comment "Een apparaatverwerkingsproces is een specifieke procedure die betrekking heeft op de verwerking van stoffen binnen een apparaat."@nl ;
    skos:broader :VerwerkingsProcedure ;
    skos:prefLabel "Apparaatverwerkingsproces"@nl .
:installatieVerwerkingsProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Installatieverwerkingsproces"@nl ;
    rdfs:comment "Een installatieverwerkingsproces is een specifieke procedure die betrekking heeft op de verwerking van stoffen binnen een installatie."@nl ;
    skos:broader :VerwerkingsProcedure ;
    skos:prefLabel "Installatieverwerkingsproces"@nl .
:overbrengingsProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Overbrengingsproces"@nl ;
    rdfs:comment "Een overbrengingsproces is een specifieke procedure die betrekking heeft op het transport van stoffen via externe overbrenging."@nl ;
    skos:broader :TransportProcedure ;
    skos:prefLabel "Overbrengingsproces"@nl .
:lozingsProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Lozingsproces"@nl ;
    rdfs:comment "Een lozingsproces is een specifieke procedure die betrekking heeft op het lozen van stoffen aan een emissiepunt in grondwater."@nl ;
    skos:broader :EmissieProcedure ;
    skos:prefLabel "Lozingsproces"@nl .
:uitstootProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Uitstootproces"@nl ;
    rdfs:comment "Een uitstootproces is een specifieke procedure die betrekking heeft op het uitstoten van stoffen aan een emissiepunt in de lucht."@nl ;
    skos:broader :EmissieProcedure ;
    skos:prefLabel "Uitstootproces"@nl .
:electriciteitsVerbruikProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Elektriciteitsverbruikproces"@nl ;
    rdfs:comment "Een elektriciteitsverbruikproces is een specifieke procedure die betrekking heeft op het verbruik van elektriciteit binnen een proces."@nl ;
    skos:broader :VerbruiksProcedure ;
    skos:prefLabel "Elektriciteitsverbruikproces"@nl .
:waterVerbruikProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Waterverbruikproces"@nl ;
    rdfs:comment "Een waterverbruikproces is een specifieke procedure die betrekking heeft op het verbruik van water binnen een proces."@nl ;
    skos:broader :VerbruiksProcedure ;
    skos:prefLabel "Waterverbruikproces"@nl .
:brandstofVerbruikProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Brandstofverbruikproces"@nl ;
    rdfs:comment "Een brandstofverbruikproces is een specifieke procedure die betrekking heeft op het verbruik van brandstof binnen een proces."@nl ;
    skos:broader :VerbruiksProcedure ;
    skos:prefLabel "Brandstofverbruikproces"@nl .
:eindproductProductieProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Eindproduct productieproces"@nl ;
    rdfs:comment "Een eindproduct productieproces is een specifieke procedure die betrekking heeft op de productie van eindproducten als output van een proces."@nl ;
    skos:broader :VerwerkingsProcedure ;
    skos:prefLabel "Eindproduct productieproces"@nl .
:meetProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Meetproces"@nl ;
    rdfs:comment "Een meetproces is een specifieke procedure die betrekking heeft op het uitvoeren van metingen op meetpunten."@nl ;
    skos:broader :MeetProcedure ;
    skos:prefLabel "Meetproces"@nl .

# Status concepten voor adms:status
:Actief a skos:Concept ;
    rdfs:label "Actief"@nl ;
    rdfs:comment "De actieve status geeft aan dat een entiteit momenteel in gebruik is."@nl ;
    skos:prefLabel "Actief"@nl ;
    rdfs:equivalentClass <http://purl.org/adms/status/Completed> .
:Inactief a skos:Concept ;
    rdfs:label "Inactief"@nl ;
    rdfs:comment "De inactieve status geeft aan dat een entiteit momenteel niet in gebruik is."@nl ;
    skos:prefLabel "Inactief"@nl ;
    rdfs:equivalentClass <http://purl.org/adms/status/Deprecated> .
:Gesloten a skos:Concept ;
    rdfs:label "Gesloten"@nl ;
    rdfs:comment "De gesloten status geeft aan dat een entiteit permanent buiten gebruik is gesteld."@nl ;
    skos:prefLabel "Gesloten"@nl ;
    rdfs:equivalentClass <http://purl.org/adms/status/Withdrawn> .
:Voorgesteld a skos:Concept ;
    rdfs:label "Voorgesteld"@nl ;
    rdfs:comment "De voorgestelde status geeft aan dat een entiteit is voorgesteld door de overheid maar nog niet bevestigd is."@nl ;
    skos:prefLabel "Voorgesteld"@nl ;
    rdfs:equivalentClass <http://purl.org/adms/status/UnderDevelopment> .

# --------------------------------------- #
# Axioms
# --------------------------------------- #
# Proces met een emissieprocedure moet worden toegeschreven aan een emissiepunt (agent)
[ a owl:Class ;
    owl:intersectionOf ( :Proces [ a owl:Restriction ;
        owl:onProperty dct:type ;
        owl:someValuesFrom :EmissieProcedure
    ] )
] rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty ssn:implementedBy ;
    owl:someValuesFrom :Emissiepunt
] .

# Proces met een apparaatverwerkingsproces moet worden toegeschreven aan een apparaat (agent)
[ a owl:Class ;
    owl:intersectionOf ( :Proces [ a owl:Restriction ;
        owl:onProperty dct:type ;
        owl:someValuesFrom :apparaatVerwerkingsProces
    ] )
] rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty ssn:implementedBy ;
    owl:someValuesFrom :Apparaat
] .

# Proces met een overbrengingsproces moet stoffen transporteren
[ a owl:Class ;
    owl:intersectionOf ( :Proces [ a owl:Restriction ;
        owl:onProperty dct:type ;
        owl:someValuesFrom :overbrengingsProces
    ] )
] rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty pplan:hasOutputVar ;
    owl:someValuesFrom pplan:Variable
] .

# Proces met meetprocedure moet attributedTo een meetpunt
[ a owl:Class ;
    owl:intersectionOf ( :Proces [ a owl:Restriction ;
        owl:onProperty dct:type ;
        owl:someValuesFrom :meetProces
    ] )
] rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty ssn:implementedBy ;
    owl:someValuesFrom :Meetpunt
] .

