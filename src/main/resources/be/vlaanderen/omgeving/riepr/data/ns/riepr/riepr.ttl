@prefix :       <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix pplan:  <http://purl.org/net/p-plan#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix ogc:    <http://www.opengis.net/ont/geosparql#> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix ssn:    <http://www.w3.org/ns/ssn/> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix concept: <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix schema: <http://schema.org/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix dct:    <http://purl.org/dc/terms/> .

# --------------------------------------- #
# Ontology definition
# --------------------------------------- #

<> a owl:Ontology ;
    dct:title "RIE-IEPR Ontologie"@nl ;
    dct:title "RIE-IEPR Ontology"@en ;
    dct:creator "Vlaamse overheid - Departement Omgeving"@nl ;
    dct:creator "Flemish Government - Department of Environment"@en ;
    dct:publisher "Vlaamse overheid - Departement Omgeving"@nl ;
    dct:publisher "Flemish Government - Department of Environment and Spatial Development"@en ;
    dct:description "De RIE-IEPR ontologie definieert een datamodel voor het beschrijven van industriele activiteiten, installaties, emissiepunten, meetpunten, apparaten, observaties, exploitanten en exploitatie locaties binnen het kader van het RIE-IEPR systeem."@nl ;
    dct:description "The RIE-IEPR ontology defines a data model for describing industrial activities, installations, emission points, measurement points, devices, observations, operators and operation locations within the context of the RIE-IEPR system."@en ;
    dct:license <https://data.vlaanderen.be/id/licentie/modellicentie-gratis-hergebruik/v1.0> ;
    dct:issued "2026-01-27"^^xsd:date ;
    dct:modified "2026-01-27"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "riepr" ;
    vann:preferredNamespaceUri "https://data.riepr.omgeving.vlaanderen.be/ns/riepr#" ;
    rdfs:seeAlso <https://omgeving.vlaanderen.be> ;
    foaf:homepage <https://github.com/milieuinfo/RIE-IEPR> ;
    owl:imports prov: , pplan: , ogc: , sosa: , ssn: , dbo: , org: , skos: , foaf: , schema: .

# --------------------------------------- #
# Classes
# --------------------------------------- #

:Activiteit a owl:Class ;
    rdfs:label "Activiteit"@nl ;
    rdfs:comment "Een (milieu)activiteit is een door de gebruiker in te vullen industriele activiteit op een bepaalde locatie bestaande uit meerdere procedurestappen die de industriele activiteit beschrijven."@nl ;
    skos:example [ a :Activiteit ;
        rdfs:label "Productie van cement in een fabriek te Antwerpen"@nl ;
        dct:created "2024-01-15T10:00:00"^^xsd:dateTime ;
        dct:valid "2020-01-01/2030-12-31"^^xsd:string ;
        prov:atLocation [ a :ExploitatieLocatie ;
            rdfs:label "Cementfabriek Antwerpen"@nl
        ]
    ] ;
    rdfs:subClassOf pplan:Plan, dbo:Project ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een activiteit moet een datum hebben waarop het is ingegeven
        owl:onProperty dct:created ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een activiteit moet een benaming hebben
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een activiteit moet een geldigheid hebben
        owl:onProperty dct:valid ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een activiteit vindt plaats op een enkele exploitatie locatie
        owl:onProperty prov:atLocation ;
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:ActiviteitStap a owl:Class ;
    rdfs:label "Activiteit Stap"@nl ;
    rdfs:comment "De activiteit stap is een individuele of meervoudige stap binnen een activiteit."@nl ;
    skos:example [ a :ActiviteitStap ;
        rdfs:label "Verwerking van grondstoffen"@nl ;
        ssn:implements [ a :VerwerkingsProcedure ]
    ] ;
    rdfs:subClassOf pplan:Step ;
    owl:equivalentClass [ a owl:Class ;
        # Stap kan een plan op zichzelf zijn (multi step)
        owl:unionOf ( pplan:Step pplan:MultiStep ) 
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een stap kan een geldigheid hebben
        owl:onProperty dct:valid ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    # Stap (als superclass van prov:Activiteit) kan gebruikmaken van een emissiepunt of apparaat
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty prov:used ; 
        owl:someValuesFrom :Emissiepunt ; 
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty prov:used ; 
        owl:someValuesFrom :Apparaat ; 
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] ;
    # Stap kan een procedure implementeren (optioneel)
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty ssn:implements ; 
        owl:someValuesFrom sosa:Procedure ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] .
    
:Installatie a owl:Class ;
    rdfs:label "Installatie"@nl ;
    rdfs:comment "Een installatie is een verzameling van apparatuur en infrastructuur op een bepaalde locatie die een specifieke functie vervult."@nl ;
    skos:example [ a :Installatie ;
        rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl ;
        dct:valid "2020-01-01/2030-12-31"^^xsd:string ;
        prov:atLocation [ a :ExploitatieLocatie ;
            rdfs:label "Cementfabriek Antwerpen"@nl
        ]
    ] ;
    rdfs:subClassOf ogc:SpatialObjectCollection, ssn:System ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een installatie moet een benaming hebben
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een installatie moet een geldigheid hebben
        owl:onProperty dct:valid ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een installatie moet onderdeel van een locatie zijn
        owl:onProperty prov:atLocation ;
        owl:someValuesFrom :ExploitatieLocatie ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:IEPRInstallatie a owl:Class ;
    rdfs:label "IEPR Installatie"@nl ;
    rdfs:comment "Een IEPR installatie is een specifieke type installatie die valt onder de regelgeving van het IEPR (Industrial Emission Portal Regulation)."@nl ;
    rdfs:subClassOf :Installatie .
:GPBVInstallatie a owl:Class ;
    rdfs:label "GPBV Installatie"@nl ;
    rdfs:comment "Een GPBV installatie is een specifieke type installatie die valt onder de regelgeving van het GPBV (Geïntegreerde preventie en bestrijding van verontreiniging)."@nl ;
    rdfs:subClassOf :Installatie .

:Emissiepunt a owl:Class ;
    rdfs:label "Emissiepunt"@nl ;
    rdfs:comment "Een emissiepunt is een specifiek punt waar stoffen de installatie verlaten en in de omgeving worden uitgestoten."@nl ;
    rdfs:subClassOf ogc:SpatialObject ;
    skos:example [ a :Emissiepunt ;
        rdfs:label "Schouw 1 Cementfabriek Antwerpen"@nl ;
        prov:atLocation [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ] ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4025 51.2194)"^^ogc:wktLiteral
        ]
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        # Een emissiepunt moet gekoppeld zijn aan exact één installatie of exploitatie locatie
        owl:onProperty prov:atLocation ; 
        owl:someValuesFrom ( :Installatie :ExploitatieLocatie ) ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        # Een emissiepunt moet een benaming hebben
        owl:onProperty rdfs:label ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Schouw a owl:Class ;
    rdfs:label "Schouw"@nl ;
    rdfs:comment "Een schouw is een specifiek type emissiepunt dat wordt gebruikt voor de uitstoot van gassen en dampen."@nl ;
    skos:example [ a :Schouw ;
        rdfs:label "Schouw 1 Cementfabriek Antwerpen"@nl ;
        dbo:diameter "2.5"^^xsd:float ;
        dbo:height "30.0"^^xsd:float ;
        prov:atLocation [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ] ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4025 51.2194)"^^ogc:wktLiteral
        ]
    ] ;
    rdfs:subClassOf :Emissiepunt ;
    # Een schouw heeft een diameter en hoogte
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty dbo:diameter ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty dbo:height ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Grondwaterput a owl:Class ;
    rdfs:label "Grondwaterput"@nl ;
    rdfs:comment "Een grondwaterput is een specifiek type emissiepunt dat wordt gebruikt voor de uitstoot van stoffen in het grondwater."@nl ;
    skos:example [ a :Grondwaterput ;
        rdfs:label "Grondwaterput 1 Cementfabriek Antwerpen"@nl ;
        dbo:depth "15.0"^^xsd:float ;
        prov:atLocation [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ] ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4020 51.2190)"^^ogc:wktLiteral
        ]
    ] ;
    rdfs:subClassOf :Emissiepunt ;
    # Een grondwaterput heeft een diepte
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty dbo:depth ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Meetpunt a owl:Class ;
    rdfs:label "Meetpunt"@nl ;
    rdfs:comment "Een meetpunt is een specifiek punt waar metingen worden uitgevoerd om de kwaliteit van de uitstoot of de omgeving te controleren."@nl ;
    skos:example [ a :Meetpunt ;
        rdfs:label "Meetpunt Luchtkwaliteit Schouw 1"@nl ;
        ogc:hasGeometry [ a ogc:Geometry ;
            ogc:asWKT "POINT(4.4026 51.2195)"^^ogc:wktLiteral
        ] ;
        sosa:isProxyFor [ a :Emissiepunt ;
            rdfs:label "Schouw 1 Cementfabriek Antwerpen"@nl
        ]
    ] ;
    rdfs:subClassOf ogc:SpatialObject ;
    # Een meetpunt moet een proxy zijn voor een emissiepunt OF een activiteit stap
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty sosa:isProxyFor ; 
        owl:someValuesFrom ( :Emissiepunt :ActiviteitStap ) ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Apparaat a owl:Class ;
    rdfs:label "Apparaat"@nl ;
    rdfs:comment "Een apparaat is een specifiek onderdeel van een installatie dat een bepaalde functie vervult binnen de installatie."@nl ;
    skos:example [ a :Apparaat ;
        rdfs:label "Filterinstallatie Schouw 1"@nl ;
        prov:atLocation [ a :Installatie ;
            rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl
        ]
    ] ;
    rdfs:subClassOf ogc:SpatialObject, ssn:System ;
    rdfs:subClassOf [ a owl:Restriction ; 
        # Een apparaat moet gekoppeld zijn aan exact één installatie of exploitatie locatie
        owl:onProperty prov:atLocation ; 
        owl:someValuesFrom ( :Installatie :ExploitatieLocatie ) ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ; 
        # Een apparaat moet een benaming hebben
        owl:onProperty rdfs:label ; 
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Observatie a owl:Class ;
    rdfs:label "Observatie"@nl ;
    rdfs:comment "Een observatie is een waarneming of meting die is uitgevoerd op een meetpunt."@nl ;
    rdfs:subClassOf sosa:Observation ;
    # Een observatie moet gekoppeld zijn aan exact één meetpunt of installatie
    rdfs:subClassOf [ a owl:Restriction ; 
        owl:onProperty sosa:hasFeatureOfInterest ; 
        owl:someValuesFrom ( :Meetpunt :Installatie ) ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] .

:Exploitant a owl:Class ;
    rdfs:label "Exploitant"@nl ;
    rdfs:comment "Een exploitant is een entiteit die een milieuimpact heeft."@nl ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een exploitant kan een geldigheid hebben
        owl:onProperty dct:valid ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty rdf:type ;
        # Een exploitant moet een organisatie of persoon zijn
        # maar niet beide tegelijk
        owl:someValuesFrom ( org:Organization foaf:Person ) ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een exploitant moet een benaming hebben
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .

:ExploitatieLocatie a owl:Class ;
    rdfs:label "Exploitatie Locatie"@nl ;
    rdfs:comment "Een exploitatie locatie is een specifieke geografische locatie waar een exploitant zijn activiteiten uitvoert."@nl ;
    rdfs:subClassOf ogc:SpatialObjectCollection, prov:Entity ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een exploitatie locatie moet gekoppeld zijn aan exact één exploitant
        owl:onProperty prov:atLocation ;
        owl:someValuesFrom :Exploitant ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een exploitatie locatie moet een benaming hebben
        owl:onProperty rdfs:label ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een exploitatie locatie kan overeenkomen met één vestigingen
        owl:onProperty prov:hadPrimarySource ;
        owl:someValuesFrom org:Site ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        # Een exploitatie locatie kan optioneel beinvloed zijn door aan een org:Site of ander type
        owl:onProperty prov:wasInfluencedBy ;
        owl:minCardinality "0"^^xsd:nonNegativeInteger
    ] .

# Procedure types as subclasses of sosa:Procedure
:TransportProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Transport Procedure"@nl ;
    rdfs:comment "Een transport procedure is een specifieke procedure die betrekking heeft op het transport van stoffen binnen of buiten een activiteit."@nl ;
    rdfs:subClassOf sosa:Procedure .
:VerbruiksProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Verbruiks Procedure"@nl ;
    rdfs:comment "Een verbruiks procedure is een specifieke procedure die betrekking heeft op het verbruik van grondstoffen binnen een activiteit."@nl ;
    rdfs:subClassOf sosa:Procedure .
:VerwerkingsProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Verwerkings Procedure"@nl ;
    rdfs:comment "Een verwerkings procedure is een specifieke procedure die betrekking heeft op de verwerking van stoffen binnen een activiteit."@nl ;
    rdfs:subClassOf sosa:Procedure .
:EmissieProcedure a owl:Class, skos:ConceptScheme ;
    rdfs:label "Emissie Procedure"@nl ;
    rdfs:comment "Een emissie procedure is een specifieke procedure die betrekking heeft op het uitstoten of lozen van stoffen aan emissiepunten."@nl ;
    rdfs:subClassOf sosa:Procedure .

# --------------------------------------- #
# Object Properties
# --------------------------------------- #

# --------------------------------------- #
# Data Properties
# --------------------------------------- #

# --------------------------------------- #
# Individuals
# --------------------------------------- #
:apparaatVerwerkingsProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Apparaatverwerkingsproces"@nl ;
    rdfs:comment "Een apparaatverwerkingsproces is een specifieke procedure die betrekking heeft op de verwerking van stoffen binnen een apparaat."@nl ;
    skos:broader :VerwerkingsProcedure ;
    skos:prefLabel "Apparaatverwerkingsproces"@nl .

:overbrengingsProces a skos:Concept ;
    rdfs:label "Overbrengingsproces"@nl ;
    rdfs:comment "Een overbrengingsproces is een specifieke procedure die betrekking heeft op het transport van stoffen via externe overbrenging."@nl ;
    skos:broader :TransportProcedure ;
    skos:prefLabel "Overbrengingsproces"@nl .

:lozingsProces a skos:Concept ;
    rdfs:label "Lozingsproces"@nl ;
    rdfs:comment "Een lozingsproces is een specifieke procedure die betrekking heeft op het lozen van stoffen aan een emissiepunt in grondwater."@nl ;
    skos:broader :EmissieProcedure ;
    skos:prefLabel "Lozingsproces"@nl .

:uitstootProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Uitstootproces"@nl ;
    rdfs:comment "Een uitstootproces is een specifieke procedure die betrekking heeft op het uitstoten van stoffen aan een emissiepunt in de lucht."@nl ;
    skos:broader :EmissieProcedure ;
    skos:prefLabel "Uitstootproces"@nl .

:stoomProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Stoomproces"@nl ;
    rdfs:comment "Een stoomproces is een specifieke procedure die betrekking heeft op het transport van stoffen via stoom binnen een activiteit."@nl ;
    skos:broader :TransportProcedure ;
    skos:prefLabel "Stoomproces"@nl .

:electriciteitsVerbruikProces a skos:Concept, sosa:Procedure ;
    rdfs:label "Elektriciteitsverbruikproces"@nl ;
    rdfs:comment "Een elektriciteitsverbruikproces is een specifieke procedure die betrekking heeft op het verbruik van elektriciteit binnen een activiteit."@nl ;
    skos:broader :VerbruiksProcedure ;
    skos:prefLabel "Elektriciteitsverbruikproces"@nl .

# --------------------------------------- #
# Axioms
# --------------------------------------- #
# ActiviteitStap met een emissieprocedure moet een emissiepunt gebruiken
[ a owl:Class ;
    owl:intersectionOf ( :ActiviteitStap [ a owl:Restriction ;
        owl:onProperty ssn:implements ;
        owl:someValuesFrom :EmissieProcedure
    ] )
] rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty prov:used ;
    owl:someValuesFrom :Emissiepunt
] .

# ActiviteitStap met een apparaatverwerkingsproces moet een apparaat gebruiken
[ a owl:Class ;
    owl:intersectionOf ( :ActiviteitStap [ a owl:Restriction ;
        owl:onProperty ssn:implements ;
        owl:someValuesFrom :apparaatVerwerkingsProces
    ] )
] rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty prov:used ;
    owl:someValuesFrom :Apparaat
] .

# ActiviteitStap met een overbrengingsproces moet stoffen transporteren
# [ a owl:Class ;
#     owl:intersectionOf ( :ActiviteitStap [ a owl:Restriction ;
#         owl:onProperty ssn:implements ;
#         owl:someValuesFrom :overbrengingsProces
#     ] )
# ] rdfs:subClassOf [ a owl:Restriction ;
#     owl:onProperty sosa:observedProperty ;
#     owl:someValuesFrom TBD:TBD
# ] .
