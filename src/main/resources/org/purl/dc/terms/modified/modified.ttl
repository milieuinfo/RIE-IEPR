PREFIX activiteit:                <https://data.omgeving.vlaanderen.be/id/activiteit/>
PREFIX actuele_rubriek:           <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/actuele_rubriek/>
PREFIX actuele_rubriek_klasse:    <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/actuele_rubriek_klasse/>
PREFIX adms:                      <http://www.w3.org/ns/adms#>
PREFIX conc_p:                    <https://data.omgeving.vlaanderen.be/id/concept/procedure/>
PREFIX concept:                   <https://data.omgeving.vlaanderen.be/id/concept/>
PREFIX conceptscheme:             <https://data.omgeving.vlaanderen.be/id/conceptscheme/>
PREFIX cpsv:                      <http://purl.org/vocab/cpsv#>
PREFIX crs:                       <http://www.opengis.net/def/crs/EPSG/0/>
PREFIX dbo:                       <http://dbpedia.org/ontology/>
PREFIX dc:                        <http://purl.org/dc/elements/1.1/>
PREFIX dct:                       <http://purl.org/dc/terms/>
PREFIX eurovoc:                   <http://eurovoc.europa.eu/>
PREFIX frbr:                      <http://purl.org/vocab/frbr/core#>
PREFIX functie_tobe_cascade:      <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/functie_tobe_cascade/>
PREFIX functie_tobe_code:         <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/functie_tobe_code/>
PREFIX geo:                       <http://www.opengis.net/ont/geosparql#>
PREFIX geometry:                  <https://data.omgeving.vlaanderen.be/id/geometry/>
PREFIX handeling_code:            <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/handeling_code/>
PREFIX identificator:             <https://data.omgeving.vlaanderen.be/id/identificator/>
PREFIX identifier:                <https://data.omgeving.vlaanderen.be/id/identifier/>
PREFIX iioa_klasse:               <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/iioa_klasse/>
PREFIX inh:                       <https://data.omgeving.vlaanderen.be/id/inhoud/>
PREFIX juridische_categorie:      <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/>
PREFIX location:                  <https://data.omgeving.vlaanderen.be/id/location/>
PREFIX locn:                      <http://www.w3.org/ns/locn#>
PREFIX m8g:                       <http://data.europa.eu/m8g/>
PREFIX omv:                       <https://data.vlaanderen.be/ns/omgevingsvergunning#>
PREFIX omv_id:                    <https://data.omgeving.vlaanderen.be/id/concept/identifier/>
PREFIX owl:                       <http://www.w3.org/2002/07/owl#>
PREFIX perceel:                   <https://data.vlaanderen.be/ns/perceel#>
PREFIX procedurestap:             <https://data.omgeving.vlaanderen.be/id/procedurestap/>
PREFIX project:                   <https://data.omgeving.vlaanderen.be/id/project/>
PREFIX rdf:                       <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:                      <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rechtssubject:             <https://data.omgeving.vlaanderen.be/id/rechtssubject/>
PREFIX ruimtelijke_eenheid:       <https://data.omgeving.vlaanderen.be/id/ruimtelijke_eenheid/>
PREFIX skos:                      <http://www.w3.org/2004/02/skos/core#>
PREFIX stedenbouwkundig_code:     <https://data.omgeving.vlaanderen.be/id/concept/stedenbouwkundig_code/>
PREFIX stedenbouwkundigtype_code: <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/stedenbouwkundigtype_code/>
PREFIX terreinobjecttype_code:    <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/terreinobjecttype_code/>
PREFIX verkavelingtype_code:      <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/verkavelingtype_code/>
PREFIX verkavelingtype_code2:     <https://data.omgeving.vlaanderen.be/id/concept/verkavelingtype_code/>
PREFIX voorwerp:                  <https://data.omgeving.vlaanderen.be/id/voorwerp/>
PREFIX voorwerptype_code:         <https://data.omgeving.vlaanderen.be/id/concept/juridische_categorie/voorwerptype_code/>
PREFIX xsd:                       <http://www.w3.org/2001/XMLSchema#>
PREFIX zaak:                      <https://data.omgeving.vlaanderen.be/id/zaak/>
PREFIX zaakhandeling:             <https://data.omgeving.vlaanderen.be/id/zaakhandeling/>

dct:valid  rdf:type         rdf:Property;
        rdfs:comment        "Date (often a range) of validity of a resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Valid"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:type  rdf:type          rdf:Property;
        rdfs:comment        "The nature or genre of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Type"@en;
        rdfs:subPropertyOf  dc:type;
        dct:description     "Recommended practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [[DCMI-TYPE](http://dublincore.org/documents/dcmi-type-vocabulary/)]. To describe the file format, physical medium, or dimensions of the resource, use the property Format."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:title  rdf:type         rdf:Property;
        rdfs:comment        "A name given to the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Title"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dc:title;
        dct:issued          "2008-01-14"^^xsd:date .

dct:temporal  rdf:type      rdf:Property;
        rdfs:comment        "Temporal characteristics of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Temporal Coverage"@en;
        rdfs:subPropertyOf  dct:coverage , dc:coverage;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:PeriodOfTime;
        dct:issued          "2000-07-11"^^xsd:date .

dct:tableOfContents  rdf:type  rdf:Property;
        rdfs:comment        "A list of subunits of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Table Of Contents"@en;
        rdfs:subPropertyOf  dct:description , dc:description;
        dct:issued          "2000-07-11"^^xsd:date .

dct:subject  rdf:type       rdf:Property;
        rdfs:comment        "A topic of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Subject"@en;
        rdfs:subPropertyOf  dc:subject;
        dct:description     "Recommended practice is to refer to the subject with a URI. If this is not possible or feasible, a literal value that identifies the subject may be provided. Both should preferably refer to a subject in a controlled vocabulary."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:spatial  rdf:type       rdf:Property;
        rdfs:comment        "Spatial characteristics of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Spatial Coverage"@en;
        rdfs:subPropertyOf  dct:coverage , dc:coverage;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Location;
        dct:issued          "2000-07-11"^^xsd:date .

dct:source  rdf:type        rdf:Property;
        rdfs:comment        "A related resource from which the described resource is derived."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Source"@en;
        rdfs:subPropertyOf  dct:relation , dc:source;
        dct:description     "This property is intended to be used with non-literal values. The described resource may be derived from the related resource in whole or in part. Best practice is to identify the related resource by means of a URI or a string conforming to a formal identification system."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:rightsHolder  rdf:type  rdf:Property;
        rdfs:comment      "A person or organization owning or managing rights over the resource."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Rights Holder"@en;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Agent;
        dct:description   "Recommended practice is to refer to the rights holder with a URI. If this is not possible or feasible, a literal value that identifies the rights holder may be provided."@en;
        dct:issued        "2004-06-14"^^xsd:date .

dct:rights  rdf:type        rdf:Property;
        rdfs:comment        "Information about rights held in and over the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Rights"@en;
        rdfs:subPropertyOf  dc:rights;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:RightsStatement;
        dct:description     "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights.  Recommended practice is to refer to a rights statement with a URI.  If this is not possible or feasible, a literal value (name, label, or short text) may be provided."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:requires  rdf:type      rdf:Property;
        rdfs:comment        "A related resource that is required by the described resource to support its function, delivery, or coherence."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Requires"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Is Required By."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:replaces  rdf:type      rdf:Property;
        rdfs:comment        "A related resource that is supplanted, displaced, or superseded by the described resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Replaces"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Is Replaced By."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:relation  rdf:type      rdf:Property;
        rdfs:comment        "A related resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Relation"@en;
        rdfs:subPropertyOf  dc:relation;
        dct:description     "Recommended practice is to identify the related resource by means of a URI.  If this is not possible or feasible, a string conforming to a formal identification system may be provided."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:references  rdf:type    rdf:Property;
        rdfs:comment        "A related resource that is referenced, cited, or otherwise pointed to by the described resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "References"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Is Referenced By."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:publisher  rdf:type     rdf:Property;
        rdfs:comment        "An entity responsible for making the resource available."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Publisher"@en;
        rdfs:subPropertyOf  dc:publisher;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Agent;
        dct:issued          "2008-01-14"^^xsd:date .

dct:provenance  rdf:type  rdf:Property;
        rdfs:comment      "A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Provenance"@en;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:ProvenanceStatement;
        dct:description   "The statement may include a description of any changes successive custodians made to the resource."@en;
        dct:issued        "2004-09-20"^^xsd:date .

dct:modified  rdf:type      rdf:Property;
        rdfs:comment        "Date on which the resource was changed."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Modified"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:medium  rdf:type        rdf:Property;
        rdfs:comment        "The material or physical carrier of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Medium"@en;
        rdfs:subPropertyOf  dct:format , dc:format;
        <http://purl.org/dc/dcam/domainIncludes>
                dct:PhysicalResource;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:PhysicalMedium;
        dct:issued          "2000-07-11"^^xsd:date .

dct:mediator  rdf:type      rdf:Property;
        rdfs:comment        "An entity that mediates access to the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Mediator"@en;
        rdfs:subPropertyOf  dct:audience;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:AgentClass;
        dct:description     "In an educational context, a mediator might be a parent, teacher, teaching assistant, or care-giver."@en;
        dct:issued          "2001-05-21"^^xsd:date .

dct:license  rdf:type       rdf:Property;
        rdfs:comment        "A legal document giving official permission to do something with the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "License"@en;
        rdfs:subPropertyOf  dct:rights , dc:rights;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:LicenseDocument;
        dct:description     "Recommended practice is to identify the license document with a URI. If this is not possible or feasible, a literal value that identifies the license may be provided."@en;
        dct:issued          "2004-06-14"^^xsd:date .

dct:language  rdf:type      rdf:Property;
        rdfs:comment        "A language of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Language"@en;
        rdfs:subPropertyOf  dc:language;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:LinguisticSystem;
        dct:description     "Recommended practice is to use either a non-literal value representing a language from a controlled vocabulary such as ISO 639-2 or ISO 639-3, or a literal value consisting of an IETF Best Current Practice 47 [[IETF-BCP47](https://tools.ietf.org/html/bcp47)] language tag."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:issued  rdf:type        rdf:Property;
        rdfs:comment        "Date of formal issuance of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Issued"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:isVersionOf  rdf:type   rdf:Property;
        rdfs:comment        "A related resource of which the described resource is a version, edition, or adaptation."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Is Version Of"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "Changes in version imply substantive changes in content rather than differences in format. This property is intended to be used with non-literal values. This property is an inverse property of Has Version."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:isRequiredBy  rdf:type  rdf:Property;
        rdfs:comment        "A related resource that requires the described resource to support its function, delivery, or coherence."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Is Required By"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Requires."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:isReplacedBy  rdf:type  rdf:Property;
        rdfs:comment        "A related resource that supplants, displaces, or supersedes the described resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Is Replaced By"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Replaces."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:isReferencedBy  rdf:type  rdf:Property;
        rdfs:comment        "A related resource that references, cites, or otherwise points to the described resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Is Referenced By"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of References."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:isPartOf  rdf:type      rdf:Property;
        rdfs:comment        "A related resource in which the described resource is physically or logically included."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Is Part Of"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Has Part."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:isFormatOf  rdf:type    rdf:Property;
        rdfs:comment        "A pre-existing related resource that is substantially the same as the described resource, but in another format."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Is Format Of"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Has Format."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:instructionalMethod
        rdf:type          rdf:Property;
        rdfs:comment      "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Instructional Method"@en;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:MethodOfInstruction;
        dct:description   "Instructional Method typically includes ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured.  Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."@en;
        dct:issued        "2005-06-13"^^xsd:date .

dct:identifier  rdf:type    rdf:Property;
        rdfs:comment        "An unambiguous reference to the resource within a given context."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Identifier"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dc:identifier;
        dct:description     "Recommended practice is to identify the resource by means of a string conforming to an identification system. Examples include International Standard Book Number (ISBN), Digital Object Identifier (DOI), and Uniform Resource Name (URN).  Persistent identifiers should be provided as HTTP URIs."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:hasVersion  rdf:type    rdf:Property;
        rdfs:comment        "A related resource that is a version, edition, or adaptation of the described resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Has Version"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "Changes in version imply substantive changes in content rather than differences in format. This property is intended to be used with non-literal values. This property is an inverse property of Is Version Of."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:hasPart  rdf:type       rdf:Property;
        rdfs:comment        "A related resource that is included either physically or logically in the described resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Has Part"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Is Part Of."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:hasFormat  rdf:type     rdf:Property;
        rdfs:comment        "A related resource that is substantially the same as the pre-existing described resource, but in another format."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Has Format"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        dct:description     "This property is intended to be used with non-literal values. This property is an inverse property of Is Format Of."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:format  rdf:type        rdf:Property;
        rdfs:comment        "The file format, physical medium, or dimensions of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Format"@en;
        rdfs:subPropertyOf  dc:format;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:MediaType , dct:Extent;
        dct:description     "Recommended practice is to use a controlled vocabulary where available. For example, for file formats one could use the list of Internet Media Types [[MIME](https://www.iana.org/assignments/media-types/media-types.xhtml)].  Examples of dimensions include size and duration."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:extent  rdf:type        rdf:Property;
        rdfs:comment        "The size or duration of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Extent"@en;
        rdfs:subPropertyOf  dct:format , dc:format;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:SizeOrDuration;
        dct:description     "Recommended practice is to specify the file size in megabytes and duration in ISO 8601 format."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:educationLevel  rdf:type  rdf:Property;
        rdfs:comment        "A class of agents, defined in terms of progression through an educational or training context, for which the described resource is intended."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Audience Education Level"@en;
        rdfs:subPropertyOf  dct:audience;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:AgentClass;
        dct:issued          "2002-07-13"^^xsd:date .

dct:description  rdf:type   rdf:Property;
        rdfs:comment        "An account of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Description"@en;
        rdfs:subPropertyOf  dc:description;
        dct:description     "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:dateSubmitted  rdf:type  rdf:Property;
        rdfs:comment        "Date of submission of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Submitted"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty.  Examples of resources to which a 'Date Submitted' may be relevant include a thesis (submitted to a university department) or an article (submitted to a journal)."@en;
        dct:issued          "2002-07-13"^^xsd:date .

dct:dateCopyrighted  rdf:type  rdf:Property;
        rdfs:comment        "Date of copyright of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Copyrighted"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Typically a year.  Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
        dct:issued          "2002-07-13"^^xsd:date .

dct:dateAccepted  rdf:type  rdf:Property;
        rdfs:comment        "Date of acceptance of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Accepted"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty.  Examples of resources to which a date of acceptance may be relevant are a thesis (accepted by a university department) or an article (accepted by a journal)."@en;
        dct:issued          "2002-07-13"^^xsd:date .

dct:date  rdf:type          rdf:Property;
        rdfs:comment        "A point or period of time associated with an event in the lifecycle of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dc:date;
        dct:description     "Date may be used to express temporal information at any level of granularity.  Recommended practice is to express the date, date/time, or period of time according to ISO 8601-1 [[ISO 8601-1](https://www.iso.org/iso-8601-date-and-time-format.html)] or a published profile of the ISO standard, such as the W3C Note on Date and Time Formats [[W3CDTF](https://www.w3.org/TR/NOTE-datetime)] or the Extended Date/Time Format Specification [[EDTF](http://www.loc.gov/standards/datetime/)].  If the full date is unknown, month and year (YYYY-MM) or just year (YYYY) may be used. Date ranges may be specified using ISO 8601 period of time specification in which start and end dates are separated by a '/' (slash) character.  Either the start or end date may be missing."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:creator  rdf:type           rdf:Property;
        rdfs:comment            "An entity responsible for making the resource."@en;
        rdfs:isDefinedBy        dct:;
        rdfs:label              "Creator"@en;
        rdfs:subPropertyOf      dct:contributor , dc:creator;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Agent;
        dct:description         "Recommended practice is to identify the creator with a URI.  If this is not possible or feasible, a literal value that identifies the creator may be provided."@en;
        dct:issued              "2008-01-14"^^xsd:date;
        owl:equivalentProperty  <http://xmlns.com/foaf/0.1/maker> .

dct:created  rdf:type       rdf:Property;
        rdfs:comment        "Date of creation of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Created"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:coverage  rdf:type      rdf:Property;
        rdfs:comment        "The spatial or temporal topic of the resource, spatial applicability of the resource, or jurisdiction under which the resource is relevant."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Coverage"@en;
        rdfs:subPropertyOf  dc:coverage;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Period , dct:Location , dct:Jurisdiction;
        dct:description     "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended practice is to use a controlled vocabulary such as the Getty Thesaurus of Geographic Names [[TGN](https://www.getty.edu/research/tools/vocabulary/tgn/index.html)]. Where appropriate, named places or time periods may be used in preference to numeric identifiers such as sets of coordinates or date ranges.  Because coverage is so broadly defined, it is preferable to use the more specific subproperties Temporal Coverage and Spatial Coverage."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:contributor  rdf:type   rdf:Property;
        rdfs:comment        "An entity responsible for making contributions to the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Contributor"@en;
        rdfs:subPropertyOf  dc:contributor;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Agent;
        dct:description     "The guidelines for using names of persons or organizations as creators apply to contributors."@en;
        dct:issued          "2008-01-14"^^xsd:date .

dct:conformsTo  rdf:type    rdf:Property;
        rdfs:comment        "An established standard to which the described resource conforms."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Conforms To"@en;
        rdfs:subPropertyOf  dct:relation , dc:relation;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Standard;
        dct:issued          "2001-05-21"^^xsd:date .

dct:bibliographicCitation
        rdf:type            rdf:Property;
        rdfs:comment        "A bibliographic reference for the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Bibliographic Citation"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:identifier , dc:identifier;
        dct:description     "Recommended practice is to include sufficient bibliographic detail to identify the resource as unambiguously as possible."@en;
        dct:issued          "2003-02-15"^^xsd:date .

dct:available  rdf:type     rdf:Property;
        rdfs:comment        "Date that the resource became or will become available."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Date Available"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:date , dc:date;
        dct:description     "Recommended practice is to describe the date, date/time, or period of time as recommended for the property Date, of which this is a subproperty."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:audience  rdf:type    rdf:Property;
        rdfs:comment      "A class of agents for whom the resource is intended or useful."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Audience"@en;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:AgentClass;
        dct:description   "Recommended practice is to use this property with non-literal values from a vocabulary of audience types."@en;
        dct:issued        "2001-05-21"^^xsd:date .

dct:alternative  rdf:type   rdf:Property;
        rdfs:comment        "An alternative name for the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Alternative Title"@en;
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  dct:title , dc:title;
        dct:description     "The distinction between titles and alternative titles is application-specific."@en;
        dct:issued          "2000-07-11"^^xsd:date .

dct:accrualPolicy  rdf:type  rdf:Property;
        rdfs:comment      "The policy governing the addition of items to a collection."@en;
        rdfs:domain       <http://purl.org/dc/dcmitype/Collection>;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Accrual Policy"@en;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Policy;
        dct:description   "Recommended practice is to use a value from the Collection Description Accrual Policy Vocabulary [[DCMI-ACCRUALPOLICY](https://dublincore.org/groups/collections/accrual-policy/)]."@en;
        dct:issued        "2005-06-13"^^xsd:date .

dct:accrualPeriodicity
        rdf:type          rdf:Property;
        rdfs:comment      "The frequency with which items are added to a collection."@en;
        rdfs:domain       <http://purl.org/dc/dcmitype/Collection>;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Accrual Periodicity"@en;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:Frequency;
        dct:description   "Recommended practice is to use a value from the Collection Description Frequency Vocabulary [[DCMI-COLLFREQ](https://dublincore.org/groups/collections/frequency/)]."@en;
        dct:issued        "2005-06-13"^^xsd:date .

dct:accrualMethod  rdf:type  rdf:Property;
        rdfs:comment      "The method by which items are added to a collection."@en;
        rdfs:domain       <http://purl.org/dc/dcmitype/Collection>;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Accrual Method"@en;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:MethodOfAccrual;
        dct:description   "Recommended practice is to use a value from the Collection Description Accrual Method Vocabulary [[DCMI-ACCRUALMETHOD](https://dublincore.org/groups/collections/accrual-method/)]."@en;
        dct:issued        "2005-06-13"^^xsd:date .

dct:accessRights  rdf:type  rdf:Property;
        rdfs:comment        "Information about who access the resource or an indication of its security status."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Access Rights"@en;
        rdfs:subPropertyOf  dct:rights , dc:rights;
        <http://purl.org/dc/dcam/rangeIncludes>
                dct:RightsStatement;
        dct:description     "Access Rights may include information regarding access or restrictions based on privacy, security, or other policies."@en;
        dct:issued          "2003-02-15"^^xsd:date .

dct:abstract  rdf:type      rdf:Property;
        rdfs:comment        "A summary of the resource."@en;
        rdfs:isDefinedBy    dct:;
        rdfs:label          "Abstract"@en;
        rdfs:subPropertyOf  dct:description , dc:description;
        dct:issued          "2000-07-11"^^xsd:date .

dct:W3CDTF  rdf:type      rdfs:Datatype;
        rdfs:comment      "The set of dates and times constructed according to the W3C Date and Time Formats Specification."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "W3C-DTF"@en;
        rdfs:seeAlso      <http://www.w3.org/TR/NOTE-datetime>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:URI  rdf:type         rdfs:Datatype;
        rdfs:comment      "The set of identifiers constructed according to the generic syntax for Uniform Resource Identifiers as specified by the Internet Engineering Task Force."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "URI"@en;
        rdfs:seeAlso      <http://www.ietf.org/rfc/rfc3986.txt>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:UDC  rdf:type         <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of conceptual resources specified by the Universal Decimal Classification."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "UDC"@en;
        rdfs:seeAlso      <http://www.udcc.org/>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:TGN  rdf:type         <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of places specified by the Getty Thesaurus of Geographic Names."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "TGN"@en;
        rdfs:seeAlso      <http://www.getty.edu/research/tools/vocabulary/tgn/index.html>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:Standard  rdf:type    rdfs:Class;
        rdfs:comment      "A reference point against which other things can be evaluated or compared."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Standard"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:SizeOrDuration  rdf:type  rdfs:Class;
        rdfs:comment      "A dimension or extent, or a time taken to play or execute."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Size or Duration"@en;
        rdfs:subClassOf   dct:MediaTypeOrExtent;
        dct:description   "Examples include a number of pages, a specification of length, width, and breadth, or a period in hours, minutes, and seconds."@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:RightsStatement  rdf:type  rdfs:Class;
        rdfs:comment      "A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Rights Statement"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:RFC5646  rdf:type     rdfs:Datatype;
        rdfs:comment      "The set of tags constructed according to RFC 5646 for the identification of languages."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "RFC 5646"@en;
        rdfs:seeAlso      <http://www.ietf.org/rfc/rfc5646.txt>;
        dct:description   "RFC 5646 obsoletes RFC 4646."@en;
        dct:issued        "2010-10-11"^^xsd:date .

dct:RFC4646  rdf:type     rdfs:Datatype;
        rdfs:comment      "The set of tags constructed according to RFC 4646 for the identification of languages."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "RFC 4646"@en;
        rdfs:seeAlso      <http://www.ietf.org/rfc/rfc4646.txt>;
        dct:description   "RFC 4646 obsoletes RFC 3066."@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:RFC3066  rdf:type     rdfs:Datatype;
        rdfs:comment      "The set of tags constructed according to RFC 3066 for the identification of languages."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "RFC 3066"@en;
        rdfs:seeAlso      <http://www.ietf.org/rfc/rfc3066.txt>;
        dct:description   "RFC 3066 has been obsoleted by RFC 4646."@en;
        dct:issued        "2002-07-13"^^xsd:date .

dct:RFC1766  rdf:type     rdfs:Datatype;
        rdfs:comment      "The set of tags, constructed according to RFC 1766, for the identification of languages."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "RFC 1766"@en;
        rdfs:seeAlso      <http://www.ietf.org/rfc/rfc1766.txt>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:ProvenanceStatement
        rdf:type          rdfs:Class;
        rdfs:comment      "Any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Provenance Statement"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:Policy  rdf:type      rdfs:Class;
        rdfs:comment      "A plan or course of action by an authority, intended to influence and determine decisions, actions, and other matters."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Policy"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:Point  rdf:type       rdfs:Datatype;
        rdfs:comment      "The set of points in space defined by their geographic coordinates according to the DCMI Point Encoding Scheme."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "DCMI Point"@en;
        rdfs:seeAlso      <https://www.dublincore.org/specifications/dublin-core/dcmi-point/>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:PhysicalResource  rdf:type  rdfs:Class;
        rdfs:comment      "A material thing."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Physical Resource"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:PhysicalMedium  rdf:type  rdfs:Class;
        rdfs:comment      "A physical material or carrier."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Physical Medium"@en;
        rdfs:subClassOf   dct:MediaType;
        dct:description   "Examples include paper, canvas, or DVD."@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:PeriodOfTime  rdf:type  rdfs:Class;
        rdfs:comment      "An interval of time that is named or defined by its start and end dates."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Period of Time"@en;
        rdfs:subClassOf   dct:LocationPeriodOrJurisdiction;
        dct:issued        "2008-01-14"^^xsd:date .

dct:Period  rdf:type      rdfs:Datatype;
        rdfs:comment      "The set of time intervals defined by their limits according to the DCMI Period Encoding Scheme."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "DCMI Period"@en;
        rdfs:seeAlso      <https://www.dublincore.org/specifications/dublin-core/dcmi-period/>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:NLM  rdf:type         <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of conceptual resources specified by the National Library of Medicine Classification."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "NLM"@en;
        rdfs:seeAlso      <http://wwwcf.nlm.nih.gov/class/>;
        dct:issued        "2005-06-13"^^xsd:date .

dct:MethodOfInstruction
        rdf:type          rdfs:Class;
        rdfs:comment      "A process that is used to engender knowledge, attitudes, and skills."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Method of Instruction"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:MethodOfAccrual  rdf:type  rdfs:Class;
        rdfs:comment      "A method by which resources are added to a collection."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Method of Accrual"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:MediaTypeOrExtent
        rdf:type          rdfs:Class;
        rdfs:comment      "A media type or extent."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Media Type or Extent"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:MediaType  rdf:type   rdfs:Class;
        rdfs:comment      "A file format or physical medium."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Media Type"@en;
        rdfs:subClassOf   dct:MediaTypeOrExtent;
        dct:issued        "2008-01-14"^^xsd:date .

dct:MESH  rdf:type        <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of labeled concepts specified by the Medical Subject Headings."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "MeSH"@en;
        rdfs:seeAlso      <http://www.nlm.nih.gov/mesh/meshhome.html>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:LocationPeriodOrJurisdiction
        rdf:type          rdfs:Class;
        rdfs:comment      "A location, period of time, or jurisdiction."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Location, Period, or Jurisdiction"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:Location  rdf:type    rdfs:Class;
        rdfs:comment      "A spatial region or named place."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Location"@en;
        rdfs:subClassOf   dct:LocationPeriodOrJurisdiction;
        dct:issued        "2008-01-14"^^xsd:date .

dct:LinguisticSystem  rdf:type  rdfs:Class;
        rdfs:comment      "A system of signs, symbols, sounds, gestures, or rules used in communication."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Linguistic System"@en;
        dct:description   "Written, spoken, sign, and computer languages are linguistic systems."@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:LicenseDocument  rdf:type  rdfs:Class;
        rdfs:comment      "A legal document giving official permission to do something with a resource."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "License Document"@en;
        rdfs:subClassOf   dct:RightsStatement;
        dct:issued        "2008-01-14"^^xsd:date .

dct:LCSH  rdf:type        <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of labeled concepts specified by the Library of Congress Subject Headings."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "LCSH"@en;
        dct:issued        "2000-07-11"^^xsd:date .

dct:LCC  rdf:type         <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of conceptual resources specified by the Library of Congress Classification."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "LCC"@en;
        rdfs:seeAlso      <http://lcweb.loc.gov/catdir/cpso/lcco/lcco.html>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:Jurisdiction  rdf:type  rdfs:Class;
        rdfs:comment      "The extent or range of judicial, law enforcement, or other authority."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Jurisdiction"@en;
        rdfs:subClassOf   dct:LocationPeriodOrJurisdiction;
        dct:issued        "2008-01-14"^^xsd:date .

dct:ISO639-3  rdf:type    rdfs:Datatype;
        rdfs:comment      "The set of three-letter codes listed in ISO 639-3 for the representation of names of languages."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "ISO 639-3"@en;
        rdfs:seeAlso      <http://www.sil.org/iso639-3/>;
        dct:issued        "2008-01-14"^^xsd:date .

dct:ISO639-2  rdf:type    rdfs:Datatype;
        rdfs:comment      "The three-letter alphabetic codes listed in ISO639-2 for the representation of names of languages."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "ISO 639-2"@en;
        rdfs:seeAlso      <http://lcweb.loc.gov/standards/iso639-2/langhome.html>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:ISO3166  rdf:type     rdfs:Datatype;
        rdfs:comment      "The set of codes listed in ISO 3166-1 for the representation of names of countries."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "ISO 3166"@en;
        rdfs:seeAlso      <https://www.iso.org/obp/ui/#search>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:IMT  rdf:type         <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of media types specified by the Internet Assigned Numbers Authority."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "IMT"@en;
        rdfs:seeAlso      <http://www.iana.org/assignments/media-types/>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:Frequency  rdf:type   rdfs:Class;
        rdfs:comment      "A rate at which something recurs."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Frequency"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:FileFormat  rdf:type  rdfs:Class;
        rdfs:comment      "A digital resource format."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "File Format"@en;
        rdfs:subClassOf   dct:MediaType;
        dct:issued        "2008-01-14"^^xsd:date .

dct:DDC  rdf:type         <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of conceptual resources specified by the Dewey Decimal Classification."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "DDC"@en;
        rdfs:seeAlso      <http://www.oclc.org/dewey/>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:DCMIType  rdf:type    <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
        rdfs:comment      "The set of classes specified by the DCMI Type Vocabulary, used to categorize the nature or genre of the resource."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "DCMI Type Vocabulary"@en;
        rdfs:seeAlso      <http://purl.org/dc/dcmitype/>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:Box  rdf:type         rdfs:Datatype;
        rdfs:comment      "The set of regions in space defined by their geographic coordinates according to the DCMI Box Encoding Scheme."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "DCMI Box"@en;
        rdfs:seeAlso      <https://www.dublincore.org/specifications/dublin-core/dcmi-box/>;
        dct:issued        "2000-07-11"^^xsd:date .

dct:BibliographicResource
        rdf:type          rdfs:Class;
        rdfs:comment      "A book, article, or other documentary resource."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Bibliographic Resource"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:AgentClass  rdf:type  rdfs:Class;
        rdfs:comment      "A group of agents."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Agent Class"@en;
        rdfs:subClassOf   rdfs:Class;
        dct:issued        "2008-01-14"^^xsd:date .

dct:Agent  rdf:type       rdfs:Class , dct:AgentClass;
        rdfs:comment      "A resource that acts or has the power to act."@en;
        rdfs:isDefinedBy  dct:;
        rdfs:label        "Agent"@en;
        dct:issued        "2008-01-14"^^xsd:date .

dct:    dct:modified   "2012-06-14"^^xsd:date;
        dct:publisher  <http://purl.org/dc/aboutdcmi#DCMI>;
        dct:title      "DCMI Metadata Terms - other"@en .
