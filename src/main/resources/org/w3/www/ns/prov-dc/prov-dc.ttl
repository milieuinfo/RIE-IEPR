<http://www.w3.org/ns/prov#RightsHolder>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "RightsHolder"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Role>;
        <http://www.w3.org/ns/prov#definition>
                "Role with the function of owning or managing rights over a resource. The Agent assigned to this role is associated with a RightsAssignment Activity"@en .

<http://www.w3.org/ns/prov#Creator>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Creator"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Contributor>;
        <http://www.w3.org/ns/prov#definition>
                "Role with the function of creating a resource. The Agent assigned to this role is associated with a Create Activity"@en .

<http://www.w3.org/ns/prov#Contributor>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Contributor"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Role>;
        <http://www.w3.org/ns/prov#definition>
                "Role with the function of having responsibility for making contributions to a resource. The Agent assigned to this role is associated with a Modify or Create Activities"@en .

<http://www.w3.org/ns/prov#Publisher>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Publisher"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Role>;
        <http://www.w3.org/ns/prov#definition>
                "Role with the function of publishing a resource. The Agent assigned to this role is associated with a Publish Activity"@en .

<http://www.w3.org/ns/prov#Replace>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Replace"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the replacement of a resource."@en .

<http://www.w3.org/ns/prov#Submit>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Submit"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the issuance (e.g., publication) of a resource."@en .

<http://www.w3.org/ns/prov#Copyright>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Copyright"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the Copyrighting activity associated to a resource."@en .

<http://www.w3.org/ns/prov#Accept>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Accept"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the acceptance of a resource (e.g., an article in a conference)"@en .

<http://www.w3.org/ns/prov#Modify>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Modify"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the modification of a resource."@en .

<http://www.w3.org/ns/prov#RightsAssignment>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "RightsAssignment"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the rights assignment of a resource."@en .

<http://www.w3.org/ns/prov#Create>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Create"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Contribute>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the creation of a resource"@en .

<http://www.w3.org/ns/prov#Contribute>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Contribute"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies any contribution of an agent to a resource."@en .

<http://www.w3.org/ns/prov#Publish>
        rdf:type          owl:Class;
        rdfs:isDefinedBy  <http://www.w3.org/ns/prov-dc#>;
        rdfs:label        "Publish"@en;
        rdfs:subClassOf   <http://www.w3.org/ns/prov#Activity>;
        <http://www.w3.org/ns/prov#definition>
                "Activity that identifies the publication of a resource"@en .

<http://www.w3.org/ns/prov-dc#>
        rdf:type          owl:Ontology;
        rdfs:comment      "This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).\n\nIf you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."@en;
        rdfs:label        "Dublin Core extensions of the W3C PROVenance Interchange Ontology (PROV-O)"@en;
        rdfs:seeAlso      <http://www.w3.org/ns/prov> , <http://www.w3.org/TR/2013/NOTE-prov-dc-20130430/>;
        frbr:abridgement  <http://www.w3.org/ns/prov-dc-refinements#>;
        frbr:complement   <http://www.w3.org/ns/prov-dc-directmappings#>;
        owl:imports       <http://www.w3.org/ns/prov-o#>;
        owl:versionIRI    <http://www.w3.org/ns/prov-dc-20130430>;
        owl:versionInfo   "2013-04-30"@en;
        <http://www.w3.org/ns/prov#alternateOf>
                <http://www.w3.org/ns/prov-dc-refinements#>;
        <http://www.w3.org/ns/prov#wasDerivedFrom>
                <http://www.w3.org/ns/prov-dc-refinements#> .
