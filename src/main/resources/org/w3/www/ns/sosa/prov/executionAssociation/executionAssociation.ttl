[ rdf:first  <http://www.w3.org/ns/sosa/Observation>;
  rdf:rest   [] 
] .

[ rdf:type  owl:Class ] .

<http://www.w3.org/ns/sosa/prov/eventAssociation>
        rdf:type  owl:ObjectProperty .

[ rdf:type  <http://xmlns.com/foaf/0.1/Agent>;
  <http://xmlns.com/foaf/0.1/name>
          "W3C/OGC Spatial Data on the Web Working Group"@en
] .

<http://www.w3.org/ns/sosa/prov>
        rdf:type      owl:Ontology;
        rdfs:comment  "Alignment of the the W3C/OGC SOSA Ontology with the W3C PROV-O Ontology"@en;
        rdfs:label    "Alignment of SOSA with PROV-O"@en;
        dct:created   "2016-12-14"^^xsd:date;
        dct:creator   -302 , "Simon J D Cox";
        dct:license   <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document> , <http://www.opengeospatial.org/ogc/Software>;
        dct:modified  "2017-04-13"^^xsd:date;
        dct:rights    "Copyright 2017 W3C/OGC.";
        owl:imports   <http://www.w3.org/ns/sosa/> , <http://www.w3.org/ns/prov-o#> .

<http://www.w3.org/ns/sosa/madeBySensor>
        rdfs:subPropertyOf  <http://www.w3.org/ns/prov#wasAssociatedWith> .

<http://www.w3.org/ns/sosa/madeBySampler>
        rdfs:subPropertyOf  <http://www.w3.org/ns/prov#wasAssociatedWith> .

<http://www.w3.org/ns/sosa/madeByActuator>
        rdfs:subPropertyOf  <http://www.w3.org/ns/prov#wasAssociatedWith> .

<http://www.w3.org/ns/sosa/isSampleOf>
        rdfs:subPropertyOf  <http://www.w3.org/ns/prov#wasDerivedFrom> .

<http://www.w3.org/ns/sosa/isResultOf>
        rdfs:subPropertyOf  <http://www.w3.org/ns/prov#wasGeneratedBy> .

<http://www.w3.org/ns/sosa/hasResult>
        rdfs:subPropertyOf  <http://www.w3.org/ns/prov#generated> .

<http://www.w3.org/ns/sosa/hasFeatureOfInterest>
        rdfs:subPropertyOf  <http://www.w3.org/ns/prov#used> .

<http://www.w3.org/ns/sosa/Sensor>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> , <http://www.w3.org/ns/prov#Agent> .

<http://www.w3.org/ns/sosa/Sampling>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Activity> .

<http://www.w3.org/ns/sosa/Sampler>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> , <http://www.w3.org/ns/prov#Agent> .

<http://www.w3.org/ns/sosa/Sample>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> .

<http://www.w3.org/ns/sosa/Result>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> .

<http://www.w3.org/ns/sosa/Procedure>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Plan> .

<http://www.w3.org/ns/sosa/Platform>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> .

<http://www.w3.org/ns/sosa/Observation>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Activity> .

<http://www.w3.org/ns/sosa/ObservableProperty>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> .

<http://www.w3.org/ns/sosa/FeatureOfInterest>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> .

<http://www.w3.org/ns/sosa/Actuator>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Entity> , <http://www.w3.org/ns/prov#Agent> .

<http://www.w3.org/ns/sosa/Actuation>
        rdfs:subClassOf  <http://www.w3.org/ns/prov#Activity> .
