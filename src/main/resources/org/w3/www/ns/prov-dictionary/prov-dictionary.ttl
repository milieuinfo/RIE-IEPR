    <http://www.w3.org/ns/prov#unqualifiedForm> <http://www.w3.org/ns/prov#derivedByInsertionFrom>.
<http://www.w3.org/ns/prov#Removal> a owl:Class;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#>;
    rdfs:label "Removal";
    <http://www.w3.org/ns/prov#definition> "Removal is a derivation that transforms a dictionary into another, by removing one or more key-entity pairs.";
    rdfs:subClassOf <http://www.w3.org/ns/prov#Derivation>.
_:n3-78 a owl:Restriction;
    owl:onProperty <http://www.w3.org/ns/prov#dictionary>;
    owl:cardinality "1"^^xsd:int.
<http://www.w3.org/ns/prov#Removal> rdfs:subClassOf 8.
_:n3-79 a owl:Restriction;
    owl:onProperty <http://www.w3.org/ns/prov#removedKey>;
    owl:minCardinality "1"^^xsd:int.
<http://www.w3.org/ns/prov#Removal> rdfs:subClassOf 9;
    <http://www.w3.org/ns/prov#category> "collections";
    <http://www.w3.org/ns/prov#component> "collections";
    <http://www.w3.org/ns/prov#dm> "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
    <http://www.w3.org/ns/prov#n> "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI;
    <http://www.w3.org/ns/prov#constraints> "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
    <http://www.w3.org/ns/prov#unqualifiedForm> <http://www.w3.org/ns/prov#derivedByRemovalFrom>.
<http://www.w3.org/ns/prov#dictionary> a owl:ObjectProperty;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#>;
    rdfs:label "dictionary";
    <http://www.w3.org/ns/prov#definition> "The property used by a prov:Insertion and prov:Removal to cite the prov:Dictionary that was prov:derivedByInsertionFrom or prov:derivedByRemovalFrom another dictionary.";
    rdfs:subPropertyOf <http://www.w3.org/ns/prov#entity>;
    rdfs:domain <http://www.w3.org/ns/prov#Insertion>, <http://www.w3.org/ns/prov#Removal>;
    rdfs:range <http://www.w3.org/ns/prov#Dictionary>;
    <http://www.w3.org/ns/prov#category> "collections";
    <http://www.w3.org/ns/prov#component> "collections";
    <http://www.w3.org/ns/prov#dm> "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI, "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
    <http://www.w3.org/ns/prov#n> "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI, "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI;
    <http://www.w3.org/ns/prov#constraints> "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI.
<http://www.w3.org/ns/prov#derivedByInsertionFrom> a owl:ObjectProperty;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#>;
    rdfs:label "derivedByInsertionFrom";
    <http://www.w3.org/ns/prov#definition> "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs.";
