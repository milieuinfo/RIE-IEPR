<http://www.w3.org/ns/prov#removedKey>
        rdf:type                        owl:DatatypeProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Removal>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "removedKey";
        rdfs:range                      rdfs:Literal;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The key removed in a Removal.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

<http://www.w3.org/ns/prov#qualifiedRemoval>
        rdf:type                        owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "qualifiedRemoval";
        rdfs:range                      <http://www.w3.org/ns/prov#Removal>;
        rdfs:subPropertyOf              <http://www.w3.org/ns/prov#qualifiedDerivation>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed keys.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

<http://www.w3.org/ns/prov#qualifiedInsertion>
        rdf:type                        owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "qualifiedInsertion";
        rdfs:range                      <http://www.w3.org/ns/prov#Insertion>;
        rdfs:subPropertyOf              <http://www.w3.org/ns/prov#qualifiedDerivation>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

<http://www.w3.org/ns/prov#pairEntity>
        rdf:type                        owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#KeyEntityPair>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "pairKey";
        rdfs:range                      <http://www.w3.org/ns/prov#Entity>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The value of a KeyEntityPair.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

<http://www.w3.org/ns/prov#pairKey>
        rdf:type                        owl:FunctionalProperty , owl:DatatypeProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#KeyEntityPair>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "pairKey";
        rdfs:range                      rdfs:Literal;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The key of a KeyEntityPair, which is an element of a prov:Dictionary.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

<http://www.w3.org/ns/prov#hadDictionaryMember>
        rdf:type                        owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "hadDictionaryMember";
        rdfs:range                      <http://www.w3.org/ns/prov#KeyEntityPair>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "Describes the key-entity pair that was member of a prov:Dictionary. A dictionary can have multiple members.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

<http://www.w3.org/ns/prov#insertedKeyEntityPair>
        rdf:type                        owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Insertion>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "insertedKeyEntityPair";
        rdfs:range                      <http://www.w3.org/ns/prov#KeyEntityPair>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "An object property to refer to the prov:KeyEntityPair inserted into a prov:Dictionary.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

<http://www.w3.org/ns/prov#derivedByRemovalFrom>
        rdf:type                        owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "derivedByRemovalFrom";
        rdfs:range                      <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:subPropertyOf              <http://www.w3.org/ns/prov#wasDerivedFrom>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed key-entity pairs.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI .

<http://www.w3.org/ns/prov#derivedByInsertionFrom>
        rdf:type                        owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "derivedByInsertionFrom";
        rdfs:range                      <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:subPropertyOf              <http://www.w3.org/ns/prov#wasDerivedFrom>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

<http://www.w3.org/ns/prov#dictionary>
        rdf:type                        owl:ObjectProperty;
        rdfs:domain                     <http://www.w3.org/ns/prov#Removal> , <http://www.w3.org/ns/prov#Insertion>;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "dictionary";
        rdfs:range                      <http://www.w3.org/ns/prov#Dictionary>;
        rdfs:subPropertyOf              <http://www.w3.org/ns/prov#entity>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "The property used by a prov:Insertion and prov:Removal to cite the prov:Dictionary that was prov:derivedByInsertionFrom or prov:derivedByRemovalFrom another dictionary.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI , "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI , "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI .

[ rdf:type            owl:Restriction;
  owl:minCardinality  "1"^^xsd:int;
  owl:onProperty      <http://www.w3.org/ns/prov#removedKey>
] .

[ rdf:type         owl:Restriction;
  owl:cardinality  "1"^^xsd:int;
  owl:onProperty   <http://www.w3.org/ns/prov#dictionary>
] .

<http://www.w3.org/ns/prov#Removal>
        rdf:type                        owl:Class;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "Removal";
        rdfs:subClassOf                 9 , 8;
        rdfs:subClassOf                 <http://www.w3.org/ns/prov#Derivation>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "Removal is a derivation that transforms a dictionary into another, by removing one or more key-entity pairs.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#unqualifiedForm>
                <http://www.w3.org/ns/prov#derivedByRemovalFrom> .

[ rdf:type            owl:Restriction;
  owl:minCardinality  "1"^^xsd:int;
  owl:onProperty      <http://www.w3.org/ns/prov#insertedKeyEntityPair>
] .

[ rdf:type         owl:Restriction;
  owl:cardinality  "1"^^xsd:int;
  owl:onProperty   <http://www.w3.org/ns/prov#dictionary>
] .

<http://www.w3.org/ns/prov#Insertion>
        rdf:type                        owl:Class;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "Insertion";
        rdfs:subClassOf                 7 , 6;
        rdfs:subClassOf                 <http://www.w3.org/ns/prov#Derivation>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "Insertion is a derivation that transforms a dictionary into another, by insertion of one or more key-entity pairs.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#unqualifiedForm>
                <http://www.w3.org/ns/prov#derivedByInsertionFrom> .

[ rdf:type         owl:Restriction;
  owl:cardinality  "1"^^xsd:int;
  owl:onProperty   <http://www.w3.org/ns/prov#pairEntity>
] .

[ rdf:type         owl:Restriction;
  owl:cardinality  "1"^^xsd:int;
  owl:onProperty   <http://www.w3.org/ns/prov#pairKey>
] .

<http://www.w3.org/ns/prov#KeyEntityPair>
        rdf:type                        owl:Class;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "Key-Entity Pair";
        rdfs:subClassOf                 5 , 4;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "A key-entity pair. Part of a prov:Dictionary through prov:hadDictionaryMember. The key is any RDF Literal, the value is a prov:Entity.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI .

<http://www.w3.org/ns/prov#EmptyDictionary>
        rdf:type                        owl:Class;
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "Empty Dictionary";
        rdfs:subClassOf                 <http://www.w3.org/ns/prov#Dictionary> , <http://www.w3.org/ns/prov#EmptyCollection>;
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "An empty dictionary (i.e. has no members).";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI .

<http://www.w3.org/ns/prov#Dictionary>
        rdf:type                        owl:Class;
        rdfs:comment                    "A given dictionary forms a given structure for its members. A different structure (obtained either by insertion or removal of members) constitutes a different dictionary." , "This concept allows for the provenance of the dictionary, but also of its constituents to be expressed. Such a notion of dictionary corresponds to a wide variety of concrete data structures, such as a maps or associative arrays.";
        rdfs:isDefinedBy                <http://www.w3.org/ns/prov#>;
        rdfs:label                      "Dictionary";
        <http://www.w3.org/ns/prov#category>
                "collections";
        <http://www.w3.org/ns/prov#component>
                "collections";
        <http://www.w3.org/ns/prov#constraints>
                "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#definition>
                "A dictionary is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the dictionary.";
        <http://www.w3.org/ns/prov#dm>  "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI;
        <http://www.w3.org/ns/prov#n>   "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI .

<http://www.w3.org/ns/prov#>
        rdf:type  owl:Ontology .

