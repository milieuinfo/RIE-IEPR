@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#AangifteShape>
        a               sh:NodeShape;
        sh:property     [ sh:datatype  <http://www.w3.org/2001/XMLSchema#date>;
                          sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://purl.org/dc/terms/created>
                        ];
        sh:property     [ sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://www.w3.org/ns/prov#wasAssociatedWith>
                        ];
        sh:property     [ sh:class     [] ;
                          sh:minCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://purl.org/dc/terms/subject>
                        ];
        sh:property     [ sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <https://data.vlaanderen.be/ns/dossier#informatieclassificatie>
                        ];
        sh:property     [ sh:class     <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangifte>;
                          sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://purl.org/dc/terms/isPartOf>
                        ];
        sh:targetClass  <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangifte> .

<http://www.w3.org/ns/sosa/PropertyShape>
        a               sh:NodeShape;
        sh:property     [ sh:or    ( [ sh:class  <http://www.w3.org/ns/sosa/Actuation> ]
                                     [ sh:class  <http://www.w3.org/ns/sosa/ActuationCollection> ]
                                   );
                          sh:path  <http://www.w3.org/ns/sosa/wasActedOnBy>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Procedure>;
                          sh:path   <http://www.w3.org/ns/sosa/hasProcedure>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Actuator>;
                          sh:path   <http://www.w3.org/ns/sosa/isActedOnBy>
                        ];
        sh:property     [ sh:or    ( [ sh:class  <http://www.w3.org/ns/sosa/Observation> ]
                                     [ sh:class  <http://www.w3.org/ns/sosa/ObservationCollection> ]
                                   );
                          sh:path  <http://www.w3.org/ns/sosa/wasObservedBy>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/FeatureOfInterest>;
                          sh:path   <http://www.w3.org/ns/sosa/isPropertyOf>
                        ];
        sh:property     [ sh:class  <http://www.w3.org/ns/sosa/Sensor>;
                          sh:path   <http://www.w3.org/ns/sosa/isObservedBy>
                        ];
        sh:targetClass  <http://www.w3.org/ns/sosa/Property> .

<http://www.w3.org/ns/prov#InfluenceShape>
        a               sh:NodeShape;
        sh:targetClass  <http://www.w3.org/ns/prov#Influence> .

<http://www.w3.org/ns/org#PostShape>
        a               sh:NodeShape;
        sh:targetClass  <http://www.w3.org/ns/org#Post> .

<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#InstallatieShape>
        a               sh:NodeShape;
        sh:property     [ sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
