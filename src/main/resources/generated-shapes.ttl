                          sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://www.w3.org/ns/adms#status>
                        ];
        sh:property     [ sh:datatype  <http://www.w3.org/2001/XMLSchema#date>;
                          sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://purl.org/dc/terms/valid>
                        ];
        sh:property     [ sh:class     <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Exploitatie>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://www.w3.org/ns/ssn/hasDeployment>
                        ];
        sh:property     [ sh:class     <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangifte>;
                          sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#aangifte>
                        ];
        sh:property     [ sh:class     <http://www.w3.org/ns/ssn/System>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://www.w3.org/ns/ssn/hasSubSystem>
                        ];
        sh:property     [ sh:class     <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#SysteemEigenschap>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://www.w3.org/ns/ssn/hasProperty>
                        ];
        sh:property     [ sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      rdfs:comment
                        ];
        sh:property     [ sh:datatype  <http://www.w3.org/2001/XMLSchema#date>;
                          sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://purl.org/dc/terms/issued>
                        ];
        sh:targetClass  <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Installatie> .

