        sh:property     [ sh:path  <http://www.w3.org/2006/time#unitType> ];
        sh:property     [ sh:maxCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "0"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://www.w3.org/2006/time#year>
