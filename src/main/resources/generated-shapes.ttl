                        ];
        sh:property     [ sh:datatype  <http://www.w3.org/2001/XMLSchema#dateTime>;
                          sh:maxCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:minCount  "1"^^<http://www.w3.org/2001/XMLSchema#long>;
                          sh:path      <http://purl.org/dc/terms/created>
