## =============================================================================
## PROCEDURES
## =============================================================================

## --- EmissieProcedures  (riepr:EmissieProcedure) ---

emissieprocedure:EX_EMISPROC_001
        a               riepr:EmissieProcedure ;
        rdfs:label      "Continue emissiemeting via CEMS"@nl ;
        rdfs:comment    "Procedure voor continue automatische emissiemeting via een Continuous Emission Monitoring System (CEMS). Van toepassing op grote stookinstallaties en procesovens met continue uitstoot van SO₂, NOₓ en stof."@nl ;
        dct:identifier  "EMISPROC-CEMS-001" ;
        dct:source      <https://eur-lex.europa.eu/legal-content/NL/TXT/?uri=CELEX:32010L0075> .

emissieprocedure:EX_EMISPROC_002
        a               riepr:EmissieProcedure ;
        rdfs:label      "Periodieke emissiemeting via monsterneming"@nl ;
        rdfs:comment    "Procedure voor periodieke emissiemeting door het nemen van representatieve monsters op het emissiepunt conform EN 15259. Wordt minimaal jaarlijks uitgevoerd voor niet-continue emissiebronnen."@nl ;
        dct:identifier  "EMISPROC-PERIOD-002" ;
        dct:source      <https://www.iso.org/standard/57758.html> .

## --- VerwerkingProcedures  (riepr:VerwerkingProcedure) ---

verwerkingprocedure:EX_VWKPROC_001
        a               riepr:VerwerkingProcedure ;
        rdfs:label      "Smelten van staal in stroomboogoven"@nl ;
        rdfs:comment    "Procedure voor het smelten van schroot en grondstoffen tot vloeibaar staal via een elektrische stroomboogoven. Omvat toevoeging van grondstoffen, verhitting en afgassing."@nl ;
        dct:identifier  "PROC-EAF-001" .

verwerkingprocedure:EX_VWKPROC_002
        a               riepr:VerwerkingProcedure ;
        rdfs:label      "Decarburisatie van staal"@nl ;
        rdfs:comment    "Procedure voor het verwijderen van koolstof uit vloeibaar staal via argon-zuurstofontkoling (AOD) of vacuüm-zuurstofdecarburisatie (VOD). Resulteert in geraffineerd staal met laag koolstofgehalte."@nl ;
        dct:identifier  "PROC-DECARB-001" .

## --- MeetProcedures  (riepr:MeetProcedure) ---

meetprocedure:EX_MEETPROC_001
        a               riepr:MeetProcedure ;
        rdfs:label      "Grondwaterpeilmeting via piezometer"@nl ;
        rdfs:comment    "Procedure voor het meten van het grondwaterpeil via een piezometrische druksensor op het onttrekkingspunt. Metingen worden om het uur geregistreerd en opgeslagen in het centrale meetsysteem."@nl ;
        dct:identifier  "NBN-ISO-21413:2005" ;
        dct:type        <https://data.riepr.omgeving.vlaanderen.be/id/concept/meetproceduretype/automatisch> .

meetprocedure:EX_MEETPROC_002
        a               riepr:MeetProcedure ;
        rdfs:label      "Luchtkwaliteitsmeting continue emissieregistratie"@nl ;
        rdfs:comment    "Continue meting van luchtemissies (stof, NOx, SO2) via gecalibreerde sensoren op het emissiepunt. Procedure conform Vlarem II bijlage 4.4.2 voor continue emissiemeetsystemen (CEMS)."@nl ;
        dct:identifier  "EN-14181:2014" ;
        dct:type        <https://data.riepr.omgeving.vlaanderen.be/id/concept/meetproceduretype/automatisch> .

## --- OnttrekkingProcedures  (riepr:OnttrekkingProcedure) ---

onttrekkingprocedure:EX_OTKPROC_001
        a               riepr:OnttrekkingProcedure ;
        rdfs:label      "Grondwateronttrekking via pompput"@nl ;
        rdfs:comment    "Procedure voor de onttrekking van grondwater via een verticale pompput met buisfilter op diepte 28-32 m. De pomp werkt continu met een debiet van maximaal 5 m³/u."@nl ;
        dct:identifier  "PROC-GW-2022-001" .

onttrekkingprocedure:EX_OTKPROC_002
        a               riepr:OnttrekkingProcedure ;
        rdfs:label      "Oppervlaktewateronttrekking via inlaatwerk"@nl ;
        rdfs:comment    "Procedure voor de onttrekking van oppervlaktewater via een vast inlaatwerk in het kanaal. Onttrekking is beperkt tot perioden buiten laagwaterstand conform vergunning."@nl ;
        dct:identifier  "PROC-OW-2021-003" .

## --- TransportProcedures  (riepr:TransportProcedure) ---

transportprocedure:EX_TRSPROC_001
        a               riepr:TransportProcedure ;
        rdfs:label      "Overbrenging vloeibaar staal via gietpan"@nl ;
        rdfs:comment    "Procedure voor het transporteren van vloeibaar staal van de stroomboogoven naar de argon-zuurstofontkoling via een gietpan. Omvat veiligheidsprotocollen voor het hanteren van vloeibaar metaal bij hoge temperaturen."@nl ;
        dct:identifier  "TRSPROC-GIETPAN-001" .

transportprocedure:EX_TRSPROC_002
        a               riepr:TransportProcedure ;
        rdfs:label      "Aanvoer van grondstoffen via transportband"@nl ;
        rdfs:comment    "Procedure voor de geautomatiseerde aanvoer van schroot en andere grondstoffen via een transportband naar de opslagbunker van de stroomboogoven. Bevat richtlijnen voor gewichtsregistratie en kwaliteitscontrole van de invoerstroom."@nl ;
        dct:identifier  "TRSPROC-TBAND-002" .
