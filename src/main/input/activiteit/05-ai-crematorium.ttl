## ---------------------------------------- ##
## Rubrieken                                ##
## ---------------------------------------- ##
# Rubrieken hangen op het proces, niet op de installatie: dezelfde installatie
# kan onder een andere rubriek vallen naargelang de activiteit die ze uitvoert.

rubriek:vlarem-43-1 a :Rubriek ;
    dct:type rubriek-type:vlarem ;
    skos:notation "43.1" ;
    skos:definition "Crematoria"@nl .

rubriek:vlarem-43-2 a :Rubriek ;
    dct:type rubriek-type:vlarem ;
    skos:notation "43.2" ;
    skos:definition "Stookinstallaties van crematoria"@nl .

rubriek:vlarem-43-3 a :Rubriek ;
    dct:type rubriek-type:vlarem ;
    skos:notation "43.3" ;
    skos:definition "Stookinstallaties voor ruimteverwarming met een geïnstalleerd thermisch vermogen van 0,085 MW"@nl .

## ---------------------------------------- ##
## Processen                                ##
## ---------------------------------------- ##

# Het hoofdproces van de exploitatie
proces:crematorium-hoofdproces a :Proces ;
    rdfs:label "Crematorium Proces"@nl ;
    rdfs:comment "Overkoepelend proces voor alle activiteiten in het crematorium."@nl ;
    dct:type procedure-type:hoofdactiviteit ;
    dct:issued "2002-01-01"^^xsd:date ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2024-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    ssn:implementedBy exploitatie:crematoria-exploitatie-1 .

# --- Verwerkingsprocessen: één per bron ---

