## ---------------------------------------- ##
## Procesvariabelen                         ##
## ---------------------------------------- ##

variabele:aardgas-verbruik a :Procesvariabele, pplan:Variable ;
    rdfs:label "Aardgasverbruik"@nl ;
    qudt:hasUnit unit:M3 .

variabele:rookgas-uitstoot a :Procesvariabele, pplan:Variable ;
    rdfs:label "Rookgas"@nl ;
    qudt:hasUnit unit:MilliGM-PER-M3 .

variabele:warmte-output a :Procesvariabele, pplan:Variable ;
    rdfs:label "Warmteproductie"@nl ;
    qudt:hasUnit unit:MegaW .

