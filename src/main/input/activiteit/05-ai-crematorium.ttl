# --- Schoorstenen (emissiepunten) ---
# Schoorsteen 1 en 2 zijn gedeeld door telkens twee crematieovens.

emissiepunt:schoorsteen-1 a :Emissiepunt, ssn:System ;
    rdfs:label "Schoorsteen 1"@nl ;
    dct:type emissiepunt-type:schoorsteen_verticale_uitstroom ;
    dct:issued "2002-01-01"^^xsd:date ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    :inGebruikVanaf "2002-01-01"^^xsd:date ;
    ssn:hasProperty eig:schoorsteen-1-hoogte, eig:schoorsteen-1-diameter ;
    # De emissiemeter zit in de schoorsteen
    ssn:hasSubSystem meetpunt:meetpunt-schoorsteen-1 ;
    ogc:hasGeometry [ a ogc:Geometry ;
        ogc:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POINT(717813.117 678859.536)"^^ogc:wktLiteral
    ] ;
    sosa:isHostedBy locatie:crematoria-1 .

