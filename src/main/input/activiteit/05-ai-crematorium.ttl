    dct:modified "2022-01-15"^^xsd:date ;
    prov:hadPart stuk:meetrapport-2021 .

stuk:meetrapport-2021 a dossier:Stuk ;
    rdfs:label "Meetrapport emissiemetingen 2021"@nl ;
    dct:description "Jaarlijks meetrapport voor de emissies van de crematieovens en de centrale verwarming"@nl ;
