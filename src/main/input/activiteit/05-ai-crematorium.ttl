aangifte:jaarrapport-2021 a :Aangifte ;
    rdfs:label "Jaarlijkse emissieaangifte 2021 - Crematoria"@nl ;
    dct:issued "2022-01-15"^^xsd:date ;
    # Bij een aangifte zijn dct:created en dct:modified datums (indiening en goedkeuring)
