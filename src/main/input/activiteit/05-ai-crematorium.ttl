## ---------------------------------------- ##
## Exploitant, locatie en exploitatie       ##
## ---------------------------------------- ##

# Minimale type-assertie voor de externe referentie
<https://data.vlaanderen.be/id/onderneming/0123456789> a org:Organization .

exploitant:crematoria-beheerder a :Exploitant ;
    rdfs:label "Beheerder Crematoria"@nl ;
    # De primaire bron waar de gegevens van de exploitant vandaan komen
    prov:hadPrimarySource <https://data.vlaanderen.be/id/onderneming/0123456789> ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2021-09-01T00:00:00Z"^^xsd:dateTime ;
    org:classification nace:96030 ;
    locn:address [ a locn:Address ;
        locn:fullAddress "Marktstraat 1, 9000 Gent, België"@nl
    ] .

locatie:crematoria-1 a :Exploitatielocatie ;
    rdfs:label "Crematoria - Exploitatielocatie"@nl ;
    rdfs:comment "Fysieke locatie van het crematorium met vier schoorstenen."@nl ;
    dct:issued "2020-01-01"^^xsd:date ;
    dct:created "2020-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2024-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    # De exploitant hangt aan de locatie, niet rechtstreeks aan de exploitatie
    prov:wasAttributedTo exploitant:crematoria-beheerder ;
    locn:address [ a locn:Address ;
        locn:thoroughfare "Crematoriumstraat"@nl ;
        locn:postCode "9000" ;
        locn:adminUnitL2 "Vlaanderen"@nl
    ] ;
    ogc:hasGeometry [ a ogc:Geometry ;
        ogc:asWKT "<http://www.opengis.net/def/crs/EPSG/0/31370> POINT(717815.118 678854.037)"^^ogc:wktLiteral
    ] .

exploitatie:crematoria-exploitatie-1 a :Exploitatie ;
    rdfs:label "Exploitatie Crematoria"@nl ;
    dct:issued "2002-01-01"^^xsd:date ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2021-09-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    ssn:deployedOnPlatform locatie:crematoria-1 ;
    # Precies één hoofdproces
    ssn:implements proces:crematorium-hoofdproces ;
    ssn:deployedSystem
        installatie:crematieoven-1, installatie:crematieoven-2,
        installatie:crematieoven-3, installatie:crematieoven-4,
        installatie:centrale-verwarming-1, installatie:centrale-verwarming-2,
        emissiepunt:schoorsteen-1, emissiepunt:schoorsteen-2,
        emissiepunt:schoorsteen-3, emissiepunt:schoorsteen-4,
        onttrekkingspunt:grondwaterput-1,
        meetpunt:meetpunt-schoorsteen-1, meetpunt:meetpunt-schoorsteen-2 .

contactpersoon:contactpersoon-1 a :Contactpersoon ;
    rdfs:label "Jan De Smet - Verantwoordelijke"@nl ;
    dct:type <https://data.riepr.omgeving.vlaanderen.be/id/concept/milieucoordinator> ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2021-09-01T00:00:00Z"^^xsd:dateTime ;
    # Een contactpersoon annoteert de exploitatie
    oa:hasTarget exploitatie:crematoria-exploitatie-1 ;
    foaf:name "Jan De Smet"@nl ;
    foaf:mbox <mailto:jan.desmet@example.com> .

