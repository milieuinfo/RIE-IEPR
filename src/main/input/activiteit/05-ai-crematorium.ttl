    rdfs:label "Transport rookgassen Crematieoven 1 naar Schoorsteen 1"@nl ;
    dct:type procedure-type:transport ;
    dct:issued "2021-08-01"^^xsd:date ;
    dct:created "2021-08-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2021-08-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    pplan:isStepOfPlan proces:crematorium-hoofdproces ;
    pplan:hasInputVar variabele:rookgas-uitstoot ;
    pplan:hasOutputVar variabele:rookgas-uitstoot ;
    pplan:isPrecededBy proces:stookproces-crematieoven-1 .

