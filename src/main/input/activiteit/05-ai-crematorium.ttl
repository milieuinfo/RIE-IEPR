# --- Emissieprocessen: één per emissiepunt ---
# Ook als er twee bronnen op uitkomen blijft het bij één emissieproces.

proces:emissie-schoorsteen-1 a :Proces ;
    rdfs:label "Emissieproces Schoorsteen 1"@nl ;
    dct:type procedure-type:emissie ;
    dct:issued "2002-01-01"^^xsd:date ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    ssn:implementedBy emissiepunt:schoorsteen-1 ;
    pplan:isStepOfPlan proces:crematorium-hoofdproces ;
    pplan:hasInputVar variabele:rookgas-uitstoot ;
    # Twee transportprocessen, één per crematieoven, komen hier samen
    pplan:isPrecededBy proces:transport-crematieoven-1-schoorsteen-1,
                       proces:transport-crematieoven-2-schoorsteen-1 .

proces:emissie-schoorsteen-2 a :Proces ;
    rdfs:label "Emissieproces Schoorsteen 2"@nl ;
    dct:type procedure-type:emissie ;
    dct:issued "2002-01-01"^^xsd:date ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    ssn:implementedBy emissiepunt:schoorsteen-2 ;
    pplan:isStepOfPlan proces:crematorium-hoofdproces ;
    pplan:hasInputVar variabele:rookgas-uitstoot ;
    pplan:isPrecededBy proces:transport-crematieoven-3-schoorsteen-2,
                       proces:transport-crematieoven-4-schoorsteen-2 .

proces:emissie-schoorsteen-3 a :Proces ;
    rdfs:label "Emissieproces Schoorsteen 3"@nl ;
    dct:type procedure-type:emissie ;
    dct:issued "2002-01-01"^^xsd:date ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    ssn:implementedBy emissiepunt:schoorsteen-3 ;
    pplan:isStepOfPlan proces:crematorium-hoofdproces ;
    pplan:isPrecededBy proces:transport-centrale-verwarming-1-schoorsteen-3 .

proces:emissie-schoorsteen-4 a :Proces ;
    rdfs:label "Emissieproces Schoorsteen 4"@nl ;
    dct:type procedure-type:emissie ;
    dct:issued "2002-01-01"^^xsd:date ;
    dct:created "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    dct:modified "2002-01-01T00:00:00Z"^^xsd:dateTime ;
    adms:status status-type:in_dienst ;
    ssn:implementedBy emissiepunt:schoorsteen-4 ;
    pplan:isStepOfPlan proces:crematorium-hoofdproces ;
    pplan:isPrecededBy proces:transport-centrale-verwarming-2-schoorsteen-4 .

# --- Transportprocessen: één per verbinding bron -> emissiepunt ---
# pplan:isPrecededBy wijst tegen de stroomrichting in: het transport wordt
# voorafgegaan door het verwerkingsproces van de bron.

