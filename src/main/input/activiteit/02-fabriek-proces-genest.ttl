@prefix riepr: <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix proces: <https://data.riepr.omgeving.vlaanderen.be/id/proces/> .
@prefix exploitatielocatie: <https://data.riepr.omgeving.vlaanderen.be/id/exploitatielocatie/> .
@prefix emissiepunt: <https://data.riepr.omgeving.vlaanderen.be/id/emissiepunt/> .
@prefix stof: <https://data.riepr.omgeving.vlaanderen.be/id/stof/> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
## ---------------------------------------

proces:ACTIVITEIT_001 a riepr:Proces ;
    dct:created "2020-07-30T10:00:00Z"^^xsd:dateTime ;
    dct:issued "2020-07-30"^^xsd:date ;
    dct:valid "2030-12-31"^^xsd:date ;
    adms:status riepr:Actief ;
    rdfs:label "Koekjes maken"@nl ;
    pplan:hasInputVar stof:meel ;
    pplan:hasOutputVar stof:koekjes ;
    sosa:isHostedBy exploitatielocatie:ACTIVITEIT_001_LOC .

exploitatielocatie:ACTIVITEIT_001_LOC a riepr:ExploitatieLocatie ;
    rdfs:label "Locatie ACTIVITEIT_001"@nl .

proces:STAP_001 a riepr:Proces ;
    rdfs:label "Koekjesdeeg maken"@nl ;
    pplan:hasInputVar stof:meel ;
    pplan:hasOutputVar stof:deeg ;
    pplan:isStepOfPlan proces:ACTIVITEIT_001 .
proces:STAP_001_1 a riepr:Proces ;
    rdfs:label "Ingrediënten mengen"@nl ;
    pplan:hasInputVar stof:meel ;
    pplan:hasOutputVar stof:mengsel ;
    pplan:isStepOfPlan proces:STAP_001 .
proces:STAP_001_2 a riepr:Proces ;
    rdfs:label "Overbrenging"@nl ;
    dct:type riepr:overbrengingsProces ;
    pplan:hasInputVar stof:mengsel ;
    pplan:hasOutputVar stof:mengsel ;
    pplan:isStepOfPlan proces:STAP_001 ;
    pplan:isPrecededBy proces:STAP_001_1 .
proces:STAP_001_3 a riepr:Proces ;
    rdfs:label "Deeg laten rusten"@nl ;
    pplan:hasInputVar stof:mengsel ;
    pplan:hasOutputVar stof:deeg ;
    pplan:isStepOfPlan proces:STAP_001 ;
    pplan:isPrecededBy proces:STAP_001_2 .

proces:STAP_002 a riepr:Proces ;
    rdfs:label "Koekjes bakken"@nl ;
    pplan:hasInputVar stof:deeg ;
    pplan:hasOutputVar stof:koekjes ;
    pplan:isStepOfPlan proces:ACTIVITEIT_001 ;
    pplan:isPrecededBy proces:STAP_001 .

proces:STAP_003 a riepr:Proces ;
    rdfs:label "Rookgas afvoeren"@nl ;
    pplan:hasInputVar stof:rookgas ;
    pplan:hasOutputVar stof:rookgas ;
    pplan:isStepOfPlan proces:ACTIVITEIT_001 ;
    pplan:isPrecededBy proces:STAP_002 ;
    dct:type riepr:uitstootProces ;
    ssn:implementedBy emissiepunt:TBD .

emissiepunt:TBD a riepr:Emissiepunt ;
    rdfs:label "Emissiepunt koekjesoven"@nl .

stof:meel a riepr:ProcesVariabele ;
    rdfs:label "Meel"@nl .

stof:mengsel a riepr:ProcesVariabele ;
    rdfs:label "Deegmengsel"@nl .

stof:deeg a riepr:ProcesVariabele ;
    rdfs:label "Deeg"@nl .

stof:koekjes a riepr:ProcesVariabele ;
    rdfs:label "Koekjes"@nl .
