@prefix riepr: <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix activiteit: <https://data.riepr.omgeving.vlaanderen.be/id/activiteit/> .
@prefix activiteitstap: <https://data.riepr.omgeving.vlaanderen.be/id/activiteit/stap/> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
## ---------------------------------------

activiteit:ACTIVITEIT_001 a riepr:Activiteit ;
    dct:created "2020-07-30T10:00:00Z"^^xsd:dateTime ;
    dct:issued "2020-07-30"^^xsd:date ;
    dct:valid "2030-12-31"^^xsd:date ;
    adms:status riepr:Actief ;
    rdfs:label "Koekjes maken"@nl .

activiteitstap:STAP_001 a riepr:ActiviteitStap ;
    rdfs:label "Koekjesdeeg maken"@nl ;
    pplan:isStepOfPlan activiteit:ACTIVITEIT_001 .
activiteitstap:STAP_001_1 a riepr:ActiviteitStap ;
    rdfs:label "Ingrediënten mengen"@nl ;
    pplan:isStepOfPlan activiteitstap:STAP_001 .
activiteitstap:STAP_001_2 a riepr:ActiviteitStap ;
    rdfs:label "Overbrenging"@nl ;
    ssn:implements riepr:overbrengingsProces ;
    pplan:isStepOfPlan activiteitstap:STAP_001 ;
    pplan:isPrecededBy activiteitstap:STAP_001_1 .
activiteitstap:STAP_001_3 a riepr:ActiviteitStap ;
    rdfs:label "Deeg laten rusten"@nl ;
    pplan:isStepOfPlan activiteitstap:STAP_001 ;
    pplan:isPrecededBy activiteitstap:STAP_001_2 .

activiteitstap:STAP_002 a riepr:ActiviteitStap ;
    rdfs:label "Koekjes bakken"@nl ;
    pplan:isStepOfPlan activiteit:ACTIVITEIT_001 ;
    # TODO: deze stap maakt gebruik van emissiepunt X
    pplan:isPrecededBy activiteitstap:STAP_001 .