## ---------------------------------------

# Staalfabriek (KBO nummer als exploitant ID)
exploitant:0400123123 a riepr:Exploitant ;
    rdfs:label "Staalfabriek NV"@nl ;
    owl:sameAs vkbo:0400123123 .

# Een locatie waar de staalfabriek is gevestigd
# Vestigingsnummer als deel van de URI
exploitatielocatie:0400123123_6851234567 a riepr:ExploitatieLocatie ;
    rdfs:label "Hoofdzetel Staalfabriek NV"@nl ;
    prov:atLocation exploitant:0400123123 ;
    owl:sameAs osm:6851234567 ;
    ogc:hasGeometry [ 
        ogc:asWKT "POINT(4.3500 51.2000)"^^ogc:WKTLiteral
    ] .

activiteit:0400123123_6851234567_ACTIVITEIT_1 a riepr:Activiteit ;
    rdfs:label "Staalproductieproces"@nl ;
    prov:atLocation exploitatielocatie:0400123123_6851234567 ;
    dct:created "2020-07-30T10:00:00Z"^^xsd:dateTime ;
    dct:issued "2020-07-30"^^xsd:date ;
    dct:created "2020-07-30T10:00:00Z"^^xsd:dateTime ;
    dct:valid "2030-12-31"^^xsd:date ;
    adms:status riepr:Actief .

# Procesketen van de staalfabriek

## ONDERDEEL VAN Stroomboogoven proces
activiteitstap:0400123123_6851234567_ACTIVITEIT_1_0001 a riepr:ActiviteitStap ;
    rdfs:label "Toevoeging van grondstoffen"@nl ;
    pplan:isStepOfPlan activiteit:0400123123_6851234567_ACTIVITEIT_1 .
