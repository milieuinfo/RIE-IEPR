PREFIX riepr:   <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#>
PREFIX stof:    <https://data.riepr.omgeving.vlaanderen.be/id/stof/>
PREFIX agent:    <https://data.riepr.omgeving.vlaanderen.be/id/agent/>
PREFIX concept: <https://data.imjv.omgeving.vlaanderen.be/id/concept/>
PREFIX pplan:   <http://purl.org/net/p-plan#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX ssn:     <http://www.w3.org/ns/ssn/>
PREFIX dct:     <http://purl.org/dc/terms/>
PREFIX qb:      <http://purl.org/linked-data/cube#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX imjv:    <https://data.imjv.omgeving.vlaanderen.be/ns/imjv#>
PREFIX sosa:    <http://www.w3.org/ns/sosa/>
PREFIX qudt:    <http://qudt.org/schema/qudt/>
PREFIX sdmxa:   <http://purl.org/linked-data/sdmx/2009/attribute#>
PREFIX schema:  <http://schema.org/>
PREFIX time:    <http://www.w3.org/2006/time#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

construct
{
    # de mens fo het labo of de sensor die de observaties doet
    agent:labo_mens_sensor_x a sosa:Sensor, prov:Agent ;
        ssn:implements riepr:meetProces .

    riepr:meetProces a sosa:Procedure , skos:Concept .

    # Procesvariabelen
    #stof:rookgas     a riepr:ProcesVariabele ; rdfs:label "Rookgas"@nl .
    #stof:proceswater a riepr:ProcesVariabele ; rdfs:label "Proceswater"@nl .

    # Emissie — FeatureOfInterest én instantie van de planvariabele
    ?emissie a riepr:Emissie , sosa:FeatureOfInterest;
        sosa:isFeatureOfInterestOf ?obs , ?concentratie , ?debiet , ?emissieDuur ;
        dct:type ?emissie_type ;
        ssn:hasProperty ?substantie , concept:debiet  , concept:emissieduur  ;
        rdfs:label ?emissie_label ;
        prov:wasAttributedTo  ?emissiepuntToestand ;
        pplan:correspondsToVariable ?emissieVar .

    # Gedeeld tijdinterval voor het rapportagejaar
    ?tijdInterval a time:Interval ;
        time:hasBeginning ?tijdBegin ;
        time:hasEnd ?tijdEinde .
    ?tijdBegin a time:Instant ;
        time:inXSDDateTime ?beginDT .
    ?tijdEinde a time:Instant ;
        time:inXSDDateTime ?eindeDT .



    # Massa-emissie observaties per stof
    ?obs a sosa:Observation  , sosa:Execution;
        sosa:madeBySensor  agent:labo_mens_sensor_x ;
        sosa:hasFeatureOfInterest ?emissie ;
        sosa:observedProperty ?substantie ;
        sosa:hasResult ?result ;
        sosa:phenomenonTime ?tijdInterval ;
        sosa:resultTime ?resultTime ;
        rdfs:label ?obs_label ;
        qb:dataSet ?dataset ;
        sosa:usedProcedure ?procedure .

    ?result sosa:isResultOf ?obs .

    ?procedure  a sosa:Procedure  , sosa:ObservingProcedure.

    ?substantie a sosa:Property , sosa:ObservableProperty , ssn:Property.

    ?result a sosa:Result ;
        qudt:quantityValue ?quantityValue .

    ?quantityValue a qudt:QuantityValue ;
        qudt:numericValue ?hoeveelheid ;
        qudt:hasUnit ?unitMeasure .

    # Concentratie-observaties (OPTIONAL)
    ?concentratie a sosa:Observation  , sosa:Execution ;
        sosa:madeBySensor  agent:labo_mens_sensor_x ;
        sosa:hasFeatureOfInterest ?emissie ;
        sosa:observedProperty ?substantie ;
        sosa:hasResult ?result_concentratie ;
        sosa:phenomenonTime ?tijdInterval ;
        sosa:resultTime ?resultTime ;
        rdfs:label ?concentratie_label ;
        sosa:usedProcedure ?procedure .

    ?result_concentratie sosa:isResultOf ?concentratie .

    ?result_concentratie a sosa:Result ;
        qudt:quantityValue ?quantityValue_concentratie .

    ?quantityValue_concentratie a qudt:QuantityValue ;
        qudt:numericValue ?hoeveelheid_concentratie ;
        qudt:hasUnit ?unitMeasure_concentratie .

    # Debiet-observaties (OPTIONAL, alleen voor luchtemissies)
    ?debiet a sosa:Observation  , sosa:Execution;
        sosa:madeBySensor  agent:labo_mens_sensor_x ;
        sosa:hasFeatureOfInterest ?emissie ;
        sosa:observedProperty  concept:debiet ;
        sosa:hasResult ?result_debiet ;
        sosa:phenomenonTime ?tijdInterval ;
        sosa:resultTime ?resultTime ;
        rdfs:label ?debiet_label ;
        sosa:usedProcedure concept:debietmeting .

    ?result_debiet sosa:isResultOf ?debiet .

    ?result_debiet a sosa:Result ;
        qudt:quantityValue ?quantityValue_debiet .

    ?quantityValue_debiet a qudt:QuantityValue ;
        qudt:numericValue ?hoeveelheid_debiet ;
        qudt:hasUnit ?unitMeasure_debiet .

    # Emissieduur-observaties (OPTIONAL, alleen voor luchtemissies)
    ?emissieDuur a sosa:Observation , sosa:Execution;
        sosa:madeBySensor  agent:labo_mens_sensor_x ;
        sosa:hasFeatureOfInterest ?emissie ;
        sosa:observedProperty concept:emissieduur ;
        sosa:hasResult ?result_emissieDuur ;
        sosa:phenomenonTime ?tijdInterval ;
        sosa:resultTime ?resultTime ;
        rdfs:label ?emissieDuur_label ;
        sosa:usedProcedure concept:emissieduurmeting .

    ?result_emissieDuur sosa:isResultOf ?emissieDuur .

    ?result_emissieDuur a sosa:Result ;
        qudt:quantityValue ?quantityValue_emissieDuur .

    ?quantityValue_emissieDuur a qudt:QuantityValue ;
        qudt:numericValue ?hoeveelheid_emissieDuur ;
        qudt:hasUnit ?unitMeasure_emissieDuur .

    # Concepten (altijd aanwezig)
    <https://data.imjv.omgeving.vlaanderen.be/id/concept/debiet>            a sosa:Property , sosa:ObservableProperty .
    <https://data.imjv.omgeving.vlaanderen.be/id/concept/debietmeting>      a sosa:Procedure  , sosa:ObservingProcedure.
    <https://data.imjv.omgeving.vlaanderen.be/id/concept/emissieduur>       a sosa:Property , sosa:ObservableProperty .
    <https://data.imjv.omgeving.vlaanderen.be/id/concept/emissieduurmeting> a sosa:Procedure  , sosa:ObservingProcedure.
}
where
{
    # Blok 1 — anker: emissiepuntToestand via CBB IRI, één rij per massa-observatie
    {
        SELECT ?obs ?exploitatiestaat ?emissiepuntToestand ?emissie
               ?emissie_label ?emissie_type ?debiet ?emissieDuur ?activiteit
        WHERE {
            VALUES ?cbb {
                <___exploitatie___>
            }
            ?emissiepuntToestand imjv:exploitatie ?cbb ;
                                 imjv:gekoppeldeActiviteit ?activiteit .
            FILTER (CONTAINS(STR(?emissiepuntToestand), "/2021"))
            ?obs imjv:emissiepuntToestand ?emissiepuntToestand ;
                 schema:about ?emissie ;
                 imjv:exploitatieToestand ?exploitatiestaat .
            ?emissie rdfs:label ?emissie_label .
            OPTIONAL { ?emissie dct:type ?emissie_type }
            OPTIONAL { ?emissie imjv:debiet ?debiet }
            OPTIONAL { ?emissie imjv:emissieDuur ?emissieDuur }
        }
    }

    # Blok 2 — stofmeting per observatie (inner join op ?obs)
    {
        SELECT ?obs ?obs_label ?dataset ?substantie ?unitMeasure ?hoeveelheid ?procedure
        WHERE {
            ?obs rdfs:label ?obs_label ;
                qb:dataSet ?dataset ;
                imjv:substantie ?substantie ;
                sdmxa:unitMeasure ?unitMeasure ;
                imjv:hoeveelheid ?hoeveelheid ;
                imjv:bepalingsMethode ?procedure .
        }
    }

    # Blok 3 — concentratiemeting (OPTIONAL, inner join op ?obs)
    OPTIONAL {
        SELECT ?obs ?concentratie ?concentratie_label ?unitMeasure_concentratie ?hoeveelheid_concentratie
        WHERE {
            ?obs imjv:concentratie ?concentratie .
            ?concentratie rdfs:label ?concentratie_label ;
                sdmxa:unitMeasure ?unitMeasure_concentratie ;
                rdf:waarde ?hoeveelheid_concentratie .
        }
    }

    # Blok 4 — debiet (OPTIONAL, inner join op ?debiet)
    OPTIONAL {
        SELECT ?debiet ?debiet_label ?unitMeasure_debiet ?hoeveelheid_debiet
        WHERE {
            ?debiet rdfs:label ?debiet_label ;
                sdmxa:unitMeasure ?unitMeasure_debiet ;
                rdf:waarde ?hoeveelheid_debiet .
        }
    }

    # Blok 5 — emissieduur (OPTIONAL, inner join op ?emissieDuur)
    OPTIONAL {
        SELECT ?emissieDuur ?emissieDuur_label ?unitMeasure_emissieDuur ?hoeveelheid_emissieDuur
        WHERE {
            ?emissieDuur rdfs:label ?emissieDuur_label ;
                sdmxa:unitMeasure ?unitMeasure_emissieDuur ;
                rdf:waarde ?hoeveelheid_emissieDuur .
        }
    }

    # Blok 6 — procesvar: lozingspunten → stof:proceswater, emissiepunten → stof:rookgas
    OPTIONAL {
        SELECT DISTINCT ?emissiepuntToestand (stof:proceswater AS ?procesVar)
        WHERE {
            ?emissiepuntToestand a imjv:LozingspuntStaat .
        }
    }

    BIND(IF(BOUND(?procesVar), "proceswater", "rookgas") AS ?medium)
    BIND(IRI(CONCAT(
        "https://data.riepr.omgeving.vlaanderen.be/id/variabele/",
        REPLACE(STR(?emissiepuntToestand),
            "^https://data.imjv.omgeving.vlaanderen.be/id/[^/]+/([^/]+)/.*", "$1"),
        "_activiteit_",
        REPLACE(STR(?activiteit), "^.*/", ""),
        "_", ?medium)) AS ?emissieVar)

    # Tijdinterval afgeleid van het rapportagejaar
    BIND(REPLACE(STR(?emissiepuntToestand), "^.*/([0-9]{4})$", "$1") AS ?jaar)
    BIND(IRI(CONCAT("https://data.riepr.omgeving.vlaanderen.be/id/tijd/jaar/", ?jaar)) AS ?tijdInterval)
    BIND(IRI(CONCAT("https://data.riepr.omgeving.vlaanderen.be/id/tijd/jaar/", ?jaar, "/begin")) AS ?tijdBegin)
    BIND(IRI(CONCAT("https://data.riepr.omgeving.vlaanderen.be/id/tijd/jaar/", ?jaar, "/einde")) AS ?tijdEinde)
    BIND(STRDT(CONCAT(?jaar, "-01-01T00:00:00"), xsd:dateTime) AS ?beginDT)
    BIND(STRDT(CONCAT(?jaar, "-12-31T23:59:59"), xsd:dateTime) AS ?eindeDT)
    BIND(xsd:integer(?jaar) + 1 AS ?volgendJaar)
    BIND(STRDT(CONCAT(STR(?volgendJaar), "-01-01T00:00:00"), xsd:dateTime) AS ?resultTime)

    # Afgeleide IRIs
    BIND(IRI(REPLACE(STR(?obs), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/result/")) AS ?result)
    BIND(IRI(REPLACE(STR(?obs), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/quantityvalue/")) AS ?quantityValue)
    BIND(IF(BOUND(?concentratie), IRI(REPLACE(STR(?concentratie), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/result/")), ?noop) AS ?result_concentratie)
    BIND(IF(BOUND(?concentratie), IRI(REPLACE(STR(?concentratie), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/quantityvalue/")), ?noop) AS ?quantityValue_concentratie)
    BIND(IF(BOUND(?debiet), IRI(REPLACE(STR(?debiet), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/result/")), ?noop) AS ?result_debiet)
    BIND(IF(BOUND(?debiet), IRI(REPLACE(STR(?debiet), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/quantityvalue/")), ?noop) AS ?quantityValue_debiet)
    BIND(IF(BOUND(?emissieDuur), IRI(REPLACE(STR(?emissieDuur), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/result/")), ?noop) AS ?result_emissieDuur)
    BIND(IF(BOUND(?emissieDuur), IRI(REPLACE(STR(?emissieDuur), "https://data.imjv.omgeving.vlaanderen.be/id/", "https://data.imjv.omgeving.vlaanderen.be/id/quantityvalue/")), ?noop) AS ?quantityValue_emissieDuur)
}
