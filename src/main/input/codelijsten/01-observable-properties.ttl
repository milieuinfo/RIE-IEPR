@prefix :  <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
## ---------------------------------------

:ZinkConcentratie a sosa:ObservableProperty ;
    rdfs:label "Zink concentratie"@nl ;
    qudt:quantityKind quantitykind:MassConcentration ;
    # TODO: Niet juist; wat als meerdere opties mogelijk in codelijst
    # Eerder weglaten en in datamodel toelaten om meerdere units te koppelen - in principe is massconcentration genoeg?
    qudt:unit unit:MicrogramPerCubicMeter .

:Zuurtegraad a sosa:ObservableProperty ;
    rdfs:label "Zuurtegraad"@nl ;
    qudt:quantityKind quantitykind:Acidity ;
    qudt:unit unit:PH .