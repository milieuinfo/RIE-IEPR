@prefix riepr: <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix installatie: <https://data.riepr.omgeving.vlaanderen.be/id/installatie/> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ogc: <http://www.opengis.net/ont/geosparql#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
## ---------------------------------------

installatie:GPBV_12345 a riepr:Installatie ;
    rdfs:label "MijnInstallatie"@nl ;
    dct:issued "2020-01-01"^^xsd:date ;
    dct:created "2020-01-01T00:00:00"^^xsd:dateTime ;
    dct:valid "2030-12-31"^^xsd:date ;
    adms:status riepr:Actief ;
    prov:atLocation [ a riepr:ExploitatieLocatie ;
        rdfs:label "Exploitatielocatie MijnInstallatie"@nl ;
        ogc:hasGeometry [ 
            ogc:asWKT "POINT(4.1234 51.5678)"^^ogc:WKTLiteral
        ]
    ] ;
    # TODO VLAREM rubrieken hebben URIs maar nog geen documentatie gevonden
    rdfs:member <...>, <...> .
