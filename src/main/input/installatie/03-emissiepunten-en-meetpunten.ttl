## ---------------------------------------
## Datavoorbeeld: Installatie met emissiepunten en andere kenmerken
## Doelstelling: Illustreren van een installatie met emissiepunten en andere relevante kenmerken
## ---------------------------------------

## WORK IN PROGRESS

# URI's voor datavoorbeelden zijn fictief
@prefix riepr: <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix installatie: <https://data.riepr.omgeving.vlaanderen.be/id/installatie/> .
@prefix emissiepunt: <https://data.riepr.omgeving.vlaanderen.be/id/emissiepunt/> .
@prefix meetpunt: <https://data.riepr.omgeving.vlaanderen.be/id/meetpunt/#> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ogc: <http://www.opengis.net/ont/geosparql#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# Een installatie is een verzameling van apparatuur en infrastructuur op een bepaalde locatie die een specifieke functie vervult.
# Deze installatie kan al dan niet (GPBV-)vergund zijn.
installatie:GPBV_12345 a riepr:Installatie ;
    rdfs:label "Fictief NV"@nl ;
    adms:identifier [
        skos:notation "BE.VL.000000001.INSTALLATION" ;
        # TODO
    ], [
        skos:notation "20260101-0001" ;
        # TODO (inrichtingsnummer)
    ] ;
    # TODO: LOD publicatie beschikbaar?
    rdfs:seeAlso <https://gpbv.omgeving.vlaanderen.be/installatiefiche/BE.VL.000000001.INSTALLATION> ;
    rdfs:member <...>, <...> .

# Een emissiepunt is een specifiek punt waar stoffen de installatie verlaten en in de omgeving worden uitgestoten.
emissiepunt:EP_001 a riepr:Emissiepunt ;
    rdfs:label "Emissiepunt Schoorsteen 1"@nl ;
    ogc:hasGeometry <...> .

# Een meetpunt is een specifiek punt waar metingen worden uitgevoerd om de kwaliteit van de uitstoot of de omgeving te controleren.
meetpunt:MP_001 a riepr:Meetpunt ;
    rdfs:label "Meetpunt Luchtkwaliteit 1"@nl ;
    sosa:isProxyFor emissiepunt:EP_001 ; # optioneel
    ogc:hasGeometry <...> .

# Een meting op de 'flow' van een stap
meetpunt:MP_002 a riepr:Meetpunt ;
    rdfs:label "Meetpunt Waterkwaliteit 1"@nl ;
    ogc:hasGeometry <...> ;
    sosa:isProxyFor activiteitstap:STAP_001 ;
    .