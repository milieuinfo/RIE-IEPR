    boter(["Boter"])
    style boter color:white,fill:#FF9500,stroke:#CC7700,color:#fff
    boter -.->|375 gr| 01.1_boter_en_chocolade_in_pan

    donkere-chocolade(["Donkere chocolade"])
    style donkere-chocolade color:white,fill:#FF9500,stroke:#CC7700,color:#fff
