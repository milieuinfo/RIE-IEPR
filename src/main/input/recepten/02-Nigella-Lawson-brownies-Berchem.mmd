    03.6_beslag_kloppen -.-> beslag
    beslag -.-> 04.2_beslag_in_bakvorm

    kleur(["Bleekbruine bovenkant"])
    style kleur color:white,fill:#7ED321,stroke:#5A9E17,color:#fff
    04.4_laat_bakken_tot_lichtbruine_bovenkant -.-> kleur
    kleur -.-> 05.1_afkoelen
    
end

