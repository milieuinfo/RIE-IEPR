    suiker(["kristalsuiker"])
    style suiker color:white,fill:#FF9500,stroke:#CC7700,color:#fff
    suiker -.->|500 gr| 03.1_eieren_en_suiker_in_kom

    eieren(["Eieren"])
    style eieren color:white,fill:#FF9500,stroke:#CC7700,color:#fff
    eieren -.->|6 stuks| 03.1_eieren_en_suiker_in_kom

    gesmolten_mengsel(["Gesmolten boter-chocolade"])
