###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangifte
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangifte> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://data.vlaanderen.be/ns/dossier#Stuk> ;
                                                              rdfs:comment "Een aangifte is een document dat wordt ingediend bij de overheid."@nl ;
                                                              rdfs:label "Aangifte"@nl ;
                                                              <http://www.w3.org/ns/hydra/core#search> _:genid2 .

_:genid2 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
          <http://www.w3.org/ns/hydra/core#mapping> _:genid3 ;
          <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/aangifte/{vlaanderenId}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid3 <http://www.w3.org/ns/hydra/core#property> <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#vlaanderenId> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
          <http://www.w3.org/ns/hydra/core#variable> "vlaanderenId" .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangiftebundel
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangiftebundel> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <https://data.vlaanderen.be/ns/dossier#Stuk> ;
                                                                    rdfs:comment "Een aangiftebundel is een verzameling van aangiften die samen worden ingediend bij de overheid door een enkele exploitant."@nl ;
                                                                    rdfs:label "Aangiftebundel"@nl ;
                                                                    <http://www.w3.org/ns/hydra/core#search> _:genid4 .

_:genid4 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
          <http://www.w3.org/ns/hydra/core#mapping> _:genid5 ;
          <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/aangifte/{vlaanderenId}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid5 <http://www.w3.org/ns/hydra/core#property> <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#vlaanderenId> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
          <http://www.w3.org/ns/hydra/core#variable> "vlaanderenId" .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Contactgegevens
