_:genid8 <http://www.w3.org/ns/hydra/core#property> <http://purl.org/dc/terms/created> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
          <http://www.w3.org/ns/hydra/core#variable> "created" .

_:genid9 <http://www.w3.org/ns/hydra/core#property> <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#localId> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
          <http://www.w3.org/ns/hydra/core#variable> "uuid" .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissie
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissie> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                                                             <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                             rdfs:comment "Een emissie is een specifiek emissieevent dat betrekking heeft op het uitstoten of lozen van stoffen aan emissiepunten over of op een bepaalde periode of momentopname."@nl ;
                                                             rdfs:label "Emissie"@nl ;
                                                             <http://www.w3.org/ns/hydra/core#search> _:genid10 .

_:genid10 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
           <http://www.w3.org/ns/hydra/core#mapping> _:genid11 ;
           <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/emissie/{uuid}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid11 <http://www.w3.org/ns/hydra/core#property> <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#localId> ;
           <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
           <http://www.w3.org/ns/hydra/core#variable> "uuid" .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissiepunt
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissiepunt> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> ,
                                                                                 <http://www.w3.org/ns/ssn/System> ;
                                                                 rdfs:comment "Een emissiepunt is een specifiek punt waar stoffen de installatie verlaten en in de omgeving worden uitgestoten."@nl ;
                                                                 rdfs:label "Emissiepunt"@nl ;
                                                                 <http://www.w3.org/2004/02/skos/core#example> _:genid12 ;
                                                                 <http://www.w3.org/ns/hydra/core#search> _:genid14 .

_:genid12 rdf:type <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissiepunt> ;
           <http://purl.org/dc/terms/issued> "2020-01-01"^^xsd:date ;
           <http://purl.org/dc/terms/valid> "2030-12-31"^^xsd:date ;
           <http://www.opengis.net/ont/geosparql#hasGeometry> _:genid13 ;
           rdfs:label "Schouw 1 Cementfabriek Antwerpen"@nl .

_:genid14 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
           <http://www.w3.org/ns/hydra/core#mapping> _:genid15 ,
                                                     _:genid16 ,
                                                     _:genid17 ;
           <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/emissiepunt/{uuid}/{issued}/{created}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

