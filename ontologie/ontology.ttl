<file:///workspace/src/main/resources/be/vlaanderen/omgeving/riepr/data/ns/riepr/riepr.ttl> rdf:type owl:Ontology ;
                                                                                             <http://purl.org/dc/terms/creator> "Flemish Government - Department of Environment"@en ,
                                                                                                                                "Vlaamse overheid - Departement Omgeving"@nl ;
                                                                                             <http://purl.org/dc/terms/description> "De RIE-IEPR ontologie definieert een datamodel voor het beschrijven van industriele processen, installaties, emissiepunten, meetpunten, apparaten, observaties, exploitanten en exploitaties binnen het kader van het RIE-IEPR systeem."@nl ,
                                                                                                                                    "The RIE-IEPR ontology defines a data model for describing industrial processes, installations, emission points, measurement points, devices, observations, operators and operation locations within the context of the RIE-IEPR system."@en ;
                                                                                             <http://purl.org/dc/terms/issued> "2026-06-23"^^xsd:date ;
                                                                                             <http://purl.org/dc/terms/license> <https://data.vlaanderen.be/id/licentie/modellicentie-gratis-hergebruik/v1.0> ;
                                                                                             <http://purl.org/dc/terms/modified> "2026-06-23"^^xsd:date ;
                                                                                             <http://purl.org/dc/terms/publisher> "Flemish Government - Department of Environment and Spatial Development"@en ,
                                                                                                                                  "Vlaamse overheid - Departement Omgeving"@nl ;
                                                                                             <http://purl.org/dc/terms/title> "RIE-IEPR Ontologie"@nl ,
                                                                                                                              "RIE-IEPR Ontology"@en ;
                                                                                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "riepr" ;
                                                                                             <http://purl.org/vocab/vann/preferredNamespaceUri> "https://data.riepr.omgeving.vlaanderen.be/ns/riepr#" ;
                                                                                             rdfs:seeAlso <https://omgeving.vlaanderen.be> ;
                                                                                             owl:versionInfo "1.0.0" ;
                                                                                             <http://xmlns.com/foaf/0.1/homepage> <https://github.com/milieuinfo/RIE-IEPR> .

