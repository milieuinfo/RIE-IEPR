                                                              rdfs:range rdfs:Datatype ;
                                                              rdfs:comment "Het datatype van de waarde van een systeem eigenschap."@nl ;
                                                              rdfs:label "Datatype"@nl .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#notatietype
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#notatietype> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <http://www.w3.org/ns/adms#Identifier> ;
                                                                 rdfs:range rdfs:Datatype .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#parameter
