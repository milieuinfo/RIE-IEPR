                                                    _:genid8 ,
                                                    _:genid9 ;
          <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/contactgegevens/{uuid}/{created}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid7 <http://www.w3.org/ns/hydra/core#property> <http://purl.org/dc/terms/issued> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
