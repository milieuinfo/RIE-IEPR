###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#aangifte
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#aangifte> rdf:type owl:ObjectProperty ;
                                                              rdfs:range <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Aangifte> ;
                                                              rdfs:comment "De aangifte die gerelateerd is aan een exploitatielocatie of observatie."@nl ;
                                                              rdfs:label "Aangifte"@nl .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#datatype
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#datatype> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Systeemeigenschap> ;
                                                              rdfs:range rdfs:Datatype ;
                                                              rdfs:comment "Het datatype van de waarde van een systeem eigenschap."@nl ;
                                                              rdfs:label "Datatype"@nl .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#parameter
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#parameter> rdf:type owl:ObjectProperty ;
                                                               rdfs:domain <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Systeemeigenschap> ;
                                                               rdfs:range <http://purl.org/net/p-plan#Variable> ;
                                                               rdfs:comment "De parameter die wordt gebruikt bij een eigenschap of meting."@nl ;
                                                               rdfs:label "Parameter"@nl .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#rubriek
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#rubriek> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Proces> ;
                                                             rdfs:range <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Rubriek> ;
                                                             rdfs:comment "De rubriek die van toepassing is op een proces of installatie."@nl ;
                                                             rdfs:label "Rubriek"@nl .


