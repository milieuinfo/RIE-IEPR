                                                                     rdfs:subClassOf <http://www.w3.org/ns/oa#Annotation> ;
                                                                     rdfs:comment "Contactgegevens zijn de gegevens van een persoon die optreedt als contactpersoon voor een exploitant."@nl ;
                                                                     rdfs:label "Contactgegevens"@nl ;
                                                                     <http://www.w3.org/ns/hydra/core#search> _:genid6 .

