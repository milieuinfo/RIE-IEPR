                                                                    rdfs:subClassOf <https://data.vlaanderen.be/ns/dossier#Stuk> ;
                                                                    rdfs:comment "Een aangiftebundel is een verzameling van aangiften die samen worden ingediend bij de overheid door een enkele exploitant."@nl ;
                                                                    rdfs:label "Aangiftebundel"@nl ;
                                                                    <http://www.w3.org/ns/hydra/core#search> _:genid4 .

_:genid4 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
          <http://www.w3.org/ns/hydra/core#mapping> _:genid5 ;
          <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/aangifte/{vlaanderenId}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid5 <http://www.w3.org/ns/hydra/core#property> <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#vlaanderenId> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
          <http://www.w3.org/ns/hydra/core#variable> "vlaanderenId" .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Contactpersoon
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Contactpersoon> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.w3.org/ns/oa#Annotation> ;
                                                                    rdfs:comment "Contactpersoon zijn de gegevens van een persoon die optreedt als contact binnen een bepaalde functie voor een exploitant."@nl ;
                                                                    rdfs:label "Contactpersoon"@nl ;
                                                                    <http://www.w3.org/ns/hydra/core#search> _:genid6 .

_:genid6 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
          <http://www.w3.org/ns/hydra/core#mapping> _:genid7 ,
                                                    _:genid8 ;
          <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/contactpersoon/{uuid}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid7 <http://www.w3.org/ns/hydra/core#property> <http://purl.org/dc/terms/issued> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
          <http://www.w3.org/ns/hydra/core#variable> "issued" .

_:genid8 <http://www.w3.org/ns/hydra/core#property> <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#localId> ;
          <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
          <http://www.w3.org/ns/hydra/core#variable> "uuid" .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissie
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissie> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ,
                                                                             <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                             rdfs:comment "Een emissie is een specifieke gebeurtenis dat betrekking heeft op het uitstoten of lozen van stoffen aan emissiepunten over of op een bepaalde periode of momentopname."@nl ;
                                                             rdfs:label "Emissie"@nl ;
                                                             <http://www.w3.org/ns/hydra/core#search> _:genid9 .

_:genid9 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
          <http://www.w3.org/ns/hydra/core#mapping> _:genid10 ;
          <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/emissie/{uuid}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid10 <http://www.w3.org/ns/hydra/core#property> <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#localId> ;
           <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
           <http://www.w3.org/ns/hydra/core#variable> "uuid" .


###  https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissiepunt
<https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissiepunt> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> ,
                                                                                 <http://www.w3.org/ns/ssn/System> ;
                                                                 rdfs:comment "Een emissiepunt is een specifiek punt waar stoffen de installatie verlaten en in de omgeving worden uitgestoten."@nl ;
                                                                 rdfs:label "Emissiepunt"@nl ;
                                                                 <http://www.w3.org/2004/02/skos/core#example> _:genid11 ;
                                                                 <http://www.w3.org/ns/hydra/core#search> _:genid13 .

_:genid11 rdf:type <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Emissiepunt> ;
           <http://purl.org/dc/terms/issued> "2020-01-01"^^xsd:date ;
           <http://purl.org/dc/terms/valid> "2030-12-31"^^xsd:date ;
           <http://www.opengis.net/ont/geosparql#hasGeometry> _:genid12 ;
           rdfs:label "Schouw 1 Cementfabriek Antwerpen"@nl .

_:genid13 rdf:type <http://www.w3.org/ns/hydra/core#IriTemplate> ;
           <http://www.w3.org/ns/hydra/core#mapping> _:genid14 ,
                                                     _:genid15 ,
                                                     _:genid16 ;
           <http://www.w3.org/ns/hydra/core#template> "https://data.mjv.omgeving.vlaanderen.be/id/emissiepunt/{uuid}/{issued}/{created}"^^<http://www.w3.org/ns/hydra/core#Rfc6570Template> .

_:genid12 rdf:type <http://www.opengis.net/ont/geosparql#Geometry> ;
           <http://www.opengis.net/ont/geosparql#asWKT> "POINT(4.4025 51.2194)"^^<http://www.opengis.net/ont/geosparql#wktLiteral> .

_:genid14 <http://www.w3.org/ns/hydra/core#property> <http://purl.org/dc/terms/created> ;
           <http://www.w3.org/ns/hydra/core#required> "true"^^xsd:boolean ;
           <http://www.w3.org/ns/hydra/core#variable> "created" .

_:genid15 <http://www.w3.org/ns/hydra/core#property> <http://purl.org/dc/terms/issued> ;
