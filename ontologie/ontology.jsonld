  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "nl",
    "@value" : "Een emissie is een specifieke gebeurtenis dat betrekking heeft op het uitstoten of lozen van stoffen aan emissiepunten over of op een bepaalde periode of momentopname."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
