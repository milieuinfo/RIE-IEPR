  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "nl",
    "@value" : "Een aangiftebundel is een verzameling van aangiften die samen worden ingediend bij de overheid door een enkele exploitant."
  } ],
