  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "nl",
    "@value" : "Een emissiepunt is een specifiek punt waar stoffen de installatie verlaten en in de omgeving worden uitgestoten."
  } ],
