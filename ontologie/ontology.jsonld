  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "nl",
    "@value" : "Contactpersoon zijn de gegevens van een persoon die optreedt als contact binnen een bepaalde functie voor een exploitant."
  } ],
