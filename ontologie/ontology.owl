<?xml version="1.0"?>
<rdf:RDF xmlns="file:///workspace/src/main/resources/be/vlaanderen/omgeving/riepr/data/ns/riepr/riepr.ttl#"
     xml:base="file:///workspace/src/main/resources/be/vlaanderen/omgeving/riepr/data/ns/riepr/riepr.ttl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:adms="http://www.w3.org/ns/adms#"
     xmlns:core="http://www.w3.org/ns/hydra/core#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:geosparql="http://www.opengis.net/ont/geosparql#">
    <owl:Ontology rdf:about="file:///workspace/src/main/resources/be/vlaanderen/omgeving/riepr/data/ns/riepr/riepr.ttl">
        <terms:creator xml:lang="en">Flemish Government - Department of Environment</terms:creator>
        <terms:creator xml:lang="nl">Vlaamse overheid - Departement Omgeving</terms:creator>
        <terms:description xml:lang="nl">De RIE-IEPR ontologie definieert een datamodel voor het beschrijven van industriele processen, installaties, emissiepunten, meetpunten, apparaten, observaties, exploitanten en exploitaties binnen het kader van het RIE-IEPR systeem.</terms:description>
        <terms:description xml:lang="en">The RIE-IEPR ontology defines a data model for describing industrial processes, installations, emission points, measurement points, devices, observations, operators and operation locations within the context of the RIE-IEPR system.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-23</terms:issued>
        <terms:license rdf:resource="https://data.vlaanderen.be/id/licentie/modellicentie-gratis-hergebruik/v1.0"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-23</terms:modified>
        <terms:publisher xml:lang="en">Flemish Government - Department of Environment and Spatial Development</terms:publisher>
        <terms:publisher xml:lang="nl">Vlaamse overheid - Departement Omgeving</terms:publisher>
        <terms:title xml:lang="nl">RIE-IEPR Ontologie</terms:title>
        <terms:title xml:lang="en">RIE-IEPR Ontology</terms:title>
        <vann:preferredNamespacePrefix>riepr</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://data.riepr.omgeving.vlaanderen.be/ns/riepr#</vann:preferredNamespaceUri>
        <rdfs:seeAlso rdf:resource="https://omgeving.vlaanderen.be"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <foaf:homepage rdf:resource="https://github.com/milieuinfo/RIE-IEPR"/>
    </owl:Ontology>
    


