        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="nl">Het datatype-IRI van een skos:notation typed literal, opgeslagen als URI-string zodat het datatype en de notatie-waarde afzonderlijk bewaard worden.</rdfs:comment>
        <rdfs:label xml:lang="nl">Notatietype</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#vlaanderenId -->


    <owl:DatatypeProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#vlaanderenId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="nl">Een unieke identificatie binnen de context van Vlaanderen, gebruikt voor het identificeren van entiteiten zoals aangiften.</rdfs:comment>
        <rdfs:label xml:lang="nl">Vlaanderen Identifier</rdfs:label>
    </owl:DatatypeProperty>
    


