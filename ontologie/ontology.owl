        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
        <rdfs:comment xml:lang="nl">Het datatype van de waarde van een systeem eigenschap.</rdfs:comment>
        <rdfs:label xml:lang="nl">Datatype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#notatietype -->


    <owl:ObjectProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#notatietype">
