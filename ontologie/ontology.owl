        <rdfs:comment xml:lang="nl">Een externe identificator heeft een notatie waarde</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt is verschillend van een emissiepunt (disjoint)</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid278">
        <rdfs:comment xml:lang="nl">Een externe identificator heeft een notatie type (het datatype-IRI van de skos:notation typed literal)</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid279">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt kan filters hebben</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid280">
        <rdfs:comment xml:lang="nl">Een adres kan een volledig adres hebben als vrije tekst</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid281">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt kan meerdere eigenschappen hebben</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid282">
        <rdfs:comment xml:lang="nl">Een adres kan een huisnummer of locatieaanduiding hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid283">
        <rdfs:comment xml:lang="nl">Een exploitatielocatie kan verbonden zijn aan een enkele aangifte</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Een proces met een emissie procedure type als dct:type moet stoffen uitstoten of lozen aan een emissiepunt</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid285">
        <rdfs:comment xml:lang="nl">Een exploitatielocatie moet gekoppeld zijn aan exact één exploitant</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid286">
        <rdfs:comment xml:lang="nl">Een exploitatie kan een geldigheid einde hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid287">
        <rdfs:comment xml:lang="nl">Een exploitatie kan verbonden zijn aan een enkele aangifte</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid288">
        <rdfs:comment xml:lang="nl">Een exploitatie implementeert een proces</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Een (exploitatie)proces is verschillend van de exploitatielocatie die het implementeert</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid290">
        <rdfs:comment xml:lang="nl">Een exploitatie kan een hoofdactiviteit hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid291">
        <rdfs:comment xml:lang="nl">Een aangifte kan deel zijn van een andere bundel.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid292">
        <rdfs:comment xml:lang="nl">Een aangifte bundel heeft een typering.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid293">
        <rdfs:comment xml:lang="nl">Een aangiftebundel is gelinkt aan de exploitant</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid294">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt moet een creatie datum hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid295">
        <rdfs:comment xml:lang="nl">Een aangifte bundel heeft een datum van indiening.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid296">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt moet een geldigheid start hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid297">
        <rdfs:comment xml:lang="nl">Een aangifte kan een datum van goedkeuring hebben.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid298">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt kan een geldigheid einde hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid299">
        <rdfs:comment xml:lang="nl">Een aangifte heeft een status.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid300">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt kan verbonden zijn aan een enkele aangifte</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid301">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt moet een enkele status hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid302">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt kan een revisie zijn van een andere systemen (optioneel)</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid303">
        <rdfs:comment xml:lang="nl">Een aangifte heeft betrekking tot een enkele exploitatie.</rdfs:comment>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid304">
        <rdfs:comment xml:lang="nl">Een aangifte heeft een datum van indiening.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid305">
        <rdfs:comment xml:lang="nl">Een aangifte kan een datum van goedkeuring hebben.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid306">
        <rdfs:comment xml:lang="nl">Een systeem mag max 1 geometrie hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid307">
        <rdfs:comment xml:lang="nl">Een exploitatie wordt op een bepaalde exploitatielocatie uitgevoerd</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid308">
        <rdfs:comment xml:lang="nl">Een exploitatie heeft een status</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid309">
        <rdfs:comment xml:lang="nl">Een exploitatie kan externe identificaties hebben (optioneel)</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid310">
        <rdfs:comment xml:lang="nl">Een exploitatie moet een geldigheid start hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid311">
        <rdfs:comment xml:lang="nl">Een exploitatie moet een benaming hebben</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid312">
        <rdfs:comment xml:lang="nl">Een exploitatie moet een modificatie datum hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid313">
        <rdfs:comment xml:lang="nl">Een exploitatie moet een creatie datum hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid314">
        <rdfs:comment xml:lang="nl">Een exploitatie zet systemen in</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid315">
        <rdfs:comment xml:lang="nl">Een observatie kan een verschijnsel tijdsinterval hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid316">
        <rdfs:comment xml:lang="nl">Een observatie kan een geobserveerde eigenschap hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid317">
        <rdfs:comment xml:lang="nl">Een observatie kan een gebruikte bepalingsmethode hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid318">
        <rdfs:comment xml:lang="nl">Een resultaat kan een numerieke waarde hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid319">
        <rdfs:comment xml:lang="nl">Een resultaat kan een eenheid hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid320">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt moet een datum in gebruik vanaf hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid321">
        <rdfs:comment xml:lang="nl">Een resultaat kan een tekstuele waarde hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid322">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt kan een datum in gebruik tot hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid323">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt heeft externe identificaties (optioneel)</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid324">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt moet een benaming hebben</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid325">
        <rdfs:comment xml:lang="nl">Een onttrekkingspunt moet een modificatie datum hebben</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid326">
        <rdfs:comment xml:lang="nl">Een proces moet een benaming hebben</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Een proces kan een beschrijving hebben</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid328">
        <rdfs:comment xml:lang="nl">Een proces kan zijn afgeleid van een (generieke) procedure (optioneel). Max 1 omdat een proces slechts van 1 procedure afgeleid kan zijn en deze procedure een verzameling van andere procedures zou moeten zijn.</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid329">
        <rdfs:comment xml:lang="nl">Een proces kan het gebruik van een systeem representeren</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid330">
        <rdfs:comment xml:lang="nl">Een proces moet een datum hebben waarop het is ingegeven</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid331">
        <rdfs:comment xml:lang="nl">Een proces kan meerdere rubrieken hebben</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid332">
        <rdfs:comment xml:lang="nl">Een proces mag minstens één inputvariabele hebben (stof)</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid333">
        <rdfs:comment xml:lang="nl">Een proces mag een of meer andere processen als voorgaande stap hebben.</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid334">
        <rdfs:comment xml:lang="nl">Een proces mag minstens één outputvariabele hebben (stof)</rdfs:comment>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid335">
        <rdfs:comment xml:lang="nl">Een proces kan deel uitmaken van een ander proces</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Een proces met een onttrekking procedure type als dct:type moet grondstoffen winnen of bemonsteren aan een onttrekkingspunt</rdfs:comment>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Een proces met een verwerkingsprocedure type als dct:type moet een installatie implementeren</rdfs:comment>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Proces kan een plan op zichzelf zijn (multi step)</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid339">
        <rdfs:comment xml:lang="nl">Een proces kan een revisie zijn van een ander proces (optioneel)</rdfs:comment>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
