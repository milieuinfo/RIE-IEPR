    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="nl">Een emissiepunt is verschillend van een onttrekkingspunt (disjoint)</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid415">
        <rdfs:comment xml:lang="nl">Contactgegevens kunnen een modificatie datum hebben</rdfs:comment>
