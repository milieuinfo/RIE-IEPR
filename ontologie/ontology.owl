        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    </owl:ObjectProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#parameter -->


    <owl:ObjectProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#parameter">
        <rdfs:domain rdf:resource="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Systeemeigenschap"/>
        <rdfs:range rdf:resource="http://purl.org/net/p-plan#Variable"/>
        <rdfs:comment xml:lang="nl">De parameter die wordt gebruikt bij een eigenschap of meting.</rdfs:comment>
        <rdfs:label xml:lang="nl">Parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#rubriek -->


    <owl:ObjectProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#rubriek">
