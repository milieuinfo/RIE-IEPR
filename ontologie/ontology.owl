        <rdfs:comment xml:lang="nl">De aangifte die gerelateerd is aan een exploitatielocatie of observatie.</rdfs:comment>
        <rdfs:label xml:lang="nl">Aangifte</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#datatype -->


