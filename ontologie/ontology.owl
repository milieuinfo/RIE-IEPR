        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="nl">De niet-functionele datum waarop een entiteit in gebruik is genomen.</rdfs:comment>
        <rdfs:label xml:lang="nl">in gebruik vanaf</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#inspireId -->


    <owl:DatatypeProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#inspireId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Een INSPIRE Identifier is een unieke identificatie conform de INSPIRE specificaties, gebruikt voor het identificeren van geografische entiteiten.</rdfs:comment>
        <rdfs:label xml:lang="en">INSPIRE Identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#localId -->


    <owl:DatatypeProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#localId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Een local identifier is een unieke identificatie binnen de context van RIE-IEPR.</rdfs:comment>
        <rdfs:label xml:lang="en">Local Identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#notatietype -->


    <owl:DatatypeProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#notatietype"/>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#vlaanderenId -->


    <owl:DatatypeProperty rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#vlaanderenId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="nl">Een unieke identificatie binnen de context van Vlaanderen, gebruikt voor het identificeren van entiteiten zoals aangiften.</rdfs:comment>
        <rdfs:label xml:lang="nl">Vlaanderen Identifier</rdfs:label>
    </owl:DatatypeProperty>
    


