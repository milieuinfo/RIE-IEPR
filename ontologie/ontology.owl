        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="nl">De niet-functionele datum waarop een entiteit buiten gebruik is gesteld.</rdfs:comment>
        <rdfs:label xml:lang="nl">in gebruik tot</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://data.riepr.omgeving.vlaanderen.be/ns/riepr#inGebruikVanaf -->


