    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Proces"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/type"/>
                <owl:someValuesFrom rdf:resource="https://data.omgeving.vlaanderen.be/id/concept/riepr/hoofdactiviteit-type"/>
            </owl:Restriction>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/implementedBy"/>
                <owl:someValuesFrom rdf:resource="https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Exploitatie"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
