<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.milieuinfo</groupId>
    <artifactId>acd-parent</artifactId>
    <version>1.1.8</version>
  </parent>

  <groupId>be.vlaanderen.omgeving</groupId>
  <artifactId>riepr</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <scm>
    <connection>scm:git:https://github.com/milieuinfo/RIE-IEPR.git</connection>
    <developerConnection>scm:git:https://github.com/milieuinfo/RIE-IEPR.git</developerConnection>
    <url>https://github.com/milieuinfo/RIE-IEPR.git</url>
    <tag>HEAD</tag>
  </scm>

  <!-- ========================= -->
  <!-- Properties -->
  <!-- ========================= -->
  <properties>
    <java.version>11</java.version>
    <jackson.version>2.15.2</jackson.version>

    <!-- Scala / Spark -->
    <scala.version>2.12.18</scala.version>
    <scala.compat.version>2.12</scala.compat.version>
    <spark.version>3.5.1</spark.version>

    <!-- Apache Jena -->
    <jena.version>4.10.0</jena.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- ========================= -->
  <!-- Dependencies -->
  <!-- ========================= -->
  <dependencies>

    <dependency>
      <groupId>org.scala-lang.modules</groupId>
      <artifactId>scala-collection-compat_2.12</artifactId>
      <version>2.12.0</version>
    </dependency>

    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-jsonld</artifactId>
      <version>4.2.1</version>
    </dependency>

    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.1</version>
      <scope>test</scope>
    </dependency>

    <!-- SLF4J + Logback for logging -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.4.11</version>
    </dependency>

    <!-- Scala -->
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-library</artifactId>
      <version>${scala.version}</version>
    </dependency>

    <!-- rdf-validator library -->
    <dependency>
      <groupId>be.vlaanderen.omgeving</groupId>
      <artifactId>rdf-validator</artifactId>
      <version>0.3.1-SNAPSHOT</version>
    </dependency>

    <!-- Apache Jena (RDF / SHACL / SPARQL) -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>apache-jena-libs</artifactId>
      <type>pom</type>
      <version>${jena.version}</version>
      <exclusions>
        <!-- Verwijder conflicterende Log4j → SLF4J bridges -->
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-to-slf4j</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- JSON-LD -->
    <dependency>
      <groupId>com.github.jsonld-java</groupId>
      <artifactId>jsonld-java</artifactId>
      <version>0.13.3</version>
      <exclusions>
        <exclusion>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>jackson-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>jackson-databind</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>jackson-annotations</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- JSON querying -->
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>2.9.0</version>
    </dependency>

    <!-- Jackson Core / Databind / Annotations -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Jackson Scala Module -->
    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-scala_2.12</artifactId>
      <version>2.15.2</version>
    </dependency>

    <!-- commons-codec >= 1.13 nodig door ScalaTest 3.2.x (MurmurHash3) -->
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.16.0</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.compat.version}</artifactId>
      <version>3.2.18</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-model</artifactId>
      <version>4.2.1</version>
    </dependency>

    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-api</artifactId>
      <version>4.2.1</version>
    </dependency>

    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-rio-turtle</artifactId>
      <version>4.2.1</version>
    </dependency>


  </dependencies>

  <!-- ========================= -->
  <!-- Repositories -->
  <!-- ========================= -->
  <repositories>
    <repository>
      <id>osgeo</id>
      <url>https://repo.osgeo.org/repository/release/</url>
    </repository>
  </repositories>

  <!-- ========================= -->
  <!-- Build -->
  <!-- ========================= -->
  <build>
    <!-- Default src/main/resources must be re-declared explicitly: a custom <resources> list
         replaces rather than extends it. The second entry packages ODDToolkit's generated output
         (see the exec-maven-plugin executions below) straight into the jar's classpath root, e.g.
         documentatie/datamodel/generated/sql/schema.sql -> classpath resource "sql/schema.sql",
         the same resource path imjvtomjv's RieSqlSchemaMeta already expects. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>documentatie/datamodel/generated</directory>
      </resource>
    </resources>
    <plugins>


      <!-- Scala compiler -->
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
        <version>4.9.2</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>testCompile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <scalaVersion>${scala.version}</scalaVersion>
          <args>
            <arg>-deprecation</arg>
            <arg>-feature</arg>
          </args>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
        <version>2.2.0</version>
        <executions>
          <execution>
            <id>test</id>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Surefire for ScalaTest
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <includes>
            <include>**/*Spec.scala</include>
            <include>**/*Test.scala</include>
          </includes>
        </configuration>
      </plugin> -->

      <!-- Exec plugin for running the application -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <mainClass>be.vlaanderen.omgeving.riepr.TurtleTransformer</mainClass>
          <cleanupDaemonThreads>false</cleanupDaemonThreads>
        </configuration>
        <!-- ODDToolkit code-generation, bound to generate-resources so the output lands under
             documentatie/datamodel/generated/ before the additional <resource> above packages it
             into the jar. One execution per generator (ODDToolkit's CLI only accepts a single
             "generator" argument per invocation); each run's ontology owl:imports fetches are cached
             under .cache/external/ (1h TTL), so only the first execution in a build pays that cost.

             ODDToolkit is declared as a dependency of *this plugin* (below), not of the riepr
             project itself, and each execution sets includeProjectDependencies=false /
             includePluginDependencies=true: ODDToolkit needs Jackson 2.20.x, which conflicts at
             runtime (NoSuchMethodError in YAMLParser) with riepr's own pinned Jackson 2.15.2 if both
             end up on the same classpath. Isolating it as a plugin dependency keeps ODDToolkit's
             (much newer/heavier: Jackson 2.20.x, Jena 4.9.0, Playwright, flexmark, ...) dependency
             tree from ever touching riepr's own compile/runtime classpath.

             Requires `oddtoolkit` installed locally first (`mvn install` in its checkout); not yet
             published to a shared repository. -->
        <dependencies>
          <dependency>
            <groupId>be.vlaanderen.omgeving</groupId>
            <artifactId>oddtoolkit</artifactId>
            <version>0.0.1</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>oddtoolkit-sql</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <includeProjectDependencies>false</includeProjectDependencies>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>be.vlaanderen.omgeving.oddtoolkit.OddtoolkitApplication</mainClass>
              <arguments>
                <argument>--generator=sql</argument>
                <argument>--config-file=documentatie/datamodel/src/config.yml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>oddtoolkit-shacl</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <includeProjectDependencies>false</includeProjectDependencies>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>be.vlaanderen.omgeving.oddtoolkit.OddtoolkitApplication</mainClass>
              <arguments>
                <argument>--generator=shacl</argument>
                <argument>--config-file=documentatie/datamodel/src/config.yml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>oddtoolkit-java</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <includeProjectDependencies>false</includeProjectDependencies>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>be.vlaanderen.omgeving.oddtoolkit.OddtoolkitApplication</mainClass>
              <arguments>
                <argument>--generator=java</argument>
                <argument>--config-file=documentatie/datamodel/src/config.yml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>oddtoolkit-typescript</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <includeProjectDependencies>false</includeProjectDependencies>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>be.vlaanderen.omgeving.oddtoolkit.OddtoolkitApplication</mainClass>
              <arguments>
                <argument>--generator=typescript</argument>
                <argument>--config-file=documentatie/datamodel/src/config.yml</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
