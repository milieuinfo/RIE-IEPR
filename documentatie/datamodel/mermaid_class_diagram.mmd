classDiagram
    %% Generated from RDF data using csv_to_mermaid.py
    %% Source: RIE-IEPR datamodel

    class Activiteit {
        rdfs:label langString
        prov:startedAtTime dateTime
        rdf:type string
    }

    class ActiviteitStap {
        pplan:isPrecededBy string
        pplan:isStepOfPlan string
        rdfs:label langString
        rdf:type string
        prov:used string
    }

    class Apparaat {
        rdfs:label langString
        rdf:type string
    }

    class Concept {
        rdf:type string
    }

    class Emissiepunt {
        geo:hasGeometry string
        rdfs:label langString
        rdf:type string
    }

    class FeatureOfInterest {
        rdf:type string
    }

    class Installatie {
        identifier string
        rdfs:label langString
        rdfs:member string
        rdfs:seeAlso string
        rdf:type string
    }

    class Meetpunt {
        geo:hasGeometry string
        sosa:isProxyFor string
        rdfs:label langString
        rdf:type string
    }

    class MultiStep {
        pplan:isStepOfPlan string
        rdfs:label langString
        rdf:type string
    }

    class ObservableProperty {
        rdfs:label langString
        quantityKind string
        rdf:type string
        unit string
    }

    class Plan {
        rdf:type string
    }

    class SpatialObject {
        rdf:type string
    }

    class SpatialObjectCollection {
        rdf:type string
    }

    class Step {
        pplan:isPrecededBy string
        pplan:isStepOfPlan string
        rdfs:label langString
        rdf:type string
    }

    %% Relationships

    Activiteit --> Plan : rdf_type
    ActiviteitStap --> Activiteit : pplan_isStepOfPlan
    Apparaat --> Concept : rdf_type
    Emissiepunt --> SpatialObject : rdf_type
    Installatie --> Apparaat : rdfs_member
    Installatie --> SpatialObjectCollection : rdf_type
    Meetpunt --> Emissiepunt : sosa_isProxyFor
    Meetpunt --> FeatureOfInterest : rdf_type
    MultiStep --> Activiteit : pplan_isStepOfPlan
    Step --> Activiteit : pplan_isStepOfPlan
    Step --> MultiStep : pplan_isPrecededBy
    Step --> MultiStep : pplan_isStepOfPlan
