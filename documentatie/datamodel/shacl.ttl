@prefix :           <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix adms:       <http://www.w3.org/ns/adms#> .
@prefix concept:    <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix dbo:        <http://dbpedia.org/ontology/> .
@prefix dc:         <http://purl.org/dc/terms/> .
@prefix dct:        <http://purl.org/dc/terms/> .
@prefix foaf:       <http://xmlns.com/foaf/0.1/> .
@prefix hydra:      <http://www.w3.org/ns/hydra/core#> .
@prefix locn:       <http://www.w3.org/ns/locn#> .
@prefix nace:       <http://data.europa.eu/ux2/nace2.1/> .
@prefix ogc:        <http://www.opengis.net/ont/geosparql#> .
@prefix org:        <http://www.w3.org/ns/org#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix pplan:      <http://purl.org/net/p-plan#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix qudt:       <http://qudt.org/schema/qudt/> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:       <http://www.w3.org/ns/sosa/> .
@prefix ssn:        <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems> .
@prefix vann:       <http://purl.org/vocab/vann/> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

:ObservatieShape  rdf:type  sh:NodeShape ;
        sh:property     [ sh:class        :Emissie ;
                          sh:description  "Een observatie moet gekoppeld zijn aan exact één meetpunt of installatie"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         sosa:hasFeatureOfInterest
                        ] ;
        sh:property     [ sh:class        sosa:Result ;
                          sh:description  "Een observatie moet een resultaat hebben."@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         sosa:hasResult
                        ] ;
        sh:targetClass  :Observatie .

:ExploitantShape  rdf:type  sh:NodeShape ;
        sh:property     [ sh:class        locn:Address ;
                          sh:description  "Een exploitant moet een adres hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         locn:address
                        ] ;
        sh:property     [ sh:datatype     xsd:date ;
                          sh:description  "Een exploitant kan een geldigheid start hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:issued
                        ] ;
        sh:property     [ sh:class        :Contactpersoon ;
                          sh:description  "Een exploitant kan meerdere contactpersonen hebben"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         org:hasMember
                        ] ;
        sh:property     [ sh:description  "Een exploitant moet een organisatie of persoon zijn maar niet beide tegelijk"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:type
                        ] ;
        sh:property     [ sh:description  "Een exploitant moet een hoofdactiviteit hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         org:classification
                        ] ;
        sh:property     [ sh:datatype     xsd:date ;
                          sh:description  "Een exploitant kan een geldigheid einde hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:valid
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een exploitant kan een modificatie datum hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:modified
                        ] ;
        sh:property     [ sh:description  "Een exploitant moet een benaming hebben"@nl ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         rdfs:label
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een exploitant kan een creatie datum hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:created
                        ] ;
        sh:targetClass  :Exploitant .

:ProcesVariabeleShape
        rdf:type        sh:NodeShape ;
        sh:property     [ sh:description  "Een proces variabele kan een waarde hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         qudt:numericValue
                        ] ;
        sh:property     [ sh:description  "Een proces variabele kan een eenheid hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         qudt:hasUnit
                        ] ;
        sh:property     [ sh:description  "Een proces variabele kan een benaming hebben"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         rdfs:label
                        ] ;
        sh:property     [ sh:class     :Proces ;
                          sh:minCount  "0"^^xsd:int ;
                          sh:path      pplan:isInputVarOf
                        ] ;
        sh:property     [ sh:class     :Proces ;
                          sh:minCount  "0"^^xsd:int ;
                          sh:path      [ sh:inversePath  pplan:hasOutputVar ]
                        ] ;
        sh:property     [ sh:description  "Een proces variabele kan een typering hebben via dct:type"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:type
                        ] ;
        sh:targetClass  :ProcesVariabele .

:MeetInstrumentShape  rdf:type  sh:NodeShape ;
        sh:property     [ sh:datatype     xsd:date ;
                          sh:description  "Een systeem kan een geldigheid einde hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:valid
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een systeem moet een creatie datum hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:created
                        ] ;
        sh:property     [ sh:description  "Een systeem moet een benaming hebben"@nl ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         rdfs:label
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een systeem moet een modificatie datum hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:modified
                        ] ;
        sh:property     [ sh:class        ssn:System ;
                          sh:description  "Een systeem kan meerdere objecten bevatten."@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         ssn:hasSubSystem
                        ] ;
        sh:property     [ sh:class     ssn:System ;
                          sh:minCount  "0"^^xsd:int ;
                          sh:path      [ sh:inversePath  ssn:hasSubSystem ]
                        ] ;
        sh:property     [ sh:description  "Een systeem kan een typering hebben via dct:type"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:type
                        ] ;
        sh:property     [ sh:class        adms:Status ;
                          sh:description  "Een systeem moet een enkele status hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         adms:status
                        ] ;
        sh:property     [ sh:class        ssn:System ;
                          sh:description  "Een systeem kan een revisie zijn van een andere systemen (optioneel)"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         prov:wasRevisionOf
                        ] ;
        sh:property     [ sh:description  "Een systeem mag max 1 geometrie hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         ogc:hasGeometry
                        ] ;
        sh:property     [ sh:class        adms:Identifier ;
                          sh:description  "Een systeem heeft externe identificaties (optioneel)"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         adms:identifier
                        ] ;
        sh:property     [ sh:datatype     xsd:date ;
                          sh:description  "Een systeem moet een geldigheid start hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:issued
                        ] ;
        sh:property     [ sh:class     :Exploitatie ;
                          sh:minCount  "0"^^xsd:int ;
                          sh:path      ssn:hasDeployment
                        ] ;
        sh:property     [ sh:class        :ExploitatieLocatie ;
                          sh:description  "Een systeem moet onderdeel van een locatie zijn"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         sosa:isHostedBy
                        ] ;
        sh:targetClass  :MeetInstrument .

:ProcesShape  rdf:type  sh:NodeShape ;
        sh:property     [ sh:class        :Proces ;
                          sh:description  "Een proces kan deel uitmaken van een of meer andere processen"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         pplan:isStepOfPlan
                        ] ;
        sh:property     [ sh:description  "Een proces moet een benaming hebben"@nl ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         rdfs:label
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een proces moet een datum hebben waarop het is ingegeven"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:created
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een proces moet een modificatie datum hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:modified
                        ] ;
        sh:property     [ sh:class        pplan:Variable ;
                          sh:description  "Een proces mag minstens één outputvariabele hebben (stof)"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         pplan:hasOutputVar
                        ] ;
        sh:property     [ sh:datatype     xsd:date ;
                          sh:description  "Een proces kan een geldigheid start hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:issued
                        ] ;
        sh:property     [ sh:class        ssn:System ;
                          sh:description  "Een proces kan optioneel een variable die een systeem representeert gebruiken"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         ssn:implementedBy
                        ] ;
        sh:property     [ sh:class        pplan:Variable ;
                          sh:description  "Een proces mag minstens één inputvariabele hebben (stof)"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         pplan:hasInputVar
                        ] ;
        sh:property     [ sh:class     :Installatie ;
                          sh:minCount  "0"^^xsd:int ;
                          sh:path      ssn:implementedBy
                        ] ;
        sh:property     [ sh:class        sosa:Procedure ;
                          sh:description  "Een proces kan zijn afgeleid van een (generieke) procedure (optioneel). Max 1 omdat een proces slechts van 1 procedure afgeleid kan zijn en deze procedure een verzameling van andere procedures zou moeten zijn."@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:type
                        ] ;
        sh:property     [ sh:class        adms:Status ;
                          sh:description  "Een proces moet een enkele status hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         adms:status
                        ] ;
        sh:property     [ sh:class        :Proces ;
                          sh:description  "Een proces kan een revisie zijn van een ander proces (optioneel)"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         prov:wasRevisionOf
                        ] ;
        sh:property     [ sh:class        :Rubriek ;
                          sh:description  "Een proces kan meerdere rubrieken hebben"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         :rubriek
                        ] ;
        sh:property     [ sh:datatype     xsd:date ;
                          sh:description  "Een proces kan een geldigheid einde hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:valid
                        ] ;
        sh:targetClass  :Proces .

:InstallatieShape  rdf:type  sh:NodeShape ;
        sh:property     [ sh:class        ssn:System ;
                          sh:description  "Een systeem kan meerdere objecten bevatten."@nl ;
                          sh:minCount     "0"^^xsd:int ;
