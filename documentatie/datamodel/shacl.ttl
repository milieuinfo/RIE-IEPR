        sh:property     [ sh:description  "Een systeem moet een benaming hebben"@nl ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         rdfs:label
                        ] ;
        sh:property     [ sh:class        :InstallatieEigenschap ;
                          sh:description  "Een installatie kan meerdere installatie eigenschappen hebben"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         ssn:hasProperty
                        ] ;
        sh:property     [ sh:class        adms:Identifier ;
                          sh:description  "Een systeem heeft externe identificaties (optioneel)"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         adms:identifier
                        ] ;
        sh:property     [ sh:description  "Een systeem kan een typering hebben via dct:type"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:type
                        ] ;
        sh:property     [ sh:class        :Rubriek ;
                          sh:description  "Een installatie kan meerdere rubrieken hebben"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         :rubriek
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een systeem moet een creatie datum hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:created
                        ] ;
        sh:property     [ sh:description  "Een systeem mag max 1 geometrie hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         ogc:hasGeometry
                        ] ;
        sh:property     [ sh:class        :Proces ;
                          sh:description  "Een installatie kan ook processen bevatten die deze installatie voortstelt"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         ssn:implements
                        ] ;
        sh:property     [ sh:class     :Exploitatie ;
                          sh:minCount  "0"^^xsd:int ;
                          sh:path      ssn:hasDeployment
                        ] ;
        sh:targetClass  :Installatie .

:VerbruikProcedureShape
        rdf:type        sh:NodeShape ;
        sh:targetClass  :VerbruikProcedure .

