:ExploitatieLocatieShape
        rdf:type        sh:NodeShape ;
        sh:property     [ sh:datatype     xsd:date ;
                          sh:description  "Een exploitatie locatie kan een geldigheid einde hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         dc:valid
                        ] ;
        sh:property     [ sh:description  "Een exploitatie locatie moet een benaming hebben"@nl ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         rdfs:label
                        ] ;
        sh:property     [ sh:class        :Exploitant ;
                          sh:description  "Een exploitatie locatie moet gekoppeld zijn aan exact één exploitant"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         prov:wasAttributedTo
                        ] ;
        sh:property     [ sh:class     :Exploitatie ;
                          sh:minCount  "0"^^xsd:int ;
                          sh:path      ssn:inDeployment
                        ] ;
        sh:property     [ sh:class        locn:Address ;
                          sh:description  "Een exploitatie locatie kan een adres hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         locn:address
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een exploitatie locatie moet een datum hebben waarop het is ingegeven"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:created
                        ] ;
        sh:property     [ sh:description  "Een exploitatie locatie moet exact 1 geometrie hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         ogc:hasGeometry
                        ] ;
        sh:property     [ sh:class        adms:Identifier ;
                          sh:description  "Een exploitatie locatie heeft externe identificaties (optioneel)"@nl ;
                          sh:minCount     "0"^^xsd:int ;
                          sh:path         adms:identifier
                        ] ;
        sh:property     [ sh:datatype     xsd:dateTime ;
                          sh:description  "Een exploitatie locatie moet een modificatie datum hebben"@nl ;
                          sh:maxCount     "1"^^xsd:int ;
                          sh:minCount     "1"^^xsd:int ;
                          sh:path         dc:modified
