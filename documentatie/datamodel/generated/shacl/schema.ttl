:AangiftebundelShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:class        adms:Status;
                          sh:description  "Een aangifte heeft een status."@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         adms:status
                        ];
        sh:property     [ sh:description  "Een aangifte bundel heeft een typering."@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:type
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een aangifte kan een datum van goedkeuring hebben."@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:modified
                        ];
        sh:property     [ sh:class        :Exploitant;
                          sh:description  "Een aangiftebundel is gelinkt aan de exploitant"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:creator
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een aangifte bundel heeft een datum van indiening."@nl;
