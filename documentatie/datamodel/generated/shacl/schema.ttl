        sh:property     [ sh:description  "Een systeem kan een typering hebben via dct:type"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:type
                        ];
        sh:property     [ sh:description  "Een systeem mag max 1 geometrie hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         ogc:hasGeometry
                        ];
        sh:property     [ sh:class        adms:Status;
                          sh:description  "Een onttrekkingspunt moet een enkele status hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         adms:status
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een onttrekkingspunt moet een datum in gebruik vanaf hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         :inGebruikVanaf
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een onttrekkingspunt kan een datum in gebruik tot hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         :inGebruikTot
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een onttrekkingspunt moet een geldigheid start hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:issued
                        ];
        sh:targetClass  :Onttrekkingspunt .

