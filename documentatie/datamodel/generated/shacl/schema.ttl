        sh:property     [ sh:datatype     xsd:dateTime;
                          sh:description  "Een onttrekkingspunt moet een modificatie datum hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:modified
                        ];
        sh:property     [ sh:class        :Filter;
                          sh:description  "Een onttrekkingspunt kan filters hebben"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         ssn:hasSubSystem
                        ];
        sh:property     [ sh:class        adms:Identifier;
                          sh:description  "Een onttrekkingspunt heeft externe identificaties (optioneel)"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         adms:identifier
                        ];
        sh:property     [ sh:class     :Exploitatie;
                          sh:minCount  "0"^^xsd:int;
