        sh:property     [ sh:class        adms:Status;
                          sh:description  "Een uitwisselpunt moet een enkele status hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         adms:status
                        ];
        sh:property     [ sh:description  "Een uitwisselpunt kan een typering hebben via dct:type"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:type
