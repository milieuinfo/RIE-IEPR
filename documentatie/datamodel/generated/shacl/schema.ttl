@prefix :           <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#> .
@prefix adms:       <http://www.w3.org/ns/adms#> .
@prefix concept:    <https://data.riepr.omgeving.vlaanderen.be/id/concept/> .
@prefix dbo:        <http://dbpedia.org/ontology/> .
@prefix dct:        <http://purl.org/dc/terms/> .
@prefix dossier:    <https://data.vlaanderen.be/ns/dossier#> .
@prefix foaf:       <http://xmlns.com/foaf/0.1/> .
@prefix hydra:      <http://www.w3.org/ns/hydra/core#> .
@prefix locn:       <http://www.w3.org/ns/locn#> .
@prefix nace:       <http://data.europa.eu/ux2/nace2.1/> .
@prefix oa:         <http://www.w3.org/ns/oa#> .
@prefix ogc:        <http://www.opengis.net/ont/geosparql#> .
@prefix org:        <http://www.w3.org/ns/org#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix pplan:      <http://purl.org/net/p-plan#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix qudt:       <http://qudt.org/schema/qudt/> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:       <http://www.w3.org/ns/sosa/> .
@prefix sosa-2023:  <http://www.w3.org/ns/sosa/> .
@prefix ssn:        <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix st:         <https://data.riepr.omgeving.vlaanderen.be/id/concept/status/> .
@prefix vann:       <http://purl.org/vocab/vann/> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

:ExploitatieShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:datatype     xsd:dateTime;
                          sh:description  "Een exploitatie moet een creatie datum hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:created
                        ];
        sh:property     [ sh:class        :Aangifte;
                          sh:description  "Een exploitatie kan verbonden zijn aan een enkele aangifte"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         :aangifte
                        ];
        sh:property     [ sh:class        :Proces;
                          sh:description  "Een exploitatie implementeert een proces"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         ssn:implements
                        ];
        sh:property     [ sh:class        :Exploitatielocatie;
                          sh:description  "Een exploitatie wordt op een bepaalde exploitatielocatie uitgevoerd"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         ssn:deployedOnPlatform
                        ];
        sh:property     [ sh:description  "Een exploitatie kan een hoofdactiviteit hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         org:classification
                        ];
        sh:property     [ sh:description  "Een exploitatie moet een benaming hebben"@nl;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         rdfs:label
                        ];
        sh:property     [ sh:class        adms:Identifier;
                          sh:description  "Een exploitatie kan externe identificaties hebben (optioneel)"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         adms:identifier
                        ];
        sh:property     [ sh:datatype     xsd:dateTime;
                          sh:description  "Een exploitatie moet een modificatie datum hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:modified
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een exploitatie kan een geldigheid einde hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:valid
                        ];
        sh:property     [ sh:class        adms:Status;
                          sh:description  "Een exploitatie heeft een status"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         adms:status
                        ];
        sh:property     [ sh:class        ssn:System;
                          sh:description  "Een exploitatie zet systemen in"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         ssn:deployedSystem
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een exploitatie moet een geldigheid start hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:issued
                        ];
        sh:targetClass  :Exploitatie .

:RubriekShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:description  "Een rubriek kan een primaire bron hebben (VITO, ...)"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         prov:hadPrimarySource
                        ];
        sh:property     [ sh:description  "Een rubriek moet een code hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         skos:notation
                        ];
        sh:property     [ sh:description  "Een rubriek kan een beschrijving hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         skos:definition
                        ];
        sh:property     [ sh:description  "Een rubriek kan een typering hebben via dct:type"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:type
                        ];
        sh:targetClass  :Rubriek .

:EmissieShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:minCount  "0"^^xsd:int;
                          sh:or        ( [ sh:class  sosa-2023:Observation ]
                                         [ sh:class  sosa-2023:ObservationCollection ]
                                       );
                          sh:path      sosa-2023:isFeatureOfInterestOf
                        ];
        sh:property     [ sh:class        :Proces;
                          sh:description  "Een emissie moet gekoppeld zijn aan een proces"@nl;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         prov:wasDerivedFrom
                        ];
        sh:targetClass  :Emissie .

:ProcesvariabeleShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:description  "Een proces variabele kan een benaming hebben"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         rdfs:label
                        ];
        sh:property     [ sh:description  "Een proces variabele kan een waarde hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         qudt:numericValue
                        ];
        sh:property     [ sh:description  "Een proces variabele kan een eenheid hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         qudt:hasUnit
                        ];
        sh:property     [ sh:class     :Proces;
                          sh:minCount  "0"^^xsd:int;
                          sh:path      [ sh:inversePath  pplan:hasOutputVar ]
                        ];
        sh:property     [ sh:class     :Proces;
                          sh:minCount  "0"^^xsd:int;
                          sh:path      pplan:isInputVarOf
                        ];
        sh:property     [ sh:description  "Een proces variabele kan een typering hebben via dct:type"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:type
                        ];
        sh:targetClass  :Procesvariabele .

:ContactpersoonShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:description  "Contactpersonen kunnen een telefoonnummer hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         foaf:phone
                        ];
        sh:property     [ sh:description  "Contactpersonen moeten een naam hebben"@nl;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         foaf:name
                        ];
        sh:property     [ sh:description  "Contactpersonen kunnen een opmerking hebben"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         rdfs:comment
                        ];
        sh:property     [ sh:class        :Exploitatie;
                          sh:description  "Contactpersonen moeten gekoppeld zijn aan exact één exploitant"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         oa:hasTarget
                        ];
        sh:property     [ sh:datatype  xsd:dateTime;
                          sh:maxCount  "1"^^xsd:int;
                          sh:minCount  "1"^^xsd:int;
                          sh:path      dct:created
                        ];
        sh:property     [ sh:description  "Contactpersonen moeten een functie hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:type
                        ];
        sh:property     [ sh:description  "Contactpersonen kunnen een e-mail adres hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         foaf:mbox
                        ];
        sh:property     [ sh:datatype     xsd:dateTime;
                          sh:description  "Contactpersonen kunnen een modificatie datum hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:modified
                        ];
        sh:targetClass  :Contactpersoon .

:AangifteShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:description  "Een aangifte heeft een informatie classificatie."@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dossier:informatieclassificatie
                        ];
        sh:property     [ sh:description  "Een aangifte heeft betrekking tot een enkele exploitatie."@nl;
                          sh:path         dct:subject
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een aangifte kan een datum van goedkeuring hebben."@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:modified
                        ];
        sh:property     [ sh:class        :Aangiftebundel;
                          sh:description  "Een aangifte kan deel zijn van een andere bundel."@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:isPartOf
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een aangifte heeft een datum van indiening."@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:created
                        ];
        sh:targetClass  :Aangifte .

:FilterShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:description  "Een systeem moet een benaming hebben"@nl;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         rdfs:label
                        ];
        sh:property     [ sh:class        adms:Identifier;
                          sh:description  "Een systeem heeft externe identificaties (optioneel)"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         adms:identifier
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een systeem kan een geldigheid einde hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:valid
                        ];
        sh:property     [ sh:description  "Een systeem mag max 1 geometrie hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         ogc:hasGeometry
                        ];
        sh:property     [ sh:datatype     xsd:dateTime;
                          sh:description  "Een systeem moet een modificatie datum hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:modified
                        ];
        sh:property     [ sh:class     :Exploitatie;
                          sh:minCount  "0"^^xsd:int;
                          sh:path      ssn:hasDeployment
                        ];
        sh:property     [ sh:class        :Aangifte;
                          sh:description  "Een filter kan verbonden zijn aan een enkele aangifte"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         :aangifte
                        ];
        sh:property     [ sh:datatype     xsd:dateTime;
                          sh:description  "Een systeem moet een creatie datum hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:created
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een systeem moet een geldigheid start hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         dct:issued
                        ];
        sh:property     [ sh:class        adms:Status;
                          sh:description  "Een systeem moet een enkele status hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         adms:status
                        ];
        sh:property     [ sh:description  "Een filter kan een typering hebben via dct:type"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:type
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een filter kan een datum in gebruik tot hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         :inGebruikTot
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een filter moet een datum in gebruik vanaf hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         :inGebruikVanaf
                        ];
        sh:targetClass  :Filter .

:OnttrekkingspuntShape
        rdf:type        sh:NodeShape;
        sh:property     [ sh:description  "Een onttrekkingspunt moet een benaming hebben"@nl;
