        sh:property     [ sh:description  "Een observatie kan een geobserveerde eigenschap hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         sosa-2023:observedProperty
                        ];
        sh:property     [ sh:class        sosa-2023:FeatureOfInterest;
                          sh:description  "Een observatie is gekoppeld aan een Emissie of Onttrekking"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         sosa-2023:hasFeatureOfInterest
                        ];
        sh:targetClass  :Observatie .

:UitwisselpuntShape  rdf:type  sh:NodeShape;
        sh:property     [ sh:datatype     xsd:date;
