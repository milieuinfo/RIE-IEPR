                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een onttrekkingspunt kan een geldigheid einde hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         dct:valid
                        ];
        sh:property     [ sh:class        :Systeemeigenschap;
                          sh:description  "Een onttrekkingspunt kan meerdere eigenschappen hebben"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         ssn:hasProperty
                        ];
