                        ];
        sh:property     [ sh:class        adms:Identifier;
                          sh:description  "Een uitwisselpunt heeft externe identificaties (optioneel)"@nl;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         adms:identifier
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een uitwisselpunt kan een datum in gebruik tot hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         :inGebruikTot
                        ];
        sh:property     [ sh:datatype     xsd:date;
                          sh:description  "Een uitwisselpunt moet een datum in gebruik vanaf hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "1"^^xsd:int;
                          sh:path         :inGebruikVanaf
                        ];
        sh:property     [ sh:class        :Aangifte;
                          sh:description  "Een uitwisselpunt kan verbonden zijn aan een enkele aangifte"@nl;
                          sh:maxCount     "1"^^xsd:int;
                          sh:minCount     "0"^^xsd:int;
                          sh:path         :aangifte
                        ];
        sh:property     [ sh:datatype     xsd:dateTime;
                          sh:description  "Een uitwisselpunt moet een creatie datum hebben"@nl;
                          sh:maxCount     "1"^^xsd:int;
