PREFIX cs:      <https://data.vlaanderen.be/ns/chemische_stof#>
PREFIX csc:     <https://data.omgeving.vlaanderen.be/id/concept/chemische_stof/>
PREFIX dbo:     <http://dbpedia.org/ontology/>
PREFIX dbp:     <http://dbpedia.org/property/>
PREFIX ns1:     <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#>
PREFIX ns2:     <http://www.w3.org/ns/ssn/>
PREFIX ns4:     <http://www.w3.org/ns/sosa/>
PREFIX ns6:     <http://www.w3.org/ns/adms#>
PREFIX ogcgs:   <http://www.opengis.net/ont/geosparql#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX sosa:    <http://www.w3.org/ns/sosa/>
PREFIX virtrdf: <http://www.openlinksw.com/schemas/virtrdf#>
PREFIX vlcs:    <https://data.omgeving.vlaanderen.be/id/conceptscheme/>



ns1:Installatie  rdf:type  "rdfs:Resource";
        rdfs:Label         "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString" , "http://www.w3.org/2001/XMLSchema#string";
        sosa:isHostedBy     ns1:Exploitatielocatie;
        ns2:hasDeployment  ns1:Exploitatie;
        ns2:hasSubSystem   ns2:System , ns1:Emissiepunt .

ns2:System  rdf:type       "rdfs:Resource";
        rdfs:Label         "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString" , "http://www.w3.org/2001/XMLSchema#string";
        ogcgs:hasGeometry  "rdfs:Resource";
        sosa:isHostedBy     ns1:Exploitatielocatie;
        ns2:hasDeployment  ns1:Exploitatie;
        ns2:hasSubSystem   ns2:System .

ns1:Exploitatielocatie
        rdf:type           "rdfs:Resource";
        rdfs:Label         "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString";
        ogcgs:hasGeometry  "rdfs:Resource";
        ns6:identifier     ns6:Identifier .

ns1:Onttrekkingspunt  rdf:type  "rdfs:Resource";
        rdfs:Label         "http://www.w3.org/2001/XMLSchema#string";
        ogcgs:hasGeometry  "rdfs:Resource";
        sosa:isHostedBy     ns1:Exploitatielocatie;
        ns2:hasDeployment  ns1:Exploitatie .

ns6:Identifier  rdf:type  "rdfs:Resource";
        skos:notation  "https://data.riepr.omgeving.vlaanderen.be/ns/riepr#KboVestigingsnummer" .

ns1:Filter  rdf:type       "rdfs:Resource";
        rdfs:Label         "http://www.w3.org/2001/XMLSchema#string";
        sosa:isHostedBy     ns1:Exploitatielocatie;
        ns2:hasDeployment  ns1:Exploitatie .


ns1:Exploitatie  rdf:type       "rdfs:Resource";
        rdfs:Label              "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString" , "http://www.w3.org/2001/XMLSchema#string";
        ns2:deployedOnPlatform   ns1:Exploitatielocatie;
        ns2:deployedSystem      ns1:Meetpunt , ns1:Onttrekkingspunt , ns2:System , ns1:Emissiepunt .

ns1:Emissiepunt  rdf:type  "rdfs:Resource";
        rdfs:Label         "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString" , "http://www.w3.org/2001/XMLSchema#string";
        ogcgs:hasGeometry  "rdfs:Resource";
        sosa:isHostedBy     ns1:Exploitatielocatie;
        ns2:hasDeployment  ns1:Exploitatie;
        ns2:hasSubSystem   ns2:System .

ns1:Meetpunt  rdf:type     "rdfs:Resource";
        rdfs:Label         "http://www.w3.org/2001/XMLSchema#string";
        ogcgs:hasGeometry  "rdfs:Resource";
        sosa:isHostedBy     ns1:Exploitatielocatie;
        ns2:hasDeployment  ns1:Exploitatie .
