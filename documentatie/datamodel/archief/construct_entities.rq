prefix riepr: <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix pplan: <http://purl.org/net/p-plan#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix sosa: <http://www.w3.org/ns/sosa/>
prefix var: <https://data.riepr.omgeving.vlaanderen.be/id/var/>
PREFIX prov: <http://www.w3.org/ns/prov#>

prefix xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX dct: <http://purl.org/dc/terms/>
prefix entity: <https://data.riepr.omgeving.vlaanderen.be/id/entity/>
prefix act_col: <https://data.riepr.omgeving.vlaanderen.be/id/actuationcollection/>

CONSTRUCT
{
    ?act a sosa:Actuation ;
        rdfs:label ?inst_lab ;
        pplan:correspondsToStep  ?pr ;
        prov:used ?used ;
        sosa:startTime ?date ;
        sosa:endTime ?date ;
        sosa:hasResult ?result ;
        sosa:madeByActuator ?installatie .

    ?used a prov:Entity ;
        rdfs:label ?input_label ;
        rdfs:label ?output_label ;
        pplan:correspondsToVariable ?input.

    ?result a sosa:Result;
        prov:wasDerivedFrom ?used ;
        rdfs:label ?input_label ;
        rdfs:label ?output_label ;
        pplan:correspondsToVariable ?output .

    ?ep_results a riepr:Emissie.

    ?act_col  a sosa:ActuationCollection ;
        sosa:usedProcedure ?plan;
        rdfs:label ?plan_label ;
        #prov:wasAssociatedWith agent:geert;
        sosa:hasMember ?act ;
        sosa:startTime ?date .
}
WHERE
{
    ?pr a riepr:Proces ;
        pplan:hasInputVar ?input ;
        pplan:hasOutputVar ?output ;
        sosa:implementedBy ?installatie .

    ?deployment ssn:deployedSystem ?installatie ;

        dct:created  ?date.

    ?input rdfs:label ?input_label .

    ?output rdfs:label ?output_label .

    ?installatie rdfs:label ?installatie_label .

    ?ep_pr pplan:hasOutputVar ?ep_output ;
        sosa:implementedBy ?ep .
    ?ep a riepr:Emissiepunt .
  #  ?x sosa:madeByActuator ?ep ;
   #     sosa:hasResult ?ep_result .

    OPTIONAL { ?deployment  ssn:implements ?plan . ?plan rdfs:label ?plan_label }


    BIND(
        CONCAT(
                  "Activiteit van ",
                  str(?installatie_label)
              )
        as ?inst_lab )

    BIND(
        IRI(
            CONCAT(

                      REPLACE(
                          STR(?deployment),
                          "https://data.riepr.omgeving.vlaanderen.be/id/exploitatie/",
                          "https://data.riepr.omgeving.vlaanderen.be/id/actuationcollection/",
                          "i"
                      ),

                      STR(?date)
                  )
        )
        AS ?act_col)

    BIND(
        IRI(
            CONCAT(
                      REPLACE(
                          REPLACE(
                              STR(?ep_output),
                              "https://data.riepr.omgeving.vlaanderen.be/id/var/",
                              "https://data.riepr.omgeving.vlaanderen.be/id/entity/",
                              "i"
                          ),
                          "https://data.riepr.omgeving.vlaanderen.be/id/stof/",
                          "https://data.riepr.omgeving.vlaanderen.be/id/entity/",
                          "i"
                      ),
                      STR(?date),
                      REPLACE(
                          REPLACE(
                              REPLACE(
                                  STR(?ep),
                                  "https://data.riepr.omgeving.vlaanderen.be/id/emissiepunt/",
                                  "",
                                  "i"
                              ),
                              "https://data.riepr.omgeving.vlaanderen.be/id/installatie/",
                              "",
                              "i"
                          ),
                          "https://data.riepr.omgeving.vlaanderen.be/id/apparaat/",
                          "",
                          "i"
                      )
                  )
        )
        AS ?ep_results)
    BIND(
        IRI(
            CONCAT(
                      REPLACE(
                          REPLACE(
                              STR(?output),
                              "https://data.riepr.omgeving.vlaanderen.be/id/var/",
                              "https://data.riepr.omgeving.vlaanderen.be/id/entity/",
                              "i"
                          ),
                          "https://data.riepr.omgeving.vlaanderen.be/id/stof/",
                          "https://data.riepr.omgeving.vlaanderen.be/id/entity/",
                          "i"
                      ),
                      STR(?date),
                      REPLACE(
                          REPLACE(
                              REPLACE(
                                  STR(?installatie),
                                  "https://data.riepr.omgeving.vlaanderen.be/id/emissiepunt/",
                                  "",
                                  "i"
                              ),
                              "https://data.riepr.omgeving.vlaanderen.be/id/installatie/",
                              "",
                              "i"
                          ),
                          "https://data.riepr.omgeving.vlaanderen.be/id/apparaat/",
                          "",
                          "i"
                      )
                  )
        )
        AS ?result)

    BIND(
        IRI(
            CONCAT(
                      REPLACE(
                          REPLACE(
                              STR(?input),
                              "https://data.riepr.omgeving.vlaanderen.be/id/var/",
                              "https://data.riepr.omgeving.vlaanderen.be/id/entity/",
                              "i"
                          ),
                          "https://data.riepr.omgeving.vlaanderen.be/id/stof/",
                          "https://data.riepr.omgeving.vlaanderen.be/id/entity/",
                          "i"
                      ),
                      STR(?date)
                  )
        )
        AS ?used)



    BIND(
        IRI(
            CONCAT(
                      REPLACE(
                          REPLACE(
                              STR(?installatie),
                              "https://data.riepr.omgeving.vlaanderen.be/id/apparaat/",
                              "https://data.riepr.omgeving.vlaanderen.be/id/actuation/",
                              "i"
                          ),
                          "https://data.riepr.omgeving.vlaanderen.be/id/emissiepunt/",
                          "https://data.riepr.omgeving.vlaanderen.be/id/actuation/",
                          "i"
                      ),
                      STR(?date)
                  )
        )
        AS ?act)
}


