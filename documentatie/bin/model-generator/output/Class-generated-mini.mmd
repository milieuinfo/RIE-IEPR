classDiagram
    class Apparaat {
        string uri
        Date aangemaaktOp
        Date geldigVan
        ExploitatieLocatie locatie (FK)
        string benaming
        Date geldigTot
    }
    class Emissiepunt {
        string uri
        string benaming
        string type
        Date geldigVan
        Date aangemaaktOp
        ExploitatieLocatie locatie (FK)
        Date geldigTot
    }
    class Grondwaterput {
        number depth
    }
    class Installatie {
        string uri
        object[] hasSubSystem (FK)
        string benaming
        Date aangemaaktOp
        Date geldigVan
        ExploitatieLocatie locatie (FK)
        Installatie[] afgeleidVan (FK)
        Date geldigTot
    }
    class Lozingspunt {
    }
    class Meetpunt {
        string uri
        string benaming
        string type
        Date aangemaaktOp
        Date geldigVan
        Date geldigTot
    }
    class Ontrekkingspunt {
        string uri
        string benaming
        string type
        Date geldigVan
        Date aangemaaktOp
        Date geldigTot
    }
    class Proces {
        string uri
        Date aangemaaktOp
        string benaming
        Date geldigVan
        ExploitatieLocatie locatie (FK)
        object[] toegewezenAan (FK)
        enum type
        ProcesVariabele[] hasInputVar (FK)
        ProcesVariabele[] hasOutputVar (FK)
        Proces onderdeelVan (FK)
        Proces[] gaatVoorafAan (FK)
        Date geldigTot
    }
    class ProcesVariabele {
        string uri
        string benaming
        string type
        string eenheid
        string waarde
        Date geldigVan
        Date aangemaaktOp
        Date geldigTot
    }
    class Schouw {
        number diameter
        number hoogte
    }
    class ISystem {
        <<interface>>
        string uri
        string afgeleidVan
        IAgent[] toegewezenAan
    }
    class IAgent {
        <<interface>>
        string uri
    }
    class ISpatialObject {
        <<interface>>
        string uri
    }

