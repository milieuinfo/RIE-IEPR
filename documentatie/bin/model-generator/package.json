{
  "name": "@riepr/model-generator",
  "version": "1.0.0",
  "description": "Model generator",
  "main": "converter.js",
  "type": "module",
  "scripts": {
    "start": "npm run clean:models && node converter.js",
    "convert": "node converter.js",
    "clean:models": "shx rm -f ./output/models/**/*.model.ts ./output/models/**/*.interface.ts ./output/models/**/*.enum.ts || true",
    "prebuild": "npm run clean:models",
    "sql": "MODEL=sql node converter.js",
    "er": "MODEL=er node converter.js",
    "class": "MODEL=class node converter.js",
    "lint": "eslint \"src/**/*.{js,ts}\" --ext .js,.ts",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --ext .js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx,css,json,md}\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "n3": "^1.17.2",
    "shacl-engine": "^1.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "shx": "^0.3.4",
    "eslint": "^8.50.0",
    "prettier": "^2.8.8",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-import": "^2.29.4"
  }
}
