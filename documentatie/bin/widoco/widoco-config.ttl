@prefix widoco: <https://w3id.org/widoco#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

widoco:config a widoco:WidocoConfig ;
    widoco:title "RIE-IEPR Ontologie" ;
    widoco:creator "Vlaanderen Omgeving" ;
    widoco:language "nl" ;
    widoco:license "https://creativecommons.org/licenses/by/4.0/" ;
    widoco:homepage "https://milieuinfo.github.io/RIE-IEPR/" ;
    widoco:documentationFormat "html" ;
    widoco:showOntologyInformation true ;
    widoco:useDefaultModules true ;
    widoco:generateDocumentationForAllImports false ;
    widoco:generateOverview true ;
    widoco:showPunning false .
