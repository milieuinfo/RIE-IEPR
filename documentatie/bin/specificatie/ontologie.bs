  rdf:type <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Lozingspunt> ;
  rdfs:label "Lozingspunt 1 Cementfabriek Antwerpen"@nl ;
  sosa:isHostedBy [ rdf:type <https://data.riepr.omgeving.vlaanderen.be/ns/riepr#Installatie> ;
  rdfs:label "Cementfabriek Antwerpen Installatie 1"@nl ] ;
  ogc:hasGeometry [ rdf:type ogc:Geometry ;
  ogc:asWKT "POINT(4.4030 51.2200)"^^ogc:wktLiteral ]
]
